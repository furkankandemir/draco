        /// <summary>
        /// Tooltip dismiss — panel dışına dokunma kapatır.
        /// C++ birebir: CUIImageTooltipDlg Tick (cpp:90-98) — hover dışı=kapat
        /// Mobil: dokunma input yoksa veya başka yere dokunulursa kapat.
        /// </summary>
        private void Update()
        {
            if (!IsVisible) return;

            // Check if player stats changed while tooltip is active
            if (m_cachedItem != null)
            {
                var gm = Core.GameManager.Instance;
                int currentStr = gm != null ? gm.StatStr : 0;
                int currentSta = gm != null ? gm.StatSta : 0;
                int currentDex = gm != null ? gm.StatDex : 0;
                int currentInt = gm != null ? gm.StatInt : 0;
                int currentCha = gm != null ? gm.StatCha : 0;

                if (m_iLastStr != currentStr || m_iLastSta != currentSta ||
                    m_iLastDex != currentDex || m_iLastInt != currentInt ||
                    m_iLastCha != currentCha)
                {
                    var basic = ItemDataManager.GetItemBasic(m_cachedItem.ItemDefId);
                    var ext = ItemDataManager.GetItemExt(m_cachedItem.ItemDefId);
                    if (basic != null)
                    {
                        UpdateItem(m_dwID_Basic, m_dwID_Ext, m_iCount, m_iDurability);
                        var lines = BuildTooltipLines(m_cachedItem, basic, ext, m_cachedShowPrice, m_cachedIsBuy);
                        RenderLines(lines);
                    }
                }
            }

            // Karakter hareket kontrolü
            if (_hasShowPlayerPos && Core.GameManager.Instance != null)
            {
                Vector3 currentPos = new Vector3(Core.GameManager.Instance.PlayerPosX, Core.GameManager.Instance.PlayerPosY, Core.GameManager.Instance.PlayerPosZ);

                Vector3 horizontalVel = _playerCharController != null ? new Vector3(_playerCharController.velocity.x, 0f, _playerCharController.velocity.z) : Vector3.zero;
                bool isMovingNow = horizontalVel.magnitude > 0.5f;

                if (_wasMovingWhenShown)
                {
                    // Koşarken açılmıştı. Yatay hız sıfıra yaklaştığında (tamamen durduğunda) yeni referans konumunu kaydet ve takibe başla.
                    bool hasFullyStopped = _playerCharController != null && new Vector3(_playerCharController.velocity.x, 0f, _playerCharController.velocity.z).magnitude < 0.05f;
                    if (hasFullyStopped)
                    {
                        _showPlayerPos = currentPos;
                        _wasMovingWhenShown = false;
                    }
                }
                else
                {
                    // Dururken açılmıştı (veya koşarken açılıp sonradan duruldu). En ufak harekette kapat.
                    float distanceMoved = Vector3.Distance(currentPos, _showPlayerPos);
                    if (distanceMoved > 0.1f)
                    {
                        Hide();
                        return;
                    }
                }
            }

            // Mouse sağ tık ile ekran döndürme kontrolü (PC/Editor)
            var mouse = UnityEngine.InputSystem.Mouse.current;
            if (mouse != null && mouse.rightButton.isPressed && mouse.delta.ReadValue().sqrMagnitude > 0.1f)
            {
                Hide();
                return;
            }

            // Tooltip açıldığı frame + 1 frame sonrası dismiss kontrolü başlasın
            // Aksi halde aynı tıklamada hem açılıp hem kapanıyor
            if (Time.frameCount <= _showFrame + 1) return;

            // Mobil dokunma veya mouse click — panel dışı dismiss
            bool pressed = false;
            Vector2 pointerPos = Vector2.zero;

            // Yeni Input System — Touchscreen
            if (UnityEngine.InputSystem.Touchscreen.current != null &&
                UnityEngine.InputSystem.Touchscreen.current.primaryTouch.press.wasPressedThisFrame)
            {
                pressed = true;
                pointerPos = UnityEngine.InputSystem.Touchscreen.current.primaryTouch.position.ReadValue();
            }
            // Yeni Input System — Mouse fallback (Editor/PC)
            else if (UnityEngine.InputSystem.Mouse.current != null &&
                     UnityEngine.InputSystem.Mouse.current.leftButton.wasPressedThisFrame)
            {
                pressed = true;
                pointerPos = UnityEngine.InputSystem.Mouse.current.position.ReadValue();
            }

            if (pressed)
            {
                // Dokunma panelin üzerinde mi kontrol et
                Vector2 localPoint;
                if (RectTransformUtility.ScreenPointToLocalPointInRectangle(
                    _panelRect, pointerPos, _canvas?.worldCamera, out localPoint))
                {
                    if (!_panelRect.rect.Contains(localPoint))
                    {
                        // Panel dışı — kapat (yeni tooltip açılacaksa Show() tekrar çağrılacak)
                        Hide();
                    }
                }
                else
                {
                    Hide();
                }
            }
        }

        // ===== C++ birebir: ResetItem (cpp:1184-1190) =====
        private void ResetItem()
        {
            m_dwID_Basic = 0;
            m_dwID_Ext = 0;
            m_iCount = 0;
            m_iDurability = 0;
            m_iLastStr = 0;
            m_iLastSta = 0;
            m_iLastDex = 0;
            m_iLastInt = 0;
            m_iLastCha = 0;
        }

        // ===== C++ birebir: IsItemChanged (cpp:1156-1163) =====
        private bool IsItemChanged(int basicId, int extId, int count, int durability)
        {
            var gm = Core.GameManager.Instance;
            int currentStr = gm != null ? gm.StatStr : 0;
            int currentSta = gm != null ? gm.StatSta : 0;
            int currentDex = gm != null ? gm.StatDex : 0;
            int currentInt = gm != null ? gm.StatInt : 0;
            int currentCha = gm != null ? gm.StatCha : 0;

            if (m_dwID_Basic == basicId && m_dwID_Ext == extId
                && m_iDurability == durability && m_iCount == count
                && m_iLastStr == currentStr && m_iLastSta == currentSta
                && m_iLastDex == currentDex && m_iLastInt == currentInt
                && m_iLastCha == currentCha)
                return false;
            return true;
        }

        // ===== C++ birebir: UpdateItem (cpp:1165-1182) =====
        private void UpdateItem(int basicId, int extId, int count, int durability)
        {
            m_dwID_Basic = basicId;
            m_dwID_Ext = extId;
            m_iCount = count;
            m_iDurability = durability;

            var gm = Core.GameManager.Instance;
            m_iLastStr = gm != null ? gm.StatStr : 0;
            m_iLastSta = gm != null ? gm.StatSta : 0;
            m_iLastDex = gm != null ? gm.StatDex : 0;
            m_iLastInt = gm != null ? gm.StatInt : 0;
            m_iLastCha = gm != null ? gm.StatCha : 0;
        }

