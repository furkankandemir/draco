        private void CreatePanel()
        {
            _panelRoot = new GameObject("ItemTooltipPanel");
            _panelRoot.transform.SetParent(transform, false);

            _panelRect = _panelRoot.AddComponent<RectTransform>();
            _panelRect.pivot = new Vector2(0, 1);

            // C++ birebir: CUIImageTooltipDlg → SetTopmost — her zaman diğer panellerin ÖNÜNDE
            // Unity'de overrideSorting ile ayrı sorting layer'da çizilir
            var tooltipCanvas = _panelRoot.AddComponent<Canvas>();
            tooltipCanvas.overrideSorting = true;
            tooltipCanvas.sortingOrder = 9999; // En üst
            _panelRoot.AddComponent<UnityEngine.UI.GraphicRaycaster>();

            _background = _panelRoot.AddComponent<Image>();
            _background.color = new Color(0.05f, 0.05f, 0.1f, 0.92f);

            var outline = _panelRoot.AddComponent<Outline>();
            outline.effectColor = new Color(0.4f, 0.35f, 0.2f, 0.8f);
            outline.effectDistance = new Vector2(2f, -2f);

            _layout = _panelRoot.AddComponent<VerticalLayoutGroup>();
            _layout.padding = new RectOffset(12, 12, 8, 8);
            _layout.spacing = 2;
            _layout.childForceExpandWidth = true;
            _layout.childForceExpandHeight = false;
            _layout.childControlWidth = true;
            _layout.childControlHeight = true;

            var fitter = _panelRoot.AddComponent<ContentSizeFitter>();
            fitter.horizontalFit = ContentSizeFitter.FitMode.PreferredSize;
            fitter.verticalFit = ContentSizeFitter.FitMode.PreferredSize;
        }

        private void RenderLines(List<TooltipLine> lines)
        {
            // Mevcut satırları temizle
            foreach (var t in _lineTexts)
            {
                if (t != null) Destroy(t.gameObject);
            }
            _lineTexts.Clear();

            for (int i = 0; i < lines.Count && i < MAX_TOOLTIP_COUNT; i++)
            {
                var line = lines[i];
                var go = new GameObject($"Line_{i}");
                go.transform.SetParent(_panelRoot.transform, false);

                var txt = go.AddComponent<Text>();
                txt.text = line.Text;
                txt.color = line.Color;
                txt.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
                txt.fontSize = 15;
                txt.alignment = line.Center ? TextAnchor.MiddleCenter : TextAnchor.MiddleLeft;
                txt.horizontalOverflow = HorizontalWrapMode.Overflow;
                txt.verticalOverflow = VerticalWrapMode.Overflow;

                var le = go.AddComponent<LayoutElement>();
                le.minHeight = 20;
                le.flexibleWidth = 1f; // Genişliği panel genişliğine zorlayarak ortalamayı çalıştırır

                _lineTexts.Add(txt);
            }
        }

        /// <summary>
        /// C++ birebir: SetPosSomething (UIImageTooltipDlg.cpp:121-213)
        /// xpos+26 sağa, sığmazsa sola. ypos-height yukarıya, sığmazsa aşağıya.
        /// </summary>
        private void PositionPanel(Vector2 screenPos)
        {
            if (_canvas == null) return;

            // Force layout rebuild so panel size is correct
            LayoutRebuilder.ForceRebuildLayoutImmediate(_panelRect);
            Canvas.ForceUpdateCanvases();

            var canvasRT = _canvas.GetComponent<RectTransform>();
            if (canvasRT == null) return;

            // Screen pos → canvas local pos
            Vector2 localPos;
            RectTransformUtility.ScreenPointToLocalPointInRectangle(
                canvasRT, screenPos, _canvas.worldCamera, out localPos);

            float panelW = _panelRect.rect.width;
            float panelH = _panelRect.rect.height;
            float canvasW = canvasRT.rect.width;
            float canvasH = canvasRT.rect.height;

            float minX = -canvasW * canvasRT.pivot.x;
            float maxX = canvasW * (1f - canvasRT.pivot.x);
            float minY = -canvasH * canvasRT.pivot.y;
            float maxY = canvasH * (1f - canvasRT.pivot.y);

            float iX, iY;
            float pivotX = 0f;
            float pivotY = 0f;

            // X-axis: Determine direction and set dynamic pivot
            if (localPos.x + panelW + 10f < maxX)
            {
                pivotX = 0f; // Grows right
                iX = localPos.x + 10f;
            }
            else
            {
                pivotX = 1f; // Grows left
                iX = localPos.x - 10f;
            }

            // Y-axis: Determine direction and set dynamic pivot
            if (localPos.y + panelH < maxY)
            {
                pivotY = 0f; // Grows up
                iY = localPos.y;
            }
            else if (localPos.y - panelH > minY)
            {
                pivotY = 1f; // Grows down
                iY = localPos.y;
            }
            else
            {
                pivotY = 0f;
                iY = minY; // Stick to bottom
            }

            // Clamping X to guarantee it stays inside screen boundaries
            if (pivotX == 0f)
            {
                if (iX + panelW > maxX) iX = maxX - panelW;
                if (iX < minX) iX = minX;
            }
            else
            {
                if (iX - panelW < minX) iX = minX + panelW;
                if (iX > maxX) iX = maxX;
            }

            // Clamping Y to guarantee it stays inside screen boundaries
            if (pivotY == 0f)
            {
                if (iY + panelH > maxY) iY = maxY - panelH;
                if (iY < minY) iY = minY;
            }
            else
            {
                if (iY - panelH < minY) iY = minY + panelH;
                if (iY > maxY) iY = maxY;
            }

            _panelRect.anchorMin = canvasRT.pivot;
            _panelRect.anchorMax = canvasRT.pivot;
            _panelRect.pivot = new Vector2(pivotX, pivotY);
            _panelRect.anchoredPosition = new Vector2(iX, iY);
        }

