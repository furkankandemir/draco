        /// <summary>
        /// C++ birebir: DisplayTooltipsEnable (cpp:1130-1154)
        /// Tooltip'i verilen item ve pozisyonda gösterir.
        /// </summary>
        public void Show(InventoryItemData item, Vector2 screenPos, bool showPrice = false, bool isBuy = true)
        {
            if (item == null)
            {
                ResetItem();
                Hide();
                return;
            }

            m_cachedItem = item;
            m_cachedShowPrice = showPrice;
            m_cachedIsBuy = isBuy;

            var basic = ItemDataManager.GetItemBasic(item.ItemDefId);
            var ext = ItemDataManager.GetItemExt(item.ItemDefId);

            int basicId = basic != null ? (int)basic.DwID : 0;
            int extId = ext != null ? ext.DwID : 0;

            if (IsItemChanged(basicId, extId, item.StackCount, item.Durability))
            {
                UpdateItem(basicId, extId, item.StackCount, item.Durability);

                var lines = BuildTooltipLines(item, basic, ext, showPrice, isBuy);
                RenderLines(lines);
            }

            if (!_panelRoot.activeSelf)
                _panelRoot.SetActive(true);

            PositionPanel(screenPos);

            // Dismiss guard — bu frame'de Update() dismiss yapmasın
            _showFrame = Time.frameCount;

            // Oyuncu konumu ve kamera rotasyonu başlangıç değerlerini kaydet
            if (Core.GameManager.Instance != null)
            {
                _showPlayerPos = new Vector3(Core.GameManager.Instance.PlayerPosX, Core.GameManager.Instance.PlayerPosY, Core.GameManager.Instance.PlayerPosZ);
                _hasShowPlayerPos = true;
            }
            else
            {
                _hasShowPlayerPos = false;
            }



            // Koşarken açılma durumunu kontrol et ve player controller cache'le
            _wasMovingWhenShown = false;
            _playerCharController = null;
            var pc = FindAnyObjectByType<Character.PlayerController>();
            if (pc != null)
            {
                _playerCharController = pc.GetComponent<CharacterController>();
                if (_playerCharController != null)
                {
                    Vector3 horizontalVel = new Vector3(_playerCharController.velocity.x, 0f, _playerCharController.velocity.z);
                    _wasMovingWhenShown = horizontalVel.magnitude > 0.5f;
                }
            }

            // C++ birebir: tooltip her zaman en üst pencere — SetTopmost/BringToTop
            transform.SetAsLastSibling();
        }

        /// <summary>
        /// C++ birebir: DisplayTooltipsDisable (cpp:100-104)
        /// </summary>
        public void Hide()
        {
            if (_panelRoot != null && _panelRoot.activeSelf)
                _panelRoot.SetActive(false);
        }

        public bool IsVisible => _panelRoot != null && _panelRoot.activeSelf;

        /// <summary>
        /// Overload: Sadece itemDefId ile tooltip göster.
        /// Shop, Warehouse, Loot, Upgrade panelleri için — InventoryItemData olmadan.
        /// C++ birebir: CUIImageTooltipDlg tekil sınıf, tüm panellerden çağrılır.
        /// </summary>
        public void ShowByItemId(int itemDefId, Vector2 screenPos, bool showPrice = false, bool isBuy = true)
        {
            // Geçici InventoryItemData oluştur — sadece tooltip için
            var tempItem = new InventoryItemData
            {
                ItemDefId = itemDefId,
                StackCount = 1,
                Durability = 0,
                Name = ""
            };
            Show(tempItem, screenPos, showPrice, isBuy);
        }

        // ===== Tooltip Satır Oluşturma — CalcTooltipStringNumAndWrite + Impl =====
        // Faz 2b-2h'de doldurulacak
        private List<TooltipLine> BuildTooltipLines(InventoryItemData item, ItemBasicEntry basic, ItemExtEntry ext, bool showPrice, bool isBuy)
        {
            var lines = new List<TooltipLine>();
            if (item != null && item.ItemDefId == 800085000)
            {
                lines.Add(new TooltipLine("Menicia's Official List", CGold, true));
                lines.Add(new TooltipLine("Scroll", CWhite, true));
                lines.Add(new TooltipLine("Use: Allows searching items in the merchant market.", CWhite));
                
                if (item.byFlag == 1)
                {
                    int remainingHours = item.Durability; // sDuration stores remaining hours
                    int days = remainingHours / 24;
                    int hours = remainingHours % 24;
                    lines.Add(new TooltipLine("Status: Active", CGreen, true));
                    lines.Add(new TooltipLine($"Remaining Time: {days} Days {hours} Hours", CGreen, true));
                }
                else
                {
                    lines.Add(new TooltipLine("Status: Unactivated", CYellow, true));
                    lines.Add(new TooltipLine("Duration: 30 Days (starts on first use)", CWhite, true));
                }
                
                if (showPrice)
                {
                    lines.Add(new TooltipLine("Purchasing Price : 99 KC", CWhite));
                }
                return lines;
            }
            if (basic == null) return lines;

            // Oyuncu bilgileri — C++ birebir: CGameBase::s_pPlayer->m_InfoExt / m_InfoBase
            var gm = Core.GameManager.Instance;

            // === FAZ 2b: İsim + Sınıf + Irk ===
            BuildNameLines(lines, item, basic, ext);
            // === FAZ 2c: Class Requirement ===
            BuildClassLines(lines, basic, gm);
            // === FAZ 2d: Savaş Statları ===
            BuildCombatStatLines(lines, basic, ext, item);
            // === FAZ 2e: Silah AC + Elemental + Drain ===
            BuildDefenseAndElementalLines(lines, ext);
            // === FAZ 2f: Stat Bonusları + Dirençler ===
            BuildBonusAndResistLines(lines, ext);
            // === FAZ 2g: Gereksinimler + Açıklama + Grade ===
            BuildRequirementLines(lines, basic, ext, gm);
            BuildRemarkLines(lines, basic);
            BuildGradeLines(lines, basic, ext);

            // === Fiyat (C++ cpp:235-257) ===
            if (showPrice)
                BuildPriceLines(lines, basic, ext, isBuy, gm);

            return lines;
        }

        // ===== Stub metotlar — her alt-fazda doldurulacak =====
        /// <summary>
        /// C++ birebir: CalcTooltipStringNumAndWriteImpl (cpp:265-350)
        /// İsim satırı + item sınıfı + ırk gereksinimi
        /// </summary>
        private void BuildNameLines(List<TooltipLine> lines, InventoryItemData item, ItemBasicEntry basic, ItemExtEntry ext)
        {
            // C++ cpp:276-288 — Gold/Coin özel durumu
            if (basic.SzName == "Coin")
            {
                lines.Add(new TooltipLine($"{item.StackCount}  {basic.SzName}", CWhite, true));
                return;
            }

            // C++ cpp:290-328 — İsim satırı + byMagicOrRare renk
            byte magicOrRare = ext != null ? ext.ByMagicOrRare : (byte)0;
            Color nameColor = magicOrRare switch
            {
                ITEM_ATTRIB_MAGIC => CBlue,
                ITEM_ATTRIB_LAIR => CYellow,
                ITEM_ATTRIB_CRAFT => CGreen,
                ITEM_ATTRIB_UNIQUE => CGold,
                ITEM_ATTRIB_UPGRADE => CIvory,
                _ => CWhite
            };

            string nameText;
            if (magicOrRare != ITEM_ATTRIB_UNIQUE)
            {
                // C++ cpp:318-323 — normal item: Name + (+N) suffix
                string suffix = "";
                int extMod = 0;
                if (ext != null)
                {
                    extMod = ext.DwID % 10;
                    if (extMod == 0)
                    {
                        int lastTwo = ext.DwID % 100;
                        if (lastTwo == 10 || lastTwo == 20 || lastTwo == 30 || lastTwo == 40 || lastTwo == 50)
                            extMod = 10;
                    }
                }
                if (extMod != 0)
                    suffix = $"(+{extMod})";
                nameText = basic.SzName + suffix;
            }
            else
            {
                // C++ cpp:326 — unique item: szHeader
                nameText = ext != null ? ext.SzHeader : basic.SzName;
            }
            lines.Add(new TooltipLine(nameText.Trim(), nameColor, true));

            // C++ cpp:331-338 — Item class (countable değilse)
            if (basic.ByContable != UIITEM_TYPE_COUNTABLE && basic.ByContable != UIITEM_TYPE_COUNTABLE_SMALL)
            {
                string className = GetItemClassName(basic.ByClass);
                if (className != null)
                    lines.Add(new TooltipLine(className, CWhite, true));
            }

            // C++ cpp:340-350 — Race requirement
            byte needRace = basic.ByNeedRace;
            if (needRace != 0) // RACE_ALL = 0
            {
                string raceName = GetRaceName(needRace);
                if (raceName != null)
                {
                    var gm = Core.GameManager.Instance;
                    bool raceMatch = gm != null && gm.Race == needRace;
                    lines.Add(new TooltipLine(raceName, raceMatch ? CWhite : CRed, true));
                }
            }
        }
        /// <summary>
        /// C++ birebir: cpp:352-541 — byNeedClass sınıf gereksinimi + renk
        /// </summary>
        private void BuildClassLines(List<TooltipLine> lines, ItemBasicEntry basic, Core.GameManager gm)
        {
            if (basic.ByNeedClass == 0) return;

            byte needClass = basic.ByNeedClass;
            string classText = GetClassKindText(needClass);
            if (classText == null) return;

            byte playerClass = gm != null ? gm.CharClass : (byte)0;
            bool classMatch = IsClassMatch(needClass, playerClass);
            lines.Add(new TooltipLine(classText, classMatch ? CWhite : CRed, true));
        }

        /// <summary>C++ birebir: GameBase.cpp:101-216 GetTextByClass</summary>
        private static string GetClassKindText(byte needClass)
        {
            return needClass switch
            {
                1 => "Warrior",       // CLASS_KINDOF_WARRIOR
                2 => "Rogue",         // CLASS_KINDOF_ROGUE
                3 => "Wizard",        // CLASS_KINDOF_WIZARD
                4 => "Priest",        // CLASS_KINDOF_PRIEST
                5 => "Berserker / Blade",       // CLASS_KINDOF_ATTACK_WARRIOR
                6 => "Guardian / Protector",     // CLASS_KINDOF_DEFEND_WARRIOR
                7 => "Hunter / Ranger",          // CLASS_KINDOF_ARCHER
                8 => "Penetrator / Assassin",    // CLASS_KINDOF_ASSASSIN
                9 => "Sorcerer / Mage",          // CLASS_KINDOF_ATTACK_WIZARD
                10 => "Necromancer / Enchanter",  // CLASS_KINDOF_PET_WIZARD
                11 => "Shaman / Cleric",          // CLASS_KINDOF_HEAL_PRIEST
                12 => "Dark Priest / Druid",      // CLASS_KINDOF_CURSE_PRIEST
                _ => null
            };
        }

        /// <summary>
        /// C++ birebir: cpp:358-541 — her CLASS_KINDOF için oyuncu sınıfı eşleşme switch
        /// </summary>
        private static bool IsClassMatch(byte needClass, byte playerClass)
        {
            return needClass switch
            {
                // CLASS_KINDOF_WARRIOR (cpp:360-375)
                1 => playerClass is 101 or 105 or 106 or 201 or 205 or 206,
                // CLASS_KINDOF_ROGUE (cpp:377-392)
                2 => playerClass is 102 or 107 or 108 or 202 or 207 or 208,
                // CLASS_KINDOF_WIZARD (cpp:394-409)
                3 => playerClass is 103 or 109 or 110 or 203 or 209 or 210,
                // CLASS_KINDOF_PRIEST (cpp:411-426)
                4 => playerClass is 104 or 111 or 112 or 204 or 211 or 212,
                // CLASS_KINDOF_ATTACK_WARRIOR (cpp:428-439)
                5 => playerClass is 105 or 205,
                // CLASS_KINDOF_DEFEND_WARRIOR (cpp:441-452)
                6 => playerClass is 106 or 206,
                // CLASS_KINDOF_ARCHER (cpp:454-465)
                7 => playerClass is 107 or 207,
                // CLASS_KINDOF_ASSASSIN (cpp:467-478)
                8 => playerClass is 108 or 208,
                // CLASS_KINDOF_ATTACK_WIZARD (cpp:480-491)
                9 => playerClass is 109 or 209,
                // CLASS_KINDOF_PET_WIZARD (cpp:493-504)
                10 => playerClass is 110 or 210,
                // CLASS_KINDOF_HEAL_PRIEST (cpp:506-517)
                11 => playerClass is 111 or 211,
                // CLASS_KINDOF_CURSE_PRIEST (cpp:519-530)
                12 => playerClass is 112 or 212,
                _ => playerClass == needClass
            };
        }
        /// <summary>
        /// C++ birebir: cpp:543-633 — savaş statları
        /// NOT: Weight (cpp:601-608) ve Durability (cpp:610-624) mobilde yok (kullanıcı kararı #53)
        /// </summary>
        private void BuildCombatStatLines(List<TooltipLine> lines, ItemBasicEntry basic, ItemExtEntry ext, InventoryItemData item)
        {
            short extDamage = ext != null ? ext.Damage : (short)0;
            
            if (basic.DwID == 119101000 || basic.DwID == 119101101 || (item != null && item.ItemDefId == 119101208))
            {
            }

            // C++ cpp:543-550 — Damage
            if (basic.SiDamage + extDamage != 0)
                lines.Add(new TooltipLine($"Attack Power : {basic.SiDamage + extDamage}", CWhite));

            // C++ cpp:552-570 — Attack speed (5 kategori)
            short extAtkPct = ext != null ? ext.AttackIntervalPct : (short)100;
            float fValue = basic.SiAttackInterval * (extAtkPct / 100.0f);
            if (fValue != 0)
            {
                string speedText;
                if (fValue >= 0 && fValue <= 89)
                    speedText = "Attack Speed : Very Fast";
                else if (fValue >= 90 && fValue <= 110)
                    speedText = "Attack Speed : Fast";
                else if (fValue >= 111 && fValue <= 130)
                    speedText = "Attack Speed : Normal";
                else if (fValue >= 131 && fValue <= 150)
                    speedText = "Attack Speed : Slow";
                else
                    speedText = "Attack Speed : Very Slow";
                lines.Add(new TooltipLine(speedText, CWhite));
            }

            // C++ cpp:574-581 — Attack range
            if (basic.SiAttackRange != 0)
                lines.Add(new TooltipLine($"Effective Range : {basic.SiAttackRange / 10.0f:F2}", CWhite));

            // C++ cpp:583-590 — Hit rate
            short extHitRate = ext != null ? ext.HitRate : (short)0;
            if (extHitRate != 0)
                lines.Add(new TooltipLine($"Increase Attack Power by {extHitRate}%", CWhite));

            // C++ cpp:592-599 — Evasion rate
            short extEvasion = ext != null ? ext.EvasionRate : (short)0;
            if (extEvasion != 0)
                lines.Add(new TooltipLine($"Increase Dodging Rate by {extEvasion}%", CWhite));

            // Weight (cpp:601-608) — mobilde yok, atlandı
            // Durability (cpp:610-624) — mobilde yok, atlandı

            // C++ cpp:626-633 — Defense
            short extDefense = ext != null ? ext.SiDefense : (short)0;
            if (basic.SiDefense + extDefense != 0)
                lines.Add(new TooltipLine($"Defense Ability : {basic.SiDefense + extDefense}", CWhite));
        }
