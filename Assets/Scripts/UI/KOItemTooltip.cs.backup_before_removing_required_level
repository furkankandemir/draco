        /// <summary>C++ birebir: cpp:868-1034 — gereksinimler</summary>
        private void BuildRequirementLines(List<TooltipLine> lines, ItemBasicEntry basic, ItemExtEntry ext, Core.GameManager gm)
        {
            short playerLevel = gm != null ? gm.Level : (short)0;

            // C++ cpp:868-880 — Need Level
            // C++ birebir: cNeedLevel + siNeedLevel > 1
            int needLvl = basic.CNeedLevel + (ext != null ? ext.SiNeedLevel : 0);
            if (needLvl > 1)
            {
                bool met = playerLevel >= needLvl;
                lines.Add(new TooltipLine($"Required Level : {needLvl}", met ? CWhite : CRed));
            }

            // C++ cpp:882-893 — Need Rank
            // C++ birebir: byNeedRank + siNeedRank > 0
            int needRank = basic.ByNeedRank + (ext != null ? ext.SiNeedRank : 0);
            if (needRank > 0)
            {
                // C++ birebir: SetTooltipTextColor(pInfoExt->iRank, needRank)
                int playerRank = gm != null ? gm.PersonalRank : 0;
                bool met = playerRank >= needRank;
                lines.Add(new TooltipLine($"Required Rank : {needRank}", met ? CWhite : CRed));
            }

            // C++ cpp:895-909 — Need Title
            // C++ birebir: byNeedTitle + siNeedTitle > 0
            int needTitle = basic.ByNeedTitle + (ext != null ? ext.SiNeedTitle : 0);
            if (needTitle > 0)
            {
                // C++ birebir: SetTooltipTextColor(pInfoExt->iTitle, needTitle)
                int playerTitle = gm != null ? gm.PersonalTitle : 0;
                bool met = playerTitle >= needTitle;
                lines.Add(new TooltipLine($"Required Title : {needTitle}", met ? CWhite : CRed));
            }

            // C++ cpp:911-1034 — 5 stat gereksinimi
            // C++ birebir mantık:
            //   iNeedValue = basic.byNeedXxx;
            //   if (iNeedValue != 0) iNeedValue += ext.siNeedXxx;
            //   if (iNeedValue > 0) { göster + Reduce etiketi }
            BuildSingleStatReq(lines, basic.ByNeedStrength, ext?.SiNeedStrength ?? 0, ext?.ByMagicOrRare ?? 0,
                gm != null ? gm.StatStr : 0, "Required Strength");
            BuildSingleStatReq(lines, basic.ByNeedStamina, ext?.SiNeedStamina ?? 0, ext?.ByMagicOrRare ?? 0,
                gm != null ? gm.StatSta : 0, "Required Health");
            BuildSingleStatReq(lines, basic.ByNeedDexterity, ext?.SiNeedDexterity ?? 0, ext?.ByMagicOrRare ?? 0,
                gm != null ? gm.StatDex : 0, "Required Dexterity");
            BuildSingleStatReq(lines, basic.ByNeedInteli, ext?.SiNeedInteli ?? 0, ext?.ByMagicOrRare ?? 0,
                gm != null ? gm.StatInt : 0, "Required Intelligence");
            BuildSingleStatReq(lines, basic.ByNeedMagicAttack, ext?.SiNeedMagicAttack ?? 0, ext?.ByMagicOrRare ?? 0,
                gm != null ? gm.StatCha : 0, "Required Magic Power");
        }

        /// <summary>
        /// C++ birebir: cpp:911-1034 — tek stat gereksinimi hesaplama + Reduce etiketi.
        /// iNeedValue = basicNeed; if (basicNeed != 0) iNeedValue += extNeed;
        /// if (extNeed < 0 && (UNIQUE || UPGRADE)) szReduce = "(Reduce)"
        /// </summary>
        private void BuildSingleStatReq(List<TooltipLine> lines, byte basicNeed, short extNeed, byte magicOrRare,
            int playerStat, string label)
        {
            int iNeedValue = basicNeed;
            if (iNeedValue != 0)
                iNeedValue += extNeed;
            if (iNeedValue <= 0) return;

            // C++ birebir: Reduce etiketi (cpp:917-921, 942-946, 967-971, 992-996, 1017-1021)
            string szReduce = "";
            if (extNeed < 0)
            {
                if (magicOrRare == ITEM_ATTRIB_UNIQUE || magicOrRare == ITEM_ATTRIB_UPGRADE)
                    szReduce = " (Reduce)";
            }

            bool met = playerStat >= iNeedValue;
            lines.Add(new TooltipLine($"{label} : {iNeedValue}{szReduce}", met ? CWhite : CRed));
        }
        /// <summary>C++ birebir: cpp:1036-1091 — szRemark açıklama split</summary>
        private void BuildRemarkLines(List<TooltipLine> lines, ItemBasicEntry basic)
        {
            // C++ cpp:1036-1038: szRemark = spItem->pItemBasic->szRemark
            // NOT: C++ sadece basic.szRemark kullanır, ext.szRemark yok
            string remark = basic.SzRemark;
            if (string.IsNullOrEmpty(remark)) return;

            // C++ cpp:1042-1047: totalWords sayma (space sayısı + 1)
            int totalWords = 1;
            foreach (char c in remark)
                if (c == ' ') totalWords++;

            if (totalWords >= MIN_WORDS_TO_SPLIT_DESC)
            {
                // C++ cpp:1051-1063: wordsInFirstHalf = (totalWords + 1) / 2, splitPos bul
                int wordsInFirstHalf = (totalWords + 1) / 2;
                int wordsSeen = 1;
                int splitPos = -1;
                for (int i = 0; i < remark.Length; i++)
                {
                    if (remark[i] != ' ') continue;
                    wordsSeen++;
                    if (wordsSeen > wordsInFirstHalf)
                    {
                        splitPos = i;
                        break;
                    }
                }

                if (splitPos >= 0)
                {
                    // C++ cpp:1068: "*" + firstHalf (ALIGNCENTER, CWhite)
                    lines.Add(new TooltipLine($"*{remark.Substring(0, splitPos)}", CWhite, true));
                    // C++ cpp:1077: secondHalf + "*" (ALIGNCENTER, CWhite)
                    lines.Add(new TooltipLine($"{remark.Substring(splitPos)}*", CWhite, true));
                }
            }
            else
            {
                // C++ cpp:1084-1086: "*" + szRemark + "*" (ALIGNCENTER, CWhite)
                lines.Add(new TooltipLine($"*{remark}*", CWhite, true));
            }
        }
        /// <summary>C++ birebir: cpp:1093-1127 — Unique/Upgrade grade</summary>
        private void BuildGradeLines(List<TooltipLine> lines, ItemBasicEntry basic, ItemExtEntry ext)
        {
            if (ext == null) return;

            byte magicOrRare = ext.ByMagicOrRare;
            switch (magicOrRare)
            {
                // C++ cpp:1098-1103 — UNIQUE → "Unique Item"
                case ITEM_ATTRIB_UNIQUE:
                    lines.Add(new TooltipLine("Unique", CGreen, true));
                    break;

                // C++ cpp:1105-1122 — UPGRADE → min(3, byGrade + bySoulBind) ile grade
                case ITEM_ATTRIB_UPGRADE:
                    int iItemGrade = System.Math.Min(3, basic.ByGrade + ext.BySoulBind);
                    int level = ext.DwID % 10;
                    if (iItemGrade == ITEM_GRADE_LOW_CLASS && level >= 7)
                        iItemGrade = ITEM_GRADE_MIDDLE_CLASS;
                    else if (iItemGrade == ITEM_GRADE_MIDDLE_CLASS && level >= 7)
                        iItemGrade = ITEM_GRADE_HIGH_CLASS;

                    string gradeText = iItemGrade switch
                    {
                        ITEM_GRADE_LOW_CLASS => "Item Grade : low Class",
                        ITEM_GRADE_MIDDLE_CLASS => "Item Grade : middle Class",
                        ITEM_GRADE_HIGH_CLASS => "Item Grade : high Class",
                        _ => null
                    };
                    if (gradeText != null)
                        lines.Add(new TooltipLine(gradeText, CGreen, true));
                    break;

                // C++ cpp:1124-1125: default → hiçbir şey yapma
            }
        }
        /// <summary>C++ birebir: cpp:235-257 — fiyat satırı</summary>
        private void BuildPriceLines(List<TooltipLine> lines, ItemBasicEntry basic, ItemExtEntry ext, bool isBuy, Core.GameManager gm)
        {
            int price;
            if (isBuy)
            {
                // C++ cpp:237-240 — ext price multiply
                int multiply = ext != null && ext.SiPriceMultiply > 0 ? ext.SiPriceMultiply : 1;
                price = basic.IPrice * multiply;
                // C++ cpp:243-246 — SetTooltipTextColor(pInfoExt->iGold, price)
                long playerGold = gm != null ? gm.Gold : 0;
                bool canAfford = playerGold >= price;
                lines.Add(new TooltipLine($"Purchasing Price : {price:N0}", canAfford ? CWhite : CRed));
            }
            else
            {
                // C++ birebir: IconItemSkill.cpp:37-58 — GetSellPrice()
                // iSellPrice = iPrice * siPriceMultiply
                // if (iSaleType != SALE_TYPE_FULL) iSellPrice /= NORMAL_RATIO(6)
                // if (iSellPrice < 1) iSellPrice = 1
                int multiply = ext != null && ext.SiPriceMultiply > 0 ? ext.SiPriceMultiply : 1;
                price = basic.IPrice * multiply;
                if (basic.ISaleType != 1) // SALE_TYPE_FULL = 1
                    price /= 6; // NORMAL_RATIO = 6 (C++ constexpr)
                if (price < 1) price = 1;
                // C++ cpp:252-253 — sell price her zaman beyaz
                lines.Add(new TooltipLine($"Selling Price : {price:N0}", CWhite));
            }
        }

