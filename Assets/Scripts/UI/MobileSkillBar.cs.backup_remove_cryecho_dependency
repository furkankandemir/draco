        private GameObject CreateCircleButton(

            Transform parent, string name,

            float offsetX, float offsetY,

            float diameter,

            Sprite frameSprite,

            string label, int fontSize,

            bool isPageBtn = false)

        {

            var outer = new GameObject(name);

            outer.transform.SetParent(parent, false);

            var outerRT = outer.AddComponent<RectTransform>();

            // Sağ-alt köşeye anchor

            outerRT.anchorMin = new Vector2(1, 0);

            outerRT.anchorMax = new Vector2(1, 0);

            outerRT.pivot = new Vector2(0.5f, 0.5f);

            // Dış kutu boyutu tam olarak istenen çapa (diameter) eşit olacak

            outerRT.sizeDelta = new Vector2(diameter, diameter);

            outerRT.anchoredPosition = new Vector2(offsetX, -offsetY); // offsetY negatif → yukarı



            var outerImg = outer.AddComponent<Image>();

            outerImg.sprite = frameSprite;

            outerImg.color = Color.white;

            outerImg.type = Image.Type.Simple;

            outerImg.raycastTarget = true; // Sürükle-bırak için



            // Maske görevi gören İç Daire (Inner)

            var inner = new GameObject("Inner");

            inner.transform.SetParent(outer.transform, false);

            var innerRT = inner.AddComponent<RectTransform>();

            innerRT.anchorMin = new Vector2(0.5f, 0.5f);

            innerRT.anchorMax = new Vector2(0.5f, 0.5f);

            innerRT.pivot = new Vector2(0.5f, 0.5f);

            // Çerçevenin altın halkasının iç sınırlarına sığması için çapı oranlıyoruz (%81'i içine oturur)

            float innerSize = diameter * 0.81f;

            innerRT.sizeDelta = new Vector2(innerSize, innerSize);

            innerRT.anchoredPosition = Vector2.zero;

            var innerImg = inner.AddComponent<Image>();
            innerImg.sprite = _circleSprite; // Maskeleme için beyaz yuvarlak şablon
            innerImg.color = Color.white;
            innerImg.type = Image.Type.Simple;

            var mask = inner.AddComponent<Mask>();
            mask.showMaskGraphic = false; // Maske görselini gizle, sadece çocukları kes

