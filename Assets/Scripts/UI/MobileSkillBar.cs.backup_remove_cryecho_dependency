        public void RefreshPage()
        {
            if (_pageText != null)
                _pageText.text = (_currentPage + 1).ToString();

            for (int i = 0; i < _skillSlots.Count; i++)
            {
                int magicNum = _pagedMagicNums[_currentPage, i];

                // Filtre: Eğer bu 6 haneli bir skill ise (yetenek) ama öğrenilmemişse barı temizle
                if (magicNum >= 100000 && magicNum <= 999999)
                {
                    bool isLearned = false;
                    if (EntropyOnline.Core.GameManager.Instance != null && EntropyOnline.Core.GameManager.Instance.LearnedSkills != null)
                    {
                        for (int j = 0; j < EntropyOnline.Core.GameManager.Instance.LearnedSkills.Length; j++)
                        {
                            if (EntropyOnline.Core.GameManager.Instance.LearnedSkills[j] == magicNum)
                            {
                                isLearned = true;
                                break;
                            }
                        }
                    }
                    if (!isLearned && KOSkillTreeManager.Instance != null)
                    {
                        for (int i0 = 0; i0 < KOSkillTreeManager.MAX_SKILL_KIND_OF; i0++)
                        {
                            for (int j0 = 0; j0 < KOSkillTreeManager.MAX_SKILL_PAGE_NUM; j0++)
                            {
                                for (int k0 = 0; k0 < KOSkillTreeManager.MAX_SKILL_IN_PAGE; k0++)
                                {
                                    var entry = KOSkillTreeManager.Instance.SkillTree[i0, j0, k0];
                                    if (entry != null && entry.SkillId == magicNum && entry.HasLevel)
                                    {
                                        isLearned = true;
                                        break;
                                    }
                                }
                                if (isLearned) break;
                            }
                            if (isLearned) break;
                        }
                    }
                    if (!isLearned)
                    {
                        _pagedMagicNums[_currentPage, i] = 0;
                        magicNum = 0;
                    }
                }

                var icon = KOItemIconLoader.LoadSkillIcon(magicNum);
                UpdateSlotUI(i, icon, magicNum);
            }
        }



        /// <summary>
        /// Skillbar verisini sunucuya gönder (WIZ_SKILLDATA sub=0x01 SAVE).
        /// Orijinal KO'da relog sırasında kaydedilir, biz her değişiklikte anında kaydediyoruz.
        /// </summary>
        private void SaveHotkeys()
        {
            if (KONetworkManager.Instance == null) return;

            // 6 sayfa × 14 slot × 4 byte (int32 magicNum) = 336 byte
            byte[] data = new byte[336];
            int offset = 0;
            for (int p = 0; p < 6; p++)
            {
                for (int s = 0; s < 14; s++)
                {
                    byte[] intBytes = System.BitConverter.GetBytes(_pagedMagicNums[p, s]);
                    System.Buffer.BlockCopy(intBytes, 0, data, offset, 4);
                    offset += 4;
                }
            }

            KONetworkManager.Instance.SendSkillBarData(data);
        }



        /// <summary>
        /// Sunucudan gelen WIZ_SKILLDATA paketini işle.
        /// Wire: [opcode:0x79][sub:0x02 LOAD][336 byte skillbar data]
        /// </summary>
        private void OnSkillBarPacketReceived(byte[] rawData)
        {
            if (rawData == null || rawData.Length < 3) return;

            // rawData[0] = opcode (WIZ_SKILLDATA 0x79)
            // rawData[1] = sub command (0x02 = LOAD)
            byte sub = rawData[1];
            if (sub != 0x02) return; // Sadece LOAD paketini işle

            int dataStart = 2;
            int expectedSize = 336; // 6 × 14 × 4
            int available = rawData.Length - dataStart;

            if (available < expectedSize)
            {
                Debug.LogWarning($"[SKILL-BAR] Sunucudan gelen skillbar verisi çok kısa: {available} byte (beklenen: {expectedSize})");
                return;
            }

            int offset = dataStart;
            for (int p = 0; p < 6; p++)
            {
                for (int s = 0; s < 14; s++)
                {
                    _pagedMagicNums[p, s] = System.BitConverter.ToInt32(rawData, offset);
                    offset += 4;
                }
            }

            _serverDataLoaded = true;
            RefreshPage();
        }



