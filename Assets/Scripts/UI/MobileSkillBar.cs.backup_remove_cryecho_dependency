        /// <summary>

        /// Tüm butonları yatayda kaydır.

        /// Inventory açılınca sola kaydırmak için kullanılır.

        /// offsetX: negatif = sola, pozitif = sağa (referans çözünürlük piksellerinde)

        /// </summary>

                



                        private Coroutine _offsetCoroutine;

        public void SetHorizontalOffset(float offsetX)
        {
            if (_buttonContainer == null) return;
            if (_offsetCoroutine != null) StopCoroutine(_offsetCoroutine);
            _offsetCoroutine = StartCoroutine(AnimateOffset(offsetX));
        }

        public void SetHorizontalOffsetInstant(float offsetX)
        {
            if (_buttonContainer == null) return;
            if (_offsetCoroutine != null)
            {
                StopCoroutine(_offsetCoroutine);
                _offsetCoroutine = null;
            }
            _buttonContainer.offsetMin = new Vector2(offsetX, 0);
            _buttonContainer.offsetMax = new Vector2(offsetX, 0);
        }

        private System.Collections.IEnumerator AnimateOffset(float targetX)
        {
            float elapsed = 0f;
            float duration = 0.2f;
            float startX = _buttonContainer.offsetMin.x;

            while (elapsed < duration)
            {
                elapsed += Time.unscaledDeltaTime;
                float t = elapsed / duration;
                t = Mathf.Sin(t * Mathf.PI * 0.5f); // Smooth ease-out

                float currentX = Mathf.Lerp(startX, targetX, t);
                _buttonContainer.offsetMin = new Vector2(currentX, 0);
                _buttonContainer.offsetMax = new Vector2(currentX, 0);
                yield return null;
            }

            _buttonContainer.offsetMin = new Vector2(targetX, 0);
            _buttonContainer.offsetMax = new Vector2(targetX, 0);
            _offsetCoroutine = null;
        }

