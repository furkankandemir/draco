                    });
                }

                // Set target icon PNG (target_icon_player) and hide label text
                var labelTrans = subLeftTrans.Find("Inner/Label");
                if (labelTrans != null) labelTrans.gameObject.SetActive(false);

                var iconTrans = subLeftTrans.Find("Inner/Icon");
                if (iconTrans != null)
                {
                    var iconImg = iconTrans.GetComponent<Image>();
                    if (iconImg != null)
                    {
                        var tex = Resources.Load<Texture2D>("UI/target_icon_player");
                        if (tex != null)
                        {
                            iconImg.sprite = Sprite.Create(tex, new Rect(0, 0, tex.width, tex.height), new Vector2(0.5f, 0.5f));
                            iconImg.color = new Color(0.82f, 0.68f, 0.38f, 1f);
                        }
                    }
                }
            }

            // 5. CustomAtkCancelBtn
            var cancelTrans = _buttonContainer.Find("CustomAtkCancelBtn");
            if (cancelTrans != null)
            {
                _customAtkCancelBtn = cancelTrans.gameObject;
                ConfigureButtonGraphics(_customAtkCancelBtn, _slotFrameSprite);
                var btnCancel = _customAtkCancelBtn.GetComponent<Button>();
                if (btnCancel != null)
                {
                    btnCancel.onClick.RemoveAllListeners();
                    btnCancel.onClick.AddListener(() => {
                        var selector = EntropyOnline.World.KOTargetSelector.Instance;
                        if (selector != null) selector.ClearTarget();
                    });
                }
            }

            // 6. 8 Skill slots
            _skillSlots.Clear();
            for (int i = 0; i < 8; i++)
            {
                int slotNum = i + 1;
                var slotTrans = _buttonContainer.Find($"Skill_{slotNum}");
                if (slotTrans != null)
                {
                    var obj = slotTrans.gameObject;
                    ConfigureButtonGraphics(obj, _slotFrameSprite);
                    
                    var slot = new SkillSlot
                    {
                        SlotIndex = i,
                        Root = obj,
                        Button = obj.GetComponent<Button>(),
                        CooldownOverlay = obj.transform.Find("Inner/CooldownOverlay")?.GetComponent<Image>()
                    ,
                        CooldownText = obj.transform.Find("Inner/CooldownText")?.GetComponent<Text>()
                    };
                    if (slot.Button != null)
                    {
                        slot.Button.onClick.RemoveAllListeners();
                        var aimHandler = obj.GetComponent<KOSkillAimHandler>() ?? obj.AddComponent<KOSkillAimHandler>();
                        aimHandler.SlotIndex = i;
                    }

                    if (slot.CooldownOverlay != null)
                    {
                        slot.CooldownOverlay.sprite = _circleSprite;
                        slot.CooldownOverlay.color = new Color(0f, 0f, 0f, 0.65f); // Yarı saydam siyah radial cooldown maskesi
                        slot.CooldownOverlay.fillAmount = 0f;
                    }

                    var dragDrop = obj.GetComponent<KOSkillBarSlotDragDrop>() ?? obj.AddComponent<KOSkillBarSlotDragDrop>();
                    dragDrop.SlotIndex = i;

                    _skillSlots.Add(slot);
                }
            }

            // 8. Page Controller
            var pageContTrans = _buttonContainer.Find("PageControllerContainer");
            if (pageContTrans != null)
            {
                _pageControllerContainer = pageContTrans.GetComponent<RectTransform>();
                
                var btnPageLeftTrans = pageContTrans.Find("BtnPageLeft");
                if (btnPageLeftTrans != null)
                {
                    var btnPageLeft = btnPageLeftTrans.GetComponent<Button>();
                    if (btnPageLeft != null)
                    {
                        ConfigureButtonGraphics(btnPageLeft.gameObject, _pageFrameSprite);
                        btnPageLeft.onClick.RemoveAllListeners();
                        btnPageLeft.onClick.AddListener(PrevPage);
                    }
                }

                var btnPageRightTrans = pageContTrans.Find("BtnPageRight");
                if (btnPageRightTrans != null)
                {
                    var btnPageRight = btnPageRightTrans.GetComponent<Button>();
                    if (btnPageRight != null)
                    {
                        ConfigureButtonGraphics(btnPageRight.gameObject, _pageFrameSprite);
                        btnPageRight.onClick.RemoveAllListeners();
                        btnPageRight.onClick.AddListener(NextPage);
                    }
                }

                var textGlowTrans = pageContTrans.Find("PageTextGlow") ?? pageContTrans.Find("TextGlow");
                if (textGlowTrans != null)
                {
                    var glowImg = textGlowTrans.GetComponent<Image>();
                    if (glowImg != null)
                    {
                        glowImg.sprite = _textGlowSprite;
                        glowImg.color = Color.white;
                    }
                }

                var pageTextTrans = pageContTrans.Find("PageText");
                if (pageTextTrans != null)
                {
                    _pageText = pageTextTrans.GetComponent<Text>();
                }
            }
            CreateExtraSlotsForPrefab();
        }



