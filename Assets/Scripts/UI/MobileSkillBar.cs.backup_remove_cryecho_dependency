            // Set dragon-breath icon and hide label text
            var labelTrans = atkObj.transform.Find("Inner/Label");
            if (labelTrans != null) labelTrans.gameObject.SetActive(false);

            var iconTrans = atkObj.transform.Find("Inner/Icon");
            if (iconTrans != null)
            {
                var iconImg = iconTrans.GetComponent<Image>();
                if (iconImg != null)
                {
                    var tex = Resources.Load<Texture2D>("UI/dragon-breath");
                    if (tex != null)
                    {
                        iconImg.sprite = Sprite.Create(tex, new Rect(0, 0, tex.width, tex.height), new Vector2(0.5f, 0.5f));
                        iconImg.color = new Color(0.82f, 0.68f, 0.38f, 1f);
                    }
                }
            }

            // 2 Yeni custom sub-button (Attack butonunun sağ aşağısına ve soluna)
