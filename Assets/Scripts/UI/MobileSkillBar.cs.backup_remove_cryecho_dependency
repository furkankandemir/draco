        /// <summary>

        /// Ekran pozisyonundaki skill slotunu bul.

        /// Drop hedefi tespiti için KOSkillDragDrop tarafından çağrılır.

        /// C++ birebir: UIHotKeyDlg::ReceiveIconDrop → slot hit-test (cpp:563-582)

        /// </summary>

        /// <returns>Slot index (0-7) veya -1 (bulunamadı)</returns>

        public int GetSlotAtScreenPosition(Vector2 screenPos)

        {

            float bestDist = float.MaxValue;

            int bestSlot = -1;



            for (int i = 0; i < _skillSlots.Count; i++)

            {

                var slot = _skillSlots[i];

                if (slot.Root == null) continue;



                var rt = slot.Root.GetComponent<RectTransform>();

                if (rt == null) continue;



                // Slot'un ekran merkez pozisyonunu hesapla

                Vector3[] corners = new Vector3[4];

                rt.GetWorldCorners(corners);

                Vector2 center = new Vector2(

                    (corners[0].x + corners[2].x) * 0.5f,

                    (corners[0].y + corners[2].y) * 0.5f);



                float dist = Vector2.Distance(screenPos, center);

                float slotRadius = (corners[2].x - corners[0].x) * 0.5f;



                // Slot alanı içinde mi? (radius * 1.3 tolerans)

                if (dist <= slotRadius * 1.3f && dist < bestDist)

                {

                    bestDist = dist;

                    bestSlot = i;

                }

            }



            return bestSlot;

        }



