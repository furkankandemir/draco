        private void ToggleMoveIndicator(GameObject go, bool active)
        {
            if (go == null) return;
            Transform indicator = go.transform.Find("MoveIndicator");
            if (indicator != null)
            {
                indicator.gameObject.SetActive(active);
                return;
            }

            if (!active) return;

            EnsureCircularGradientSprite();
            GameObject indicatorObj = new GameObject("MoveIndicator");
            indicatorObj.transform.SetParent(go.transform, false);
            RectTransform rt = indicatorObj.AddComponent<RectTransform>();
            rt.anchorMin = Vector2.zero;
            rt.anchorMax = Vector2.one;
            rt.offsetMin = Vector2.zero;
            rt.offsetMax = Vector2.zero;

            Image img = indicatorObj.AddComponent<Image>();
            img.sprite = _circularGradientSprite;
            img.color = new Color(0f, 0f, 0f, 0.5f);
            img.raycastTarget = true;

            GameObject textObj = new GameObject("Text");
            textObj.transform.SetParent(indicatorObj.transform, false);
            RectTransform textRT = textObj.AddComponent<RectTransform>();
            textRT.anchorMin = new Vector2(0.15f, 0.15f);
            textRT.anchorMax = new Vector2(0.85f, 0.85f);
            textRT.offsetMin = Vector2.zero;
            textRT.offsetMax = Vector2.zero;

            Text txt = textObj.AddComponent<Text>();
            txt.text = "✖";
            txt.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
            txt.fontStyle = FontStyle.Bold;
            txt.alignment = TextAnchor.MiddleCenter;
            txt.color = new Color(0.95f, 0.85f, 0.35f, 1f);
            txt.resizeTextForBestFit = true;
            txt.resizeTextMinSize = 10;
            txt.resizeTextMaxSize = 80;

            Shadow shadow = textObj.AddComponent<Shadow>();
            shadow.effectColor = Color.black;
            shadow.effectDistance = new Vector2(1.5f, -1.5f);

            indicatorObj.SetActive(true);
        }

        private static Sprite _circularGradientSprite;
        private static void EnsureCircularGradientSprite()
        {
            if (_circularGradientSprite != null) return;
            Texture2D tex = new Texture2D(64, 64, TextureFormat.RGBA32, false);
            for (int y = 0; y < 64; y++)
            {
                for (int x = 0; x < 64; x++)
                {
                    float dx = x - 31.5f;
                    float dy = y - 31.5f;
                    float dist = Mathf.Sqrt(dx*dx + dy*dy) / 32f;
                    float alpha = Mathf.Clamp01(1f - dist);
                    tex.SetPixel(x, y, new Color(1f, 1f, 1f, alpha));
                }
            }
            tex.Apply();
            _circularGradientSprite = Sprite.Create(tex, new Rect(0, 0, 64, 64), new Vector2(0.5f, 0.5f));
        }
