        private void Update()
        {
            var gm = EntropyOnline.Core.GameManager.Instance;

            // Cancel butonunun görünürlüğünü güncelle
            if (_customAtkCancelBtn != null)
            {
                var selector = EntropyOnline.World.KOTargetSelector.Instance;
                bool hasTarget = (selector != null && selector.SelectedEntity != null) || (gm != null && gm.TargetId != -1);
                if (_customAtkCancelBtn.activeSelf != hasTarget)
                {
                    _customAtkCancelBtn.SetActive(hasTarget);
                    if (hasTarget)
                    {
                        _customAtkCancelBtn.transform.SetAsLastSibling();
                    }
                }
                else if (hasTarget)
                {
                    // Her karede en önde olmasını sağla (örneğin edit modundan çıkarken bozulmaması için)
                    _customAtkCancelBtn.transform.SetAsLastSibling();
                }
            }

            var mgr = EntropyOnline.Combat.KOMagicSkillManager.Instance;
            if (mgr == null) return;



            var inv = KOInventory.Instance;

            // Change detector for player stats/inventory/buffs
            if (gm != null)
            {
                int curMp = gm.CurrentMp;
                int curHp = gm.CurrentHp;
                int curBuffHash = mgr.GetBuffHash();
                int curInvHash = inv != null ? inv.GetInventoryHash() : 0;

                if (curMp != _lastMp || curHp != _lastHp || curBuffHash != _lastBuffHash || curInvHash != _lastInvHash)
                {
                    _lastMp = curMp;
                    _lastHp = curHp;
                    _lastBuffHash = curBuffHash;
                    _lastInvHash = curInvHash;

                    UpdateDisableCheck();
                }
            }

            for (int i = 0; i < _skillSlots.Count; i++)

            {

                var slot = _skillSlots[i];
                EnsureCooldownText(slot);

                if (slot.MagicNum <= 0)

                {

                    if (slot.CountText != null) slot.CountText.gameObject.SetActive(false);

                    if (slot.CooldownOverlay != null) slot.CooldownOverlay.fillAmount = 0f;
            if (slot.CooldownText != null) slot.CooldownText.gameObject.SetActive(false);

                    continue;

                }



                float remaining = mgr.GetCooldown(slot.MagicNum);

                float max = mgr.GetMaxCooldown(slot.MagicNum);



                if (remaining > 0f && max > 0f)
            {
                if (slot.CooldownOverlay != null) slot.CooldownOverlay.fillAmount = remaining / max;
                if (slot.CooldownText != null)
                {
                    slot.CooldownText.gameObject.SetActive(true);
                    slot.CooldownText.text = remaining.ToString("F1");
                }
            }
            else
            {
                if (slot.CooldownOverlay != null) slot.CooldownOverlay.fillAmount = 0f;
                if (slot.CooldownText != null) slot.CooldownText.gameObject.SetActive(false);
            }



                // Count render

                var pSkill = KOImport.SkillTableParser.Find(slot.MagicNum);

                if (pSkill != null && pSkill.ExhaustItem > 0 && inv != null)

                {

                    int qty = inv.GetCountInInvByID((int)pSkill.ExhaustItem);

                    if (qty > 0)

                    {

                        if (slot.CountText == null)

                        {

                            var inner = slot.Root.transform.Find("Inner");

                            if (inner != null)

                                slot.CountText = CreateCountText(inner);

                        }

                        if (slot.CountText != null)

                        {

                            slot.CountText.text = qty.ToString();

                            slot.CountText.gameObject.SetActive(true);

                        }

                    }

                    else

                    {

                        if (slot.CountText != null) slot.CountText.gameObject.SetActive(false);

                    }

                }

                else

                {

                    if (slot.CountText != null) slot.CountText.gameObject.SetActive(false);

                }

            }

        }



