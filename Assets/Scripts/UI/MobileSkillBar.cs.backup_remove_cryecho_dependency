                subBtnRightX, subBtnRightY, SKILL_SIZE, _slotFrameSprite, "?R", 14);
            var btnRight = _customAtkSubBtnRight.GetComponent<Button>();
            if (btnRight != null)
            {
                btnRight.onClick.AddListener(() => {
                    var selector = EntropyOnline.World.KOTargetSelector.Instance;
                    if (selector != null) selector.TargetNearestMonster();
                });
