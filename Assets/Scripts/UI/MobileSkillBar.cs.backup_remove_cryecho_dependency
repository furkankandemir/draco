            {
                if (_skillSlots[i]?.Root == null) continue;

                if (i < 8)
                {
                    _skillSlots[i].Root.SetActive(true);
                }
                else
                {
                    bool active = (i - 8) < extraSkillCount;
                    _skillSlots[i].Root.SetActive(active);
                }
            }
        }

        public void ApplyZButtonScale()
        {
            if (_customAtkSubBtnLeft == null) return;
            
            float zScale = 1.0f;
            if (GameOptionsManager.Instance != null)
            {
                zScale = Mathf.Lerp(0.7f, 1.5f, GameOptionsManager.Instance.Graphic2_ZButtonSize);
            }
            
            bool changeZAndR = GameOptionsManager.Instance != null && GameOptionsManager.Instance.PK_ChangeZAndR;
            if (changeZAndR)
            {
                _customAtkSubBtnLeft.transform.localScale = Vector3.one;
                if (_attackButton?.Root != null)
                {
                    _attackButton.Root.transform.localScale = new Vector3(zScale, zScale, 1f);
                }
            }
            else
            {
                _customAtkSubBtnLeft.transform.localScale = new Vector3(zScale, zScale, 1f);
                if (_attackButton?.Root != null)
                {
                    _attackButton.Root.transform.localScale = Vector3.one;
                }
            }
        }

        public void ApplyZAndRLayout()
        {
            if (_attackButton?.Root == null || _customAtkSubBtnLeft == null) return;

            var r0 = _attackButton.Root.GetComponent<RectTransform>();
            var r1 = _customAtkSubBtnLeft.GetComponent<RectTransform>();
            if (r0 == null || r1 == null) return;

            bool changeZAndR = GameOptionsManager.Instance != null && GameOptionsManager.Instance.PK_ChangeZAndR;

            Vector2 attackTargetPos = changeZAndR ? _defaultSubLeftPosition : _defaultAttackPosition;
            Vector2 attackTargetSize = changeZAndR ? _defaultSubLeftSize : _defaultAttackSize;
            Vector2 subLeftTargetPos = changeZAndR ? _defaultAttackPosition : _defaultSubLeftPosition;
            Vector2 subLeftTargetSize = changeZAndR ? _defaultAttackSize : _defaultSubLeftSize;

            if (attackTargetPos == Vector2.zero && attackTargetSize == Vector2.zero)
            {
                if (changeZAndR)
                {
                    attackTargetPos = new Vector2(subBtnLeftX, subBtnLeftY);
                    attackTargetSize = new Vector2(60f, 60f);
                }
                else
                {
                    attackTargetPos = new Vector2(-109.8f, -125.4f);
                    attackTargetSize = new Vector2(105f, 105f);
                }
            }

            if (subLeftTargetPos == Vector2.zero && subLeftTargetSize == Vector2.zero)
            {
                if (changeZAndR)
                {
                    subLeftTargetPos = new Vector2(-109.8f, -125.4f);
                    subLeftTargetSize = new Vector2(105f, 105f);
                }
                else
                {
                    subLeftTargetPos = new Vector2(subBtnLeftX, subBtnLeftY);
                    subLeftTargetSize = new Vector2(60f, 60f);
                }
            }

            r0.anchoredPosition = attackTargetPos;
            r0.sizeDelta = attackTargetSize;
            r1.anchoredPosition = subLeftTargetPos;
            r1.sizeDelta = subLeftTargetSize;

            var inner0 = r0.Find("Inner") as RectTransform;
            var inner1 = r1.Find("Inner") as RectTransform;
            if (inner0 != null)
            {
                float size = attackTargetSize.x * 0.81f;
                inner0.sizeDelta = new Vector2(size, size);
            }
            if (inner1 != null)
            {
                float size = subLeftTargetSize.x * 0.81f;
                inner1.sizeDelta = new Vector2(size, size);
            }

            if (changeZAndR)
            {
                r0.SetAsLastSibling();
            }
            else
            {
                r1.SetAsLastSibling();
            }

            if (_customAtkCancelBtn != null && _customAtkCancelBtn.activeSelf)
            {
                _customAtkCancelBtn.transform.SetAsLastSibling();
            }

            ApplyZButtonScale();
        }

