        /// <summary>

        /// Open-KO birebir: GameProcMain.cpp satır 1239-1251

        ///   KM_TOGGLE_ATTACK → m_bAttackContinous ise durdur,

        ///     değilse TryStartAttack() → CommandEnableAttackContinous(true, target)

        ///

        /// Attack butonu paket GÖNDERMEZ.

        /// PlayerController.StartAutoAttack() → AttackTick() → MsgSend_Attack(WIZ_ATTACK)

        /// state machine üzerinden çalışır.

        /// </summary>

        private void OnAttackPressed()
        {
            // PlayerController'ı bul
            var pc = FindAnyObjectByType<EntropyOnline.Character.PlayerController>();
            if (pc == null) return;

            // Open-KO birebir: satır 1242-1250 — toggle mantığı
            if (pc.IsAutoAttacking)
            {
                pc.StopAutoAttack();
                return;
            }

            var gm = EntropyOnline.Core.GameManager.Instance;
            var selector = EntropyOnline.World.KOTargetSelector.Instance;

            // Hedef yoksa veya seçili entity boşsa, ayarlardaki önceliğe göre en yakın hedefe odaklan
            if (selector != null)
            {
                if (gm == null || gm.TargetId < 0 || selector.SelectedEntity == null)
                {
                    if (GameOptionsManager.Instance != null)
                    {
                        if (GameOptionsManager.Instance.PK_TargetPriorityPlayer)
                        {
                            selector.TargetNearestEnemy();
                        }
                        else if (GameOptionsManager.Instance.PK_TargetPriorityMonster)
                        {
                            selector.TargetNearestMonster();
                        }
                    }
                }
            }

            // Hedef kontrolü
            if (gm == null || gm.TargetId < 0)
            {
                return;
            }

            // Hedef KOEntity'yi bul — Open-KO: TargetPointerCheck(false)
            var target = selector?.SelectedEntity;
            if (target == null)
            {
                return;
            }

            // Open-KO birebir: TryStartAttack() → StartAutoAttack(target)
            pc.StartAutoAttack(target);
        }



        /// <summary>

        /// Open-KO birebir: UIHotKeyDlg.cpp DoOperate() satır 712-722

        ///   → MsgSend_MagicProcess(iIDTarget, pSkill->pSkill)

        ///

        /// Artık doğrudan paket göndermez — KOMagicSkillManager'a yönlendirir.

        /// KOMagicSkillManager casting state machine, cooldown ve validate kontrollerini yapar.

        /// </summary>

        public void OnSkillPressedDirectly(int slotIndex)
        {
            OnSkillPressed(slotIndex);
        }

        private void OnSkillPressed(int slotIndex)
        {
            if (slotIndex < 0 || slotIndex >= _skillSlots.Count) return;

            int magicNum = _skillSlots[slotIndex].MagicNum;
            if (magicNum <= 0)
            {
                return;
            }

            // Open-KO birebir: s_pTbl_Skill.Find(dwMagicID)
            var pSkill = KOImport.SkillTableParser.Find(magicNum);
            if (pSkill == null)
            {
                Debug.LogWarning($"[SKILL-BAR] Skill tablosunda bulunamadı: {magicNum}");
                return;
            }

            var gm = EntropyOnline.Core.GameManager.Instance;
            int targetId = gm != null ? (int)gm.TargetId : -1;

            var mgr = EntropyOnline.Combat.KOMagicSkillManager.Instance;
            if (mgr == null)
            {
                Debug.LogWarning("[SKILL-BAR] KOMagicSkillManager bulunamadı!");
                return;
            }

            bool requiresTarget = pSkill.Target == 7;

            var selector = EntropyOnline.World.KOTargetSelector.Instance;
            if (targetId == -1 && requiresTarget && selector != null)
            {
                if (GameOptionsManager.Instance != null && GameOptionsManager.Instance.PK_TargetPriorityPlayer)
                {
                    selector.TargetNearestEnemy();
                }
                else
                {
                    selector.TargetNearestMonster();
                }
                targetId = gm != null ? (int)gm.TargetId : -1;
            }

            if (targetId != -1 && mgr.IsTargetSkillOutOfRange(targetId, pSkill))
            {
                if (KOUIManager.Instance != null)
                {
                    KOUIManager.Instance.AddMsgOutput("Skill Failed - Too far", KOUIManager.D3DColorToUnity(0xffffff00));
                }

                var target = selector?.SelectedEntity;
                var pc = FindAnyObjectByType<EntropyOnline.Character.PlayerController>();
                if (pc != null && target != null)
                {
                    pc.StartAutoAttack(target);
                }
                return;
            }

            bool success = mgr.MsgSend_MagicProcess(targetId, pSkill);
            if (success)
            {
                if (GameOptionsManager.Instance != null && GameOptionsManager.Instance.PK_ComboHelper && pSkill.FirstTableType == 1)
                {
                    StartCoroutine(TriggerComboHelperRoutine());
                }
            }
            else
            {

            }

        }



