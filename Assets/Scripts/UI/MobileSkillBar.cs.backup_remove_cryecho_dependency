        private void ConfigureButtonGraphics(GameObject btnObj, Sprite frameSprite)
        {
            if (btnObj == null) return;
            var img = btnObj.GetComponent<Image>();
            if (img != null && (img.sprite == null || img.sprite.name == "UIMask" || img.sprite.name == "Background" || img.sprite.name == "unity_builtin_extra"))
            {
                img.sprite = frameSprite;
                img.color = Color.white;
            }
            var innerTrans = btnObj.transform.Find("Inner");
            if (innerTrans != null)
            {
                var innerImg = innerTrans.GetComponent<Image>();
                if (innerImg != null && (innerImg.sprite == null || innerImg.sprite.name == "UIMask" || innerImg.sprite.name == "Background" || innerImg.sprite.name == "unity_builtin_extra"))
                {
                    innerImg.sprite = _circleSprite;
                    innerImg.color = new Color(0f, 0f, 0f, 0.4f); // Yarı saydam siyah slot içi
                }
            }
        }

        private void BindPrefabElements()
        {
            _canvas = GetComponentInChildren<Canvas>();
            
            var containerTrans = transform.Find("MobileSkillBarCanvas/ButtonContainer");
            if (containerTrans != null)
            {
                _buttonContainer = containerTrans.GetComponent<RectTransform>();
            }
            else
            {
                _buttonContainer = GetComponentInChildren<RectTransform>();
            }

            if (_buttonContainer == null) return;

            // 1. Resolve any null fonts in Text components (LegacyRuntime.ttf)
            var allTexts = GetComponentsInChildren<Text>(true);
            var defaultFont = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
            foreach (var txt in allTexts)
            {
                if (txt.font == null && defaultFont != null)
                {
                    txt.font = defaultFont;
                }
            }

            // 2. AttackButton
            var atkTrans = _buttonContainer.Find("AttackButton");
            if (atkTrans != null)
            {
                var atkObj = atkTrans.gameObject;
                ConfigureButtonGraphics(atkObj, _attackFrameSprite);
                _attackButton = new SkillSlot { SlotIndex = -1, Root = atkObj, Button = atkObj.GetComponent<Button>() };
                if (_attackButton.Button != null)
                {
                    _attackButton.Button.onClick.RemoveAllListeners();
                    _attackButton.Button.onClick.AddListener(OnAttackPressed);
                }

                // Set dragon-breath icon and hide label text
                var labelTrans = atkTrans.Find("Inner/Label");
                if (labelTrans != null) labelTrans.gameObject.SetActive(false);

                var iconTrans = atkTrans.Find("Inner/Icon");
                if (iconTrans != null)
                {
                    var iconImg = iconTrans.GetComponent<Image>();
                    if (iconImg != null)
                    {
                        var tex = Resources.Load<Texture2D>("UI/dragon-breath");
                        if (tex != null)
                        {
                            iconImg.sprite = Sprite.Create(tex, new Rect(0, 0, tex.width, tex.height), new Vector2(0.5f, 0.5f));
                            iconImg.color = new Color(0.82f, 0.68f, 0.38f, 1f);
                        }
                    }
                }
            }

            // 3. CustomAtkSubBtnRight
            var subRightTrans = _buttonContainer.Find("CustomAtkSubBtnRight");
            if (subRightTrans != null)
            {
                _customAtkSubBtnRight = subRightTrans.gameObject;
                ConfigureButtonGraphics(_customAtkSubBtnRight, _slotFrameSprite);
                var btnRight = _customAtkSubBtnRight.GetComponent<Button>();
                if (btnRight != null)
                {
                    btnRight.onClick.RemoveAllListeners();
                    btnRight.onClick.AddListener(() => {
                        var selector = EntropyOnline.World.KOTargetSelector.Instance;
                        if (selector != null) selector.TargetNearestMonster();
                    });
                }

                // Set target icon PNG (target_icon_monster) and hide label text
                var labelTrans = subRightTrans.Find("Inner/Label");
                if (labelTrans != null) labelTrans.gameObject.SetActive(false);

                var iconTrans = subRightTrans.Find("Inner/Icon");
                if (iconTrans != null)
                {
                    var iconImg = iconTrans.GetComponent<Image>();
                    if (iconImg != null)
                    {
                        var tex = Resources.Load<Texture2D>("UI/target_icon_monster");
                        if (tex != null)
                        {
                            iconImg.sprite = Sprite.Create(tex, new Rect(0, 0, tex.width, tex.height), new Vector2(0.5f, 0.5f));
                            iconImg.color = new Color(0.85f, 0.1f, 0.1f, 1f);
                        }
                    }
                }
            }

            // 4. CustomAtkSubBtnLeft
            var subLeftTrans = _buttonContainer.Find("CustomAtkSubBtnLeft");
            if (subLeftTrans != null)
            {
                _customAtkSubBtnLeft = subLeftTrans.gameObject;
                ConfigureButtonGraphics(_customAtkSubBtnLeft, _slotFrameSprite);
                var btnLeft = _customAtkSubBtnLeft.GetComponent<Button>();
                if (btnLeft != null)
                {
                    btnLeft.onClick.RemoveAllListeners();
                    btnLeft.onClick.AddListener(() => {
                        var selector = EntropyOnline.World.KOTargetSelector.Instance;
