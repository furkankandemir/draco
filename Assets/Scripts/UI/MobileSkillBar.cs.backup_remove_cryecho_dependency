        private static void EnsurePremiumSprites()

        {

            if (_circleSprite != null) return;



            // 1. Maske Şablonu (Beyaz Yuvarlak)

            int maskSize = 128;

            var maskTex = new Texture2D(maskSize, maskSize, TextureFormat.RGBA32, false);

            float maskCenter = maskSize / 2f;

            float maskRadius = maskCenter - 1f;



            for (int y = 0; y < maskSize; y++)

            {

                for (int x = 0; x < maskSize; x++)

                {

                    float dist = Vector2.Distance(new Vector2(x, y), new Vector2(maskCenter, maskCenter));

                    if (dist <= maskRadius)

                    {

                        float alpha = Mathf.Clamp01(maskRadius - dist);

                        maskTex.SetPixel(x, y, new Color(1, 1, 1, alpha));

                    }

                    else

                    {

                        maskTex.SetPixel(x, y, Color.clear);

                    }

                }

            }

            maskTex.Apply();

            _circleSprite = Sprite.Create(maskTex, new UnityEngine.Rect(0, 0, maskSize, maskSize), new Vector2(0.5f, 0.5f));
            _circleSprite.name = "MobileSkillBar_CircleMask";



            // 2. Premium Slot Çerçevesi (Kavisli Altın Süslemeler + Düz Koyu Arka Plan)

            _slotFrameSprite = CreatePremiumFrame(128, SLOT_BORDER, SLOT_BG, false, false);
            _slotFrameSprite.name = "MobileSkillBar_SlotFrame";



            // 3. Premium Atak Çerçevesi (Altın Çerçeve + Kanatçıklar + Düz Ruby Kırmızı Arka Plan)

            _attackFrameSprite = CreatePremiumFrame(128, SLOT_BORDER, ATTACK_BG, true, false);
            _attackFrameSprite.name = "MobileSkillBar_AttackFrame";



            // 4. Premium Sayfa Butonu Çerçevesi (Düz Altın Çerçeve + Düz Koyu Arka Plan, Süslemesiz)

            _pageFrameSprite = CreatePremiumFrame(128, SLOT_BORDER, SLOT_BG, false, true);
            _pageFrameSprite.name = "MobileSkillBar_PageFrame";



            // 5. Rakam Arkası Yatay Kapsül Gölgelendirme (Soft Fading Glow)

            int glowW = 64;

            int glowH = 32;

            var glowTex = new Texture2D(glowW, glowH, TextureFormat.RGBA32, false);

            for (int y = 0; y < glowH; y++)

            {

                for (int x = 0; x < glowW; x++)

                {

                    float nx = (x - glowW / 2f) / (glowW / 2f);

                    float ny = (y - glowH / 2f) / (glowH / 2f);

                    float alphaX = Mathf.Clamp01(1f - nx * nx);

                    float alphaY = Mathf.Clamp01(1f - ny * ny);

                    float alpha = alphaX * alphaY;

                    glowTex.SetPixel(x, y, new Color(0f, 0f, 0f, alpha * 0.55f));

                }

            }

            glowTex.Apply();

            _textGlowSprite = Sprite.Create(glowTex, new Rect(0, 0, glowW, glowH), new Vector2(0.5f, 0.5f));
            _textGlowSprite.name = "MobileSkillBar_TextGlow";

        }



        private static Sprite CreatePremiumFrame(int size, Color borderCol, Color fillCol, bool isAttack, bool isPageBtn)

        {

            var tex = new Texture2D(size, size, TextureFormat.RGBA32, false);

            tex.filterMode = FilterMode.Bilinear;

            tex.wrapMode = TextureWrapMode.Clamp;



            float center = size / 2f;

            float radius = center - 7f; // Süslemeler için pay bırakıyoruz



            float borderWidth = 3.5f; // Atak ve normal slotların çerçeve kalınlığı eşitlendi



            // Gradyan Renkleri (Merkez -> Kenar) - Translucent Cam Morfik Opaklıklar

            Color centerColor;

            Color edgeColor;



            if (isAttack)

            {

                centerColor = new Color(0.55f, 0.12f, 0.08f, 0.85f); // Merkez %85 opak yakut kırmızı

                edgeColor = new Color(0.12f, 0.02f, 0.01f, 0.90f);   // Kenar %90 opak koyu kırmızı

            }

            else

            {

                centerColor = new Color(0.24f, 0.22f, 0.20f, 0.80f); // Merkez %80 opak koyu antrasit

                edgeColor = new Color(0.04f, 0.04f, 0.04f, 0.85f);   // Kenar %85 opak koyu siyah

            }



            for (int y = 0; y < size; y++)

            {

                for (int x = 0; x < size; x++)

                {

                    float dist = Vector2.Distance(new Vector2(x, y), new Vector2(center, center));

                    Color pxColor = Color.clear;



                    if (dist <= radius)

                    {

                        // Daire içi

                        if (dist >= radius - borderWidth)

                        {

                            // Ana çerçeve halkası (Altın)

                            pxColor = borderCol;

                        }

                        else

                        {

                            // 3D Metalik Gradyan (Merkezden kenara)

                            float fillDist = dist / (radius - borderWidth);

                            pxColor = Color.Lerp(centerColor, edgeColor, fillDist);



                            // Küre Parlaması (Sol-Üst Glossy Highlight)

                            float dx = x - (center - radius * 0.35f);

                            float dy = y - (center + radius * 0.35f);

                            float distToHighlight = Mathf.Sqrt(dx * dx + dy * dy);

                            float highlightRadius = radius * 0.35f;

                            if (distToHighlight < highlightRadius)

                            {

                                float gloss = (1f - distToHighlight / highlightRadius) * 0.32f;

                                pxColor.r = Mathf.Clamp01(pxColor.r + gloss);

                                pxColor.g = Mathf.Clamp01(pxColor.g + gloss * 0.95f);

                                pxColor.b = Mathf.Clamp01(pxColor.b + gloss * 0.90f);

                            }

                        }

                    }

                    else

                    {

                        // Daire dışı: Sadece sayfa butonlarında süsleme olmayacak.

                        // Normal slotlar ve Atak butonunun üst/alt kavisli süslemeleri (kanatçıkları)

                        if (!isPageBtn)

                        {

                            float dx = x - center;

                            float dy = y - center;

                            float absDx = Mathf.Abs(dx);



                            // Süslemenin yatay genişliği

                            float ornamentWidth = radius * 0.45f;

                            if (absDx < ornamentWidth)

                            {

                                // Merkeze yaklaştıkça yüksekliği artan kavisli kanat

                                float crescentMaxHeight = isAttack ? 6f : 5f;

                                float crescentHeight = crescentMaxHeight - (absDx / ornamentWidth) * crescentMaxHeight;

                                if (dist > radius && dist <= radius + crescentHeight)

                                {

                                    pxColor = borderCol;

                                }

                            }

                        }

                    }



                    // Yumuşatma (Anti-Aliasing) filtresi

                    float outerEdge = radius;

                    if (!isPageBtn)

                    {

                        float dxEdge = x - center;

                        float dyEdge = y - center;

                        float absDxEdge = Mathf.Abs(dxEdge);

                        float edgeWidth = radius * 0.45f;

                        if (absDxEdge < edgeWidth)

                        {

                            float crescentMaxHeight = isAttack ? 6f : 5f;

                            outerEdge += crescentMaxHeight - (absDxEdge / edgeWidth) * crescentMaxHeight;

                        }

                    }



                    if (dist > outerEdge - 1f && dist <= outerEdge + 1f)

                    {

                        float alpha = 1f - (dist - (outerEdge - 1f)) / 2f;

                        pxColor.a *= Mathf.Clamp01(alpha);

                    }







                    tex.SetPixel(x, y, pxColor);

                }

            }



            tex.Apply();

            return Sprite.Create(tex, new Rect(0f, 0f, size, size), new Vector2(0.5f, 0.5f));

        }



