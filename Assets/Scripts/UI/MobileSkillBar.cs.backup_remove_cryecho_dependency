        private void UpdateDisableCheck()
        {
            var mgr = EntropyOnline.Combat.KOMagicSkillManager.Instance;
            if (mgr == null) return;
            var inv = KOInventory.Instance;

            for (int i = 0; i < _skillSlots.Count; i++)
            {
                var slot = _skillSlots[i];
                if (slot.MagicNum <= 0) continue;

                var pSkill = KOImport.SkillTableParser.Find(slot.MagicNum);
                if (pSkill == null) continue;

                bool isUsable = IsSkillUsable(slot, pSkill, inv);

                var iconTrans = slot.Root.transform.Find("Inner/Icon");
                if (iconTrans != null)
                {
                    var iconImg = iconTrans.GetComponent<Image>();
                    if (iconImg != null && iconImg.sprite != null)
                    {
                        if (isUsable)
                        {
                            iconImg.color = Color.white;
                        }
                        else
                        {
                            iconImg.color = new Color(0.4f, 0.4f, 0.4f, 0.6f); // 50% dimmed/darkened overlay
                        }
                    }
                }
            }
        }

        private bool IsSkillUsable(SkillSlot slot, KOImport.SkillEntry pSkill, KOInventory inv)
        {
            var gm = EntropyOnline.Core.GameManager.Instance;
            if (gm == null) return false;
            var mgr = EntropyOnline.Combat.KOMagicSkillManager.Instance;
            if (mgr == null) return false;

            // 1. Mana (MP) check
            if (gm.CurrentMp < pSkill.ExhaustMSP)
                return false;

            // 2. Health (HP) check
            if (pSkill.ExhaustHP < 10000 && gm.CurrentHp < pSkill.ExhaustHP)
                return false;

            // 3. Item check
            if (pSkill.ExhaustItem > 0 && inv != null)
            {
                int qty = inv.GetCountInInvByID((int)pSkill.ExhaustItem);
                if (qty <= 0)
                    return false;
            }

            // 4. Custom Battle Cry active buff check for Cry Echo (106782, 206782)
            if (slot.MagicNum == 106782 || slot.MagicNum == 206782)
            {
                if (!mgr.IsBuffActive(7, 106781) && !mgr.IsBuffActive(7, 206781))
                {
                    return false;
                }
            }

            return true;
        }

