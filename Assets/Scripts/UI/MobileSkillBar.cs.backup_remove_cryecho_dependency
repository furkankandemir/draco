            var cdShadow = cdTextObj.AddComponent<Shadow>();
            cdShadow.effectColor = Color.black;
            cdShadow.effectDistance = new Vector2(1f, -1f);

            cdTextObj.SetActive(false);



            



            // Label (Yazı)

            var txtObj = new GameObject("Label");

            txtObj.transform.SetParent(inner.transform, false);

