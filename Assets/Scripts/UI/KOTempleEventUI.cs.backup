            buttonsContainer.anchorMax = new Vector2(0.95f, 0.35f);
            buttonsContainer.sizeDelta = Vector2.zero;

            // Register Button
            var regGo = new GameObject("RegisterButton");
            regGo.transform.SetParent(buttonsContainer, false);
