using UnityEngine;
using EntropyOnline.Network;
using EntropyOnline.Network.KO;
using EntropyOnline.Core;

namespace EntropyOnline.UI
{
    /// <summary>
    /// Ölüm/Respawn packet handler'ı.
    /// UI artık KOUIManager tarafından co_Dead_us.uif'den yükleniyor.
    /// Bu sınıf packet event'lerini dinler ve C2S_REGENE gönderir.
    /// Open-KO: WIZ_REGENE (0x12) — Regene() User.cpp:2305-2550
    /// </summary>
    public class DeathUI : MonoBehaviour
    {
        public static DeathUI Instance { get; private set; }

        private bool _isDead = false;
        private float _deathTimer = 0f;
        private const float MIN_RESPAWN_WAIT = 3.5f;
        
        /// <summary>
        /// Open-KO birebir: CUIDead::m_iSendRegeneration
        /// 0 = gönderilebilir, 2 = bir kez gönderildi (tekrar ölene kadar engelli)
        /// UIDead.cpp:219-220 + 230 birebir
        /// </summary>
        private int _sendRegeneration = 0;
        
        /// <summary>
        /// Open-KO birebir: CUIDead::m_bProcessing
        /// Sunucu yanıtı beklenirken true, yanıt geldiğinde false
        /// UIDead.cpp:216 + 232 + 237 birebir
        /// </summary>
        private bool _bProcessing = false;

        private void Awake()
        {
            if (Instance != null && Instance != this) { Destroy(gameObject); return; }
            Instance = this;
        }

        private void Start()
        {
            if (Instance != this) return;
            KOPacketHandler.OnDead += HandleDead_KO;
            KOPacketHandler.OnRegene += HandleRegene_KO;
        }

        private void OnDestroy()
        {
            KOPacketHandler.OnDead -= HandleDead_KO;
            KOPacketHandler.OnRegene -= HandleRegene_KO;
            if (Instance == this) Instance = null;
        }

        private void Update()
        {
            if (_isDead)
                _deathTimer += Time.deltaTime;
        }

        // ============================
        // KO RAW DATA WRAPPERS
        // ============================

        private void HandleDead_KO(byte[] rawData)
        {
            // Open-KO birebir: MsgRecv_Dead (GameProcMain.cpp:3330-3364)
            // Wire: [opcode][targetId:int16]
            var r = new KOPacketReader(rawData);
            short targetId = r.ReadInt16();

            // C++ birebir: if (iIDTarget == s_pPlayer->IDNumber())
            var gm = GameManager.Instance;
            bool isMe = (gm != null && targetId == (short)gm.CharacterId);
            HandleEntityDeath(targetId, isMe);
        }

        private void HandleRegene_KO(byte[] rawData)
        {
            var r = new KOPacketReader(rawData);
            ushort x = r.ReadUInt16();
            ushort z = r.ReadUInt16();
            short y = r.ReadInt16();
            HandleRegene(x, z, y);
        }

        // ============================
        // OLD HANDLERS (called from wrappers)
        // ============================

        private void HandleEntityDeath(long entityId, bool isMe)
        {
            if (!isMe) return;
            TriggerDeath();
        }

        /// <summary>
        /// Ölüm panelini gösterir ve respawn sürecini başlatır.
        /// Hem WIZ_DEAD hem de WIZ_ATTACK result==0x02'den çağrılır.
        /// C++ birebir: MessageBoxPost(szMsg, "", MB_OK, BEHAVIOR_REGENERATION)
        /// </summary>
        public void TriggerDeath()
        {
            if (_isDead) return; // Zaten ölü — tekrar tetikleme

            _isDead = true;
            _deathTimer = 0f;
            _sendRegeneration = 0; // Open-KO birebir: yeniden ölünce sıfırla
            _bProcessing = false;

            // KOUIManager'dan dead panelini göster
            if (KOUIManager.Instance != null)
                KOUIManager.Instance.ShowDead(true);

        }

        /// <summary>
        /// S2C_REGENE yanıtı — sunucu yeni pozisyon gönderdi.
        /// C++ birebir: GameProcMain.cpp:2399-2428 — MsgRecv_Regen
        /// Wire: [x*10: uint16] [z*10: uint16] [y*10: int16]
        /// </summary>
        private void HandleRegene(ushort x, ushort z, short y)
        {
            if (!_isDead) return;
            
            // Open-KO birebir: UIDead.cpp:237 — m_bProcessing = false;
            _bProcessing = false;

            // C++ birebir: GameProcMain.cpp:2402-2404
            // vPosPlayer.x = (pkt.read<uint16_t>()) / 10.0f;
            // vPosPlayer.z = (pkt.read<uint16_t>()) / 10.0f;
            // vPosPlayer.y = (pkt.read<int16_t>()) / 10.0f;
            float worldX = x / 10f;
            float worldZ = z / 10f;
            float worldY = y / 10f;

            // C++ birebir: GameProcMain.cpp:454 — InitPlayerPosition(vPosPlayer)
            // float fYTerrain = ACT_WORLD->GetHeightWithTerrain(vPos.x, vPos.z);
            // C++'ta GetHeightWithTerrain HER ZAMAN çağrılır — sunucu Y=0 gönderebilir
            // veya geçersiz bir Y gönderebilir, her durumda terrain height doğrulanır.
            {
                // KOCollisionManager varsa programatik height kullan
                var collisionMgr = EntropyOnline.World.KOCollisionManager.Instance;
                if (collisionMgr != null)
                {
                    float collisionY = collisionMgr.GetHeight(worldX, worldZ);
                    if (collisionY > float.MinValue)
                    {
                        worldY = collisionY + 0.5f;
                    }
                    else
                    {
                        // Collision data yoksa raycast fallback
                        worldY = RaycastTerrainHeight(worldX, worldZ);
                    }
                }
                else
                {
                    // KOCollisionManager yoksa raycast fallback
                    worldY = RaycastTerrainHeight(worldX, worldZ);
                }
            }

            // C++ birebir: GameProcMain.cpp:471 — s_pPlayer->PositionSet(vPosFinal, true)
            var player = GameObject.FindWithTag("Player");
            if (player != null)
            {
                var cc = player.GetComponent<CharacterController>();
                if (cc != null) cc.enabled = false;
                player.transform.position = new Vector3(worldX, worldY, worldZ);
                if (cc != null) cc.enabled = true;
            }

            // C++ birebir: GameProcMain.cpp:2407 — s_pPlayer->RegenerateCollisionMesh();
            // Unity'de CharacterController yeniden etkinleştirme ile halledilir (yukarıda yapıldı)

            // C++ birebir: GameProcMain.cpp:2409-2410
            // s_pPlayer->m_iSendRegeneration = 0;
            // s_pPlayer->m_fTimeAfterDeath   = 0;
            _sendRegeneration = 0;
            _isDead = false;
            _deathTimer = 0f;

            // GameManager pozisyonunu güncelle
            if (GameManager.Instance != null)
            {
                GameManager.Instance.PlayerPosX = worldX;
                GameManager.Instance.PlayerPosY = worldY;
                GameManager.Instance.PlayerPosZ = worldZ;
            }

            // C++ birebir: GameProcMain.cpp:2414-2415
            // if (m_pUIStateBarAndMiniMap) m_pUIStateBarAndMiniMap->ClearMagic();
            if (KOUIManager.Instance != null)
                KOUIManager.Instance.ClearBuffs();

            // C++ birebir: GameProcMain.cpp:2416-2417
            // if (m_pMagicSkillMng) m_pMagicSkillMng->ClearDurationalMagic();
            var magicMgr = EntropyOnline.Combat.KOMagicSkillManager.Instance;
            if (magicMgr != null)
                magicMgr.ClearDurationalMagic();

            // C++ birebir: GameProcMain.cpp:2418-2419
            // if (CGameProcedure::s_pFX) s_pFX->StopMine();
            var fxMgr = KO.KOFXManager.Instance;
            if (fxMgr != null && GameManager.Instance != null)
            {
                int myId = (int)GameManager.Instance.CharacterId;
                fxMgr.StopMine(myId);

                // C++ birebir: GameProcMain.cpp:2423-2426
                // if (s_pPlayer->Nation() == NATION_KARUS)
                //     s_pFX->TriggerBundle(s_pPlayer->IDNumber(), -1, FXID_REGEN_KARUS, s_pPlayer->IDNumber(), -1);
                // else if (s_pPlayer->Nation() == NATION_ELMORAD)
                //     s_pFX->TriggerBundle(s_pPlayer->IDNumber(), -1, FXID_REGEN_ELMORAD, s_pPlayer->IDNumber(), -1);
                byte nation = GameManager.Instance.Nation;
                if (nation == 1) // NATION_KARUS
                    fxMgr.TriggerBundle(myId, -1, KO.KOFXManager.FXID_REGEN_KARUS, myId, -1);
                else if (nation == 2) // NATION_ELMORAD
                    fxMgr.TriggerBundle(myId, -1, KO.KOFXManager.FXID_REGEN_ELMORAD, myId, -1);
            }

            // C++ birebir: GameProcMain.cpp:889 — MessageBoxClose(szMsg);
            // Mobilde MessageBox yok — dead paneli kapat
            if (KOUIManager.Instance != null)
                KOUIManager.Instance.ShowDead(false);

            // C++ birebir: GameProcMain.cpp:890 — m_pUITargetBar->SetVisible(false);
            if (TargetInfoUI.Instance != null)
                TargetInfoUI.Instance.ClearTarget();

        }

        // ============================
        // RESPAWN İSTEĞİ
        // ============================

        /// <summary>
        /// C2S_REGENE gönderir. Dışarıdan çağrılabilir (UIF butonundan).
        /// Open-KO: WIZ_REGENE [regene_type: byte] (1=normal, 2=resurrection stone)
        /// </summary>
        public void SendRespawn(byte regeneType = 1)
        {
            if (!_isDead || _deathTimer < MIN_RESPAWN_WAIT) return;
            
            // Open-KO birebir: UIDead.cpp:215-216 — m_bProcessing guard
            if (_bProcessing) return;
            
            // Open-KO birebir: UIDead.cpp:219-220 — m_iSendRegeneration >= 2 → return
            if (_sendRegeneration >= 2) return;
            if (KONetworkManager.Instance == null) return;

            // Open-KO birebir: WIZ_REGENE [regene_type: byte]
            using var pkt = new KOPacketWriter(WizOpcode.WIZ_REGENE);
            pkt.WriteByte(regeneType);
            KONetworkManager.Instance.SendPacket(pkt);
            
            // Open-KO birebir: UIDead.cpp:230 — m_iSendRegeneration = 2;
            _sendRegeneration = 2;
            _bProcessing = true;

        }

        public bool IsDead => _isDead;

        // ============================
        // TERRAIN HEIGHT HELPER
        // ============================

        /// <summary>
        /// Raycast ile terrain yüksekliğini hesaplar.
        /// C++ birebir: ACT_WORLD->GetHeightWithTerrain fallback.
        /// </summary>
        private static float RaycastTerrainHeight(float worldX, float worldZ)
        {
            // Yukarıdan aşağıya raycast — terrain yüzeyini bul (Su, UI ve tetikleyiciler hariç)
            Ray ray = new Ray(new Vector3(worldX, 500f, worldZ), Vector3.down);
            int layerMask = ~LayerMask.GetMask("Water", "UI", "Ignore Raycast");
            if (Physics.Raycast(ray, out RaycastHit hit, 1000f, layerMask, QueryTriggerInteraction.Ignore))
            {
                float y = hit.point.y + 0.5f;
                return y;
            }

            // Terrain collider bulunamadı — Katman filtresiyle daha yüksekten tekrar dene (su/trigger hariç)
            if (Physics.Raycast(new Ray(new Vector3(worldX, 1000f, worldZ), Vector3.down), out RaycastHit hit2, 2000f, layerMask, QueryTriggerInteraction.Ignore))
            {
                float y2 = hit2.point.y + 0.5f;
                return y2;
            }

            Debug.LogWarning("[RESPAWN] Terrain raycast miss — fallback Y=10");
            return 10f;
        }
    }
}
