        /// IsCasting()'den farkı: post-cast delay ve PSA_SPELLMAGIC animasyonu DAHİL DEĞİL.
        /// Combo cancel için kullanılır — timer aktifse FailCast, değilse sadece animasyon iptal.
        /// </summary>
        public bool IsCastingTimerActive()
        {
            return _dwMagicID != 0xffffffff && _castingSkill != null;
        }

