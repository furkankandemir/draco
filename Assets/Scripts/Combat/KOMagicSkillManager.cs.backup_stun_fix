        private void SetSkillCooldown(SkillEntry pSkill)
        {
            // cpp:972 — iReCastTime stored in tenths of seconds
            float fCooldown = pSkill.ReCastTime / 10f;
            if (fCooldown <= 0f) return;

            // cpp:974-981
            if (pSkill.SelfAnimID1 > 0)
                _recastTimes[pSkill.Id] = fCooldown;
            else
