        /// PSA_SPELLMAGIC || m_dwMagicID != 0xffffffff || m_bStun || m_fDelay > 0
        /// </summary>
        public bool IsCasting()
        {
            if (_dwMagicID != 0xffffffff) return true;
            if (_fDelay > 0f) return true;

            var pc = Character.PlayerController.Instance;
            if (pc != null)
            {
                // cpp:166: s_pPlayer->m_bStun == true
                if (pc.IsStunned) return true;
            }

            return false;
        }

        /// <summary>
