                }
            }

            // cpp:543-558 — HasRequiredMana (MagicSkillMng.cpp:198-201)
            if (!HasRequiredMana(pSkill))
            {
                if (KOUIManager.Instance != null)
                {
                    int representClass = GetRepresentClass(gm.CharClass);
                    string msg = "";
                    if (representClass == 2 || representClass == 3) // Wizard or Priest
                    {
                        msg = EntropyOnline.Services.StringTableService.Get(3004); // Lack of MP
                    }
                    else if (representClass == 0 || representClass == 1) // Warrior or Rogue
                    {
                        msg = EntropyOnline.Services.StringTableService.Get(4008); // Lack of SP (Stamina)
                    }

                    if (!string.IsNullOrEmpty(msg))
                    {
                        KOUIManager.Instance.AddMsgOutput(msg, KOUIManager.D3DColorToUnity(0xffffff00));
                    }
                }
                return false;
            }

            // cpp:561-566 — HasRequiredHealth (MagicSkillMng.cpp:203-210)
            if (!HasRequiredHealth(pSkill))
            {
                if (KOUIManager.Instance != null)
                {
