        /// <summary>
        /// Open-KO birebir: CMagicSkillMng::AddIdx (MagicSkillMng.cpp:2472-2516)
        /// Flying bundle için unique index oluşturur.
        ///
        /// cpp:2478-2493 — iNum > 1: ardışık index'ler oluştur
        /// cpp:2497-2513 — iNum == 1: ilk boş slotu bul
        /// </summary>
        public int AddIdx(int magicId, int iNum = 1)
        {
            int idx = 0;

            // cpp:2478-2493 — birden fazla index gerekiyorsa (multi-arrow)
            if (iNum > 1)
            {
                if (_mySelf.Count > 0)
                {
                    // cpp:2482-2484 — en son key + 1
                    int maxKey = 0;
                    foreach (var k in _mySelf.Keys)
                        if (k > maxKey) maxKey = k;
                    idx = maxKey + 1;
                }
                else
                    idx = 1;

                for (int i = 0; i < iNum; i++)
                    _mySelf[idx + i] = magicId;
                return idx;
            }

            // cpp:2497-2513 — tek index: ilk boş slotu bul
            while (_mySelf.ContainsKey(idx))
                idx++;
            _mySelf[idx] = magicId;
            return idx;
        }

