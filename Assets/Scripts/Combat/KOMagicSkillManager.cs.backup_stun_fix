                if (iSourceID == myId || (iTargetID == myId && (sourceNpc != null || sourcePlayer != null)))
                {
                    RemoveIdx(d4);
                }
                else
                {
                    if (KOFXManager.Instance != null)
                        KOFXManager.Instance.Stop(iSourceID, iTargetID, pSkill.FlyingFX, d4);
                }

                // cpp:2027-2043 — Hedef bensem: StopCastingByRatio / StunMySelf
                if (iTargetID == myId)
                {
                    if (pSkill.FirstTableType == 2 || pSkill.SecondTableType == 2)
                    {
                        StopCastingByRatio();
                    }
                    else if (pSkill.FirstTableType == 3 || pSkill.SecondTableType == 3)
                    {
                        var pType3 = KOImport.SkillType3Parser.Find((int)dwMagicID);
                        if (pType3 != null && pType3.Attribute == 3)
                        {
                            StopCastingByRatio();
                            StunMySelf(pType3);
                        }
                    }
                }

                // cpp:2045-2054 — TargetFX tetikle
                bool targetExists = (iTargetID == myId) || 
                                    (FindRemotePlayerByID(iTargetID) != null) || 
                                    (FindEntityByID(iTargetID) != null);
                if (KOFXManager.Instance != null)
                {
                    if (targetExists)
                    {
                        KOFXManager.Instance.TriggerBundle(iSourceID, pSkill.TargetPart, pSkill.TargetFX, iTargetID, pSkill.TargetPart);
                    }
                    else
                    {
                        Vector3 targetPos = new Vector3(d0, d1, d2);
                        KOFXManager.Instance.TriggerBundle(iSourceID, 0, pSkill.TargetFX, targetPos);
                    }
                }
                return;
            }

            // cpp:2058-2060 — Diğer fail tipleri (gelecekte eklenecek)
        }

        private bool IsPlayerMoving()
        {
            var pc = Character.PlayerController.Instance;
            if (pc == null) return false;
            // Joystick aktifse hareket var (kamera joystick'ini yoksay)
            var joysticks = FindObjectsByType<Input.VirtualJoystick>(FindObjectsInactive.Exclude);
