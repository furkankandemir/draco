            // Open-KO birebir: WIZ_MAGIC_PROCESS + EFFECTING
            using var pkt = new KOPacketWriter(WizOpcode.WIZ_MAGIC_PROCESS);
            pkt.WriteByte(subOpcode); // PacketDef.h:93 N3_SP_MAGIC_EFFECTING = 0x03 or N3_SP_MAGIC_FLYING = 0x02
            pkt.WriteInt32(magicId);
            pkt.WriteInt16((short)sourceID);
