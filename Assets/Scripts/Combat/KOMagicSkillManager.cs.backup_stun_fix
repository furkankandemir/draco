        /// <summary>
        /// Open-KO birebir: CMagicSkillMng::MsgSend_MagicProcess (MagicSkillMng.cpp:737-967)
        /// Ana entry point — skill butonundan çağrılır.
        /// </summary>
        // C++ birebir: MagicSkillMng.cpp:737 — bool CMagicSkillMng::MsgSend_MagicProcess(int iTargetID, __TABLE_UPC_SKILL* pSkill)
        // targetIsPlayer parametresi C++'ta YOK — kaldırıldı.
        public bool MsgSend_MagicProcess(int iTargetID, SkillEntry pSkill, bool isAutoCast = false)
        {
            var gm = GameManager.Instance;
            if (gm == null) return false;

            // cpp:740-741 — ölü iken skill kullanılamaz

            // cpp:746 — null check
            if (pSkill == null) return false;

            // Rogue class Minor Healing (ID ends in 7705 or 8705) Auto-Cast Toggle
            int skillEnd = pSkill.Id % 100000;
            if ((skillEnd == 7705 || skillEnd == 8705) && IsRepresentRogue(gm.CharClass))
            {
                if (!isAutoCast)
                {
                    _isAutoMinorActive = !_isAutoMinorActive;
                    if (_isAutoMinorActive)
                    {
                        _autoMinorSkill = pSkill;
                        _autoMinorTimer = 0.1f; // Cast immediately in the next Update frame
                    }
                    else
                    {
                        _autoMinorSkill = null;
                    }
                    return true;
                }
            }

            // Type1 combo animasyonu kesilmeden yeni Type1 skill engellenir
            if (pSkill.FirstTableType == 1 || pSkill.SecondTableType == 1)
            {
                var pc = Character.PlayerController.Instance;
                if (pc != null)
                {
                    bool isComboPlaying = pc.IsComboAnimPlaying();
                    if (isComboPlaying)
                    {
                        return false;
                    }
                }
            }

            // cpp:749-765 — Cooldown checks
            if (pSkill.SelfAnimID1 > 0) // Casting skill with animation
            {
                // cpp:754 — IsCasting || recast > 0
                if (_dwMagicID != 0xffffffff || (_recastTimes.TryGetValue(pSkill.Id, out float cd) && cd > 0))
                {
                    return false;
                }
            }
            else // Instant/non-action skill
            {
                // cpp:759-764
                if (_nonActionRecastTimes.TryGetValue(pSkill.Id, out float ncd) && ncd > 0)
                    return false;

                _dwCastingStateNonAction = 0;
                _fCastTimeNonAction = 0f;
                _dwNonActionMagicID = 0;
                _iNonActionMagicTarget = -1;
            }

            // cpp:767-768 — CheckValidCondition
            if (!CheckValidCondition(iTargetID, pSkill))
            {
                return false;
            }

            var targetEntity = FindEntityByID(iTargetID);
            var targetPlayer = (targetEntity == null) ? FindRemotePlayerByID(iTargetID) : null;


            // cpp:792-794 — fDist = s_pPlayer->Radius() + 1.0f + pTarget->Radius()
            float fDist = 1.5f; // playerRadius + 1.0f default
            if (targetEntity != null)
            {
                float targetRadius = 0.5f;
                var targetCol = targetEntity.GetComponent<CapsuleCollider>();
                if (targetCol != null)
                    targetRadius = targetCol.radius * targetEntity.transform.localScale.x;
                fDist += targetRadius;
            }
            else if (targetPlayer != null)
            {
                float targetRadius = 0.5f;
                var targetCol = targetPlayer.GetComponent<CapsuleCollider>();
                if (targetCol != null)
                    targetRadius = targetCol.radius * targetPlayer.transform.localScale.x;
                fDist += targetRadius;
            }

            // cpp:776-780 — Region magic FX reset
            CancelRegionTargeting();

            // cpp:796-964 — Target type dispatch
            // Open-KO birebir switch(pSkill->iTarget)
            switch (pSkill.Target)
            {
                case 1: // SKILLMAGIC_TARGET_SELF (cpp:798-800)
                    // cpp:799 — StartSkillMagicAtTargetPacket(pSkill, (int16_t) s_pPlayer->IDNumber())
                    StartSkillMagicAtTargetPacket(pSkill, (short)gm.CharacterId);
                    return true;

                case 2: // SKILLMAGIC_TARGET_FRIEND_WITHME (cpp:802-816)
                    // cpp:803 — pTarget == nullptr → self cast
                    if (targetEntity == null && targetPlayer == null)
                    {
                        // cpp:805 — StartSkillMagicAtTargetPacket(pSkill, (int16_t) s_pPlayer->IDNumber())
                        StartSkillMagicAtTargetPacket(pSkill, (short)gm.CharacterId);
                        return true;
                    }
                    // cpp:808 — else if (!s_pPlayer->IsHostileTarget(pTarget))
                    else if (targetEntity != null && !IsHostileTarget(targetEntity))
                    {
                        // cpp:810 — CheckValidDistance
                        if (!CheckValidDistance(pSkill, targetEntity, fDist))
                        {
                            // Partideki kişi yakında değilse kendi karakterini minnor yapmalı (self-cast)
                            StartSkillMagicAtTargetPacket(pSkill, (short)gm.CharacterId);
                            return true;
                        }
                        // cpp:813 — StartSkillMagicAtTargetPacket(pSkill, (int16_t) pTarget->IDNumber())
                        StartSkillMagicAtTargetPacket(pSkill, (short)iTargetID);
                        return true;
                    }
                    else if (targetPlayer != null && !IsHostileTarget(targetPlayer))
                    {
                        if (!CheckValidDistance(pSkill, targetPlayer, fDist))
                        {
                            StartSkillMagicAtTargetPacket(pSkill, (short)gm.CharacterId);
                            return true;
                        }
                        StartSkillMagicAtTargetPacket(pSkill, (short)iTargetID);
                        return true;
                    }
                    else // Target is hostile (monster/enemy) -> self cast (cpp:815)
                    {
                        StartSkillMagicAtTargetPacket(pSkill, (short)gm.CharacterId);
                        return true;
                    }

                case 3: // SKILLMAGIC_TARGET_FRIEND_ONLY (cpp:818-827)
                    if (targetEntity != null && !IsHostileTarget(targetEntity))
                    {
                        if (!CheckValidDistance(pSkill, targetEntity, fDist))
                            return false;
                        StartSkillMagicAtTargetPacket(pSkill, (short)iTargetID);
                        return true;
                    }
                    else if (targetPlayer != null && !IsHostileTarget(targetPlayer))
                    {
                        if (!CheckValidDistance(pSkill, targetPlayer, fDist))
                            return false;
                        StartSkillMagicAtTargetPacket(pSkill, (short)iTargetID);
                        return true;
                    }
                    break;

                case 4: // SKILLMAGIC_TARGET_PARTY (cpp:829-853)
                {
                    var partyMgr = KOPartyManager.Instance;
                    PartyMemberData pInfo = partyMgr?.MemberInfoGetSelected();

                    if (pInfo == null && iTargetID == -1)
                    {
                        StartSkillMagicAtTargetPacket(pSkill, (short)gm.CharacterId);
                        return true;
                    }

                    if (targetEntity != null || targetPlayer != null)
                    {
                        int iMemberIndex;
                        bool isMember = partyMgr != null &&
                            partyMgr.MemberInfoGetByID(iTargetID, out iMemberIndex) != null;
                        bool isSelf = iTargetID == gm.CharacterId;

                        if (isMember || isSelf)
                        {
                            if (targetEntity != null && !CheckValidDistance(pSkill, targetEntity, fDist))
                                return false;
                            if (targetPlayer != null && !CheckValidDistance(pSkill, targetPlayer, fDist))
                                return false;

                            StartSkillMagicAtTargetPacket(pSkill, (short)iTargetID);
                            return true;
                        }
                    }

                    if (pInfo != null)
                    {
                        StartSkillMagicAtTargetPacket(pSkill, (short)pInfo.CharacterId);
                        return true;
                    }
                }
                break;

                case 5: // SKILLMAGIC_TARGET_NPC_ONLY (cpp:855-863)
                    // cpp:856 — pTarget != nullptr && s_pOPMgr->NPCGetByID(pTarget->IDNumber(), true)
                    if (targetEntity != null)
                    {
                        // cpp:858
                        if (!CheckValidDistance(pSkill, targetEntity, fDist))
                            return false;
                        // cpp:861
                        StartSkillMagicAtTargetPacket(pSkill, (short)iTargetID);
                        return true;
                    }
                    break;

                case 6: // SKILLMAGIC_TARGET_PARTY_ALL (cpp:866-868)
                    // C++ birebir: cpp:867 — StartSkillMagicAtPosPacket(pSkill, s_pPlayer->Position())
                    {
                        var pc6 = Character.PlayerController.Instance;
                        Vector3 selfPos = pc6 != null ? pc6.transform.position : Vector3.zero;
                        StartSkillMagicAtPosPacket(pSkill, selfPos);
                    }
                    return true;

                case 7: // SKILLMAGIC_TARGET_ENEMY_ONLY (cpp:870-878)
                    // cpp:871 — if (pTarget != nullptr && s_pPlayer->IsHostileTarget(pTarget))
                    if (targetEntity != null && IsHostileTarget(targetEntity))
                    {
                        // cpp:873
                        if (!CheckValidDistance(pSkill, targetEntity, fDist))
                            return false;
                        // cpp:876 — StartSkillMagicAtTargetPacket(pSkill, (int16_t) pTarget->IDNumber())
                        StartSkillMagicAtTargetPacket(pSkill, (short)iTargetID);
                        return true;
                    }
                    else if (targetPlayer != null && IsHostileTarget(targetPlayer))
                    {
                        if (!CheckValidDistance(pSkill, targetPlayer, fDist))
                            return false;
                        StartSkillMagicAtTargetPacket(pSkill, (short)iTargetID);
                        return true;
                    }
                    break;

                case 8: // SKILLMAGIC_TARGET_ALL (cpp:881-890)
                    // cpp:882 — if (pTarget != nullptr)
                    if (targetEntity != null)
                    {
                        // cpp:884
                        if (!CheckValidDistance(pSkill, targetEntity, fDist))
                            return false;
                        // cpp:887
                        StartSkillMagicAtTargetPacket(pSkill, (short)iTargetID);
                        return true;
                    }
                    else if (targetPlayer != null)
                    {
                        if (!CheckValidDistance(pSkill, targetPlayer, fDist))
                            return false;
                        StartSkillMagicAtTargetPacket(pSkill, (short)iTargetID);
                        return true;
                    }
                    break;

                case 13: // SKILLMAGIC_TARGET_AREA (cpp:892-894)
                    // C++ birebir: cpp:893 — StartSkillMagicAtPosPacket(pSkill, s_pPlayer->Position())
                    {
                        var pc13 = Character.PlayerController.Instance;
                        Vector3 selfPos13 = pc13 != null ? pc13.transform.position : Vector3.zero;
                        StartSkillMagicAtPosPacket(pSkill, selfPos13);
                    }
                    return true;

                case 10: // SKILLMAGIC_TARGET_AREA_ENEMY (cpp:896-948)
                case 11: // SKILLMAGIC_TARGET_AREA_FRIEND
                case 12: // SKILLMAGIC_TARGET_AREA_ALL
                {
                    // cpp:900-901 — region magic state'e geç
                    _dwRegionMagicState = 1;
                    _dwRegionSkill = pSkill;

                    // cpp:907-931 — zone pointer radius hesapla (Type3/4)
                    _fZonePointerRadius = 3.0f; // varsayılan
                    switch (pSkill.FirstTableType)
                    {
                        case 3:
                        {
                            var pType3 = KOImport.SkillType3Parser.Find(pSkill.Id);
                            if (pType3 != null)
                                _fZonePointerRadius = pType3.Radius - 1.0f;
                            break;
                        }
                        case 4:
                        {
                            var pType4 = KOImport.SkillType4Parser.Find(pSkill.Id);
                            if (pType4 != null)
                                _fZonePointerRadius = pType4.Radius - 1.0f;
                            break;
                        }
                        case 7:
                        {
                            if (pSkill.Id == 111751 || pSkill.Id == 112751 || pSkill.Id == 211751 || pSkill.Id == 212751)
                                _fZonePointerRadius = 29.0f;
                            else
                                _fZonePointerRadius = 3.0f;
                            break;
                        }
                    }
                    if (_fZonePointerRadius < 1.0f) _fZonePointerRadius = 3.0f;

                    // UI'a bildir — ground indicator göster
                    OnRegionTargetingStart?.Invoke(_fZonePointerRadius, pSkill.Name);

                    return true;
                }

                case 25: // SKILLMAGIC_TARGET_DEAD_FRIEND_ONLY (cpp:950-959)
                    // cpp:952 — pTarget != nullptr && !s_pPlayer->IsHostileTarget(pTarget) && pTarget->IsDead()
                    if (targetEntity != null && !IsHostileTarget(targetEntity) && targetEntity.IsDead)
                    {
                        // cpp:954
                        if (!CheckValidDistance(pSkill, targetEntity, fDist))
                            return false;
                        // cpp:956
                        StartSkillMagicAtTargetPacket(pSkill, (short)iTargetID);
                        return true;
                    }
                    else if (targetPlayer != null && !IsHostileTarget(targetPlayer) && !targetPlayer.IsAlive)
                    {
                        if (!CheckValidDistance(pSkill, targetPlayer, fDist))
                            return false;
                        StartSkillMagicAtTargetPacket(pSkill, (short)iTargetID);
                        return true;
                    }
                    break;

                default:
                    break;
            }

            return false;
        }

