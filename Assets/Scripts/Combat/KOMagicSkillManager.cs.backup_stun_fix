        private void Awake()
        {
            if (Instance != null && Instance != this) { Destroy(gameObject); return; }
            Instance = this;

            // Region target indicator bileşenini otomatik ekle
            if (GetComponent<RegionTargetIndicator>() == null)
                gameObject.AddComponent<RegionTargetIndicator>();
        }

        private void OnDestroy()
        {
            if (Instance == this) Instance = null;
        }

        private void OnDisable()
        {
            _isAutoMinorActive = false;
            _autoMinorSkill = null;
        }

        /// <summary>
        /// Open-KO birebir: CMagicSkillMng::Tick (MagicSkillMng.cpp:1300-1416)
        /// Her frame çağrılır.
        /// </summary>
        private void Update()
        {
            float dt = Time.deltaTime;

            // --- Cooldown countdown (MagicSkillMng.cpp:1307-1341) ---
            TickCooldowns(dt);

            // --- Legacy delay (MagicSkillMng.cpp:1343-1346) ---
            _fDelay -= dt;
            if (_fDelay < 0f) _fDelay = 0f;

            // --- Casting timer (MagicSkillMng.cpp:1347) ---
            ProcessCasting();

            // --- Region magic confirm (MagicSkillMng.cpp:1361-1371) ---
            ProcessRegionMagic();

            // --- Non-action casting (MagicSkillMng.cpp:1373-1416) ---
            ProcessNonActionCasting(dt);

            // --- Auto-minor healing tick ---
            ProcessAutoMinor(dt);
        }

