            if (!HasRequiredExhaustItem(pSkill))
            {
                return false;
            }

            // ================================================================
            // cpp:593-612 — Type3 self buff stacking kontrolü
            // Aynı türde Type3 buff zaten aktifse tekrar kullanılamaz.
            // Open-KO birebir: MagicSkillMng.cpp:593-612
