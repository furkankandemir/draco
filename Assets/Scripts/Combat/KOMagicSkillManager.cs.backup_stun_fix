        /// <summary>
        /// Open-KO birebir: CMagicSkillMng::FlyingType2 (MagicSkillMng.cpp:2157-2278)
        /// Type2 (bow/range) multi-arrow flying FX — kendi oyuncumuz (lokal) için.
        /// EntityManager'daki FlyingType2 uzak oyuncular içindir, bu lokal oyuncu içindir.
        /// </summary>
        private void FlyingType2(SkillEntry pSkill, int sourceID, int targetID, short[] data)
        {
            var pType2 = KOImport.SkillType2Parser.Find(pSkill.Id);
            if (pType2 == null) return;

            var fxMgr = KOFXManager.Instance;
            if (fxMgr == null || pSkill.FlyingFX <= 0) return;

            int spart1 = pSkill.SelfPart1 % 1000;
            int idx = data.Length > 3 ? data[3] : 0;

            // Source pozisyonu (kendi oyuncumuz)
            var pc = Character.PlayerController.Instance;
            if (pc == null) return;
            Vector3 sourcePos = pc.transform.position;

            // Target entity'yi bul
            var targetEntity = FindEntityByID(targetID);
            var targetPlayerEntity = (targetEntity == null) ? FindRemotePlayerByID(targetID) : null;

            // cpp:2181-2210: target == nullptr → fixedTarget
            if (targetEntity == null && targetPlayerEntity == null)
            {
                Vector3 vDir = pc.transform.forward;
                Vector3 sourceChest = KOFXManager.ResolveEntityPosition(sourceID);
                Vector3 vTargetPos = sourceChest + vDir;

                // Ana ok
                fxMgr.TriggerBundle(sourceID, spart1, pSkill.FlyingFX,
                    vTargetPos, idx, pType2.SuccessType);

                // Multi-arrow spread
                int numArrow = (pType2.NumArrow - 1) >> 1;
                Vector3 vTargetPos2 = vTargetPos - sourceChest;
                for (int i = 1; i <= numArrow; i++)
                {
                    float fAng = (Mathf.PI * i) / 12.0f;

                    Quaternion rotLeft = Quaternion.AngleAxis(-fAng * Mathf.Rad2Deg, Vector3.up);
                    Vector3 vLeft = rotLeft * vTargetPos2;
                    fxMgr.TriggerBundle(sourceID, spart1, pSkill.FlyingFX,
                        vLeft + sourceChest, idx++, pType2.SuccessType);

                    Quaternion rotRight = Quaternion.AngleAxis(fAng * Mathf.Rad2Deg, Vector3.up);
                    Vector3 vRight = rotRight * vTargetPos2;
                    fxMgr.TriggerBundle(sourceID, spart1, pSkill.FlyingFX,
                        vRight + sourceChest, idx++, pType2.SuccessType);
                }
            }
            // cpp:2211-2273: target != nullptr
            else
            {
                Vector3 vTargetPos = KOFXManager.ResolveEntityPosition(targetID);
                Vector3 sourceChest = KOFXManager.ResolveEntityPosition(sourceID);

                if (pType2.SuccessType == KOFXManager.FX_BUNDLE_MOVE_DIR_FIXEDTARGET)
                {
                    // Ana ok
                    fxMgr.TriggerBundle(sourceID, spart1, pSkill.FlyingFX,
                        vTargetPos, idx, KOFXManager.FX_BUNDLE_MOVE_DIR_FIXEDTARGET);

                    // Multi-arrow
                    int numArrow = (pType2.NumArrow - 1) >> 1;
                    Vector3 vTargetPos2 = vTargetPos - sourceChest;
                    for (int i = 1; i <= numArrow; i++)
                    {
                        float fAng = (Mathf.PI * i) / 12.0f;

                        Quaternion rotLeft = Quaternion.AngleAxis(-fAng * Mathf.Rad2Deg, Vector3.up);
                        Vector3 vLeft = rotLeft * vTargetPos2;
                        fxMgr.TriggerBundle(sourceID, spart1, pSkill.FlyingFX,
                            vLeft + sourceChest, idx++, KOFXManager.FX_BUNDLE_MOVE_DIR_FIXEDTARGET);

                        Quaternion rotRight = Quaternion.AngleAxis(fAng * Mathf.Rad2Deg, Vector3.up);
                        Vector3 vRight = rotRight * vTargetPos2;
                        fxMgr.TriggerBundle(sourceID, spart1, pSkill.FlyingFX,
                            vRight + sourceChest, idx++, KOFXManager.FX_BUNDLE_MOVE_DIR_FIXEDTARGET);
                    }
                }
                else
                {
                    // FLEXABLETARGET (tracking)
                    fxMgr.TriggerBundle(sourceID, spart1, pSkill.FlyingFX,
                        targetID, pSkill.TargetPart, idx, pType2.SuccessType);

                    // Multi-arrow
                    int numArrow = (pType2.NumArrow - 1) >> 1;
                    Vector3 vTargetPos2 = vTargetPos - sourceChest;
                    for (int i = 1; i <= numArrow; i++)
                    {
                        float fAng = (Mathf.PI * i) / 12.0f;

                        Quaternion rotLeft = Quaternion.AngleAxis(-fAng * Mathf.Rad2Deg, Vector3.up);
                        Vector3 vLeft = rotLeft * vTargetPos2;
                        fxMgr.TriggerBundle(sourceID, spart1, pSkill.FlyingFX,
                            vLeft + sourceChest, idx++, pType2.SuccessType);

                        Quaternion rotRight = Quaternion.AngleAxis(fAng * Mathf.Rad2Deg, Vector3.up);
                        Vector3 vRight = rotRight * vTargetPos2;
                        fxMgr.TriggerBundle(sourceID, spart1, pSkill.FlyingFX,
                            vRight + sourceChest, idx++, pType2.SuccessType);
                    }
                }
            }

        }
