            // if ((pSkill->dw1stTableType == 4 || pSkill->dw2ndTableType == 4)
            //     && (pSkill->iTarget == SKILLMAGIC_TARGET_SELF || iTargetID == s_pPlayer->IDNumber()))
            if ((pSkill.FirstTableType == 4 || pSkill.SecondTableType == 4)
                && (pSkill.Target == 1 || iTargetID == gm.CharacterId))
            {
                // cpp:617-619: pType4 = m_pTbl_Type_4->Find(pSkill->dwID)
                var pType4 = KOImport.SkillType4Parser.Find(pSkill.Id);
                if (pType4 == null)
                    return false;

                // cpp:621-660: BuffType'a göre delta kontrolü
                switch (pType4.BuffType)
                {
                    case BUFFTYPE_MAXHP: // 1
                        if (_buffMaxHP != 0)
                            return false;
                        break;

                    case BUFFTYPE_AC: // 2
                        if (_buffAC != 0)
                            return false;
                        break;

                    case BUFFTYPE_ATTACK: // 4
                        if (_buffAttack != 0)
                            return false;
                        break;

                    case BUFFTYPE_ATTACKSPEED: // 5
                        if (_buffAttackSpeed != 1.0f)
                            return false;
                        break;

                    case BUFFTYPE_SPEED: // 6
                        if (_buffSpeed != 1.0f)
                            return false;
                        break;

                    case BUFFTYPE_ABILITY: // 7
                        if (_buffStr != 0 || _buffSta != 0 || _buffDex != 0 || _buffInt != 0 || _buffMAP != 0)
