                          needSkill == 201 || needSkill == 205 || needSkill == 206),    // Karus + Elmorad warriors
                    1 => (needSkill == 102 || needSkill == 107 || needSkill == 108 ||  // CLASS_REPRESENT_ROGUE
                          needSkill == 202 || needSkill == 207 || needSkill == 208),
                    2 => (needSkill == 103 || needSkill == 109 || needSkill == 110 ||  // CLASS_REPRESENT_WIZARD
                          needSkill == 203 || needSkill == 209 || needSkill == 210),
                    3 => (needSkill == 104 || needSkill == 111 || needSkill == 112 ||  // CLASS_REPRESENT_PRIEST
                          needSkill == 204 || needSkill == 211 || needSkill == 212),
                    _ => true
                };

                if (!classOk)
