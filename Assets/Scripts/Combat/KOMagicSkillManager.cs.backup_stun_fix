        /// </summary>
        private int GetRepresentClass(byte eClass)
        {
            // Open-KO: eClass % 100 → base class ID
            int baseClass = eClass % 100;
            return baseClass switch
            {
                1 or 5 or 6 => 0,   // Warrior / Berserker-Blade / Guardian-Protector
                2 or 7 or 8 => 1,   // Rogue / Hunter-Ranger / Penetrator-Assassin
                3 or 9 or 10 => 2,  // Wizard / Sorcerer-Mage / Necromancer-Enchanter
                4 or 11 or 12 => 3, // Priest / Shaman-Cleric / DarkPriest-Druid
                _ => -1
            };
        }

