            }
        }

        // ================================================================
        // ProcessAutoMinor — Rogue Minor Healing Auto-Caster
        // ================================================================
        private void ProcessAutoMinor(float dt)
        {
            var gm = GameManager.Instance;
            if (gm == null || gm.CurrentHp <= 0)
            {
                if (_isAutoMinorActive)
                {
                    _isAutoMinorActive = false;
                    _autoMinorSkill = null;
                }
                return;
            }

            if (!_isAutoMinorActive || _autoMinorSkill == null) return;

            _autoMinorTimer += dt;
            if (_autoMinorTimer >= 0.1f)
            {
                _autoMinorTimer = 0f;
                int targetId = (int)gm.TargetId;
                MsgSend_MagicProcess(targetId, _autoMinorSkill, isAutoCast: true);
            }
        }

