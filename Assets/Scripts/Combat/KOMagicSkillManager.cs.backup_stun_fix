            pkt.WriteInt16((short)vPos.x); // sData[0] (X)
            pkt.WriteInt16((short)vPos.y); // sData[1] (Y)
            pkt.WriteInt16((short)vPos.z); // sData[2] (Z)
            pkt.WriteInt16(0);             // sData[3]
            pkt.WriteInt16(0);             // sData[4]
            pkt.WriteInt16(0);             // sData[5]
            pkt.WriteInt16(0);             // sData[6]
            KONetworkManager.Instance.SendPacket(pkt);
