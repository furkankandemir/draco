        /// <summary>
        /// Open-KO birebir: CPlayerBase::IsHostileTarget (PlayerBase.cpp:2532-2642)
        /// Zone ability tipine göre hostile kontrolü.
        ///
        /// Basitleştirilmiş versiyon:
        ///   - NPC/Monster (nation == NATION_NOTSELECTED → 0): genellikle hostile
        ///   - Player: karşı nation → hostile
        ///   - C++ default: return true (herkes hostile)
        ///
        /// TODO: Zone ability bazlı tam implementasyon (ZoneAbilityType kontrolü)
        ///   C++ tam versiyon: pTarget->m_InfoBase.eNation + ZoneAbilityType switch
        ///   ABILITY_NEUTRAL → false
        ///   ABILITY_NPC_TRADE_ONLY → (pTarget is NPC ? false : hostile)
        ///   ABILITY_ATTACK_ONLY_ENEMY_PLAYER → (player ? nation check : true)
        ///   vs.
        /// </summary>
        private bool IsHostileTarget(EntropyOnline.World.KOEntity target)
        {
            if (target == null) return false;

            var gm = GameManager.Instance;
            if (gm == null) return true;

            // Open-KO birebir port: PlayerBase.cpp:2553-2570 (ZONE_ABILITY_NEUTRAL)
            if (gm.ZoneAbilityType == 0) 
            {
                // Oyuncu vs Oyuncu tarafsız bölgede saldıramaz (RemotePlayerEntity overload'unda elenir).
                // Hedef KOEntity (yani NPC/Monster) olduğundan C++'taki PlayerType() != PLAYER_NPC && rhs->PlayerType() != PLAYER_NPC engeline takılmaz.
                
                // C++: if (Nation() != NATION_NOTSELECTED) { if (rhs->Nation() != NATION_NOTSELECTED) return false; }
                if (gm.Nation != 0) // NATION_NOTSELECTED
                {
                    if (target.Nation != 0)
                        return false; // Dost NPC'ler tarafsız bölgede düşman değildir
                }
                else if (target.Nation != 0)
                {
                    return false;
                }

                return true; // Vahşi yaratıklar (target.Nation == 0) düşmandır, atak yapılabilir!
            }

            if (target.IsNpc)
            {
                // Eslant (Zone 11 ve 12) haritalarında tüm dost NPC'ler dost (tarafsız) kabul edilir.
                if (gm.CurrentZoneId == 11 || gm.CurrentZoneId == 12)
                    return false;
            }

            // C++ birebir: Player → nation karşılaştırması
            // PlayerBase.cpp:2563: if (pTarget->m_InfoBase.eNation != s_pPlayer->m_InfoBase.eNation)
            return target.Nation != gm.Nation; // Farklı ulus → hostile
        }

        private bool IsHostileTarget(EntropyOnline.World.RemotePlayerEntity target)
        {
            if (target == null) return false;
            var gm = GameManager.Instance;
            if (gm == null) return true;

            // Open-KO birebir: ZoneAbilityType == 0 (ZONE_ABILITY_NEUTRAL, örn. Moradon) ise
            // karşı ırktan oyuncular düşman sayılmaz ve birbirini iyileştirebilir / buff'layabilir.
            if (gm.ZoneAbilityType == 0)
            {
                return false;
            }

            return target.Nation != gm.Nation;
        }

