        /// <summary>
        /// Open-KO birebir: CMagicSkillMng::GetCooldown (MagicSkillMng.cpp)
        /// Verilen skill için kalan cooldown süresini döndürür.
        /// </summary>
        public float GetCooldown(int skillId)
        {
            if (_recastTimes.TryGetValue(skillId, out float r) && r > 0) return r;
            if (_nonActionRecastTimes.TryGetValue(skillId, out float n) && n > 0) return n;
            return 0f;
        }

        /// <summary>Verilen skill için toplam cooldown süresini döndürür (saniye)</summary>
        public float GetMaxCooldown(int skillId)
        {
            var skill = SkillTableParser.Find(skillId);
            if (skill == null) return 0f;
            return skill.ReCastTime / 10f;
        }

