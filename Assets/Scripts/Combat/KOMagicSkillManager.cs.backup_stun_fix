            // cpp:1155
            fxMgr.TriggerBundle(sourceID, spart1, pSkill.SelfFX1, sourceID, spart1, -1);

            // cpp:1156-1157
            if (spart2 != 0)
                fxMgr.TriggerBundle(sourceID, spart2, pSkill.SelfFX1, sourceID, spart2, -2);
        }

