                    case BUFFTYPE_RESIST: // 8
                        if (_buffFireR != 0 || _buffColdR != 0 || _buffLightningR != 0 ||
                            _buffMagicR != 0 || _buffDiseaseR != 0 || _buffPoisonR != 0)
                            return false;
                        break;

                    default:
                        break;
                }
            }

            return true;
        }

