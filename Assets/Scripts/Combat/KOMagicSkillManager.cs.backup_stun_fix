        /// <summary>
        /// Open-KO birebir: CMagicSkillMng::CheckValidDistance (MagicSkillMng.cpp:984-1028)
        /// Hedefin skill menzilinde olup olmadığını kontrol eder.
        ///
        /// cpp:986 — fDist = (vTargetPos - s_pPlayer->Position()).Magnitude()
        /// cpp:988 — iValidDist > 0 → iValidDist + fTargetRadius + 1.0f
        /// cpp:992-1001 — Type1: silah menzili + targetRadius + 1.0f
        /// cpp:1004-1022 — Type2: silah menzili * iAddDist / 100 + targetRadius + 1.0f
        /// </summary>
        private bool CheckValidDistance(SkillEntry pSkill, Vector3 targetPos, float fTargetRadius)
        {
            // cpp:986
            var player = GameObject.FindGameObjectWithTag("Player");
            if (player == null) return true;

            float fDist = Vector3.Distance(player.transform.position, targetPos);

            // cpp:988-989 — iValidDist > 0 ise doğrudan mesafe kontrolü
            if (pSkill.ValidDist > 0 && fDist <= (pSkill.ValidDist + fTargetRadius + 1.0f))
                return true;

            // cpp:992-1001 — Type1 skill: silah menzili kontrolü
            if (pSkill.FirstTableType == 1 || pSkill.SecondTableType == 1)
            {
                // cpp:994-1000 — m_pMySlot[ITEM_SLOT_HAND_RIGHT]->pItemBasic->siAttackRange
                float weaponRange = 3.0f; // default melee
                var inv = KOInventory.Instance;
                if (inv != null && KOInventory.s_pTbl_Items_Basic != null)
                {
                    var rhSlot = inv.m_pMySlot[KOInventory.ITEM_SLOT_HAND_RIGHT];
                    if (rhSlot != null && !rhSlot.IsEmpty
                        && KOInventory.s_pTbl_Items_Basic.TryGetValue((uint)(rhSlot.itemId / 1000 * 1000), out var rhBasic))
                    {
                        weaponRange = rhBasic.siAttackRange / 10.0f;
                    }
                }
                float fValidDist = weaponRange + fTargetRadius + 1.0f;
                if (fValidDist >= fDist)
                    return true;
            }

            // cpp:1004-1022 — Type2 skill: ok/yay menzili kontrolü
            if (pSkill.FirstTableType == 2 || pSkill.SecondTableType == 2)
            {
                // cpp:1006-1013 — önce ITEM_SLOT_HAND_RIGHT, sonra ITEM_SLOT_HAND_LEFT
                // Sol el üzerine yazar (bow sol elde) — C++ birebir
                float ItemDistance = 0.0f;
                var invBow = KOInventory.Instance;
                if (invBow != null && KOInventory.s_pTbl_Items_Basic != null)
                {
                    // cpp:1010-1011: pItemIcon2 (sağ el)
                    var rhSlot = invBow.m_pMySlot[KOInventory.ITEM_SLOT_HAND_RIGHT];
                    if (rhSlot != null && !rhSlot.IsEmpty
                        && KOInventory.s_pTbl_Items_Basic.TryGetValue((uint)(rhSlot.itemId / 1000 * 1000), out var rhBasic))
                    {
                        ItemDistance = rhBasic.siAttackRange / 10.0f;
                    }
                    // cpp:1012-1013: pItemIcon1 (sol el) — üzerine yazar
                    var lhSlot = invBow.m_pMySlot[KOInventory.ITEM_SLOT_HAND_LEFT];
                    if (lhSlot != null && !lhSlot.IsEmpty
                        && KOInventory.s_pTbl_Items_Basic.TryGetValue((uint)(lhSlot.itemId / 1000 * 1000), out var lhBasic))
                    {
                        ItemDistance = lhBasic.siAttackRange / 10.0f;
                    }
                }

                // cpp:1011-1013: iAddDist = pType2->iAddDist
                int iAddDist = 100;
                var pType2Dist = KOImport.SkillType2Parser.Find(pSkill.Id);
                if (pType2Dist != null && pType2Dist.AddDist > 0)
                    iAddDist = pType2Dist.AddDist;

                float fValidDist = (ItemDistance + fTargetRadius + 1.0f) * iAddDist / 100.0f;
                if (fValidDist >= fDist)
                    return true;
            }

            // cpp:1024-1025 — iValidDist kontrolü de geçemediyse → çok uzak
            return false;
        }

