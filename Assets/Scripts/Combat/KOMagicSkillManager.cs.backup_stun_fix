        /// <summary>
        /// Open-KO birebir: CMagicSkillMng::ProcessCasting (MagicSkillMng.cpp:1631-1661)
        /// Her frame çağrılır — casting timer.
        /// </summary>
        private void ProcessCasting()
        {
            // cpp:1634 — cast aktif mi?
            if (_dwMagicID == 0xffffffff) return;

            // cpp:1636 — skill tablosundan bul
            var pSkill = _castingSkill ?? SkillTableParser.Find((int)_dwMagicID);
            if (pSkill == null)
            {
                _dwMagicID = 0xffffffff;
                return;
            }

            var pTarget = FindEntityByID(_iTarget);
            var pTargetPlayer = (pTarget == null) ? FindRemotePlayerByID(_iTarget) : null;
            if (pTarget != null)
            {
                var pcRotate = Character.PlayerController.Instance;
                if (pcRotate != null)
                    pcRotate.RotateToTarget(pTarget.transform);
            }
            else if (pTargetPlayer != null)
            {
                var pcRotate = Character.PlayerController.Instance;
                if (pcRotate != null)
                    pcRotate.RotateToTarget(pTargetPlayer.transform);
            }

            // cpp:1643 — casting süresi hesapla
            // fCastingTime = (iCastTime / 10.0f) * m_fAttackDelta
            // m_fAttackDelta → attack speed modifier (buff/debuff), varsayılan 1.0f
            float fCastingTime = (pSkill.CastTime / 10f);
            var pcDelta = Character.PlayerController.Instance;
            if (pcDelta != null && pcDelta.AttackDelta > 0f)
                fCastingTime *= pcDelta.AttackDelta;

            // cpp:1295 — m_fCastingTime artır (PlayerMySelf.cpp:295)
            _fCastingTime += Time.deltaTime;

            // UI progress callback
            OnCastingProgress?.Invoke(_fCastingTime, fCastingTime);

            // cpp:1648 — casting tamamlandı mı?
            if (_fCastingTime >= fCastingTime)
            {
                SuccessCast(pSkill);
                return;
            }

            // cpp:1655 — hareket ederse cast fail
            // Open-KO birebir: MagicSkillMng.cpp:1655
            // s_pPlayer->State() != PSA_SPELLMAGIC || StateMove() != PSM_STOP
            var pcCheck = Character.PlayerController.Instance;
            if (pcCheck != null)
            {
                if (pcCheck.StateMove() != Character.PlayerStateMove.PSM_STOP)
                {
                    FailCast(pSkill);
                    return;
                }
            }
            // Fallback: joystick aktifse cast fail
            else if (IsPlayerMoving())
            {
                FailCast(pSkill);
            }
        }

