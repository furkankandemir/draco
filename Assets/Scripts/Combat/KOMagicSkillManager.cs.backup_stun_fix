        // ================================================================
        // Cooldown tick — Open-KO birebir: MagicSkillMng.cpp:1307-1341
        // ================================================================

        private void TickCooldowns(float dt)
        {
            // Casting skill cooldowns (cpp:1307-1323)
            var toRemove = new List<int>();
            foreach (var kvp in _recastTimes)
            {
                if (kvp.Value - dt < 0f) toRemove.Add(kvp.Key);
            }
            foreach (var key in toRemove) _recastTimes.Remove(key);

            // Update remaining
            var keys = new List<int>(_recastTimes.Keys);
            foreach (var key in keys) _recastTimes[key] -= dt;

            // Non-action cooldowns (cpp:1325-1341)
            toRemove.Clear();
            foreach (var kvp in _nonActionRecastTimes)
            {
                if (kvp.Value - dt < 0f) toRemove.Add(kvp.Key);
            }
            foreach (var key in toRemove) _nonActionRecastTimes.Remove(key);

            keys.Clear();
            keys.AddRange(_nonActionRecastTimes.Keys);
            foreach (var key in keys) _nonActionRecastTimes[key] -= dt;
        }

