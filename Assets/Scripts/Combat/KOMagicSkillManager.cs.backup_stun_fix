        public bool IsTargetSkillOutOfRange(int targetId, SkillEntry pSkill)
        {
            if (pSkill == null) return false;

            // Kendine kullanılan veya alan yeteneklerinde mesafe aranmaz
            if (pSkill.Target == 1 || pSkill.Target == 6 || pSkill.Target == 10 || pSkill.Target == 11 || pSkill.Target == 12 || pSkill.Target == 13)
                return false;

            var targetEntity = FindEntityByID(targetId);
            var targetPlayer = (targetEntity == null) ? FindRemotePlayerByID(targetId) : null;

            if (targetEntity == null && targetPlayer == null)
                return false;

            float targetRadius = 0.5f;
            if (targetEntity != null)
            {
                var targetCol = targetEntity.GetComponent<CapsuleCollider>();
                if (targetCol != null)
                    targetRadius = targetCol.radius * targetEntity.transform.localScale.x;
                float fDist = 1.5f + targetRadius;
                return !CheckValidDistance(pSkill, targetEntity, fDist);
            }
            else if (targetPlayer != null)
            {
                var targetCol = targetPlayer.GetComponent<CapsuleCollider>();
                if (targetCol != null)
                    targetRadius = targetCol.radius * targetPlayer.transform.localScale.x;
                float fDist = 1.5f + targetRadius;
                return !CheckValidDistance(pSkill, targetPlayer, fDist);
            }

            return false;
        }

