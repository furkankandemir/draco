        /// C++: CPlayerNPC* pTarget = s_pOPMgr->CharacterGetByID(iID, bMustAlive);
        /// </summary>
        private EntropyOnline.World.KOEntity FindEntityByID(int entityId)
        {
            if (entityId < 0) return null;

            // Önce SelectedEntity'yi kontrol et (en yaygın durum — O(1))
            var selected = EntropyOnline.World.KOTargetSelector.Instance?.SelectedEntity;
            if (selected != null && selected.ServerInstanceId == entityId)
                return selected;

            // O(1) Dictionary lookup via EntityManager
            var entityMgr = EntropyOnline.World.EntityManager.Instance;
            if (entityMgr != null)
            {
                return entityMgr.GetEntityByInstanceId(entityId);
            }
            return null;
        }

        private EntropyOnline.World.RemotePlayerEntity FindRemotePlayerByID(int entityId)
        {
            if (entityId < 0) return null;

            // O(1) Dictionary lookup via EntityManager
            var entityMgr = EntropyOnline.World.EntityManager.Instance;
            if (entityMgr != null)
            {
                var rp = entityMgr.GetRemotePlayer(entityId);
                if (rp != null) return rp.Entity;
            }
            return null;
        }



