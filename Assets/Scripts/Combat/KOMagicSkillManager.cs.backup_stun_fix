        /// <summary>
        /// Open-KO birebir: CMagicSkillMng::StopCastingByRatio (MagicSkillMng.cpp:2711-2727)
        /// Düşman Type3 ile stun yediğinde casting'i interrupt edebilir.
        ///
        /// cpp:2713: CommandSitDown(false, false)
        /// cpp:2714: IsCasting() kontrolü
        /// cpp:2720: SuccessValue = rand()%100 >= iPercentSuccess → FailCast
        /// </summary>
        private void StopCastingByRatio()
        {
            // cpp:2713: CommandSitDown(false, false) — 일으켜 세운다 (oturuyorsa ayağa kaldır)
            var pc = Character.PlayerController.Instance;
            if (pc != null && pc.State() == Character.PlayerStateAction.PSA_SITDOWN)
            {
                pc.Action(Character.PlayerStateAction.PSA_BASIC, true);
            }

            // cpp:2714
            if (!IsCasting()) return;

            var pSkill = _castingSkill ?? SkillTableParser.Find((int)_dwMagicID);
            if (pSkill == null) return;

            // cpp:2720
            int successValue = Random.Range(0, 100);
            if (successValue >= pSkill.PercentSuccess)
            {
                // cpp:2722: FailCast
                FailCast(pSkill);
            }
        }

