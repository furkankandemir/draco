            if (gm != null)
                regist = (float)(gm.LightningR + gm.LightningRDelta);  // cpp:2738 birebir
            if (regist > 80f) regist = 80f;  // cpp:2739-2740

            // cpp:2742
            float prob = 30f + (40f - (40f * (regist / 80f)));

            // cpp:2744-2748
            if (sample < (int)prob)
            {
                const float STUN_TIME = 3.0f;  // GameDef.h:1281: STUN_TIME = 3.0f

                // cpp:2746: CommandSitDown(false, false) — 일으켜 세운다
                var pc = Character.PlayerController.Instance;
                if (pc != null)
                {
                    // Oturuyorsa ayağa kaldır
                    if (pc.State() == Character.PlayerStateAction.PSA_SITDOWN)
                        pc.Action(Character.PlayerStateAction.PSA_BASIC, true);

                    // cpp:2747: s_pPlayer->Stun(STUN_TIME)
                    pc.Stun(STUN_TIME);

                    // Casting varsa iptal et
                    CancelCasting();

                }
            }
        }

