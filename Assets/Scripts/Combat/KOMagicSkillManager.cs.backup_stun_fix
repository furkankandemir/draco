            if ((pSkill.FirstTableType == 3 || pSkill.SecondTableType == 3) && pSkill.Target == 1)
            {
                // cpp:595-597: pType3 = m_pTbl_Type_3->Find(pSkill->dwID)
                var pType3 = KOImport.SkillType3Parser.Find(pSkill.Id);
                if (pType3 == null)
                    return false;

                // cpp:599-605: key hesaplama
                int key;
                if (pType3.StartDamage > 0 || (pType3.StartDamage == 0 && pType3.DuraDamage > 0))
                    key = DDTYPE_TYPE3_DUR_OUR;
                else
                    key = DDTYPE_TYPE3_DUR_ENEMY;

                key += pType3.DDType;

                // cpp:607-610: key == DDTYPE_TYPE3_DUR_OUR ve listede varsa → false
                if (key == DDTYPE_TYPE3_DUR_OUR)
                {
                    if (_listBuffTypeID.ContainsKey(key))
