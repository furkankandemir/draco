        private Texture2D CreateGrassTexture()
        {
            var tex = new Texture2D(64, 64);
            for (int y = 0; y < 64; y++)
            {
                for (int x = 0; x < 64; x++)
                {
                    float noise = Mathf.PerlinNoise(x * 0.15f, y * 0.15f);
                    float r = Mathf.Lerp(0.18f, 0.35f, noise);
                    float g = Mathf.Lerp(0.42f, 0.62f, noise);
                    float b = Mathf.Lerp(0.08f, 0.18f, noise);
                    tex.SetPixel(x, y, new Color(r, g, b));
                }
            }
            tex.Apply();
            tex.wrapMode = TextureWrapMode.Repeat;
            return tex;
        }

        /// <summary>URP/Standard materyal oluşturucu.</summary>
        public static Material CreateMaterial(Color color)
        {
            var shader = Shader.Find("Universal Render Pipeline/Lit");
            if (shader == null) shader = Shader.Find("Standard");
            if (shader == null) shader = Shader.Find("Sprites/Default");
            var mat = new Material(shader);
            if (mat.HasProperty("_BaseColor"))
                mat.SetColor("_BaseColor", color);
            else
                mat.color = color;
            return mat;
        }

        /// <summary>
        /// Texture'ın gerçekten saydam pikselleri olup olmadığını kontrol eder.
        /// Hızlı örnekleme: tüm pikselleri değil, grid bazlı örnek noktaları kontrol eder.
        /// Alpha < 250 olan piksel varsa true döner.
        /// </summary>
        private static bool HasTransparentPixels(Texture2D tex)
        {
            if (tex == null) return false;
            
            try
            {
                var pixels = tex.GetPixels32();
                // Hızlı örnekleme: her 16. pikseli kontrol et
                int step = Mathf.Max(1, pixels.Length / 256);
                for (int i = 0; i < pixels.Length; i += step)
                {
                    if (pixels[i].a < 250)
                        return true;
                }
                return false;
            }
            catch
            {
                return false;
            }
        }

