        /// <summary>
        /// Verilen dünya koordinatındaki terrain + collision yüksekliğini döndürür.
        /// KOCollisionManager varsa kombine yükseklik (max terrain, collision) kullanılır.
        /// </summary>
        public float GetTerrainHeight(float x, float z)
        {
            if (IsIndoor)
            {
                if (KOCollisionManager.Instance != null)
                    return KOCollisionManager.Instance.GetHeight(x, z);
                return 0f;
            }

            // OPD collision sistemi aktifse kombine yükseklik kullan
            if (KOCollisionManager.Instance != null)
                return KOCollisionManager.Instance.GetCombinedHeight(x, z, _terrain);

            // Fallback: sadece terrain
            if (_terrain != null)
                return _terrain.transform.position.y + _terrain.SampleHeight(new Vector3(x, 0, z));

            return 0f;
        }

