        /// <summary>C++ m_bIndoor — Zindan veya kapalı alan mı?</summary>
        public bool IsIndoor { get; private set; }

        public static bool IsIndoorZone(int zoneId)
        {
            // C++ birebir: N3WorldManager.cpp:39-52 — Sadece Zone 51 CDungeonManager (Indoor) olarak yüklenir
            return zoneId == 51;
        }

        /// <summary>
        /// Zone değiştiğinde çağrılır — mevcut terrain'i yıkıp yenisini yükler.
        /// </summary>
        public void ChangeZone(short newZoneId)
        {
            _currentZoneId = newZoneId;
            IsIndoor = IsIndoorZone(newZoneId);

            // Mevcut terrain'i kaldır
            if (_terrain != null)
            {
                Destroy(_terrain.gameObject);
                _terrain = null;
            }

            // Mevcut objeleri kaldır
            if (_objectsParent != null)
                Destroy(_objectsParent);

            // Mevcut zone ışıklarını kaldır
            var oldLights = transform.Find("ZoneLights");
            if (oldLights != null)
                Destroy(oldLights.gameObject);

            // Mevcut su sistemini kaldır — zone değişiminde eski zone'un suyu kalıyordu
            var oldWater = transform.Find("WaterSystem");
            if (oldWater != null)
                Destroy(oldWater.gameObject);

            // Mevcut collision manager'ı kaldır
            var oldCollision = transform.Find("KOCollisionManager");
            if (oldCollision != null)
                Destroy(oldCollision.gameObject);

            // Mesh cache temizle
            N3PMeshImporter.ClearCache();

            // Convert edilmiş zone asset'i dene
            _currentZoneAsset = Resources.Load<KOZoneAsset>($"KOZones/zone_{newZoneId}");
            if (_currentZoneAsset != null)
            {
                Debug.Log($"[WORLD] ✅ Convert edilmiş zone asset bulundu: zone_{newZoneId}");
                LoadConvertedZone(_currentZoneAsset);
            }
            else
            {
                Debug.Log($"[WORLD] Convert edilmiş asset yok, runtime parse kullanılıyor (zone={newZoneId})");
                if (!IsIndoor)
                {
                    LoadTerrain();
                }
                else
                {
                    Debug.Log($"[WORLD] Dungeon zone (indoor) tespit edildi, terrain yüklemesi atlanıyor.");
                }
                LoadObjects();
                LoadZoneLights();
                CreateSkyAndFog();
            }

            LoadZoneEventFile(newZoneId);

            Debug.Log($"[WORLD] Zone değiştirildi → {newZoneId} (Indoor={IsIndoor})");
        }

        private void LoadZoneEventFile(short zoneId)
        {
            if (KOEventManager.Instance == null)
            {
                var evtObj = new GameObject("KOEventManager");
                evtObj.transform.SetParent(transform, false);
                evtObj.AddComponent<KOEventManager>();
            }

            var zoneInfo = KOZoneMapper.GetZoneInfo(zoneId);
            if (zoneInfo == null)
            {
                KOEventManager.Instance.Release();
                return;
            }

            string gtdFile = zoneInfo.GtdFile;
            if (string.IsNullOrEmpty(gtdFile))
            {
                KOEventManager.Instance.Release();
                return;
            }

            string baseName = System.IO.Path.GetFileNameWithoutExtension(gtdFile);
            string gevFileName = $"Zones/{baseName}.gev";

            KOEventManager.Instance.LoadFromFile(gevFileName);
        }

