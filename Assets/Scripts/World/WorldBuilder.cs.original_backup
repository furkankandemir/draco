        private void LoadTerrain()
        {
            // 1. KO asset'inden gerçek terrain dene
            string gtdPath = KOZoneMapper.GetGtdPath(_currentZoneId);

            if (gtdPath != null && KOBinaryProvider.Exists(gtdPath))
            {
                LoadKOTerrain(gtdPath);
            }
            else
            {
                Debug.LogWarning($"[WORLD] GTD bulunamadı (zone={_currentZoneId}), " +
                    $"prosedürel terrain kullanılıyor. Path: {gtdPath}");
                CreateFallbackTerrain();
            }
        }

        private void LoadKOTerrain(string gtdPath)
        {
            Debug.Log($"[WORLD] KO terrain yükleniyor: {gtdPath}");

            var gtdData = GtdTerrainImporter.Parse(gtdPath);
            if (gtdData == null)
            {
                Debug.LogError("[WORLD] GTD parse başarısız, fallback kullanılıyor.");
                CreateFallbackTerrain();
                return;
            }

            var terrainData = GtdTerrainImporter.CreateTerrainData(gtdData);
            if (terrainData == null)
            {
                CreateFallbackTerrain();
                return;
            }

            // Terrain GameObject oluştur
            var terrainObj = Terrain.CreateTerrainGameObject(terrainData);
            terrainObj.name = $"KOTerrain_{_currentZoneId}";
            _terrain = terrainObj.GetComponent<Terrain>();
            _terrainWorldSize = gtdData.WorldSize;

            // Terrain rendering ayarları
            _terrain.basemapDistance = 100000f; // Basemap'e hiç geçiş yapma (siyah patch önleme)
            _terrain.drawInstanced = true;
            _terrain.heightmapPixelError = 5f; // LOD kalitesi
            _terrain.reflectionProbeUsage = UnityEngine.Rendering.ReflectionProbeUsage.Off; // Yansıma kapat
            // KO koordinat sistemi: terrain.position.y = minHeight - 1
            // Bu sayede world Y = KO Y (objeler ve terrain aynı koordinat uzayında)
            terrainObj.transform.position = new Vector3(0, GtdTerrainImporter.LastTerrainBaseY, 0);

            // TerrainCollider
            var collider = terrainObj.GetComponent<TerrainCollider>();
            if (collider != null) collider.terrainData = terrainData;

            // Fog kapalı — terrain üzerinde yarı saydam kaplama oluşturuyordu
            RenderSettings.fog = false;

            // ============================================
            // TILE TEXTURE SİSTEMİ
            // ============================================
            // KO terrain rendering: per-cell tile texture + colormap modulate
            // Unity port: tile texture'ları TerrainLayer olarak ekle, splatmap paint et
            ApplyTileTextures(terrainData, gtdData);

            Debug.Log($"[WORLD] ✅ KO terrain yüklendi: {gtdData.MapName} " +
                      $"({gtdData.MapSize}x{gtdData.MapSize}, {_terrainWorldSize:F0}m)");

            // River/Pond su render sistemi
            if (gtdData.Rivers.Count > 0 || gtdData.Ponds.Count > 0)
            {
                var waterObj = new GameObject("WaterSystem");
                waterObj.transform.SetParent(transform, false);
                var waterRenderer = waterObj.AddComponent<WaterRenderer>();
                waterRenderer.Initialize(gtdData);
            }
        }

        /// <summary>
        /// KO tile texture'larını tek bir composite texture'a bake eder.
        /// Her hücrenin Tex1Idx'ine göre ilgili tile texture'dan sample alınır
        /// ve büyük bir terrain texture'ına yazılır. Sonuç: 1 TerrainLayer.
        /// </summary>
        private void ApplyTileTextures(TerrainData terrainData, GtdTerrainImporter.GtdData gtdData)
        {
            Debug.Log($"[TILE-DIAG] ApplyTileTextures ENTERED — " +
                      $"TileTextures={(gtdData.TileTextures?.Count ?? -1)}, " +
                      $"TileTexSources={(gtdData.TileTexSources?.Count ?? -1)}, " +
                      $"CellData={(gtdData.CellData != null ? "YES" : "NULL")}");

            bool hasTileData = gtdData.TileTextures != null && gtdData.TileTextures.Count > 0
                            && gtdData.TileTexSources != null && gtdData.TileTexSources.Count > 0
                            && gtdData.CellData != null;

            if (!hasTileData)
            {
                Debug.LogWarning("[TILE] Tile texture verisi yok, colormap fallback kullanılıyor");
                ApplyColormapFallback(terrainData, gtdData);
                return;
            }

            int mapSize = gtdData.MapSize;       // e.g. 1025
            int maxTileIdx = gtdData.TileTextures.Count;
            int cellCount = mapSize - 1;         // e.g. 1024

            // ============================================
            // STEP 1: Colormap'i base layer olarak yükle
            // Open-KO birebir: N3TerrainPatch.cpp:251-254
            //   if (Tex1Idx >= TileTextureCount || !bIsTileFull)
            //       → colormap kullanılır
            // ============================================
            Texture2D colormapTex = null;
            var zoneInfo = KOZoneMapper.GetZoneInfo(_currentZoneId);
            if (zoneInfo != null && !string.IsNullOrEmpty(zoneInfo.DxtFile))
            {
                string dxtPath = System.IO.Path.Combine("", "Zones", zoneInfo.DxtFile);
                colormapTex = KOTextureProvider.Load(dxtPath);
            }

            // ============================================
            // STEP 2: Kullanılan unique tile texture'ları GTT'den yükle
            // Open-KO birebir: CN3Terrain::LoadTileInfo (N3Terrain.cpp:524-596)
            // ============================================
            var tileCache = new System.Collections.Generic.Dictionary<int, Texture2D>();

            for (int x = 0; x < mapSize; x++)
                for (int z = 0; z < mapSize; z++)
                {
                    var cell = gtdData.CellData[x, z];
                    // Open-KO birebir: sadece IsTileFull=true VE valid Tex1Idx olan cell'ler tile kullanır
                    if (!cell.IsTileFull) continue;
                    int idx = cell.Tex1Idx;
                    if (idx < 0 || idx >= maxTileIdx) continue;
                    if (tileCache.ContainsKey(idx)) continue;

                    var info = gtdData.TileTextures[idx];
                    if (info.SrcIdx >= 0 && info.SrcIdx < gtdData.TileTexSources.Count)
                    {
                        string gttRel = gtdData.TileTexSources[info.SrcIdx]
                            .Replace('/', System.IO.Path.DirectorySeparatorChar)
                            .Replace('\\', System.IO.Path.DirectorySeparatorChar);
                        string gttFull = System.IO.Path.Combine("", gttRel);
                        Texture2D tex = GttTextureImporter.LoadTile(gttFull, info.TileIdx);
                        tileCache[idx] = tex;
                    }

                    // C++ birebir: Tex2 tile texture'ı da yükle
                    int idx2 = cell.Tex2Idx;
                    if (idx2 >= 0 && idx2 < maxTileIdx && !tileCache.ContainsKey(idx2))
                    {
                        var info2 = gtdData.TileTextures[idx2];
                        if (info2.SrcIdx >= 0 && info2.SrcIdx < gtdData.TileTexSources.Count)
                        {
                            string gttRel2 = gtdData.TileTexSources[info2.SrcIdx]
                                .Replace('/', System.IO.Path.DirectorySeparatorChar)
                                .Replace('\\', System.IO.Path.DirectorySeparatorChar);
                            string gttFull2 = System.IO.Path.Combine("", gttRel2);
                            Texture2D tex2 = GttTextureImporter.LoadTile(gttFull2, info2.TileIdx);
                            tileCache[idx2] = tex2;
                        }
                    }
                }

            // DIAGNOSTIC: Tile texture boyutlarını ve dir dağılımını logla
            int[] dirCounts = new int[8];
            int tileFull = 0, tileNotFull = 0, tileNoIdx = 0;
            foreach (var kv in tileCache)
            {
                if (kv.Value != null)
                    Debug.Log($"[TILE-DIAG] TileCache[{kv.Key}] = {kv.Value.width}x{kv.Value.height}");
            }
            for (int dx = 0; dx < cellCount; dx++)
                for (int dz = 0; dz < cellCount; dz++)
                {
                    var dc = gtdData.CellData[dx, dz];
                    if (dc.IsTileFull && dc.Tex1Idx >= 0 && dc.Tex1Idx < maxTileIdx)
                    {
                        tileFull++;
                        int d = dc.Tex1Dir;
                        if (d >= 0 && d < 8) dirCounts[d]++;
                    }
                    else if (!dc.IsTileFull) tileNotFull++;
                    else tileNoIdx++;
                }
            Debug.Log($"[TILE-DIAG] Cells: tileFull={tileFull}, notFull={tileNotFull}, noIdx={tileNoIdx}");
            Debug.Log($"[TILE-DIAG] Tex1Dir distribution: " +
                      $"0={dirCounts[0]} 1={dirCounts[1]} 2={dirCounts[2]} 3={dirCounts[3]} " +
                      $"4={dirCounts[4]} 5={dirCounts[5]} 6={dirCounts[6]} 7={dirCounts[7]}");

            Debug.Log($"[TILE] {tileCache.Count} benzersiz tile texture yüklendi " +
                      $"(toplam {maxTileIdx} tanımlı, {gtdData.TileTexSources.Count} GTT kaynak), " +
                      $"colormap={(colormapTex != null ? $"{colormapTex.width}x{colormapTex.height}" : "yok")}");

            // ============================================
            // STEP 3: Composite texture oluştur
            // ============================================
            // GPU'nun desteklediği max texture boyutunu kullan (çoğu modern GPU: 16384)
            int maxTexSize = Mathf.Min(16384, SystemInfo.maxTextureSize);
            int pixPerCell = Mathf.Max(1, maxTexSize / cellCount);
            int compositeSize = cellCount * pixPerCell;
            if (compositeSize > maxTexSize) { compositeSize = maxTexSize; pixPerCell = compositeSize / cellCount; }
            if (pixPerCell < 1) pixPerCell = 1;
            compositeSize = cellCount * pixPerCell;

            Debug.Log($"[TILE] Composite texture: {compositeSize}x{compositeSize} ({pixPerCell}px/cell), GPU max: {SystemInfo.maxTextureSize}");

            var composite = new Texture2D(compositeSize, compositeSize, TextureFormat.RGBA32, true); // mipmap=true
            var pixels = new Color32[compositeSize * compositeSize];

            // Base: colormap'ten doldur (varsa)
            Color32[] cmPixels = null;
            int cmW = 0, cmH = 0;
            if (colormapTex != null)
            {
                cmPixels = colormapTex.GetPixels32();
                cmW = colormapTex.width;
                cmH = colormapTex.height;
            }
            var fallbackColor = new Color32(80, 100, 60, 255);

            // Tüm pixel'leri colormap'ten sample al
            for (int py = 0; py < compositeSize; py++)
            {
                for (int px = 0; px < compositeSize; px++)
                {
                    if (cmPixels != null)
                    {
                        float u = (float)px / compositeSize;
                        float v = (float)py / compositeSize;
                        int cx2 = Mathf.Clamp((int)(u * cmW), 0, cmW - 1);
                        int cy2 = Mathf.Clamp((int)(v * cmH), 0, cmH - 1);
                        var c = cmPixels[cy2 * cmW + cx2];
                        c.a = 255;
                        pixels[py * compositeSize + px] = c;
                    }
                    else
                    {
                        pixels[py * compositeSize + px] = fallbackColor;
                    }
                }
            }

            // ============================================
            // STEP 4: Open-KO birebir TileDirU/TileDirV tablosu
            // LyTerrain.cpp:118-157 — _KNIGHT variant
            // 8 yön × 4 köşe [LT, RT, LB, RB]
            // ============================================
            float[,] tileDirU = new float[8, 4]
            {
                { 0f, 1f, 0f, 1f },  // 0: up
                { 0f, 0f, 1f, 1f },  // 1: right (90° CW)
                { 1f, 0f, 1f, 0f },  // 2: bottom (180°)
                { 1f, 1f, 0f, 0f },  // 3: left (270° CW)
                { 1f, 0f, 1f, 0f },  // 4: up_mirror
                { 0f, 0f, 1f, 1f },  // 5: right_mirror
                { 0f, 1f, 0f, 1f },  // 6: bottom_mirror
                { 1f, 1f, 0f, 0f },  // 7: left_mirror
            };
            float[,] tileDirV = new float[8, 4]
            {
                { 0f, 0f, 1f, 1f },  // 0: up
                { 1f, 0f, 1f, 0f },  // 1: right
                { 1f, 1f, 0f, 0f },  // 2: bottom
                { 0f, 1f, 0f, 1f },  // 3: left
                { 0f, 0f, 1f, 1f },  // 4: up_mirror
                { 0f, 1f, 0f, 1f },  // 5: right_mirror
                { 1f, 1f, 0f, 0f },  // 6: bottom_mirror
                { 1f, 0f, 1f, 0f },  // 7: left_mirror
            };

            // ============================================
            // STEP 5: Tile texture'ları colormap üzerine overlay et
            // ============================================
            int tileOverlayCount = 0;
            for (int cx = 0; cx < cellCount; cx++)
            {
                for (int cz = 0; cz < cellCount; cz++)
                {
                    var cell = gtdData.CellData[cx, cz];
                    if (!cell.IsTileFull) continue;
                    int tex1Idx = cell.Tex1Idx;
                    if (tex1Idx < 0 || tex1Idx >= maxTileIdx) continue;

                    Texture2D tileTex = null;
                    tileCache.TryGetValue(tex1Idx, out tileTex);
                    if (tileTex == null) continue;

                    int tex1Dir = cell.Tex1Dir;
                    if (tex1Dir < 0 || tex1Dir > 7) tex1Dir = 0;

                    int tw = tileTex.width;
                    int th = tileTex.height;
                    var tilePixels = tileTex.GetPixels32();

                    int startX = cx * pixPerCell;
                    int startY = cz * pixPerCell;

                    float uLB = tileDirU[tex1Dir, 2], uRB = tileDirU[tex1Dir, 3];
                    float uLT = tileDirU[tex1Dir, 0], uRT = tileDirU[tex1Dir, 1];
                    float vLB = tileDirV[tex1Dir, 2], vRB = tileDirV[tex1Dir, 3];
                    float vLT = tileDirV[tex1Dir, 0], vRT = tileDirV[tex1Dir, 1];

                    // Tex2 ADD blending
                    int tex2Idx = cell.Tex2Idx;
                    int tex2Dir = cell.Tex2Dir;
                    Texture2D tileTex2 = null;
                    Color32[] tilePixels2 = null;
                    int tw2 = 0, th2 = 0;
                    bool hasTex2 = (tex2Idx >= 0 && tex2Idx < maxTileIdx);
                    if (hasTex2)
                    {
                        tileCache.TryGetValue(tex2Idx, out tileTex2);
                        if (tileTex2 != null)
                        {
                            tw2 = tileTex2.width;
                            th2 = tileTex2.height;
                            tilePixels2 = tileTex2.GetPixels32();
                            if (tex2Dir < 0 || tex2Dir > 7) tex2Dir = 0;
                        }
                        else hasTex2 = false;
                    }

                    float u2LB = 0, u2RB = 0, u2LT = 0, u2RT = 0;
                    float v2LB = 0, v2RB = 0, v2LT = 0, v2RT = 0;
                    if (hasTex2)
                    {
                        u2LB = tileDirU[tex2Dir, 2]; u2RB = tileDirU[tex2Dir, 3];
                        u2LT = tileDirU[tex2Dir, 0]; u2RT = tileDirU[tex2Dir, 1];
                        v2LB = tileDirV[tex2Dir, 2]; v2RB = tileDirV[tex2Dir, 3];
                        v2LT = tileDirV[tex2Dir, 0]; v2RT = tileDirV[tex2Dir, 1];
                    }

                    for (int py = 0; py < pixPerCell; py++)
                    {
                        float t = (float)py / pixPerCell;
                        for (int px = 0; px < pixPerCell; px++)
                        {
                            float s = (float)px / pixPerCell;

                            float u = (1f - s) * (1f - t) * uLB + s * (1f - t) * uRB
                                    + (1f - s) * t * uLT + s * t * uRT;
                            float v = (1f - s) * (1f - t) * vLB + s * (1f - t) * vRB
                                    + (1f - s) * t * vLT + s * t * vRT;

                            int txS = Mathf.Clamp((int)(u * tw), 0, tw - 1);
                            int tyS = Mathf.Clamp((int)(v * th), 0, th - 1);

                            int compIdx = (startY + py) * compositeSize + (startX + px);
                            int tileIdx1 = tyS * tw + txS;
                            if (compIdx < pixels.Length && tileIdx1 < tilePixels.Length)
                            {
                                var c1 = tilePixels[tileIdx1];

                                if (hasTex2)
                                {
                                    float u2 = (1f - s) * (1f - t) * u2LB + s * (1f - t) * u2RB
                                             + (1f - s) * t * u2LT + s * t * u2RT;
                                    float v2 = (1f - s) * (1f - t) * v2LB + s * (1f - t) * v2RB
                                             + (1f - s) * t * v2LT + s * t * v2RT;
                                    int tx2S = Mathf.Clamp((int)(u2 * tw2), 0, tw2 - 1);
                                    int ty2S = Mathf.Clamp((int)(v2 * th2), 0, th2 - 1);
                                    int tileIdx2 = ty2S * tw2 + tx2S;
                                    if (tileIdx2 < tilePixels2.Length)
                                    {
                                        var c2 = tilePixels2[tileIdx2];
                                        byte r = (byte)Mathf.Min(c1.r + c2.r, 255);
                                        byte g = (byte)Mathf.Min(c1.g + c2.g, 255);
                                        byte b = (byte)Mathf.Min(c1.b + c2.b, 255);
                                        pixels[compIdx] = new Color32(r, g, b, 255);
                                    }
                                    else if (c1.a > 0)
                                    {
                                        c1.a = 255;
                                        pixels[compIdx] = c1;
                                    }
                                }
                                else
                                {
                                    if (c1.a > 0)
                                    {
                                        c1.a = 255;
                                        pixels[compIdx] = c1;
                                    }
                                }
                            }
                        }
                    }
                    tileOverlayCount++;
                }
            }

            composite.SetPixels32(pixels);
            composite.Apply(true, false);  // mipmap generate
            composite.Compress(true);  // DXT sıkıştırma — VRAM tasarrufu (~4x küçültme)
            composite.Apply(true, true);  // mipmap yeniden oluştur + CPU kopyasını serbest bırak
            composite.wrapMode = TextureWrapMode.Clamp;
            composite.filterMode = FilterMode.Trilinear;
            composite.anisoLevel = 8;

            // Tek TerrainLayer olarak uygula
            var layers = new TerrainLayer[1];
            layers[0] = new TerrainLayer();
            layers[0].diffuseTexture = composite;
            layers[0].tileSize = new Vector2(gtdData.WorldSize, gtdData.WorldSize);
            layers[0].smoothness = 0f;
            layers[0].metallic = 0f;
            terrainData.terrainLayers = layers;

            // Resolution'ları ayarla
            terrainData.alphamapResolution = 512;
            terrainData.baseMapResolution = 4096;
            int alphaRes = terrainData.alphamapResolution;
            float[,,] alphamap = new float[alphaRes, alphaRes, 1];
            for (int ay = 0; ay < alphaRes; ay++)
                for (int ax = 0; ax < alphaRes; ax++)
                    alphamap[ay, ax, 0] = 1f;
            terrainData.SetAlphamaps(0, 0, alphamap);

            // Tile texture cache temizle
            foreach (var kv in tileCache)
                if (kv.Value != null) DestroyImmediate(kv.Value, true);
            tileCache.Clear();
            if (colormapTex != null) DestroyImmediate(colormapTex, true);

            Debug.Log($"[TILE] ✅ Composite terrain texture uygulandı: {compositeSize}x{compositeSize}, " +
                      $"{pixPerCell}px/cell, tile overlay: {tileOverlayCount}/{cellCount * cellCount} cells");
        }

        /// <summary>
        /// Tile texture verisi yoksa DXT colormap ile fallback.
        /// </summary>
        private void ApplyColormapFallback(TerrainData terrainData, GtdTerrainImporter.GtdData gtdData)
        {
            var zoneInfo = KOZoneMapper.GetZoneInfo(_currentZoneId);
            if (zoneInfo == null || string.IsNullOrEmpty(zoneInfo.DxtFile))
                return;

            string dxtPath = System.IO.Path.Combine("", "Zones", zoneInfo.DxtFile);
            var colormap = KOTextureProvider.Load(dxtPath);
            if (colormap == null) return;

            var layers = new TerrainLayer[1];
            layers[0] = new TerrainLayer();
            layers[0].diffuseTexture = colormap;
            layers[0].tileSize = new Vector2(gtdData.WorldSize, gtdData.WorldSize);
            layers[0].smoothness = 0f;
            layers[0].metallic = 0f;
            terrainData.terrainLayers = layers;

            int alphaRes = terrainData.alphamapResolution;
            float[,,] alphamap = new float[alphaRes, alphaRes, 1];
            for (int ay = 0; ay < alphaRes; ay++)
                for (int ax = 0; ax < alphaRes; ax++)
                    alphamap[ay, ax, 0] = 1f;
            terrainData.SetAlphamaps(0, 0, alphamap);

            Debug.Log($"[TILE] Colormap fallback uygulandı: {zoneInfo.DxtFile}");
        }

        private void CreateFallbackTerrain()
        {
            var terrainData = new TerrainData();
            terrainData.heightmapResolution = 257;
            terrainData.size = new Vector3(fallbackTerrainSize, fallbackTerrainHeight, fallbackTerrainSize);

            float[,] heights = new float[257, 257];
            for (int y = 0; y < 257; y++)
            {
                for (int x = 0; x < 257; x++)
                {
                    float nx = (float)x / 257;
                    float ny = (float)y / 257;
                    float h = Mathf.PerlinNoise(nx * 3f + 0.5f, ny * 3f + 0.5f) * 0.3f;
                    h += Mathf.PerlinNoise(nx * 8f + 1.3f, ny * 8f + 2.7f) * 0.1f;

                    float distToCenter = Vector2.Distance(new Vector2(nx, ny), new Vector2(0.5f, 0.5f));
                    h *= Mathf.Clamp01(distToCenter * 3f - 0.3f);
                    heights[y, x] = Mathf.Clamp01(h);
                }
            }
            terrainData.SetHeights(0, 0, heights);

            var layers = new TerrainLayer[1];
            layers[0] = new TerrainLayer();
            layers[0].diffuseTexture = CreateGrassTexture();
            layers[0].tileSize = new Vector2(8, 8);
            terrainData.terrainLayers = layers;

            var terrainObj = Terrain.CreateTerrainGameObject(terrainData);
            terrainObj.name = "FallbackTerrain";
            _terrain = terrainObj.GetComponent<Terrain>();
            _terrainWorldSize = fallbackTerrainSize;

            var collider = terrainObj.GetComponent<TerrainCollider>();
            if (collider != null) collider.terrainData = terrainData;
        }

        // ============================
        // OPD OBJE YERLEŞİMİ
        // ============================

        private void LoadObjects()
        {
            var zoneInfo = KOZoneMapper.GetZoneInfo(_currentZoneId);
            if (zoneInfo == null)
            {
                Debug.LogError($"[WORLD] ZoneInfo bulunamadı (zone={_currentZoneId})!");
                return;
            }

            string opdPath = System.IO.Path.Combine("", "Zones", zoneInfo.OpdFile);
            Debug.Log($"[WORLD] OPD yükleniyor: {opdPath} (exists={KOBinaryProvider.Exists(opdPath)})");

            if (!KOBinaryProvider.Exists(opdPath))
            {
                Debug.LogError($"[WORLD] OPD bulunamadı: {opdPath}");
                return;
            }

            // Tam N3Shape parse (collision + tüm shape'ler)
            N3ShapeParser.OpdFullData opdFull = null;
            try
            {
                opdFull = N3ShapeParser.ParseFull(opdPath);
            }
            catch (System.Exception ex)
            {
                Debug.LogError($"[WORLD] OPD parse exception: {ex.Message}\n{ex.StackTrace}");
            }

            if (opdFull == null || opdFull.Shapes.Count == 0)
            {
                Debug.LogWarning($"[WORLD] OPD parse başarısız veya shape yok (opdFull={opdFull != null}, shapes={opdFull?.Shapes?.Count ?? 0}), fallback kullanılıyor.");
                LoadObjectsFallback(opdPath);
                return;
            }

            // Try loading PVS for indoor zone
            string pvsPath = System.IO.Path.Combine("", "Zones", System.IO.Path.GetFileNameWithoutExtension(zoneInfo.GtdFile) + ".pvs");
            bool usePvs = false;
            if (KOBinaryProvider.Exists(pvsPath))
            {
                Debug.Log($"[WORLD] PVS dosyası bulundu: {pvsPath}, yükleniyor...");
                _pvsManager = new KOPvsManager();
                try
                {
                    using (var pvsReader = KOBinaryProvider.OpenReader(pvsPath))
                    {
                        if (pvsReader != null)
                        {
                            usePvs = _pvsManager.Load(pvsReader);
                        }
                    }
                }
                catch (System.Exception ex)
                {
                    Debug.LogError($"[WORLD] PVS parse exception: {ex.Message}\n{ex.StackTrace}");
                    _pvsManager = null;
                    usePvs = false;
                }
            }

            _objectsParent = new GameObject("KOObjects");
            int placed = 0;

            _meshLoaded = 0; _meshFailed = 0; _texLoaded = 0;

            if (usePvs)
            {
                // Instantiate shapes using PVS global shape list
                foreach (var pSI in KOPvsManager.s_plShapeInfoList)
                {
                    string shapePath = pSI.ShapeFile;
                    shapePath = shapePath.Replace('\\', '/');

                    N3ShapeParser.N3ShapeData shapeData = null;
                    try
                    {
                        shapeData = N3ShapeParser.ParseShapeFile(shapePath);
                    }
                    catch (System.Exception ex)
                    {
                        Debug.LogError($"[WORLD] PVS Shape parse exception: {ex.Message} for file: {shapePath}");
                    }

                    if (shapeData == null)
                    {
                        Debug.LogWarning($"[WORLD] PVS Shape parse failed: {shapePath}, skipping.");
                        continue;
                    }

                    var shapeObj = new GameObject(string.IsNullOrEmpty(pSI.Name) ? $"Shape_{placed}" : pSI.Name);
                    shapeObj.transform.SetParent(_objectsParent.transform);
                    shapeObj.transform.position = pSI.Position;
                    shapeObj.transform.rotation = pSI.Rotation;
                    shapeObj.transform.localScale = pSI.Scale;

                    if (shapeData.Parts != null && shapeData.Parts.Count > 0)
                    {
                        foreach (var part in shapeData.Parts)
                        {
                            CreatePartObject(shapeObj.transform, part, placed);
                        }
                    }
                    else
                    {
                        var cube = GameObject.CreatePrimitive(PrimitiveType.Cube);
                        cube.name = "NoPartPlaceholder";
                        cube.transform.SetParent(shapeObj.transform);
                        cube.transform.localPosition = Vector3.zero;
                        cube.transform.localScale = Vector3.one * 2f;
                        cube.GetComponent<Renderer>().material = CreateMaterial(new Color(0.5f, 0.45f, 0.4f));
                    }

                    // Populate SpawnedGameObjects in pSI
                    pSI.SpawnedGameObjects.Clear();
                    if (shapeData.Parts != null)
                    {
                        for (int p = 0; p < shapeData.Parts.Count; p++)
                        {
                            if (p < shapeObj.transform.childCount)
                            {
                                var childGo = shapeObj.transform.GetChild(p).gameObject;
                                pSI.SpawnedGameObjects.Add(childGo);
                                _pvsManager.RegisterSpawnedObject(childGo);
                            }
                        }
                    }

                    if (pSI.EventID != 0)
                    {
                        var worldEvent = shapeObj.AddComponent<KOWorldEvent>();
                        worldEvent.EventID = pSI.EventID;
                        worldEvent.EventType = pSI.EventType;
                        worldEvent.NPC_ID = pSI.NPC_ID;

                        var meshFilters = shapeObj.GetComponentsInChildren<MeshFilter>();
                        foreach (var mfEvt in meshFilters)
                        {
                            if (mfEvt.sharedMesh != null)
                            {
                                var mc = mfEvt.gameObject.AddComponent<MeshCollider>();
                                mc.sharedMesh = mfEvt.sharedMesh;
                                mc.convex = false;
                            }
                        }
                    }

                    placed++;
                }

                var player = GameObject.FindGameObjectWithTag("Player") ?? GameObject.Find("Player");
                if (player != null)
                {
                    _pvsManager.Tick(player.transform.position, true);
                }

                Debug.Log($"[WORLD] ✅ {placed} shapes yerleştirildi (PVS ile)");
            }
            else
            {
                // Standard OPD shape loading
                foreach (var shape in opdFull.Shapes)
                {
                    var t = shape.Transform;
                    if (t == null) continue;

                    // Sıfır pozisyonlu shape'leri atla
                    if (t.Position.sqrMagnitude < 0.001f) continue;

                    // Shape GameObject oluştur
                    var shapeObj = new GameObject(
                        string.IsNullOrEmpty(t.Name) ? $"Shape_{placed}" : t.Name);
                    shapeObj.transform.SetParent(_objectsParent.transform);

                    // KO koordinat sistemi birebir — terrain de aynı uzayda
                    shapeObj.transform.position = t.Position;

                    // KO quaternion → Unity quaternion
                    if (t.Rotation.w != 0 || t.Rotation.x != 0 ||
                        t.Rotation.y != 0 || t.Rotation.z != 0)
                    {
                        shapeObj.transform.rotation = t.Rotation;
                    }

                    shapeObj.transform.localScale = t.Scale;

                    // 🔍 SHAPE DUMP: Tüm shape verilerini CSV dosyasına yaz (ilk 100)
                    if (placed == 0)
                    {
                        float tBaseY = _terrain != null ? _terrain.transform.position.y : float.NaN;
                        Debug.Log($"[DIAG] TerrainBaseY={tBaseY.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)} " +
                                  $"TerrainSize={(_terrain != null ? _terrain.terrainData.size.ToString() : "N/A")}");
                        _shapeDumpPath = System.IO.Path.Combine(Application.persistentDataPath, "shape_dump.csv");
                        try
                        {
                            System.IO.File.WriteAllText(_shapeDumpPath,
                                "idx|name|px|py|pz|qx|qy|qz|qw|sx|sy|sz|terrainY|diffY|parts\n");
                            Debug.Log($"[DIAG] Shape dump dosyası: {_shapeDumpPath}");
                        }
                        catch { _shapeDumpPath = null; }
                    }
                    if (_shapeDumpPath != null && placed < 3000)
                    {
                        var ci = System.Globalization.CultureInfo.InvariantCulture;
                        float tw = _terrain != null
                            ? _terrain.SampleHeight(t.Position) + _terrain.transform.position.y : 0f;
                        float dy = t.Position.y - tw;
                        string line = string.Format(ci,
                            "{0}|{1}|{2:F3}|{3:F3}|{4:F3}|{5:F5}|{6:F5}|{7:F5}|{8:F5}|{9:F3}|{10:F3}|{11:F3}|{12:F3}|{13:F3}|{14}\n",
                            placed, t.Name ?? "",
                            t.Position.x, t.Position.y, t.Position.z,
                            t.Rotation.x, t.Rotation.y, t.Rotation.z, t.Rotation.w,
                            t.Scale.x, t.Scale.y, t.Scale.z,
                            tw, dy, shape.Parts?.Count ?? 0);
                        try { System.IO.File.AppendAllText(_shapeDumpPath, line); } catch { }
                    }

                    // Her part için child mesh oluştur
                    if (shape.Parts != null && shape.Parts.Count > 0)
                    {
                        foreach (var part in shape.Parts)
                        {
                            CreatePartObject(shapeObj.transform, part, placed);
                        }
                    }
                    else
                    {
                        // Part yoksa basit küp placeholder
                        var cube = GameObject.CreatePrimitive(PrimitiveType.Cube);
                        cube.name = "NoPartPlaceholder";
                        cube.transform.SetParent(shapeObj.transform);
                        cube.transform.localPosition = Vector3.zero;
                        cube.transform.localScale = Vector3.one * 2f;
                        cube.GetComponent<Renderer>().material = CreateMaterial(
                            new Color(0.5f, 0.45f, 0.4f));
                    }

                    if (shape.EventID != 0)
                    {
                        var worldEvent = shapeObj.AddComponent<KOWorldEvent>();
                        worldEvent.EventID = shape.EventID;
                        worldEvent.EventType = shape.EventType;
                        worldEvent.NPC_ID = shape.NPC_ID;

                        // MeshCollider ekle — raycast ile tıklanabilir olması için
                        // Child mesh'lerden birini kullan
                        var meshFilters = shapeObj.GetComponentsInChildren<MeshFilter>();
                        foreach (var mfEvt in meshFilters)
                        {
                            if (mfEvt.sharedMesh != null)
                            {
                                var mc = mfEvt.gameObject.AddComponent<MeshCollider>();
                                mc.sharedMesh = mfEvt.sharedMesh;
                                mc.convex = false;
                            }
                        }

                        Debug.Log($"[WORLD] Event shape: {t.Name} EventID={shape.EventID} " +
                                  $"EventType={shape.EventType} NPC_ID={shape.NPC_ID} " +
                                  $"pos=({t.Position.x:F1},{t.Position.y:F1},{t.Position.z:F1})");
                    }

                    placed++;
                }

                Debug.Log($"[WORLD] ✅ {placed} shape yerleştirildi — " +
                          $"mesh: {_meshLoaded} yüklendi, {_meshFailed} placeholder, " +
                          $"texture: {_texLoaded} yüklendi");
            }

            // OPD collision sistemi başlat — tüm shape'ler yüklendikten sonra
            // MeshCollider yerine tek birleşik OPD collision mesh kullanılır
            var collisionObj = new GameObject("KOCollisionManager");
            collisionObj.transform.SetParent(transform, false);
            var collisionMgr = collisionObj.AddComponent<KOCollisionManager>();
            collisionMgr.Initialize(opdFull);
        }

        /// <summary>
        /// Spawns a 3D loot box at the specified position.
        /// Parses the shape file and instantiates its parts.
        /// </summary>
        public GameObject SpawnLootBox(Vector3 position, long bundleId, KOEntity corpse)
        {
            var shapeData = N3ShapeParser.ParseShapeFile("Misc/itembox.n3shape");
            if (shapeData == null)
            {
                Debug.LogError("[LOOT] itembox.n3shape yüklenemedi!");
                return null;
            }

            var shapeObj = new GameObject($"LootBox_{bundleId}");
            shapeObj.transform.position = position;
            shapeObj.transform.rotation = Quaternion.identity;
            shapeObj.transform.localScale = new Vector3(1.6f, 1.6f, 1.6f);

            if (shapeData.Parts != null)
            {
                foreach (var part in shapeData.Parts)
                {
                    CreatePartObject(shapeObj.transform, part, -99);
                }
            }

            // Attach KOLootBox component
            var lootBox = shapeObj.AddComponent<KOLootBox>();
            lootBox.BundleID = bundleId;
            lootBox.CorpseEntity = corpse;

            // Compute bounds and add a BoxCollider for raycast selection
            var renderers = shapeObj.GetComponentsInChildren<MeshRenderer>();
            if (renderers.Length > 0)
            {
                Bounds bounds = renderers[0].bounds;
                for (int i = 1; i < renderers.Length; i++)
                {
                    bounds.Encapsulate(renderers[i].bounds);
                }
                var col = shapeObj.AddComponent<BoxCollider>();
                col.center = shapeObj.transform.InverseTransformPoint(bounds.center);
                col.size = bounds.size;
                col.isTrigger = true;
            }
            else
            {
                var col = shapeObj.AddComponent<BoxCollider>();
                col.size = Vector3.one;
                col.isTrigger = true;
            }

            // Attach KOLootBoxInteractButton
            var interactBtn = shapeObj.AddComponent<KOLootBoxInteractButton>();
            interactBtn.Initialize(lootBox);

            return shapeObj;
        }

        /// <summary>
        /// N3SPart verilerinden child mesh objesi oluşturur.
        /// .N3PMesh dosyasından gerçek mesh verisi yüklenir.
        /// Dosya bulunamazsa placeholder küp kullanılır.
        /// </summary>
        private void CreatePartObject(Transform parent, N3ShapeParser.N3PartData part, int shapeIdx)
        {
            string partName = string.IsNullOrEmpty(part.MeshFileName)
                ? $"Part_{shapeIdx}" : System.IO.Path.GetFileName(part.MeshFileName);

            // Materyal: shape'in orijinal diffuse rengini kullan
            Color diffuse = part.Material != null ? part.Material.Diffuse : Color.gray;
            if (diffuse.r < 0.01f && diffuse.g < 0.01f && diffuse.b < 0.01f)
                diffuse = new Color(0.5f, 0.48f, 0.45f);

            // .N3PMesh dosyasını yüklemeyi dene
            Mesh unityMesh = null;
            N3PMeshImporter.N3PMeshData lodMeshData = null;
            if (!string.IsNullOrEmpty(part.MeshFileName))
            {
                // === Resources.Load fallback: convert edilmiş mesh ===
                string meshBaseName = System.IO.Path.GetFileNameWithoutExtension(part.MeshFileName);
                unityMesh = Resources.Load<Mesh>($"KOModels/Object/Meshes/{meshBaseName}");

                // === Fallback: parse ===
                if (unityMesh == null)
                {
                    string meshRelPath = part.MeshFileName.Replace('\\', '/');
                    string meshFullPath = System.IO.Path.Combine("", meshRelPath);

                    if (!KOBinaryProvider.Exists(meshFullPath))
                    {
                        string meshName = System.IO.Path.GetFileName(meshRelPath);
                        string altPath = System.IO.Path.Combine("", "Object", meshName);
                        if (KOBinaryProvider.Exists(altPath))
                            meshFullPath = altPath;
                    }

                    if (KOBinaryProvider.Exists(meshFullPath))
                    {
                        lodMeshData = N3PMeshImporter.Load(meshFullPath);
                        if (lodMeshData != null)
                        {
                            unityMesh = N3PMeshImporter.CreateUnityMesh(lodMeshData);
                        }
                    }
                }
            }

            GameObject partObj;
            if (unityMesh != null)
            {
                // Gerçek mesh kullan
                partObj = new GameObject(partName);
                var mf = partObj.AddComponent<MeshFilter>();
                mf.mesh = unityMesh;
                var mr = partObj.AddComponent<MeshRenderer>();

                // Texture yüklemeyi dene
                Material mat = CreateMeshMaterial(part, diffuse);
                mr.material = mat;

                _meshLoaded++;

                // Open-KO birebir: KOShapeLOD component ekle (CN3SPart::Tick LOD)
                // LOD verisi olan mesh'ler için progressive mesh LOD sistemi
                if (lodMeshData != null && lodMeshData.Collapses != null &&
                    lodMeshData.Collapses.Length > 0 && lodMeshData.MinLODIndices != null)
                {
                    var lod = partObj.AddComponent<KOShapeLOD>();
                    lod.Initialize(lodMeshData, mf, mr);
                }
            }
            else
            {
                // Placeholder küp
                partObj = GameObject.CreatePrimitive(PrimitiveType.Cube);
                partObj.name = partName;
                partObj.transform.localScale = Vector3.one * 2f;
                partObj.GetComponent<Renderer>().material = CreateMaterial(diffuse);
                _meshFailed++;
            }

            partObj.transform.SetParent(parent, false);
            partObj.transform.localPosition = part.Pivot;
            partObj.transform.localRotation = Quaternion.identity;
            partObj.transform.localScale = Vector3.one;

            // RF_BOARD_Y (0x8) — Y ekseni billboard (CN3SPart::Tick, N3Shape.cpp:108-128)
            uint renderFlags = part.Material != null ? part.Material.RenderFlags : 0;
            if ((renderFlags & 0x8) != 0)
            {
                partObj.AddComponent<BillboardY>();
            }

            // RF_WINDY (0x20) — Rüzgar salınım efekti (CN3SPart::Tick, N3Shape.cpp:131-173)
            if ((renderFlags & 0x20) != 0)
            {
                partObj.AddComponent<WindyPart>();
            }

            // Texture Animation (CN3SPart::Tick, N3Shape.cpp:99-106)
            // Part'ın birden fazla texture'ı varsa FPS bazlı döngü
            if (part.TextureFileNames != null && part.TextureFileNames.Count > 1)
            {
                var texList = new System.Collections.Generic.List<Texture2D>();
                foreach (string texRelPath in part.TextureFileNames)
                {
                    string path = texRelPath.Replace('\\', '/');
                    string texBaseName = System.IO.Path.GetFileNameWithoutExtension(path);
                    Texture2D t = null;

                    // === Resources.Load fallback ===
                    string[] texSearchDirs = { "Object", "Chr", "Item", "DTex", "Misc" };
                    foreach (var dir in texSearchDirs)
                    {
                        t = Resources.Load<Texture2D>($"KOTextures/{dir}/{texBaseName}");
                        if (t != null) break;
                    }

                    // === Fallback ===
                    if (t == null)
                    {
                        string fullPath = System.IO.Path.Combine("", path);
                        if (!KOBinaryProvider.Exists(fullPath))
                        {
                            string texName = System.IO.Path.GetFileName(path);
                            string altPath = System.IO.Path.Combine("", "Object", texName);
                            if (KOBinaryProvider.Exists(altPath))
                                fullPath = altPath;
                        }
                        if (KOBinaryProvider.Exists(fullPath))
                            t = KOTextureProvider.Load(fullPath, flipY: false);
                    }
                    texList.Add(t);
                }
                if (texList.Count > 1)
                {
                    var anim = partObj.AddComponent<TextureAnimPart>();
                    // C++ varsayılan: m_fTexFPS = 10.0f (N3Shape.cpp:17)
                    anim.Initialize(texList.ToArray(), part.TexFPS > 0 ? part.TexFPS : 10.0f);
                }
            }
        }

        private Material CreateMeshMaterial(N3ShapeParser.N3PartData part, Color diffuse)
        {
            // Part'ın ilk texture'ını yüklemeyi dene
            Texture2D tex = null;
            if (part.TextureFileNames != null && part.TextureFileNames.Count > 0)
            {
                string texRelPath = part.TextureFileNames[0].Replace('\\', '/');
                if (!string.IsNullOrEmpty(texRelPath))
                {
                    // === Resources.Load fallback: convert edilmiş texture ===
                    string texBaseName = System.IO.Path.GetFileNameWithoutExtension(texRelPath);
                    string[] texSearchDirs = { "Object", "Chr", "Item", "ChrSelect", "DTex", "Misc" };
                    foreach (var dir in texSearchDirs)
                    {
                        tex = Resources.Load<Texture2D>($"KOTextures/{dir}/{texBaseName}");
                        if (tex != null) break;
                    }

                    // === Fallback: DXT yükle ===
                    if (tex == null)
                    {
                        string texFullPath = System.IO.Path.Combine("", texRelPath);
                        if (!KOBinaryProvider.Exists(texFullPath))
                        {
                            string texName = System.IO.Path.GetFileName(texRelPath);
                            string altPath = System.IO.Path.Combine("", "Object", texName);
                            if (KOBinaryProvider.Exists(altPath))
                                texFullPath = altPath;
                        }
                        if (KOBinaryProvider.Exists(texFullPath))
                        {
                            tex = KOTextureProvider.Load(texFullPath, flipY: false);
                        }
                    }
                }
            }

            if (tex != null)
            {
                _texLoaded++;
                var shader = Shader.Find("Universal Render Pipeline/Lit");
                if (shader == null) shader = Shader.Find("Standard");
                var mat = new Material(shader);
                if (mat.HasProperty("_BaseMap"))
                    mat.SetTexture("_BaseMap", tex);
                else
                    mat.mainTexture = tex;
                if (mat.HasProperty("_BaseColor"))
                    mat.SetColor("_BaseColor", Color.white);
                else
                    mat.color = Color.white;

                // C++ __Material render flags (My_3DStruct.h:78-89)
                uint renderFlags = part.Material != null ? part.Material.RenderFlags : 0;

                // RF_ALPHABLENDING (0x1) — C++ My_3DStruct.h:79
                // C++ CN3SPart::Render: D3DRS_ALPHABLENDENABLE = TRUE
                //   + D3DRS_SRCBLEND = mat.dwSrcBlend
                //   + D3DRS_DESTBLEND = mat.dwDestBlend
                //
                // D3DBLEND constants (d3d9types.h):
                //   D3DBLEND_ZERO = 1
                //   D3DBLEND_ONE = 2
                //   D3DBLEND_SRCCOLOR = 3
                //   D3DBLEND_INVSRCCOLOR = 4
                //   D3DBLEND_SRCALPHA = 5
                //   D3DBLEND_INVSRCALPHA = 6
                //   D3DBLEND_DESTALPHA = 7
                //   D3DBLEND_INVDESTALPHA = 8
                //   D3DBLEND_DESTCOLOR = 9
                //   D3DBLEND_INVDESTCOLOR = 10
                bool hasAlphaBlend = (renderFlags & 0x1) != 0;
                // RF_DIFFUSEALPHA (0x80) — Diffuse alpha kullanarak blending
                bool hasDiffuseAlpha = (renderFlags & 0x80) != 0;
                // RF_NOTZWRITE (0x100) — Z buffer yazma kapalı
                bool noZWrite = (renderFlags & 0x100) != 0;
                // RF_NOTZBUFFER (0x400) — Z buffer tamamen kapalı
                bool noZBuffer = (renderFlags & 0x400) != 0;

                uint srcBlend = part.Material != null ? part.Material.SrcBlend : 0;
                uint destBlend = part.Material != null ? part.Material.DestBlend : 0;

                // Additive blend tanıma: siyah pikselleri saydam yapar
                // D3DBLEND_ONE(2) + D3DBLEND_ONE(2) = pure additive
                // D3DBLEND_SRCALPHA(5) + D3DBLEND_ONE(2) = pre-multiplied additive
                // D3DBLEND_ONE(2) + D3DBLEND_INVSRCALPHA(6) = pre-multiplied alpha
                bool isAdditiveBlend = hasAlphaBlend && (
                    (srcBlend == 2 && destBlend == 2) ||   // ONE + ONE
                    (srcBlend == 5 && destBlend == 2) ||   // SRCALPHA + ONE
                    (srcBlend == 2 && destBlend == 6));     // ONE + INVSRCALPHA

                if (isAdditiveBlend)
                {
                    // Additive blending — siyah piksel saydam olur (ateş, ışınlanma, decal efektleri)
                    mat.SetFloat("_Surface", 1); // Transparent
                    mat.SetOverrideTag("RenderType", "Transparent");
                    mat.renderQueue = (int)UnityEngine.Rendering.RenderQueue.Transparent;
                    mat.SetInt("_SrcBlend", (int)UnityEngine.Rendering.BlendMode.One);
                    mat.SetInt("_DstBlend", (int)UnityEngine.Rendering.BlendMode.One);
                    mat.SetFloat("_ZWrite", 0);
                    mat.EnableKeyword("_SURFACE_TYPE_TRANSPARENT");
                    mat.DisableKeyword("_ALPHATEST_ON");
                    if (mat.HasProperty("_AlphaClip"))
                        mat.SetFloat("_AlphaClip", 0);
                    if (mat.HasProperty("_Cull"))
                        mat.SetFloat("_Cull", 0); // Cull Off
                }
                else if (hasAlphaBlend || hasDiffuseAlpha)
                {
                    // Standard alpha blending — SrcAlpha + InvSrcAlpha
                    mat.SetFloat("_Surface", 1);
                    mat.SetOverrideTag("RenderType", "Transparent");
                    mat.renderQueue = (int)UnityEngine.Rendering.RenderQueue.Transparent;
                    mat.SetInt("_SrcBlend", (int)UnityEngine.Rendering.BlendMode.SrcAlpha);
                    mat.SetInt("_DstBlend", (int)UnityEngine.Rendering.BlendMode.OneMinusSrcAlpha);
                    mat.SetFloat("_ZWrite", 0);
                    mat.EnableKeyword("_SURFACE_TYPE_TRANSPARENT");
                    if (mat.HasProperty("_Cull"))
                        mat.SetFloat("_Cull", 0); // Cull Off
                }
                else
                {
                    // Non-alpha-blend: Alpha cutout (DXT1/3/5 alpha için)
                    // C++ CN3SPart::Render: D3DRS_ALPHATESTENABLE = TRUE, D3DCMP_GREATER, ALPHAREF=0x88
                    // 0x88 / 0xFF = 0.533
                    // Sadece texture gerçekten alpha içeriyorsa uygula (opak texture'ları bozma)
                    bool texHasAlpha = HasTransparentPixels(tex);
                    if (texHasAlpha && mat.HasProperty("_AlphaClip"))
                    {
                        mat.SetFloat("_AlphaClip", 1);
                        mat.SetFloat("_Cutoff", 0.53f);
                        mat.SetOverrideTag("RenderType", "TransparentCutout");
                        mat.renderQueue = (int)UnityEngine.Rendering.RenderQueue.AlphaTest;
                        mat.EnableKeyword("_ALPHATEST_ON");
                    }
                }

                // RF_NOTZWRITE (0x100) veya RF_NOTZBUFFER (0x400) — Z write kapalı
                if (noZWrite || noZBuffer)
                {
                    mat.SetFloat("_ZWrite", 0);
                }

                // RF_ALPHABLENDING (0x1) veya RF_BOARD_Y (0x8): çift taraflı render
                bool needsDoubleSided = (renderFlags & 0x1) != 0 || (renderFlags & 0x8) != 0;
                if (needsDoubleSided)
                {
                    if (mat.HasProperty("_Cull"))
                        mat.SetFloat("_Cull", 0); // Cull Off
                }

                // RF_DOUBLESIDED (0x4) — Çift taraflı render (D3DCULL_NONE)
                if ((renderFlags & 0x4) != 0)
                {
                    if (mat.HasProperty("_Cull"))
                        mat.SetFloat("_Cull", 0); // 0 = Off (D3DCULL_NONE)
                }

                // RF_POINTSAMPLING (0x10) — MipMap Point Sampling
                // C++ CN3SPart::Render: D3DTSS_MINFILTER/MAGFILTER = D3DTEXF_POINT
                if ((renderFlags & 0x10) != 0 && tex != null)
                {
                    tex.filterMode = FilterMode.Point;
                }

                // RF_NOTUSELIGHT (0x40) — Aydınlatma kapalı (Light Off)
                // C++ CN3SPart::Render: D3DRS_LIGHTING = FALSE
                if ((renderFlags & 0x40) != 0)
                {
                    // Unlit shader'a geç — ama alpha handling'i de uygula!
                    var unlitShader = Shader.Find("Universal Render Pipeline/Unlit");
                    if (unlitShader == null) unlitShader = Shader.Find("Unlit/Texture");
                    if (unlitShader != null)
                    {
                        var unlitMat = new Material(unlitShader);
                        if (unlitMat.HasProperty("_BaseMap"))
                            unlitMat.SetTexture("_BaseMap", tex);
                        else
                            unlitMat.mainTexture = tex;
                        if (unlitMat.HasProperty("_BaseColor"))
                            unlitMat.SetColor("_BaseColor", Color.white);

                        // Alpha handling — unlit shader'da da uygulanmalı
                        if (isAdditiveBlend)
                        {
                            // Additive blending (ateş efektleri: siyah=saydam)
                            unlitMat.SetFloat("_Surface", 1);
                            unlitMat.SetOverrideTag("RenderType", "Transparent");
                            unlitMat.renderQueue = (int)UnityEngine.Rendering.RenderQueue.Transparent;
                            unlitMat.SetInt("_SrcBlend", (int)UnityEngine.Rendering.BlendMode.One);
                            unlitMat.SetInt("_DstBlend", (int)UnityEngine.Rendering.BlendMode.One);
                            unlitMat.SetFloat("_ZWrite", 0);
                            unlitMat.EnableKeyword("_SURFACE_TYPE_TRANSPARENT");
                            if (unlitMat.HasProperty("_Cull"))
                                unlitMat.SetFloat("_Cull", 0);
                        }
                        else if (hasAlphaBlend || hasDiffuseAlpha)
                        {
                            // Standard alpha blending
                            unlitMat.SetFloat("_Surface", 1);
                            unlitMat.SetOverrideTag("RenderType", "Transparent");
                            unlitMat.renderQueue = (int)UnityEngine.Rendering.RenderQueue.Transparent;
                            unlitMat.SetInt("_SrcBlend", (int)UnityEngine.Rendering.BlendMode.SrcAlpha);
                            unlitMat.SetInt("_DstBlend", (int)UnityEngine.Rendering.BlendMode.OneMinusSrcAlpha);
                            unlitMat.SetFloat("_ZWrite", 0);
                            unlitMat.EnableKeyword("_SURFACE_TYPE_TRANSPARENT");
                            if (unlitMat.HasProperty("_Cull"))
                                unlitMat.SetFloat("_Cull", 0);
                        }
                        else if (unlitMat.HasProperty("_AlphaClip"))
                        {
                            // Alpha cutout (ağaçlar, çimenler)
                            unlitMat.SetFloat("_AlphaClip", 1);
                            unlitMat.SetFloat("_Cutoff", 0.5f);
                            unlitMat.SetOverrideTag("RenderType", "TransparentCutout");
                            unlitMat.renderQueue = (int)UnityEngine.Rendering.RenderQueue.AlphaTest;
                            unlitMat.EnableKeyword("_ALPHATEST_ON");
                        }

                        // Cull off — unlit+alpha objeleri genellikle çift taraflı
                        if ((renderFlags & 0x4) != 0 || hasAlphaBlend)
                        {
                            if (unlitMat.HasProperty("_Cull"))
                                unlitMat.SetFloat("_Cull", 0);
                        }

                        return unlitMat;
                    }
                }

                // RF_DIFFUSEALPHA (0x80) — Diffuse renk alfa ile alpha blending
                // C++ CN3SPart::Render: D3DRS_ALPHABLENDENABLE + diffuse alpha
                if ((renderFlags & 0x80) != 0)
                {
                    if (mat.HasProperty("_Surface"))
                        mat.SetFloat("_Surface", 1); // Transparent
                    mat.SetOverrideTag("RenderType", "Transparent");
                    mat.renderQueue = (int)UnityEngine.Rendering.RenderQueue.Transparent;
                    if (mat.HasProperty("_Blend"))
                        mat.SetFloat("_Blend", 1); // Alpha
                }

                // RF_NOTZWRITE (0x100) — ZBuffer'a yazma (Z-Write Off)
                // C++ CN3SPart::Render: D3DRS_ZWRITEENABLE = FALSE
                if ((renderFlags & 0x100) != 0)
                {
                    if (mat.HasProperty("_ZWrite"))
                        mat.SetFloat("_ZWrite", 0);
                }

                // RF_UV_CLAMP (0x200) — Texture UV modunu Clamp'e ayarla
                if ((renderFlags & 0x200) != 0 && tex != null)
                {
                    tex.wrapMode = TextureWrapMode.Clamp;
                }

                // RF_NOTZBUFFER (0x400) — ZBuffer testi kapalı (ZTest Always)
                // C++ CN3SPart::Render: D3DRS_ZENABLE = FALSE
                if ((renderFlags & 0x400) != 0)
                {
                    if (mat.HasProperty("_ZTest"))
                        mat.SetFloat("_ZTest", (float)UnityEngine.Rendering.CompareFunction.Always);
                }

                return mat;
            }
            else
            {
                // Sadece diffuse renkli materyal
                return CreateMaterial(diffuse);
            }
        }

        /// <summary>
        /// N3ShapeParser başarısız olursa collision-based fallback.
        /// </summary>
        private void LoadObjectsFallback(string opdPath)
        {
            var opdData = OpdObjectImporter.Parse(opdPath);
            if (opdData == null || opdData.Objects.Count == 0) return;

            _objectsParent = new GameObject("KOObjects_Fallback");
            int placed = 0;

            Color[] colors = {
                new Color(0.5f, 0.45f, 0.4f),
                new Color(0.4f, 0.35f, 0.3f),
                new Color(0.55f, 0.5f, 0.45f),
            };

            foreach (var obj in opdData.Objects)
            {
                var size = obj.Size;
                if (size.x > 100f || size.z > 100f || size.y > 80f) continue;
                if (size.x < 2f && size.z < 2f) continue;

                var cube = GameObject.CreatePrimitive(PrimitiveType.Cube);
                cube.name = $"Obj_{placed}";
                cube.transform.SetParent(_objectsParent.transform);
                cube.transform.position = obj.Center;
                cube.transform.localScale = size;
                cube.GetComponent<Renderer>().material = CreateMaterial(colors[placed % colors.Length]);
                placed++;
            }

            Debug.Log($"[WORLD] {placed} obje yerleştirildi (fallback collision AABB)");
        }

