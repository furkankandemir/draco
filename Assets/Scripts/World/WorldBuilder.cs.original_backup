        /// <summary>
        /// NPC_Looks.tbl'yi diskten yükle (ilk çağrıda) veya cache'ten döndür.
        /// C++ birebir: s_pTbl_NPC_Looks uygulama başında bir kez yüklenir.
        /// </summary>
        private Dictionary<uint, KOImport.NpcLooksTblParser.NpcLooksEntry> GetNpcLooksTable()
        {
            if (_npcLooksTableFull == null)
            {
                string tblPath = System.IO.Path.Combine("", "Data", "NPC_Looks.tbl");
                _npcLooksTableFull = KOImport.NpcLooksTblParser.Load(tblPath);
            }
            return _npcLooksTableFull;
        }

        // Open-KO birebir sabitler:
        // WarFareMain.cpp:94-98 — s_Options.iViewDist = 512 (min=256, max=512)
        // GameDef.h:1278-1279 — SOUND_RANGE_TO_SET=10, SOUND_RANGE_TO_RELEASE=20
        private const float KO_VIEW_DIST = 512f;
        private const float KO_NAME_SHOW_DIST = 10f;    // SOUND_RANGE_TO_SET (GameDef.h:1278)
        private const float KO_NAME_HIDE_DIST = 20f;    // SOUND_RANGE_TO_RELEASE (GameDef.h:1279)

        /// <summary>
        /// S2C_SPAWN_MONSTER geldiğinde EntityManager bu metodu çağırır.
        /// Open-KO birebir: WIZ_NPC_INOUT → client entity oluşturur.
        /// </summary>
        public GameObject BuildMonsterModel(int defId, out string monsterName, out int monsterSize)
        {
            monsterName = "Unknown";
            monsterSize = 100;

            if (!_monsterDefCache.TryGetValue(defId, out var defData))
            {
                // Cache henüz dolmamışsa, K_MONSTER'dan yükle
                if (_monsterDefCache.Count == 0)
                {
                    _monsterDefCache = LoadMonsterPidMap();
                }
                if (!_monsterDefCache.TryGetValue(defId, out defData))
                    return null;
            }

            monsterName = defData.Name;
            monsterSize = defData.Size;

            if (!_monsterLooksCache.TryGetValue(defId, out var looks))
            {
                // Looks cache'te yoksa tam tablodan ara (tablo sadece 1 kez diskten okunur)
                var allLooks = GetNpcLooksTable();
                if (allLooks.TryGetValue((uint)defData.Pid, out var entry))
                {
                    _monsterLooksCache[defId] = entry;
                    looks = entry;
                }
                else
                    return null;
            }

            return Import.N3CharBuilder.BuildFromLooks(looks);
        }

        /// <summary>
        /// C++ birebir: GameProcMain.cpp:2921 — s_pTbl_NPC_Looks.Find(iIDResrc)
        /// Sunucu paketindeki resourceId (iIDResrc) doğrudan NPC_Looks.tbl ID'sidir.
        /// K_MONSTER tablosuna gerek yok — doğrudan NPC_Looks'tan model yükle.
        /// </summary>
        public GameObject BuildMonsterModelByResourceId(int resourceId, out int monsterSize)
        {
            monsterSize = 100;

            if (!_monsterLooksCache.TryGetValue(resourceId, out var looks))
            {
                var allLooks = GetNpcLooksTable();
                if (allLooks.TryGetValue((uint)resourceId, out var entry))
                {
                    _monsterLooksCache[resourceId] = entry;
                    looks = entry;
                }
                else
                {
                    Debug.LogWarning($"[WORLD] NPC_Looks.tbl'de resourceId={resourceId} bulunamadı");
                    return null;
                }
            }

            return Import.N3CharBuilder.BuildFromLooks(looks);
        }

