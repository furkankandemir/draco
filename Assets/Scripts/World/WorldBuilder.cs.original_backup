        private void CreateSun()
        {
            // Kullanıcı ek Unity ışıklandırması istemiyor — Sun minimal tutulur
            var sunObj = new GameObject("Sun");
            _sun = sunObj.AddComponent<Light>();
            _sun.type = LightType.Directional;
            _sun.color = Color.white;
            _sun.intensity = 0f; // Ek ışık yok — texture renkleri olduğu gibi görünsün
            _sun.shadows = LightShadows.None;

            sunObj.transform.rotation = Quaternion.Euler(50f, -30f, 0f);

            // Ambient: Tam beyaz — texture'lar olduğu gibi görünsün (Unity Lit shader'da gerekli)
            RenderSettings.ambientMode = AmbientMode.Flat;
            RenderSettings.ambientLight = Color.white;
            // Environment reflection'ı kapat — terrain üzerinde parlak yansıma oluşturuyordu
            RenderSettings.defaultReflectionMode = UnityEngine.Rendering.DefaultReflectionMode.Custom;
            RenderSettings.defaultReflectionResolution = 16;
            RenderSettings.reflectionIntensity = 0f;
        }

