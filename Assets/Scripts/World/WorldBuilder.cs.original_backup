        private void Start()
        {
            // Zone ID: GameManager'dan al (karakter seçiminde set edilir)
            // Inspector override sadece GameManager yoksa veya 0 ise kullanılır
            _currentZoneId = 0;
            if (GameManager.Instance != null && GameManager.Instance.CurrentZoneId > 0)
            {
                _currentZoneId = GameManager.Instance.CurrentZoneId;
            }
            else if (inspectorZoneId > 0)
            {
                _currentZoneId = inspectorZoneId;
            }
            if (_currentZoneId == 0) _currentZoneId = 21; // Son fallback: Moradon
            
            Debug.Log($"[WORLD] Zone ID belirlendi: {_currentZoneId} (GM={GameManager.Instance?.CurrentZoneId}, Inspector={inspectorZoneId})");

            CreateSun();

            // Convert edilmiş zone asset'i dene — yoksa eski runtime parse
            _currentZoneAsset = Resources.Load<KOZoneAsset>($"KOZones/zone_{_currentZoneId}");
            if (_currentZoneAsset != null)
            {
                Debug.Log($"[WORLD] ✅ Convert edilmiş zone asset bulundu: zone_{_currentZoneId}");
                LoadConvertedZone(_currentZoneAsset);
            }
            else
            {
                Debug.Log($"[WORLD] Convert edilmiş asset yok, runtime parse kullanılıyor (zone={_currentZoneId})");
                LoadTerrain();
                LoadObjects();
                // LoadZoneLights(); — kullanıcı ek Unity ışığı istemiyor
                CreateSkyAndFog();
            }

            // GameSceneSetup placeholder objelerini gizle
            HidePlaceholders();

            // Oyuncuyu terrain üzerine yerleştir
            RepositionPlayer();

            // Open-KO birebir: CGameBase::Init() → Item_Org + Item_Ext tablo yükleme
            // GameBase.cpp:59-79 — s_pTbl_Items_Basic + s_pTbl_Items_Exts[MAX_ITEM_EXTENSION]
            string koDataDir = System.IO.Path.Combine("", "Data");
            KOImport.ItemDataManager.LoadAll(koDataDir);

            // Open-KO birebir: NPC'ler lokal dosyadan spawn EDİLMEZ.
            // C++ client sadece sunucudan gelen MsgRecv_NPCIn (WIZ_NPC_INOUT) ile entity oluşturur.
            // Burada sadece monster model cache'ini dolduruyoruz — EntityManager.HandleSpawnMonster kullanacak.
            CacheMonsterData();

            // Target selection sistemi — tap ile entity seçme
            gameObject.AddComponent<KOTargetSelector>();

            // Open-KO birebir: camera far plane = iViewDist (WarFareMain.cpp:94)
            // GameEng.cpp:251 — fFP = s_Options.iViewDist * m_fFPDeltaCur
            // WarFareMain.cpp:94-98 — iViewDist = ini.GetInt("ViewPort", "Distance", 512); min=256, max=512
            var mainCam = UnityEngine.Camera.main;
            if (mainCam != null)
            {
                mainCam.farClipPlane = KO_VIEW_DIST;
            }

            LoadZoneEventFile(_currentZoneId);

            Debug.Log($"[WORLD] Dünya oluşturuldu — Zone {_currentZoneId}");
        }

        /// <summary>
        /// Open-KO birebir: CN3Chr::Tick() satır 1452-1457
        /// Kameradan uzak entity'leri gizle (LOD -1 → render edilmez).
        /// PlayerOtherMgr::Tick() — SOUND_RANGE_TO_SET/RELEASE ile isim gösterim kontrolü.
        /// </summary>
        private void LateUpdate()
        {
            var cam = UnityEngine.Camera.main;
            if (cam == null) return;

            Vector3 camPos = cam.transform.position;

            // Open-KO birebir: PlayerOtherMgr::Tick(vPosPlayer) satır 76
            // FloatingName mesafesi OYUNCU pozisyonundan hesaplanır, kameradan değil.
            // CN3Chr::Tick entity culling için kamera mesafesi kullanır — bu ayrı.
            Vector3 playerPos = camPos; // fallback
            if (_playerTransform != null)
                playerPos = _playerTransform.position;
            else
            {
                // Cache'i yenilemeyi dene
                var player = GameObject.FindGameObjectWithTag("Player");
                if (player == null) player = GameObject.Find("Player");
                if (player != null)
                {
                    _playerTransform = player.transform;
                    playerPos = _playerTransform.position;
                }
            }

            // Tick PVS Manager if active
            if (_pvsManager != null)
            {
                _pvsManager.Tick(playerPos);
            }

            // Tüm KOEntity'leri bul ve mesafeye göre gizle/göster
            var entities = FindObjectsByType<KOEntity>(FindObjectsInactive.Exclude);
            foreach (var entity in entities)
            {
                if (entity == null) continue;

                // CN3Chr::Tick() satır 1452-1457:
                // if (fDist > s_CameraData.fFP + m_fRadius * 2.0f) { m_nLOD = -1; return; }
                // Entity render on/off — kamera mesafesi
                float camDist = Vector3.Distance(camPos, entity.transform.position);
                bool shouldRender = camDist <= KO_VIEW_DIST;

                // Renderer'ları aç/kapat (GameObject'i deaktif etmek yerine — collider raycast için kalmalı)
                var renderers = entity.GetComponentsInChildren<Renderer>();
                foreach (var r in renderers)
                    r.enabled = shouldRender;

                // FloatingName kontrolü — SOUND_RANGE_TO_SET/RELEASE
                // Open-KO birebir: PlayerOtherMgr::Tick() satır 77-80, 108-111
                // Mesafe oyuncu pozisyonundan hesaplanır (vPosPlayer)
                float playerDist = Vector3.Distance(playerPos, entity.transform.position);
                var floatingName = entity.GetComponent<FloatingName>();
                if (floatingName != null)
                {
                    // Hysteresis: 10 birimde göster, 20 birimde gizle
                    if (playerDist < KO_NAME_SHOW_DIST)
                        floatingName.SetVisible(true);
                    else if (playerDist > KO_NAME_HIDE_DIST)
                        floatingName.SetVisible(false);
                }
            }
        }

        /// <summary>
        /// Zone'a ait GLO (Game Light Object) dosyasından ışıkları yükler.
        /// Open-KO: N3TerrainManager::InitWorld → LightMgr::LoadZoneLight
        /// 
        /// D3D Point Light → Unity Point Light dönüşümü:
        /// - Position: D3D (X,Y,Z) → Unity (X,Y,Z) — aynı (KO coordinate convention)
        /// - Range: D3D Range/4 (InitPoint'ta ×4 olarak kaydedilir)
        /// - Color: Diffuse rengi
        /// - Intensity: Ambient/Diffuse oranından hesaplanır
        /// </summary>
        private void LoadZoneLights()
        {
            var zoneInfo = KOZoneMapper.GetZoneInfo(_currentZoneId);
            if (zoneInfo == null || string.IsNullOrEmpty(zoneInfo.GloFile))
            {
                Debug.Log("[GLO] Zone için GLO dosyası tanımlı değil — atlanıyor");
                return;
            }

            string gloPath = System.IO.Path.Combine("", "Zones", zoneInfo.GloFile);
            var lights = GloLightImporter.Load(gloPath);

            if (lights.Count == 0)
                return;

            // Işıklar için parent obje
            var lightsParent = new GameObject("ZoneLights");
            lightsParent.transform.SetParent(transform, false);

            int created = 0;
            foreach (var ld in lights)
            {
                // Orijinal KO'da zone ışıkları bOn=FALSE ile yüklenir ve
                // CLightMgr::Tick() içinde mesafeye göre aktif edilir.
                // Unity'de D3D ışık slot yönetimi gerekmediğinden hepsini oluşturuyoruz.

                var lightObj = new GameObject($"ZoneLight_{ld.Number}_{ld.Name}");
                lightObj.transform.SetParent(lightsParent.transform, false);

                // CN3Light::Tick → m_Data.Position = m_vPos
                // Transform pozisyonu = ışık pozisyonu
                lightObj.transform.localPosition = ld.Position;

                var uLight = lightObj.AddComponent<Light>();

                // D3DLIGHTTYPE: 1=Point, 2=Spot, 3=Directional
                switch (ld.Type)
                {
                    case 1: // D3DLIGHT_POINT
                        uLight.type = LightType.Point;
                        // D3D Range = fRange * 4.0f (InitPoint'ta) — Unity PBR'de daha geniş range gerekli
                        uLight.range = ld.Range > 0 ? ld.Range / 2.0f : 10f;
                        break;
                    case 2: // D3DLIGHT_SPOT
                        uLight.type = LightType.Spot;
                        uLight.range = ld.Range > 0 ? ld.Range : 10f;
                        uLight.spotAngle = ld.Phi * Mathf.Rad2Deg;
                        uLight.innerSpotAngle = ld.Theta * Mathf.Rad2Deg;
                        lightObj.transform.forward = ld.Direction.normalized;
                        break;
                    case 3: // D3DLIGHT_DIRECTIONAL
                        uLight.type = LightType.Directional;
                        lightObj.transform.forward = ld.Direction.normalized;
                        break;
                    default:
                        uLight.type = LightType.Point;
                        uLight.range = 10f;
                        break;
                }

                uLight.color = new Color(ld.Diffuse.r, ld.Diffuse.g, ld.Diffuse.b, 1f);

                // D3D ışık yoğunluğu: Diffuse renk değerlerinden hesapla
                // KO'daki ışıklar genelde 0-1 arası diffuse ile çalışır
                float maxChannel = Mathf.Max(ld.Diffuse.r, Mathf.Max(ld.Diffuse.g, ld.Diffuse.b));
                uLight.intensity = Mathf.Clamp(maxChannel * 2f, 0.5f, 5f);

                // Mobil performans: gölge kapalı (zone point light'lar için)
                uLight.shadows = LightShadows.None;

                // Render mode: önemli değil (mobilde otomatik seçilir)
                uLight.renderMode = LightRenderMode.Auto;

                created++;
            }

            Debug.Log($"[GLO] ✅ {created} zone ışığı oluşturuldu ({lights.Count} toplam, zone={zoneInfo.GloFile})");
        }

        /// <summary>
        /// GameSceneSetup'tan kalan placeholder objeleri (küp binalar, silindir NPC'ler) gizler.
        /// </summary>
        private void HidePlaceholders()
        {
            string[] placeholderNames = {
                "WallNorth", "WallSouth", "WallEast", "WallWest",
                "Building_Inn", "Building_Shop", "Building_Blacksmith", "Building_Tower",
                "NPC_Sunrise", "NPC_Blacksmith", "NPC_Sundries",
                "Ground",
                // GameSceneSetup placeholder UI + test objeleri
                "CharNameLabel",
                "Monster_Bultura_0", "Monster_Bultura_1",
                "Monster_Isi_2", "Monster_Isi_3", "Monster_Lycan_4",
                // Sahne içi varsayılan ışık — kullanıcı ek Unity ışığı istemiyor
                "Directional Light"
            };

            int hidden = 0;
            foreach (string name in placeholderNames)
            {
                var obj = GameObject.Find(name);
                if (obj != null)
                {
                    Destroy(obj);
                    hidden++;
                }
            }

            if (hidden > 0)
                Debug.Log($"[WORLD] {hidden} placeholder gizlendi");
        }

        /// <summary>
        /// Oyuncuyu terrain'in default spawn noktasına yerleştirir.
        /// </summary>
        private void RepositionPlayer()
        {
            var player = GameObject.FindGameObjectWithTag("Player");
            if (player == null)
            {
                player = GameObject.Find("Player");
                if (player == null)
                {
                    Debug.LogWarning("[WORLD] Player bulunamadı (tag veya isimle)!");
                    return;
                }
                Debug.Log("[WORLD] Player tag ile bulunamadı, isimle bulundu");
            }
            _playerTransform = player.transform; // LateUpdate'te kullanılmak üzere cache'le

            var zoneInfo = KOZoneMapper.GetZoneInfo(_currentZoneId);
            Vector3 spawnPos = zoneInfo != null ? zoneInfo.DefaultSpawn : Vector3.zero;

            // DefaultSpawn == Vector3.zero → doğrulanmış spawn verisi yok
            // Harita merkezini kullan (GTD WorldSize / 2)
            if (spawnPos.sqrMagnitude < 0.001f)
            {
                float center = _terrainWorldSize * 0.5f;
                spawnPos = new Vector3(center, 0, center);
                Debug.Log($"[WORLD] Spawn verisi yok, harita merkezi kullanılıyor: ({center:F0}, {center:F0})");
            }

            // Terrain yüksekliğini örnekle — sadece terrain, OPD collision hariç
            // (HandleMyInfo gelince C++ birebir InitPlayerPosition mantığıyla override edilecek)
            float terrainY = 0f;
            if (_terrain != null)
                terrainY = _terrain.transform.position.y + _terrain.SampleHeight(new Vector3(spawnPos.x, 0, spawnPos.z));
            spawnPos.y = terrainY + 0.1f; // Minimal buffer (yere gömülmesin)

            // CharacterController varsa, position set etmeden önce disable et
            // (aktifken transform.position değişikliği ignore edilebilir)
            var cc = player.GetComponent<CharacterController>();
            if (cc != null) cc.enabled = false;

            player.transform.position = spawnPos;

            if (cc != null) cc.enabled = true;

            Debug.Log($"[WORLD] Oyuncu yerleştirildi: ({spawnPos.x:F0}, {spawnPos.y:F1}, {spawnPos.z:F0}) terrainY={terrainY:F1}");

            // Kamerayı oyuncuya bağla
            var mainCam = UnityEngine.Camera.main;
            if (mainCam != null)
            {
                var camCtrl = mainCam.GetComponent<EntropyOnline.Camera.CameraController>();
                if (camCtrl != null)
                {
                    camCtrl.SetTarget(player.transform);
                    Debug.Log("[WORLD] Kamera → Player bağlandı");
                }
                else
                {
                    Debug.LogWarning("[WORLD] CameraController bileşeni bulunamadı!");
                }

                mainCam.transform.position = spawnPos + new Vector3(0, 3f, -5f);
                mainCam.transform.LookAt(player.transform);
            }
            else
            {
                Debug.LogWarning("[WORLD] MainCamera bulunamadı!");
            }

            // C++ birebir: MsgRecv_MyInfo_All (GameProcMain.cpp:1856-1868)
            // Karakter modeli sunucu verisi (race) gelmeden OLUŞTURULMAZ.
            // HandleMyInfo → BuildPlayerModel() çağrısıyla oluşturulacak.
            // Burada sadece Capsule placeholder bileşenlerini temizliyoruz.
            CleanupPlayerPlaceholder(player);
        }

        /// <summary>
        /// Open-KO birebir: CPlayerBase::InitChr (PlayerBase.cpp:2025-2055)
        /// + GameProcMain.cpp:1856-1868 (MsgRecv_MyInfo_All → InitChr akışı)
        /// + GameProcMain.cpp:2144-2155 (default part giydirme)
        ///
        /// Akış:
        ///   1. eRace → s_pTbl_UPC_Looks.Find(eRace) → pLooks
        ///   2. pLooks->szChrFN → LoadFromFile (skeleton + body)
        ///   3. pLooks->szPartFNs[0..5] → default kıyafet
        ///   4. InitFace() / InitHair() — yüz ve saç
        /// </summary>
        /// <summary>
        /// Capsule placeholder bileşenlerini kaldırır.
        /// Model oluşturma BuildPlayerModel() ile yapılır — sunucu verisi gerektirir.
        /// </summary>
        private void CleanupPlayerPlaceholder(GameObject player)
        {
            var rootMR = player.GetComponent<MeshRenderer>();
            if (rootMR != null) DestroyImmediate(rootMR);
            var rootMF = player.GetComponent<MeshFilter>();
            if (rootMF != null) DestroyImmediate(rootMF);
            var rootCC = player.GetComponent<CapsuleCollider>();
            if (rootCC != null) DestroyImmediate(rootCC);
        }

        /// <summary>
        /// Open-KO birebir: MsgRecv_MyInfo_All (GameProcMain.cpp:1856-1868)
        ///   eRace = pkt.read<uint8_t>();
        ///   pLooks = s_pTbl_UPC_Looks.Find(eRace);
        ///   s_pPlayer->InitChr(pLooks);
        ///
        /// HandleMyInfo'dan çağrılır — race sunucudan geldikten sonra.
        /// </summary>
        public void BuildPlayerModel(byte eRace)
        {
            var player = GameObject.FindGameObjectWithTag("Player");
            if (player == null) player = GameObject.Find("Player");
            if (player == null) { Debug.LogError("[WORLD] BuildPlayerModel: Player bulunamadı!"); return; }

            // Mevcut karakter modelini kaldır
            for (int i = player.transform.childCount - 1; i >= 0; i--)
            {
                var child = player.transform.GetChild(i);
                DestroyImmediate(child.gameObject);
            }

            // Bind pose cache'ini temizle — yeni model yeni rest pose ile hesaplanacak
            Import.N3CharBuilder.ClearBindPoseCache();

            // UPC_DefaultLooks.tbl yükle (KOEquipmentVisualizer ile paylaşılan static cache)
            if (KOEquipmentVisualizer.s_pTbl_UPC_Looks == null)
            {
                string looksPath = System.IO.Path.Combine("", "Data", "UPC_DefaultLooks.tbl");
                KOEquipmentVisualizer.s_pTbl_UPC_Looks = KOTableReader.LoadUpcLooksTable(looksPath);
            }

            if (KOEquipmentVisualizer.s_pTbl_UPC_Looks == null ||
                !KOEquipmentVisualizer.s_pTbl_UPC_Looks.TryGetValue(eRace, out var pLooks))
            {
                Debug.LogError($"[WORLD] UPC_DefaultLooks.tbl'de race={eRace} bulunamadı!");
                return;
            }

            Debug.Log($"[WORLD] InitChr: race={eRace}, szChrFN='{pLooks.szChrFN}', " +
                      $"szJointFN='{pLooks.szJointFN}', szAniFN='{pLooks.szAniFN}'");

            // ============================================================
            // Open-KO birebir: CPlayerBase::InitChr (PlayerBase.cpp:2025-2055)
            //   if (!pTbl->szChrFN.empty())
            //       m_Chr.LoadFromFile(pTbl->szChrFN);
            //   else
            //       m_Chr.JointSet(pTbl->szJointFN);
            //       m_Chr.AniCtrlSet(pTbl->szAniFN);
            //
            // szChrFN varsa → .n3chr (skeleton + built-in parts)
            // szChrFN boşsa → ayrı joint + anim dosyaları
            // ============================================================
            // Open-KO birebir: CPlayerBase::InitChr (PlayerBase.cpp:2035)
            // C++: m_Chr.LoadFromFile(pLooks->szChrFN) — SADECE skeleton yüklenir.
            // Part'lar InitChr sonrası PartSet ile eklenir (GameProcMain.cpp:2144-2155).
            //
            // Unity'de BuildWithExternalParts'a boş dizi geçerek sadece skeleton oluşturuyoruz.
            // Sonra C++ akışını birebir takip ederek PartSet ile default part'ları ekliyoruz.
            // Bu sayede tüm part'lar PART_{index}_ prefix'li oluşur ve çift model sorunu olmaz.
            // ============================================================

            // Skeleton (.n3chr) dosya yolunu belirle
            string chrPath = null;
            if (!string.IsNullOrEmpty(pLooks.szChrFN))
            {
                chrPath = Import.N3CharBuilder.FindAssetFile(pLooks.szChrFN);
            }

            GameObject charModel = null;
            if (chrPath != null && KOBinaryProvider.Exists(chrPath))
            {
                // C++ birebir: m_Chr.LoadFromFile(pTbl->szChrFN)
                charModel = Import.N3CharBuilder.BuildWithExternalParts(
                    chrPath, new string[0]);
            }
            else if (!string.IsNullOrEmpty(pLooks.szJointFN))
            {
                // C++ birebir: PlayerBase.cpp:2040-2055 — else dalı
                //   m_Chr.JointSet(pTbl->szJointFN);
                //   m_Chr.AniCtrlSet(pTbl->szAniFN);
                Debug.Log($"[WORLD] szChrFN boş — JointSet+AniCtrlSet ile deneniyor: " +
                          $"'{pLooks.szJointFN}', '{pLooks.szAniFN}'");
                string jointPath = Import.N3CharBuilder.FindAssetFile(pLooks.szJointFN);
                charModel = Import.N3CharBuilder.BuildWithJointAndAnim(
                    jointPath, pLooks.szAniFN);
            }

            if (charModel == null)
            {
                Debug.LogWarning($"[WORLD] Karakter modeli yüklenemedi (race={eRace})");
                return;
            }

            charModel.transform.SetParent(player.transform);
            charModel.transform.localPosition = Vector3.zero;
            charModel.transform.localRotation = Quaternion.identity;
            charModel.transform.localScale = Vector3.one;

            // ============================================================
            // Open-KO birebir: MsgRecv_MyInfo_All (GameProcMain.cpp:1838-2196)
            // C++ akış sırası:
            //   1. InitChr(pLooks) → skeleton  (satır 1868)
            //   2. Inventory slot'ları → PartSet ile item giydirme (satır 2016-2099)
            //   3. Boş kalan slot'lar → default part (satır 2144-2155)
            //   4. InitFace() + InitHair() (satır 2152-2155)
            //
            // C++'da hepsi tek senkron fonksiyon. Unity'de inventory event async
            // olduğundan KOEquipmentVisualizer henüz attach olmadan event kaçırılabiliyor.
            // Bu yüzden adım 3-4'ü burada senkron olarak uyguluyoruz.
            // Tüm part'lar PartSet ile PART_{index}_ prefix'li oluşturulur.
            // KOEquipmentVisualizer geldiğinde PartRemove + PartSet ile temiz üzerine yazar.
            // ============================================================

            // C++ satır 2144-2151: boş slot'lar → default part
            // UPPER, LOWER, HANDS, FEET — FACE ve HAIR özel işlenecek
            for (int i = 0; i < Import.N3CharBuilder.PART_POS_COUNT && i < pLooks.szPartFNs.Length; i++)
            {
                if (i == Import.N3CharBuilder.PART_POS_FACE) continue;
                if (i == Import.N3CharBuilder.PART_POS_HAIR_HELMET) continue;

                if (!string.IsNullOrEmpty(pLooks.szPartFNs[i]))
                {
                    Import.N3CharBuilder.PartSet(charModel, i, pLooks.szPartFNs[i]);
                }
            }

            // C++ satır 2152-2153: InitFace()
            byte iFace = GameManager.Instance?.PlayerFace ?? 0;
            Import.N3CharBuilder.InitFace(charModel, pLooks, iFace);

            // C++ satır 2154-2155: InitHair()
            byte iHair = GameManager.Instance?.PlayerHairColor ?? 0;
            Import.N3CharBuilder.InitHair(charModel, pLooks, iHair);

            // 1. Modelin mesh sınırlarını hesapla (özellikle en alt noktasını bul)
            // Parçalar (part) ve yüz/saç yüklendikten sonra renderer bounds'ları mevcuttur.
            var renderers = charModel.GetComponentsInChildren<Renderer>();
            float bottomOffsetY = 0f;
            if (renderers.Length > 0)
            {
                Bounds worldBounds = renderers[0].bounds;
                for (int ri = 1; ri < renderers.Length; ri++)
                    worldBounds.Encapsulate(renderers[ri].bounds);

                // Modelin en alt noktasının charModel pivotuna olan mesafesi
                bottomOffsetY = worldBounds.min.y - charModel.transform.position.y;
            }

            // Emniyet kontrolü: Eğer hesaplanan değer mantıksızsa (örneğin model yüklenirken hatalı bounds aldıysa) 0 kabul et
            if (bottomOffsetY < -2f || bottomOffsetY > 2f)
                bottomOffsetY = 0f;

            // 2. Unity CharacterController skinWidth telafisi:
            // CharacterController zemine skinWidth (0.08) kadar havada kalacak şekilde basar.
            // Karakter ayaklarının zeminle tam buluşması için hem pivot kaymasını hem de skinWidth'i telafi ediyoruz.
            var cc = player.GetComponent<CharacterController>();
            float ccSkin = (cc != null) ? cc.skinWidth : 0.08f;

            // 3. Kalibrasyon payı:
            // Animasyonlar (nefes alma, koşma) sırasında hip/kemik hareketleri karakteri yukarı kaldırabilir.
            // Ayrıca Unity fizik toleransları nedeniyle ayakların yere tam basmasını sağlamak için küçük bir ek kalibrasyon uyguluyoruz.
            // (Ayakların yere hafifçe basması/gömülmesi, havada kalmasından çok daha doğal durur).
            float calibrationOffset = 0.05f; // 5 cm ek aşağı kaydırma

            float finalYOffset = -bottomOffsetY - ccSkin - calibrationOffset;
            charModel.transform.localPosition = new Vector3(0f, finalYOffset, 0f);

            Debug.Log($"[WORLD] Local player model bounds calculation - bottomOffsetY: {bottomOffsetY:F4}, ccSkin: {ccSkin:F4}, calibrationOffset: {calibrationOffset:F4}, finalYOffset: {finalYOffset:F4}");

            if (GameManager.Instance != null && GameManager.Instance.CapeId > 0)
            {
                int jointCloak = pLooks.iJointCloak;
                Import.N3CharBuilder.PlugSet(charModel, $"Item\\cloak_{GameManager.Instance.CapeId:D3}.n3cplug", jointCloak, "PLUG_BACK");
            }

            // Animasyonu başlat + diagnostic
            var anim = charModel.GetComponent<Animation>();
            if (anim == null)
            {
                Debug.LogError("[WORLD] ❌ Animation component bulunamadı! T-pose olacak.");
            }
            else if (anim.clip == null)
            {
                Debug.LogError("[WORLD] ❌ Animation clip atanmamış! T-pose olacak.");
                // Tüm clip'leri listele
                int clipCount = 0;
                foreach (AnimationState st in anim)
                {
                    Debug.Log($"[WORLD-ANIM] Mevcut clip: '{st.name}' length={st.length:F2}s");
                    clipCount++;
                    if (clipCount == 1 && anim.clip == null)
                    {
                        // İlk clip'i default olarak ata
                        anim.clip = st.clip;
                        anim.clip.wrapMode = WrapMode.Loop;
                        anim.Play(st.name);
                        Debug.Log($"[WORLD] Fallback: ilk clip '{st.name}' default olarak atandı");
                    }
                }
                Debug.Log($"[WORLD-ANIM] Toplam clip: {clipCount}");
            }
            else
            {
                anim.clip.wrapMode = WrapMode.Loop;
                anim.Play();
                Debug.Log($"[WORLD] ✅ Animasyon başlatıldı: '{anim.clip.name}' " +
                    $"isPlaying={anim.isPlaying} legacy={anim.clip.legacy}");
                
                // Bone match kontrolü — ilk skeleton bone'un hierarchy'de var olduğunu doğrula
                if (charModel.transform.childCount > 0)
                {
                    var firstChild = charModel.transform.GetChild(0);
                    bool isBone = firstChild.GetComponent<SkinnedMeshRenderer>() == null 
                               && firstChild.GetComponent<MeshRenderer>() == null;
                    Debug.Log($"[WORLD-ANIM] İlk child: '{firstChild.name}' isBone={isBone} " +
                        $"childCount={firstChild.childCount}");
                    
                    // Hierarchy dump (ilk 3 seviye)
                    for (int ci = 0; ci < charModel.transform.childCount && ci < 5; ci++)
                    {
                        var ch = charModel.transform.GetChild(ci);
                        bool chIsBone = ch.GetComponent<SkinnedMeshRenderer>() == null 
                                     && ch.GetComponent<MeshRenderer>() == null;
                        Debug.Log($"[WORLD-ANIM]   [{ci}] '{ch.name}' (bone={chIsBone})");
                    }
                }
            }

            Debug.Log($"[WORLD] ✅ KO karakter modeli yüklendi (race={eRace}, chr='{pLooks.szChrFN}' face={iFace} hair={iHair})");

            // ============================================================
            // DEBUG: Player hierarchy dump — çift model ve T-pose teşhisi
            // ============================================================
            Debug.Log($"[WORLD-DIAG] Player hierarchy dump (childCount={player.transform.childCount}):");
            DumpHierarchy(player.transform, "  ", 4);

            // Model yeniden oluşturulduğunda PlayerController'ın eski Animation cache'i geçersiz olur
            var pc = player.GetComponent<EntropyOnline.Character.PlayerController>();
            if (pc != null)
            {
                // PlayerAnimClips null ise, Animation component'taki clip'leri kaydet
                // BuildWithExternalParts normalde set eder ama suffix kaldırma
                // veya dosya bulunamama durumunda null kalabilir
                var gm2 = GameManager.Instance;
                if (gm2 != null && (gm2.PlayerAnimClips == null || gm2.PlayerAnimClips.Count == 0))
                {
                    if (anim != null)
                    {
                        // szAniFN doğrudan anim dosya yolunu içerir (ör: "Chr\upc_el_rm.n3Anim")
                        string animFileName = pLooks.szAniFN;
                        if (string.IsNullOrEmpty(animFileName))
                        {
                            // Fallback: szChrFN veya szJointFN'den türet
                            string baseSrc = !string.IsNullOrEmpty(pLooks.szChrFN) ? pLooks.szChrFN : pLooks.szJointFN;
                            if (!string.IsNullOrEmpty(baseSrc))
                            {
                                string baseName = System.IO.Path.GetFileNameWithoutExtension(baseSrc);
                                string[] clsSuffixes = { "_wa", "_rog", "_pri", "_wiz", "_ma" };
                                foreach (string sfx in clsSuffixes)
                                {
                                    if (baseName.EndsWith(sfx))
                                    {
                                        baseName = baseName.Substring(0, baseName.Length - sfx.Length);
                                        break;
                                    }
                                }
                                animFileName = "Chr\\" + baseName + ".n3anim";
                            }
                        }

                        if (!string.IsNullOrEmpty(animFileName))
                        {
                            string chrAnimPath = Import.N3CharBuilder.FindAssetFile(animFileName);
                            if (chrAnimPath != null && KOBinaryProvider.Exists(chrAnimPath))
                            {
                                var animCtrl = Import.N3CPartImporter.LoadAnimControl(chrAnimPath);
                                if (animCtrl != null && animCtrl.Animations.Count > 0)
                                {
                                    var chrData = gm2.PlayerChrData;
                                    if (chrData?.RootJoint != null)
                                    {
                                        var jointPaths = Import.N3AnimBuilder.BuildJointPaths(chrData.RootJoint);
                                        var rebuiltClips = Import.N3AnimBuilder.BuildClips(chrData, animCtrl, jointPaths);
                                        if (rebuiltClips.Count > 0)
                                        {
                                            gm2.PlayerAnimClips = rebuiltClips;
                                            Debug.Log($"[WORLD] PlayerAnimClips yeniden oluşturuldu: {rebuiltClips.Count} clip ({chrAnimPath})");
                                        }
                                    }
                                }
                            }
                            else
                            {
                                Debug.LogWarning($"[WORLD] Chr anim dosyası bulunamadı: {animFileName} (resolved={chrAnimPath})");
                            }
                        }
                    }
                }
                
                pc.InvalidateAnimCache();
                // Open-KO birebir: CPlayerBase::InitChr sonrası → AniCurSet(ANI_BREATH)
                // Model rebuild sonrası idle animasyonunu başlat — T-pose önleme
                pc.StartCoroutine(ForceIdleAnimNextFrame(pc));
            }

            // Open-KO birebir: CPlayerBase::InitChr sonrası isim gösterimi
            // C++ SetSoundAndInitFont() → font oluştur/göster
            // Oyuncu karakterinin üzerinde isim göster
            var existingFloat = player.GetComponent<FloatingName>();
            if (existingFloat != null) DestroyImmediate(existingFloat);
            // Eski NameCanvas'ı da temizle
            var oldCanvas = player.transform.Find("NameCanvas");
            if (oldCanvas != null) DestroyImmediate(oldCanvas.gameObject);

            string playerName = GameManager.Instance?.CharacterName ?? "Player";
            var floatingName = player.AddComponent<FloatingName>();
            // Oyuncu modeli için yükseklik — Open-KO birebir: başın hemen üstünde
            float nameHeight = 2.3f;
            floatingName.Initialize(playerName, false, nameHeight);
            // Oyuncu ismi beyaz renk olmalı (NPC sarı, Monster kırmızı, Player beyaz)
            // FloatingName.Initialize NPC/Monster renk ayarlar — oyuncu için override
            var nameText = floatingName.GetComponentInChildren<UnityEngine.UI.Text>();
            if (nameText != null)
                nameText.color = Color.white;
            
            // Open-KO birebir: CPlayerMySelf::SetSoundAndInitFont() — PlayerMySelf.cpp:1021-1043
            // m_pClanFont->SetText(m_InfoExt.szKnights) + SetFontColor(KNIGHTS_FONT_COLOR)
            string clanName = GameManager.Instance?.ClanName;
            if (!string.IsNullOrEmpty(clanName))
                floatingName.SetClanName(clanName);

            // Eğer aktif olarak parti arıyorsa kafasının üstündeki yeşil bilgi metni doğrudan oluşturulur
            if (GameManager.Instance != null && GameManager.Instance.RecruitParty)
            {
                int level = GameManager.Instance.Level;
                int iLMin = Mathf.Min(level - 8, (int)(level / 1.5f));
                if (iLMin < 1) iLMin = 1;
                int iLMax = Mathf.Max(level + 8, (int)(level * 1.5f));
                if (iLMax > 80) iLMax = 80;
                string szMsg = $"Seeking Party : Level {iLMin} ~ {iLMax}";
                floatingName.SetInfoText(szMsg, new Color(0f, 1f, 0f, 1f));
            }
            
            // Open-KO birebir: CPlayerMySelf::KnightsInfoSet() — runtime clan değişikliği
            // Clan oluşturma/katılma/ayrılma anında nameplate güncellenir
            if (UI.KOKnightsManager.Instance != null)
            {
                UI.KOKnightsManager.Instance.OnKnightsInfoChanged -= OnPlayerClanChanged;
                UI.KOKnightsManager.Instance.OnKnightsInfoChanged += OnPlayerClanChanged;
            }
            
            Debug.Log($"[WORLD] ✅ Oyuncu ismi eklendi: '{playerName}' clan='{clanName}'");
        }

        /// <summary>
        /// Open-KO birebir: CPlayerMySelf::KnightsInfoSet() callback
        /// Clan oluşturma/katılma/ayrılma anında oyuncu nameplate'ini günceller.
        /// </summary>
        private void OnPlayerClanChanged()
        {
            var player = GameObject.FindGameObjectWithTag("Player");
            if (player == null) player = GameObject.Find("Player");
            if (player == null) return;
            
            var fn = player.GetComponent<FloatingName>();
            if (fn != null)
            {
                string clanName = UI.KOKnightsManager.Instance?.ClanName ?? "";
                fn.SetClanName(clanName);
                Debug.Log($"[WORLD] Clan nameplate güncellendi: '{clanName}'");
            }

            var charModel = player.transform.childCount > 0 ? player.transform.GetChild(0).gameObject : null;
            if (charModel != null && GameManager.Instance != null)
            {
                short capeId = UI.KOKnightsManager.Instance != null ? UI.KOKnightsManager.Instance.CapeId : (short)0;
                if (capeId > 0)
                {
                    byte eRace = GameManager.Instance.Race;
                    if (KOEquipmentVisualizer.s_pTbl_UPC_Looks != null &&
                        KOEquipmentVisualizer.s_pTbl_UPC_Looks.TryGetValue(eRace, out var pLooks))
                    {
                        int jointCloak = pLooks.iJointCloak;
                        Import.N3CharBuilder.PlugSet(charModel, $"Item\\cloak_{capeId:D3}.n3cplug", jointCloak, "PLUG_BACK");
                    }
                }
                else
                {
                    Import.N3CharBuilder.PlugRemove(charModel, "PLUG_BACK");
                }
            }
        }

        /// <summary>
        /// Open-KO birebir: CPlayerBase::InitChr sonrası ANI_BREATH başlatma.
        /// Model rebuild sonrası yeni Animation component'ı hazır olana kadar
        /// bir frame bekleyip idle animasyonu başlatır — T-pose önleme.
        /// </summary>
        private static System.Collections.IEnumerator ForceIdleAnimNextFrame(
            EntropyOnline.Character.PlayerController pc)
        {
            // Yeni model child'ları bu frame sonunda hazır olur
            yield return null;
            // İkinci frame — Animation component kesinlikle erişilebilir
            yield return null;

            if (pc == null) yield break;

            // Cache'i tekrar sıfırla (yeni Animation component'ı bulsun)
            pc.InvalidateAnimCache();

            // Open-KO: AniCurSet(ANI_BREATH, false) — idle animasyonu
            pc.ForcePlayIdle();
            Debug.Log("[WORLD] ✅ Model rebuild sonrası idle animasyon başlatıldı (T-pose fix)");
        }

        /// <summary>
        /// Open-KO birebir: CPlayerOther::InitFace/InitHair (PlayerOther.cpp:172-201)
        ///
        /// C++ akışı:
        ///   _splitpath(pItem->szPartFNs[FACE].c_str(), nullptr, szDir, szFName, szExt);
        ///   szFN = fmt::format("{}{}{:02}{}", szDir, szFName, iFace, szExt);
        ///
        /// Yani: directory + filename + index(2 haneli) + extension
        /// Örn: "Item\upc_el_rm_face" + ".n3cpart" → "Item\upc_el_rm_face00.n3cpart"
        /// </summary>
        private string ApplyFaceHairIndex(string partFileName, int index)
        {
            if (string.IsNullOrEmpty(partFileName)) return partFileName;

            // C++ _splitpath birebir: directory, filename, extension ayır
            string dir = System.IO.Path.GetDirectoryName(partFileName);
            string fileName = System.IO.Path.GetFileNameWithoutExtension(partFileName);
            string ext = System.IO.Path.GetExtension(partFileName);

            // C++ birebir: fmt::format("{}{}{:02}{}", szDir, szFName, index, szExt)
            // _splitpath dir sonunda separator var, Path.Combine ile aynı etkiyi sağlıyoruz
            string result;
            if (!string.IsNullOrEmpty(dir))
                result = dir + System.IO.Path.DirectorySeparatorChar + fileName + index.ToString("D2") + ext;
            else
                result = fileName + index.ToString("D2") + ext;

            return result;
        }

        /// <summary>
        /// Open-KO birebir: NPC/Monster modeli yüklerken kullanılacak cache'i doldurur.
        /// C++ client'ta NPC entity'leri asla lokal veriden oluşturulmaz.
        /// Sadece sunucudan gelen MsgRecv_NPCIn (WIZ_NPC_INOUT / WIZ_REQ_NPCIN) ile entity yaratılır.
        /// 
        /// Bu metod K_NPCPOS + K_MONSTER + K_NPC + NPC_Looks.tbl verilerini okuyup
        /// _monsterDefCache ve _monsterLooksCache'i doldurur.
        /// EntityManager.HandleSpawnMonster → BuildMonsterModelByResourceId bu cache'i kullanır.
        /// </summary>
        private void CacheMonsterData()
        {
            // 1. NPC_Looks.tbl yükle — PID→.n3chr eşlemesi (cache'li, sadece 1 kez diskten okunur)
            var npcLooks = GetNpcLooksTable();
            if (npcLooks.Count == 0)
            {
                Debug.LogWarning("[WORLD] NPC_Looks.tbl yüklenemedi");
                return;
            }

            // 2. K_NPCPOS verilerini SQL dosyasından oku (zone filtrelemeli)
            var npcPositions = LoadNpcPositionsFromSql(_currentZoneId);
            if (npcPositions.Count == 0)
            {
                Debug.Log($"[WORLD] Zone {_currentZoneId} için K_NPCPOS verisi yok");
                return;
            }

            // 3. Monster tablolarını yükle — NPC tablosu da yükle (EntityManager NPC byType bilgisi için)
            var monPidMap = LoadMonsterPidMap();     // K_MONSTER → SID→(Name, PID, Size)
            var npcPidMap = LoadNpcPidMap();         // K_NPC → SID→(Name, PID, Size, ByType)

            int cachedMon = 0, cachedNpc = 0;

            foreach (var npcPos in npcPositions)
            {
                // Open-KO birebir: actType < 100 → K_MONSTER, actType >= 100 → K_NPC
                bool isNpc = npcPos.ActType >= 100;

                if (!isNpc)
                {
                    // Monster model cache — EntityManager.HandleSpawnMonster kullanacak
                    if (monPidMap.TryGetValue(npcPos.NpcId, out var monInfo))
                    {
                        _monsterDefCache[npcPos.NpcId] = monInfo;
                        if (npcLooks.TryGetValue((uint)monInfo.Pid, out var monLooks))
                            _monsterLooksCache[npcPos.NpcId] = monLooks;
                        cachedMon++;
                    }
                }
                else
                {
                    // NPC model cache — resourceId üzerinden NPC_Looks erişimi için
                    if (npcPidMap.TryGetValue(npcPos.NpcId, out var npcInfo))
                    {
                        _monsterDefCache[npcPos.NpcId] = npcInfo;
                        if (npcLooks.TryGetValue((uint)npcInfo.Pid, out var npcLookEntry))
                            _monsterLooksCache[npcPos.NpcId] = npcLookEntry;
                        cachedNpc++;
                    }
                }
            }

            Debug.Log($"[WORLD] Cache tamamlandı — NPC: {cachedNpc}, Monster: {cachedMon} (zone {_currentZoneId})");
        }

        /// <summary>
        /// K_NPCPOS SQL dosyasından belirtilen zone'un NPC pozisyonlarını okur.
        /// Open-KO birebir: AIServerApp::LoadNpcPosTable()
        /// </summary>
        private struct PathPoint
        {
            public int x, z;
        }

        private struct NpcPosData
        {
            public int NpcId;
            public int ActType;
            public int LeftX, TopZ, RightX, BottomZ;
            public int NumNPC;
            public int Direction;
            public int DotCnt;
            public PathPoint[] PathPoints;
        }

        private List<NpcPosData> LoadNpcPositionsFromSql(short zoneId)
        {
            var results = new List<NpcPosData>();
            string sqlPath = System.IO.Path.Combine(
                System.IO.Path.GetDirectoryName(Application.dataPath),
                "..", "openko-db", "ManualSetup", "6_InsertData_K_NPCPOS.sql");

            if (!KOBinaryProvider.Exists(sqlPath))
            {
                Debug.LogWarning($"[WORLD] K_NPCPOS SQL bulunamadı: {sqlPath}");
                return results;
            }

            string zonePrefix = $"({zoneId},";
            foreach (string line in System.IO.File.ReadLines(sqlPath))
            {
                string trimmed = line.Trim();
                if (!trimmed.StartsWith(zonePrefix)) continue;

                string clean = trimmed.TrimEnd(',', ')').TrimStart('(');
                int nIdx = clean.IndexOf(", N'");
                if (nIdx > 0) clean = clean.Substring(0, nIdx);
                int nullIdx = clean.IndexOf(", NULL");
                if (nullIdx > 0) clean = clean.Substring(0, nullIdx);

                string[] parts = clean.Split(',');
                if (parts.Length < 11) continue;

                if (!int.TryParse(parts[1].Trim(), out int npcId)) continue;
                if (!int.TryParse(parts[2].Trim(), out int actType)) continue;
                if (!int.TryParse(parts[7].Trim(), out int leftX)) continue;
                if (!int.TryParse(parts[8].Trim(), out int topZ)) continue;
                if (!int.TryParse(parts[9].Trim(), out int rightX)) continue;
                if (!int.TryParse(parts[10].Trim(), out int bottomZ)) continue;

                int numNpc = 1;
                if (parts.Length > 15)
                    int.TryParse(parts[15].Trim(), out numNpc);
                if (numNpc < 1) numNpc = 1;

                int direction = 0, dotCnt = 0;
                if (parts.Length > 17)
                    int.TryParse(parts[17].Trim(), out direction);
                if (parts.Length > 18)
                    int.TryParse(parts[18].Trim(), out dotCnt);

                // Path string parse — Open-KO birebir: "%04d%04d" per point
                PathPoint[] pathPoints = null;
                if (dotCnt > 0)
                {
                    int pathStart = trimmed.IndexOf("N'");
                    if (pathStart >= 0)
                    {
                        int pathQuoteStart = trimmed.IndexOf("'", pathStart) + 1;
                        int pathQuoteEnd = trimmed.IndexOf("'", pathQuoteStart);
                        if (pathQuoteEnd > pathQuoteStart)
                        {
                            string pathStr = trimmed.Substring(pathQuoteStart, pathQuoteEnd - pathQuoteStart);
                            int pointCount = Mathf.Min(dotCnt, pathStr.Length / 8);
                            if (pointCount > 0)
                            {
                                pathPoints = new PathPoint[pointCount];
                                for (int p = 0; p < pointCount; p++)
                                {
                                    int offset = p * 8;
                                    if (offset + 8 <= pathStr.Length)
                                    {
                                        int.TryParse(pathStr.Substring(offset, 4), out pathPoints[p].x);
                                        int.TryParse(pathStr.Substring(offset + 4, 4), out pathPoints[p].z);
                                    }
                                }
                            }
                        }
                    }
                }

                results.Add(new NpcPosData
                {
                    NpcId = npcId,
                    ActType = actType,
                    LeftX = leftX, TopZ = topZ,
                    RightX = rightX, BottomZ = bottomZ,
                    NumNPC = numNpc,
                    Direction = direction,
                    DotCnt = dotCnt,
                    PathPoints = pathPoints
                });
            }

            return results;
        }

