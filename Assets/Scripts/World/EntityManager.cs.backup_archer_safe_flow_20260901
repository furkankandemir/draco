                int spart2 = Mathf.Abs(pSkill.SelfPart1 / 1000);



                // satır 1770: s_pFX->TriggerBundle(iSourceID, spart1, iSelfFX1, iSourceID, spart1, -1)

                fxMgr.TriggerBundle((int)sourceId, spart1, pSkill.SelfFX1, (int)sourceId, spart1, -1);

