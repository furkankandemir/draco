                // Open-KO'da HP güncellemesi WIZ_HP_CHANGE ile ayrı paket olarak gelir,

                // bizim mimarimizde S2C_ATTACK_RESULT içinde geldiği için burada yapılır.

                UpdateLinkedKOEntityHp(targetId, targetHp);



                if (targetDied)

                {

