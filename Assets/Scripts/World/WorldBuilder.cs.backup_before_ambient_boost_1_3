            }

            foreach (string line in System.IO.File.ReadLines(sqlPath))
            {
                string trimmed = line.Trim();
                if (!trimmed.StartsWith("(")) continue;

                string clean = trimmed.TrimEnd(',', ')').TrimStart('(');
                int firstComma = clean.IndexOf(',');
                if (firstComma < 0) continue;
                string sidStr = clean.Substring(0, firstComma).Trim();
                if (!int.TryParse(sidStr, out int sid)) continue;

                int nameStart = clean.IndexOf("N'", firstComma);
                if (nameStart < 0) nameStart = clean.IndexOf("'", firstComma);
                if (nameStart < 0) continue;
                int quoteStart = clean.IndexOf("'", nameStart) + 1;
                int quoteEnd = clean.IndexOf("'", quoteStart);
                if (quoteEnd < 0) continue;
                string name = clean.Substring(quoteStart, quoteEnd - quoteStart);

                string afterName = clean.Substring(quoteEnd + 1);
                string[] afterParts = afterName.Split(',');
                if (afterParts.Length < 3) continue;
                if (!int.TryParse(afterParts[1].Trim(), out int pid)) continue;
                int.TryParse(afterParts[2].Trim(), out int size);
