        /// <summary>
        /// Convert edilmiş KOZoneAsset'ten zone'u yükler.
        /// Runtime parse yapmaz — tüm asset'ler önceden bake edilmiştir.
        /// </summary>
        private void LoadConvertedZone(KOZoneAsset za)
        {
            var sw = System.Diagnostics.Stopwatch.StartNew();

            if (!IsIndoor)
            {
                LoadConvertedTerrain(za);
            }
            else
            {
            }
            LoadConvertedObjects(za);
            LoadConvertedWater(za);
            LoadConvertedLights(za);

            // Sky/Fog
            if (za.skyboxMaterial != null)
                RenderSettings.skybox = za.skyboxMaterial;
            else
                CreateSkyAndFog();

            sw.Stop();
        }

        /// <summary>
        /// Convert edilmiş TerrainData'dan terrain oluştur.
        /// </summary>
        private void LoadConvertedTerrain(KOZoneAsset za)
        {
            if (za.terrainData == null)
            {
                Debug.LogError("[WORLD] Convert edilmiş terrainData null!");
                return;
            }

            var terrainObj = Terrain.CreateTerrainGameObject(za.terrainData);
            terrainObj.name = $"KOTerrain_{_currentZoneId}";
            _terrain = terrainObj.GetComponent<Terrain>();
            _terrainWorldSize = za.worldSize;

            // Terrain rendering ayarları
            _terrain.basemapDistance = 100000f;
            _terrain.drawInstanced = true;
            _terrain.heightmapPixelError = 5f;
            _terrain.reflectionProbeUsage = UnityEngine.Rendering.ReflectionProbeUsage.Off;
            terrainObj.transform.position = new Vector3(0, za.terrainBaseY, 0);

            var terrainMat = Resources.Load<Material>($"TerrainAssets/Zone_{_currentZoneId}_Terrain_Mat");
            if (terrainMat != null)
            {
                _terrain.materialTemplate = terrainMat;
            }

            var collider = terrainObj.GetComponent<TerrainCollider>();
            if (collider != null) collider.terrainData = za.terrainData;

            RenderSettings.fog = false;
        }

        /// <summary>
        /// Convert edilmiş shape'lerden obje oluştur.
        /// Mesh ve Material zaten Unity asset — sadece instantiate.
        /// </summary>
        private void LoadConvertedObjects(KOZoneAsset za)
        {
            if (za.shapes == null || za.shapes.Length == 0)
            {
                Debug.LogError("[WORLD] Convert edilmiş shape verisi bulunamadı!");
                return;
            }

            _objectsParent = new GameObject("KOObjects");
            int placed = 0;

            System.Collections.Generic.List<KOShapeEntry> allShapes = new System.Collections.Generic.List<KOShapeEntry>(za.shapes);
            if (_currentZoneId == 21)
            {
                bool hasKarusGate = false;
                bool hasElMoradGate = false;
                foreach (var shape in za.shapes)
                {
                    if (shape.npcID == 211 || shape.name == "obj_ka_transmark00") hasKarusGate = true;
                    if (shape.npcID == 212 || shape.name == "obj_el_transmark00") hasElMoradGate = true;
                }
                if (!hasKarusGate)
                {
                    var kGate = new KOShapeEntry();
                    kGate.name = "obj_ka_transmark00";
                    kGate.position = new Vector3(282.04f, 8.94f, 373.94f);
                    kGate.rotation = Quaternion.identity;
                    kGate.scale = new Vector3(304.5818f, 304.5818f, 304.5818f);
                    kGate.npcID = 211;
                    kGate.eventType = 5;
                    kGate.eventID = 4014;
                    kGate.isCustom = true;
                    allShapes.Add(kGate);
                }
                if (!hasElMoradGate)
                {
                    var eGate = new KOShapeEntry();
                    eGate.name = "obj_el_transmark00";
                    eGate.position = new Vector3(338.10f, 8.72f, 318.10f);
                    eGate.rotation = Quaternion.identity;
                    eGate.scale = new Vector3(304.5818f, 304.5818f, 304.5818f);
                    eGate.npcID = 212;
                    eGate.eventType = 5;
                    eGate.eventID = 4013;
                    eGate.isCustom = true;
                    allShapes.Add(eGate);
                }
            }

            foreach (var shape in allShapes)
            {
                if (shape.position.sqrMagnitude < 0.001f) continue;
                if ((shape.eventType == 8 && (shape.eventID < 5001 || shape.eventID > 5005)) || IsAnvilShape(shape.name)) continue;

                if (_currentZoneId == 1)
                {
                    shape.isCustom = true; // Karus haritasında tüm nesneleri custom olarak işaretle (yükseklik snapping'ini önler ve collider üretir)
                }


                bool isKarusGate = shape.npcID == 211 || (!string.IsNullOrEmpty(shape.name) && shape.name.StartsWith("obj_ka_transmark") && 
                    !shape.name.Contains("_gr") && !shape.name.Contains("_post") && !shape.name.Contains("_magic") && !shape.name.Contains("_wall") && !shape.name.Contains("_water"));
                
                bool isElMoradGate = shape.npcID == 212 || (!string.IsNullOrEmpty(shape.name) && shape.name.StartsWith("obj_el_transmark") && 
                    !shape.name.Contains("_gr") && !shape.name.Contains("_post") && !shape.name.Contains("_magic") && !shape.name.Contains("_wall") && !shape.name.Contains("_water") && !shape.name.Contains("00_"));

                bool isKarusGatePart = !string.IsNullOrEmpty(shape.name) && shape.name.StartsWith("obj_ka_transmark") && !isKarusGate;
                bool isElMoradGatePart = !string.IsNullOrEmpty(shape.name) && shape.name.StartsWith("obj_el_transmark") && !isElMoradGate;

                // Eski kapının diğer alt parça shape'lerini (gr, post, magic, water) ve diğer town kapılarını üretme
                if (!string.IsNullOrEmpty(shape.name) && (isElMoradGatePart || isKarusGatePart))
                {
                    continue;
                }

                var shapeObj = new GameObject(string.IsNullOrEmpty(shape.name) ? $"Shape_{placed}" : shape.name);
                shapeObj.transform.SetParent(_objectsParent.transform);
                
                Vector3 spawnPos = shape.position;
                if (_terrain != null && (!shape.isCustom || isKarusGate))
                {
                    float terrainHeight = _terrain.transform.position.y + _terrain.SampleHeight(new Vector3(spawnPos.x, 0, spawnPos.z));
                    if (Mathf.Abs(spawnPos.y - terrainHeight) < 15.0f)
                    {
                        spawnPos.y = terrainHeight;
                    }
                }
                shapeObj.transform.position = spawnPos;
                if (shape.rotation.w != 0 || shape.rotation.x != 0 ||
                    shape.rotation.y != 0 || shape.rotation.z != 0)
                    shapeObj.transform.rotation = shape.rotation;
                
                // Kapının boyutu ayarlandığı gibi kalsın
                if (isElMoradGate || isKarusGate)
                {
                    shapeObj.transform.localScale = new Vector3(304.5818f, 304.5818f, 304.5818f);
                }
                else
                {
                    shapeObj.transform.localScale = shape.scale;
                }

                // Part'ları oluştur
                float nameHeight = 3.8f;

                if (isElMoradGate || isKarusGate)
                {

                    GameObject gatePrefab = null;
                    if (isElMoradGate)
                    {
                        gatePrefab = Resources.Load<GameObject>("Prefabs/Runic_Spiral_Portal/Runic_Spiral_Portal");
                    }
                    else if (isKarusGate)
                    {
                        gatePrefab = Resources.Load<GameObject>("Prefabs/Meshy_AI_Portal_of_the_Enchant_0627204643_texture");
                    }

                    if (gatePrefab != null)
                    {
                        var portalInst = Instantiate(gatePrefab, shapeObj.transform);
                        portalInst.transform.localPosition = Vector3.zero;
                        if (isElMoradGate)
                        {
                            portalInst.transform.localRotation = Quaternion.Euler(-90f, 0f, 0f);
                            portalInst.transform.localScale = Vector3.one;
                        }
                        else
                        {
                            // Prefab'ın varsayılan rotasyonuna 90 derece Y (sağa döndürme) ekle ve ölçeğini %20 arttır
                            portalInst.transform.localRotation = Quaternion.Euler(0f, 90f, 0f) * gatePrefab.transform.localRotation;
                            portalInst.transform.localScale = Vector3.one * 0.8f;
                        }

                        // Zemin hizalamasını otomatik yap (pivot merkezde olduğu için yerin altına girmesini engeller)
                        var renderers = portalInst.GetComponentsInChildren<Renderer>();
                        if (renderers != null && renderers.Length > 0)
                        {
                            Bounds bounds = renderers[0].bounds;
                            for (int i = 1; i < renderers.Length; i++)
                            {
                                bounds.Encapsulate(renderers[i].bounds);
                            }
                            float currentBottom = bounds.min.y;
                            float targetBottom = shapeObj.transform.position.y;
                            float yDiff = targetBottom - currentBottom;
                            float buryOffset = isElMoradGate ? -1.0f : 0.0f; // El Morad 1m gömülüyor, Karus zemine sıfırlanıyor (gömülme yok)
                            portalInst.transform.position += new Vector3(0f, yDiff + buryOffset, 0f);
                            nameHeight = bounds.max.y - shapeObj.transform.position.y;
                        }

                    }
                    else
                    {
                        Debug.LogError($"[WORLD] Could not load prefab for {shape.name}!");
                    }
                }
                else if (TryApplyEventShapeVisualOverride(shapeObj, shape.eventID))
                {
                    // Override visual applied, skip loading original parts!
                }
                else if (shape.parts != null && shape.parts.Length > 0)
                {
                    foreach (var part in shape.parts)
                    {
                        if (part.mesh == null) continue;
                        if (part.mesh.name == "obj_co_itemup_tble" || 
                            part.mesh.name == "obj_co_itemup_table" || 
                            part.mesh.name == "obj_co_itemup_fx00" || 
                            part.mesh.name == "obj_co_itemup_fx01") continue;

                        var partObj = new GameObject(part.mesh.name ?? "Part");
                        partObj.transform.SetParent(shapeObj.transform);
                        partObj.transform.localPosition = part.pivot;
                        partObj.transform.localRotation = Quaternion.identity;
                        partObj.transform.localScale = Vector3.one;

                        var mf = partObj.AddComponent<MeshFilter>();
                        mf.sharedMesh = part.mesh;

                        var mr = partObj.AddComponent<MeshRenderer>();

                        // Her katı objeye fiziksel çarpışma ekle
                        if (part.mesh != null)
                        {
                            // Bush, çalı, ot, çiçek gibi objelere collider EKLEME
                            string shapeLower = (shape.name ?? "").ToLowerInvariant();
                            bool skipCollider = shapeLower.Contains("bush") || shapeLower.Contains("grass")
                                || shapeLower.Contains("plant") || shapeLower.Contains("flower")
                                || shapeLower.Contains("hedge") || shapeLower.Contains("shrub")
                                || shapeLower.Contains("weed") || shapeLower.Contains("fern")
                                || shapeLower.Contains("water") || shapeLower.Contains("river")
                                || shapeLower.Contains("pond") || shapeLower.Contains("lake")
                                || shapeLower.Contains("sea") || shapeLower.Contains("ocean");

                            if (!skipCollider)
                            {
                                Mesh collMesh = part.colliderMesh;

                                // Fallback: colliderMesh yoksa ve mesh readable ise runtime'da gövde çıkar
                                if (collMesh == null && part.mesh.isReadable && part.mesh.subMeshCount > 1
                                    && part.materials != null && part.materials.Length > 1)
                                {
                                    var trunkTri = new List<int>();
                                    for (int si = 0; si < part.mesh.subMeshCount; si++)
                                    {
                                        bool isLeaf = false;
                                        if (si < part.materials.Length && part.materials[si] != null)
                                        {
                                            string mn = part.materials[si].name.ToLowerInvariant();
                                            isLeaf = mn.Contains("leaf") || mn.Contains("branch")
                                                  || mn.Contains("leaves") || mn.Contains("foliage")
                                                  || mn.Contains("bush") || mn.Contains("hedge")
                                                  || mn.Contains("shrub") || mn.Contains("cone");
                                        }
                                        if (!isLeaf)
                                            trunkTri.AddRange(part.mesh.GetTriangles(si));
                                    }
                                    if (trunkTri.Count > 0 && trunkTri.Count < part.mesh.triangles.Length)
                                    {
                                        collMesh = new Mesh();
                                        collMesh.vertices = part.mesh.vertices;
                                        collMesh.triangles = trunkTri.ToArray();
                                        collMesh.RecalculateBounds();
                                    }
                                }


                                var mc = partObj.AddComponent<MeshCollider>();
                                mc.sharedMesh = collMesh != null ? collMesh : part.mesh;
                            }
                        }

                        // Eğer obje ismi invisible/collider/collision içeriyorsa MeshRenderer'ı kapat (Görünmez Engel)
                        if (!string.IsNullOrEmpty(shape.name))
                        {
                            string lowerName = shape.name.ToLowerInvariant();
                            if (lowerName.Contains("invisible") || lowerName.Contains("collider") || lowerName.Contains("collision"))
                            {
                                mr.enabled = false;
                            }
                        }

                        // Material instance oluştur ve render flag'leri runtime'da uygula
                        // (birebir CreateMeshMaterial ile aynı — URP serialize sorunu yok)
                        var mat = part.material != null
                            ? new Material(part.material)
                            : new Material(Shader.Find("Universal Render Pipeline/Lit") ?? Shader.Find("Standard"));

                        uint rf = part.renderFlags;
                        uint srcBlend = part.srcBlend;
                        uint destBlend = part.destBlend;

                        bool hasAlphaBlend = (rf & 0x1) != 0;
                        bool hasDiffuseAlpha = (rf & 0x80) != 0;

                        bool isAdditiveBlend = hasAlphaBlend && (
                            (srcBlend == 2 && destBlend == 2) ||
                            (srcBlend == 5 && destBlend == 2) ||
                            (srcBlend == 2 && destBlend == 6));

                        if (isAdditiveBlend)
                        {
                            mat.SetFloat("_Surface", 1);
                            mat.SetOverrideTag("RenderType", "Transparent");
                            mat.renderQueue = (int)UnityEngine.Rendering.RenderQueue.Transparent;
                            mat.SetInt("_SrcBlend", (int)UnityEngine.Rendering.BlendMode.One);
                            mat.SetInt("_DstBlend", (int)UnityEngine.Rendering.BlendMode.One);
                            mat.SetFloat("_ZWrite", 0);
                            mat.EnableKeyword("_SURFACE_TYPE_TRANSPARENT");
                            mat.DisableKeyword("_ALPHATEST_ON");
                            if (mat.HasProperty("_AlphaClip"))
                                mat.SetFloat("_AlphaClip", 0);
                            if (mat.HasProperty("_Cull"))
                                mat.SetFloat("_Cull", 0);
                        }
                        else if (hasAlphaBlend || hasDiffuseAlpha)
                        {
                            mat.SetFloat("_Surface", 1);
                            mat.SetOverrideTag("RenderType", "Transparent");
                            mat.renderQueue = (int)UnityEngine.Rendering.RenderQueue.Transparent;
                            mat.SetInt("_SrcBlend", (int)UnityEngine.Rendering.BlendMode.SrcAlpha);
                            mat.SetInt("_DstBlend", (int)UnityEngine.Rendering.BlendMode.OneMinusSrcAlpha);
                            mat.SetFloat("_ZWrite", 0);
                            mat.EnableKeyword("_SURFACE_TYPE_TRANSPARENT");
                            if (mat.HasProperty("_Cull"))
                                mat.SetFloat("_Cull", 0);
                        }
                        else
                        {
                            // Alpha cutout — texture alpha varsa
                            var tex = mat.HasProperty("_BaseMap") 
                                ? mat.GetTexture("_BaseMap") as Texture2D : null;
                            if (tex != null && HasTransparentPixels(tex) && mat.HasProperty("_AlphaClip"))
                            {
                                mat.SetFloat("_AlphaClip", 1);
                                mat.SetFloat("_Cutoff", 0.53f);
                                mat.SetOverrideTag("RenderType", "TransparentCutout");
                                mat.renderQueue = (int)UnityEngine.Rendering.RenderQueue.AlphaTest;
                                mat.EnableKeyword("_ALPHATEST_ON");
                            }
                        }

                        if ((rf & 0x100) != 0 || (rf & 0x400) != 0)
                            mat.SetFloat("_ZWrite", 0);

                        if ((rf & 0x1) != 0 || (rf & 0x8) != 0 || (rf & 0x4) != 0)
                        {
                            if (mat.HasProperty("_Cull"))
                                mat.SetFloat("_Cull", 0);
                        }

                        // Terrain Exporter ile export edilmiş objelerde materials dizisi var
                        // (ağaçlar gibi multi-submesh mesh'lerde her submesh'e doğru material atanır)
                        if (part.materials != null && part.materials.Length > 0)
                        {
                            mr.sharedMaterials = part.materials;
                        }
                        else
                        {
                            mr.material = mat;
                        }

                        // RenderFlags-based components
                        if ((rf & 0x8) != 0) // RF_BOARD_Y
                            partObj.AddComponent<BillboardY>();
                        if ((rf & 0x20) != 0) // RF_WINDY
                            partObj.AddComponent<WindyPart>();
                        if (part.animTextures != null && part.animTextures.Length > 1)
                        {
                            var anim = partObj.AddComponent<TextureAnimPart>();
                            anim.Initialize(part.animTextures, part.texFPS > 0 ? part.texFPS : 10f);
                        }
                    }
                }

                // Event shape
                if (shape.eventID != 0)
                {
                    var worldEvent = shapeObj.AddComponent<KOWorldEvent>();
                    worldEvent.EventID = shape.eventID;
                    worldEvent.EventType = shape.eventType;
                    worldEvent.NPC_ID = shape.npcID;

                    if (shapeObj.GetComponent<Collider>() == null)
                    {
                        var meshFilters = shapeObj.GetComponentsInChildren<MeshFilter>();
                        foreach (var mfEvt in meshFilters)
                        {
                            if (mfEvt.sharedMesh != null)
                            {
                                var mc = mfEvt.gameObject.AddComponent<MeshCollider>();
                                mc.sharedMesh = mfEvt.sharedMesh;
                                mc.convex = false;
                            }
                        }
                    }

                    if (isElMoradGate || isKarusGate)
                    {
                        var koEntity = shapeObj.AddComponent<KOEntity>();
                        koEntity.EntityName = isElMoradGate ? "El Morad Gate" : "Karus Gate";
                        koEntity.IsNpc = true;
                        koEntity.ActType = 2; // Gate NPC
                        koEntity.IsObjectNpc = true;
                        koEntity.ServerInstanceId = (uint)shape.npcID;
                        koEntity.NpcId = shape.eventID;
                        koEntity.Nation = (byte)(isElMoradGate ? 2 : 1); // 2 = El Morad, 1 = Karus
                        
                        var interactBtn = shapeObj.AddComponent<KONpcInteractButton>();
                        interactBtn.Initialize(koEntity);
                        interactBtn.UpdateHeight(nameHeight);
                        CreateGateLightBeam(shapeObj, isKarusGate);
                    }
                }

                placed++;
            }


        }

    private void CreateGateLightBeam(GameObject gateObj, bool isKarus)
    {
        var beam = GameObject.CreatePrimitive(PrimitiveType.Cylinder);
        beam.name = "GateLightBeam";
        
        var col = beam.GetComponent<Collider>();
        if (col != null) Destroy(col);
        
        beam.transform.SetParent(gateObj.transform);
        beam.transform.localPosition = new Vector3(0f, 10f / gateObj.transform.localScale.y, 0f);
        
        float parentScale = gateObj.transform.localScale.y;
        
        // Thinner width: 1.5 meters instead of 5 meters
        beam.transform.localScale = new Vector3(1.5f / parentScale, 10f / parentScale, 1.5f / parentScale);
        beam.transform.localRotation = Quaternion.identity;
        
        // Add dynamic animation effect script
        var effect = beam.AddComponent<GateBeamEffect>();
        effect.baseWidth = 1.5f;
        effect.baseHeight = 20f;
        effect.parentScale = parentScale;
        effect.isKarus = isKarus;
        
        var renderer = beam.GetComponent<MeshRenderer>();
        if (renderer != null)
        {
            renderer.shadowCastingMode = UnityEngine.Rendering.ShadowCastingMode.Off;
            renderer.receiveShadows = false;
            
            Shader shader = Shader.Find("Universal Render Pipeline/Unlit") ?? Shader.Find("Sprites/Default") ?? Shader.Find("Standard");
            var mat = new Material(shader);
            
            Color beamColor = new Color(0.85f, 0.95f, 1.0f, 0.40f);
            if (mat.HasProperty("_Color")) mat.SetColor("_Color", beamColor);
            if (mat.HasProperty("_BaseColor")) mat.SetColor("_BaseColor", beamColor);
            
            var beamTex = Resources.Load<Texture2D>("KOTextures/fx/object/1123me_laser/me_laser0000") ?? 
                          Resources.Load<Texture2D>("KOTextures/Misc/dust_soft");
            if (beamTex != null)
            {
                if (mat.HasProperty("_MainTex")) mat.SetTexture("_MainTex", beamTex);
                if (mat.HasProperty("_BaseMap")) mat.SetTexture("_BaseMap", beamTex);
            }
            
            
            mat.SetFloat("_Surface", 1);
            mat.SetOverrideTag("RenderType", "Transparent");
            mat.renderQueue = (int)UnityEngine.Rendering.RenderQueue.Transparent;
            mat.SetInt("_SrcBlend", (int)UnityEngine.Rendering.BlendMode.SrcAlpha);
            mat.SetInt("_DstBlend", (int)UnityEngine.Rendering.BlendMode.OneMinusSrcAlpha);
            mat.SetFloat("_ZWrite", 0);
            mat.EnableKeyword("_SURFACE_TYPE_TRANSPARENT");
            
            renderer.material = mat;
        }
    }

        private bool TryApplyEventShapeVisualOverride(GameObject shapeObj, int eventId)
        {
            if (eventId >= 5001 && eventId <= 5005)
            {
                string overridePrefabPath = $"Monster/Overrides/{eventId}";
                if (!string.IsNullOrEmpty(overridePrefabPath))
                {
                    GameObject prefab = Resources.Load<GameObject>(overridePrefabPath);
                    if (prefab != null)
                    {
                        GameObject customVisual = Instantiate(prefab, shapeObj.transform);
                        customVisual.transform.localPosition = Vector3.zero;
                        customVisual.transform.localRotation = prefab.transform.localRotation;
                        customVisual.transform.localScale = prefab.transform.localScale;
                        
                        Animator animator = customVisual.GetComponentInChildren<Animator>();
                        if (animator != null)
                        {
                            animator.enabled = true;
                        }
                        
                        
                        return true;
                    }
                }
            }
            return false;
        }

        private static bool IsAnvilShape(string name)
        {
            if (string.IsNullOrEmpty(name)) return false;
            string normalized = name.Trim().ToLowerInvariant();
            return normalized == "obj_co_itemup_tble.n3pmesh" || 
                   normalized == "obj_co_itemup_tble" || 
                   normalized == "obj_co_itemup_table.n3pmesh" || 
                   normalized == "obj_co_itemup_table" || 
                   normalized == "obj_co_itemup_fx00.n3pmesh" || 
                   normalized == "obj_co_itemup_fx00" || 
