        /// <summary>
        /// NPC_Looks.tbl'yi diskten yükle (ilk çağrıda) veya cache'ten döndür.
        /// C++ birebir: s_pTbl_NPC_Looks uygulama başında bir kez yüklenir.
        /// </summary>
        private Dictionary<uint, KOImport.NpcLooksTblParser.NpcLooksEntry> GetNpcLooksTable()
        {
            if (_npcLooksTableFull == null)
            {
                string tblPath = System.IO.Path.Combine("", "Data", "NPC_Looks.tbl");
                _npcLooksTableFull = KOImport.NpcLooksTblParser.Load(tblPath);
            }
            return _npcLooksTableFull;
        }

        // Open-KO birebir sabitler:
        // WarFareMain.cpp:94-98 — s_Options.iViewDist = 512 (min=256, max=512)
        // GameDef.h:1278-1279 — SOUND_RANGE_TO_SET=10, SOUND_RANGE_TO_RELEASE=20
        private const float KO_VIEW_DIST = 512f;
        private const float KO_NAME_SHOW_DIST = 10f;    // SOUND_RANGE_TO_SET (GameDef.h:1278)
        private const float KO_NAME_HIDE_DIST = 20f;    // SOUND_RANGE_TO_RELEASE (GameDef.h:1279)

        /// <summary>
        /// S2C_SPAWN_MONSTER geldiğinde EntityManager bu metodu çağırır.
        /// Open-KO birebir: WIZ_NPC_INOUT → client entity oluşturur.
        /// </summary>
        public GameObject BuildMonsterModel(int defId, out string monsterName, out int monsterSize)
        {
            monsterName = "Unknown";
            monsterSize = 100;

            if (!_monsterDefCache.TryGetValue(defId, out var defData))
            {
                // Cache henüz dolmamışsa, K_MONSTER'dan yükle
                if (_monsterDefCache.Count == 0)
                {
                    _monsterDefCache = LoadMonsterPidMap();
                }
                if (!_monsterDefCache.TryGetValue(defId, out defData))
                    return null;
            }

            monsterName = defData.Name;
            monsterSize = defData.Size;

            if (!_monsterLooksCache.TryGetValue(defId, out var looks))
            {
                // Looks cache'te yoksa tam tablodan ara (tablo sadece 1 kez diskten okunur)
                var allLooks = GetNpcLooksTable();
                if (allLooks.TryGetValue((uint)defData.Pid, out var entry))
                {
                    _monsterLooksCache[defId] = entry;
                    looks = entry;
                }
                else
                    return null;
            }

            return Import.N3CharBuilder.BuildFromLooks(looks);
        }

        /// <summary>
        /// C++ birebir: GameProcMain.cpp:2921 — s_pTbl_NPC_Looks.Find(iIDResrc)
        /// Sunucu paketindeki resourceId (iIDResrc) doğrudan NPC_Looks.tbl ID'sidir.
        /// K_MONSTER tablosuna gerek yok — doğrudan NPC_Looks'tan model yükle.
        /// </summary>
        public GameObject BuildMonsterModelByResourceId(int resourceId, out int monsterSize, bool isNpc = false)
        {
            monsterSize = 100;

            // Magic Anvils are handled at map load time as event shapes, so return null here
            // to let EntityManager link the spawned NPC to the static scene shapeObj.
            if (resourceId >= 5001 && resourceId <= 5005)
            {
                return null;
            }

            // Resolve monster size from definition if available
            if (_monsterDefCache != null)
            {
                foreach (var def in _monsterDefCache.Values)
                {
                    if (def.Pid == resourceId)
                    {
                        monsterSize = def.Size;
                        break;
                    }
                }
            }

            // Directly load our custom monster/NPC prefab by resourceId (Looks ID)
            string overridePrefabPath = $"Monster/Overrides/{resourceId}";
            GameObject prefab = Resources.Load<GameObject>(overridePrefabPath);
            if (prefab != null)
            {
                GameObject overrideObj = UnityEngine.Object.Instantiate(prefab);
                overrideObj.name = $"NPC_{resourceId}_override";
                
                Animator animator = overrideObj.GetComponentInChildren<Animator>();
                if (animator != null)
                {
                    animator.enabled = true;
                }
                
                return overrideObj;
            }

            Debug.LogWarning($"[WORLD] No custom prefab found for NPC/Monster resourceId={resourceId}. Load skipped.");
            return null;
        }

        public int GetMonsterLooksId(int resourceId)
        {
            if (_monsterLooksCache.TryGetValue(resourceId, out var looks))
            {
                return (int)looks.Id;
            }
            return 0;
        }

        private void Awake()
        {
            if (Instance != null && Instance != this) { Destroy(gameObject); return; }
            Instance = this;
            KONpcOverrideManager.ClearCache();
        }

        private void Start()
        {
            // Zone ID: GameManager'dan al (karakter seçiminde set edilir)
            // Inspector override sadece GameManager yoksa veya 0 ise kullanılır
            _currentZoneId = 0;
            if (GameManager.Instance != null && GameManager.Instance.CurrentZoneId > 0)
            {
                _currentZoneId = GameManager.Instance.CurrentZoneId;
            }
            else if (inspectorZoneId > 0)
            {
                _currentZoneId = inspectorZoneId;
            }
            if (_currentZoneId == 0) _currentZoneId = 21; // Son fallback: Moradon
            
            CreateSun();

            // Convert edilmiş zone asset'i dene — yoksa eski runtime parse
            _currentZoneAsset = Resources.Load<KOZoneAsset>($"KOZones/zone_{_currentZoneId}");
            if (_currentZoneAsset != null)
            {
                LoadConvertedZone(_currentZoneAsset);
            }
            else
            {
                Debug.LogError($"[WORLD] Convert edilmiş zone asset bulunamadı: zone_{_currentZoneId}");
            }

            // GameSceneSetup placeholder objelerini gizle
            HidePlaceholders();

            // Oyuncuyu terrain üzerine yerleştir
            RepositionPlayer();

            // Open-KO birebir: CGameBase::Init() → Item_Org + Item_Ext tablo yükleme
            // GameBase.cpp:59-79 — s_pTbl_Items_Basic + s_pTbl_Items_Exts[MAX_ITEM_EXTENSION]
            if (!KOImport.ItemDataManager.IsLoaded)
            {
                string koDataDir = System.IO.Path.Combine("", "Data");
                KOImport.ItemDataManager.LoadAll(koDataDir);
            }

            // Open-KO birebir: NPC'ler lokal dosyadan spawn EDİLMEZ.
            // C++ client sadece sunucudan gelen MsgRecv_NPCIn (WIZ_NPC_INOUT) ile entity oluşturur.
            // Burada sadece monster model cache'ini dolduruyoruz — EntityManager.HandleSpawnMonster kullanacak.
            CacheMonsterData();

            // Target selection sistemi — tap ile entity seçme
            gameObject.AddComponent<KOTargetSelector>();

            // Open-KO birebir: camera far plane = iViewDist (WarFareMain.cpp:94)
            // GameEng.cpp:251 — fFP = s_Options.iViewDist * m_fFPDeltaCur
            // WarFareMain.cpp:94-98 — iViewDist = ini.GetInt("ViewPort", "Distance", 512); min=256, max=512
            var mainCam = UnityEngine.Camera.main;
            if (mainCam != null)
            {
                mainCam.farClipPlane = KO_VIEW_DIST;

                // Force enable URP Post-Processing on the Main Camera at runtime
                var cameraData = mainCam.GetComponent<UnityEngine.Rendering.Universal.UniversalAdditionalCameraData>();
                if (cameraData == null)
                    cameraData = mainCam.gameObject.AddComponent<UnityEngine.Rendering.Universal.UniversalAdditionalCameraData>();
                if (cameraData != null)
                    cameraData.renderPostProcessing = true;
            }

            LoadZoneEventFile(_currentZoneId);
        }

        /// <summary>
        /// Open-KO birebir: CN3Chr::Tick() satır 1452-1457
        /// Kameradan uzak entity'leri gizle (LOD -1 → render edilmez).
        /// PlayerOtherMgr::Tick() — SOUND_RANGE_TO_SET/RELEASE ile isim gösterim kontrolü.
        /// </summary>
        private void LateUpdate()
        {
            var cam = UnityEngine.Camera.main;
            if (cam == null) return;

            Vector3 camPos = cam.transform.position;

            // Open-KO birebir: PlayerOtherMgr::Tick(vPosPlayer) satır 76
            // FloatingName mesafesi OYUNCU pozisyonundan hesaplanır, kameradan değil.
            // CN3Chr::Tick entity culling için kamera mesafesi kullanır — bu ayrı.
            Vector3 playerPos = camPos; // fallback
            if (_playerTransform != null)
                playerPos = _playerTransform.position;
            else
            {
                // Cache'i yenilemeyi dene
                var player = GameObject.FindGameObjectWithTag("Player");
                if (player == null) player = GameObject.Find("Player");
                if (player != null)
                {
                    _playerTransform = player.transform;
                    playerPos = _playerTransform.position;
                }
            }

            // Tick PVS Manager if active
            if (_pvsManager != null)
            {
                _pvsManager.Tick(playerPos);
            }

            // Tüm KOEntity'leri bul ve mesafeye göre gizle/göster
            var entities = FindObjectsByType<KOEntity>(FindObjectsInactive.Exclude);
            foreach (var entity in entities)
            {
                if (entity == null) continue;

                // CN3Chr::Tick() satır 1452-1457:
                // if (fDist > s_CameraData.fFP + m_fRadius * 2.0f) { m_nLOD = -1; return; }
                // Entity render on/off — kamera mesafesi
                float camDist = Vector3.Distance(camPos, entity.transform.position);
                bool shouldRender = camDist <= KO_VIEW_DIST;

                // Renderer'ları aç/kapat (GameObject'i deaktif etmek yerine — collider raycast için kalmalı)
                var renderers = entity.GetComponentsInChildren<Renderer>();
                foreach (var r in renderers)
                    r.enabled = shouldRender;

                // FloatingName kontrolü — SOUND_RANGE_TO_SET/RELEASE
                // Open-KO birebir: PlayerOtherMgr::Tick() satır 77-80, 108-111
                // Mesafe oyuncu pozisyonundan hesaplanır (vPosPlayer)
                float playerDist = Vector3.Distance(playerPos, entity.transform.position);
                var floatingName = entity.GetComponent<FloatingName>();
                if (floatingName != null)
                {
                    // Hysteresis: 10 birimde göster, 20 birimde gizle
                    if (playerDist < KO_NAME_SHOW_DIST)
                        floatingName.SetVisible(true);
                    else if (playerDist > KO_NAME_HIDE_DIST)
                        floatingName.SetVisible(false);
                }
            }
        }


        /// <summary>
