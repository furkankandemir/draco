        /// <summary>
        /// Convert edilmiş su mesh'lerini yükle.
        /// </summary>
        private void LoadConvertedWater(KOZoneAsset za)
        {
            bool hasWater = (za.rivers != null && za.rivers.Length > 0) ||
                            (za.ponds != null && za.ponds.Length > 0);
            if (!hasWater) return;

            var waterObj = new GameObject("WaterSystem");
            waterObj.transform.SetParent(transform, false);

            // River'lar
            if (za.rivers != null)
            {
                foreach (var river in za.rivers)
                {
                    if (river.mesh == null) continue;
                    var rObj = new GameObject("River");
                    rObj.transform.SetParent(waterObj.transform, false);
                    var mf = rObj.AddComponent<MeshFilter>();
                    mf.sharedMesh = river.mesh;
                    var mr = rObj.AddComponent<MeshRenderer>();
                    mr.sharedMaterial = river.material;
                }
            }

            // Pond'lar
            if (za.ponds != null)
            {
                foreach (var pond in za.ponds)
                {
                    if (pond.mesh == null) continue;
                    var pObj = new GameObject("Pond");
                    pObj.transform.SetParent(waterObj.transform, false);
                    var mf = pObj.AddComponent<MeshFilter>();
                    mf.sharedMesh = pond.mesh;
                    var mr = pObj.AddComponent<MeshRenderer>();
                    mr.sharedMaterial = pond.material;
                }
            }

            // WaterRenderer'ı da ekle — caustic animasyon ve UV scroll için
            var wr = waterObj.AddComponent<WaterRenderer>();
            wr.InitializeFromConverted(za);

        }

        /// <summary>
        /// Convert edilmiş ışıkları yükle.
        /// </summary>
        private void LoadConvertedLights(KOZoneAsset za)
        {
            if (za.lights == null || za.lights.Length == 0) return;

            var lightsParent = new GameObject("ZoneLights");
            lightsParent.transform.SetParent(transform, false);

            foreach (var ld in za.lights)
            {
                if (!ld.isOn) continue;

                var lightObj = new GameObject($"ZoneLight_{ld.name}");
                lightObj.transform.SetParent(lightsParent.transform);
                lightObj.transform.position = ld.position;
                lightObj.transform.rotation = ld.rotation;

                var light = lightObj.AddComponent<Light>();
                light.color = ld.diffuse;

                switch (ld.type)
                {
                    case 1: // Point
                        light.type = LightType.Point;
                        light.range = ld.range / 2f;
                        break;
                    case 2: // Spot
                        light.type = LightType.Spot;
                        light.range = ld.range;
                        light.spotAngle = ld.phi * Mathf.Rad2Deg;
                        break;
                    case 3: // Directional
                        light.type = LightType.Directional;
                        break;
                }

                light.intensity = 0.5f;
                light.shadows = LightShadows.None;
            }
        }

