        /// <summary>
        /// Karakter modelini dünyaya spawn eder.
        /// N3CharBuilder ile tam skeleton + skinned mesh + material pipeline.
        /// </summary>
        /// <param name="chrFileName">Karakter dosya adı (ör: "mob_goblin.n3chr")</param>
        /// <param name="worldPos">Dünya pozisyonu</param>
        /// <param name="yRotation">Y ekseni rotasyonu (derece)</param>
        /// <returns>Oluşturulan karakter GameObject'i</returns>
        public GameObject SpawnCharacter(string chrFileName, Vector3 worldPos, float yRotation = 0f)
        {
            string chrPath = System.IO.Path.Combine("", "Chr", chrFileName);

            var charObj = N3CharBuilder.Build(chrPath);
            if (charObj == null)
            {
                Debug.LogWarning($"[WORLD] Karakter yüklenemedi: {chrFileName}");
                return null;
            }

            charObj.transform.position = worldPos;
            charObj.transform.rotation = Quaternion.Euler(0, yRotation, 0);

            return charObj;
        }

