        private void CreateSkyAndFog()
        {
            // --- N3Sky dosyasından zone ortam verisini yükle ---
            // Open-KO: N3TerrainManager::InitWorld → m_pSky->LoadFromFile(pZone->szSkySetting)
            var zoneInfo = KOZoneMapper.GetZoneInfo(_currentZoneId);
            N3SkyImporter.N3SkyData skyData = null;

            if (zoneInfo != null && !string.IsNullOrEmpty(zoneInfo.SkyFile))
            {
                string skyPath = System.IO.Path.Combine("", zoneInfo.SkyFile);
                skyData = N3SkyImporter.Load(skyPath);
            }

            // --- Oyun saati hesapla ---
            // Open-KO: SetCheckGameTime(CONVERT_SEC(10, 0, 0)) — varsayılan sabah 10:00
            // FixedSunDirection > 0 ise o saati kullan
            uint gameTimeSec = 10 * 3600; // 10:00 AM default
            if (zoneInfo != null && zoneInfo.FixedSunDirection > 0)
                gameTimeSec = (uint)(zoneInfo.FixedSunDirection * 3600);

            // --- Sky Color ---
            Color skyColor = new Color(0.45f, 0.55f, 0.75f); // fallback
            Color fogColor = new Color(0.6f, 0.65f, 0.75f);  // fallback
            Color light0Color = Color.white;                   // fallback

            if (skyData != null)
            {
                skyColor = N3SkyImporter.GetSkyColorAtTime(skyData, gameTimeSec);
                fogColor = N3SkyImporter.GetFogColorAtTime(skyData, gameTimeSec);
                light0Color = N3SkyImporter.GetLight0ColorAtTime(skyData, gameTimeSec);

            }

            // --- Skybox ---
            // URP ve mat görüntüyü korumak ve NOWA Online havasını yakalamak için Polyart paketinin el çizimi 6-sided M_Castle_Skybox materyali yüklenir.
            var skyMat = Resources.Load<Material>("TerrainAssets/M_Castle_Skybox");
            if (skyMat != null)
            {
                RenderSettings.skybox = skyMat;
            }
            else
            {
                // Fallback (Bulunamazsa procedural oluştur)
                var fallbackSkyMat = new Material(Shader.Find("Skybox/Procedural"));
                if (fallbackSkyMat != null)
                {
                    fallbackSkyMat.SetColor("_SkyTint", skyColor);
                    fallbackSkyMat.SetColor("_GroundColor", fogColor * 0.6f);
                    fallbackSkyMat.SetFloat("_Exposure", 1.1f);
                    fallbackSkyMat.SetFloat("_SunSize", 0.06f);
                    fallbackSkyMat.SetFloat("_AtmosphereThickness", 1.2f);
                    RenderSettings.skybox = fallbackSkyMat;
                }
            }

            // Fog kapalı — terrain üzerinde yarı saydam kaplama oluşturuyordu
            RenderSettings.fog = false;

            // --- Sun/Directional Light rengini N3Sky Light0 verisiyle güncelle ---
            // Kullanıcı ek Unity ışığı istemiyor — sun intensity=0, color güncellemeye gerek yok
            // if (_sun != null)
            // {
            //     _sun.color = light0Color;
            // }

            // --- Ambient ---
            // Kullanıcı ek Unity ışıklandırması istemiyor — ambient=white tutularak
            // texture renkleri olduğu gibi görünsün
            RenderSettings.ambientLight = Color.white;

        }

