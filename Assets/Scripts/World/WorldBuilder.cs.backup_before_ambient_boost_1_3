        private GameObject CreateBoothPart(string partName, Mesh mesh, Texture2D texture, Transform parent, bool isCutout)
        {
            if (mesh == null)
            {
                Debug.LogWarning($"[WORLD] Pazar parçası yüklenemedi: {partName} mesh'i null");
                return null;
            }

            GameObject partObj = new GameObject(partName);
            partObj.transform.SetParent(parent, false);
            partObj.transform.localPosition = Vector3.zero;
            partObj.transform.localRotation = Quaternion.identity;
            partObj.transform.localScale = Vector3.one;

            var mf = partObj.AddComponent<MeshFilter>();
            mf.mesh = mesh;
            var mr = partObj.AddComponent<MeshRenderer>();

            var shader = Shader.Find("Universal Render Pipeline/Lit");
            if (shader == null) shader = Shader.Find("Standard");
            var mat = new Material(shader);

            if (texture != null)
            {
                if (mat.HasProperty("_BaseMap"))
                {
                    mat.SetTexture("_BaseMap", texture);
                    mat.SetTextureScale("_BaseMap", new Vector2(1f, -1f));
                    mat.SetTextureOffset("_BaseMap", new Vector2(0f, 1f));
                }
                else
                {
                    mat.mainTexture = texture;
                    mat.mainTextureScale = new Vector2(1f, -1f);
                    mat.mainTextureOffset = new Vector2(0f, 1f);
                }
            }

            if (mat.HasProperty("_BaseColor"))
                mat.SetColor("_BaseColor", Color.white);
            else
                mat.color = Color.white;

            if (isCutout)
            {
                mat.SetFloat("_AlphaClip", 1f);
                mat.SetFloat("_Cutoff", 0.5f);
                mat.EnableKeyword("_ALPHATEST_ON");
                mat.renderQueue = (int)UnityEngine.Rendering.RenderQueue.AlphaTest;
            }

            mr.material = mat;
            return partObj;
        }


        public void SpawnMerchantStall(int socketId, string message, int[] itemIds, bool isPremium, string sellerName, float x, float y, float z)
        {
            DespawnMerchantStall(socketId);

            Transform playerTransform = null;
            FloatingName fn = null;
            byte nation = 2; // Default El Morad

            if (GameManager.Instance != null && (GameManager.Instance.CharacterId == socketId || (short)GameManager.Instance.CharacterId == (short)socketId))
            {
                // Local player
                var playerObj = GameObject.FindGameObjectWithTag("Player") ?? GameObject.Find("Player");
                if (playerObj != null)
                {
                    playerTransform = playerObj.transform;
                    fn = playerObj.GetComponent<FloatingName>();
                    nation = GameManager.Instance.Nation;
                }
            }
            else
            {
                // Remote player
                var rp = EntityManager.Instance?.GetRemotePlayer(socketId);
                if (rp != null && rp.Root != null)
                {
                    playerTransform = rp.Root.transform;
                    fn = rp.Root.GetComponent<FloatingName>();
                    var rpe = rp.Root.GetComponent<RemotePlayerEntity>();
                    rpe?.Action(PlayerStateAction.PSA_SITDOWN);
                    if (rpe != null) nation = rpe.Nation;
                }
            }

            // Instantiate a visual stall parent object at the exact location
            GameObject stallObj = new GameObject($"Stall_{socketId}");
            stallObj.transform.position = new Vector3(x, y, z);
            if (playerTransform != null)
            {
                stallObj.transform.rotation = playerTransform.rotation;
            }
            else
            {
                stallObj.transform.rotation = Quaternion.identity;
            }

            if (isPremium)
            {
                // Orijinal Gold Pazar Kutusu Yükleme
                Mesh goldMesh = Resources.Load<Mesh>("KOModels/Object/Meshes/counter_g");
                Texture2D goldTex = Resources.Load<Texture2D>("KOTextures/Object/counterg2");
                if (goldMesh != null)
                {
                    CreateBoothPart("GoldMerchantBox", goldMesh, goldTex, stallObj.transform, false);
                }
            }
            else
            {
                // Orijinal Normal Pazar Kutusu Yükleme
                Mesh normalMesh = Resources.Load<Mesh>("KOModels/Object/Meshes/obj_counter");
                Texture2D normalTex = Resources.Load<Texture2D>("KOTextures/Object/counter");
                if (normalMesh != null)
                {
                    CreateBoothPart("NormalMerchantBox", normalMesh, normalTex, stallObj.transform, false);
                }
            }

            string playerName = sellerName;
            if (string.IsNullOrEmpty(playerName))
            {
                if (GameManager.Instance != null && (GameManager.Instance.CharacterId == socketId || (short)GameManager.Instance.CharacterId == (short)socketId))
                {
                    playerName = GameManager.Instance.CharacterName;
                }
                else
                {
                    var rp = EntityManager.Instance?.GetRemotePlayer(socketId);
                    if (rp != null) playerName = rp.Name;
                }
            }

            _merchantStalls[socketId] = stallObj;

            var billboard = stallObj.AddComponent<KOMerchantBillboard>();
            billboard.Initialize(socketId, playerName, itemIds);

            // Show the sign above player's head (persistent chat bubble) if local/remote entity is online here
            fn?.ShowChatBubble(message, new Color(0.1f, 0.9f, 0.4f), true);
        }

        public void DespawnMerchantStall(int socketId)
    {
        if (_merchantStalls.TryGetValue(socketId, out var stallObj))
        {
            if (stallObj != null) Destroy(stallObj);
            _merchantStalls.Remove(socketId);
        }

        FloatingName fn = null;

        if (GameManager.Instance != null && (GameManager.Instance.CharacterId == socketId || (short)GameManager.Instance.CharacterId == (short)socketId))
        {
            var playerObj = GameObject.FindGameObjectWithTag("Player") ?? GameObject.Find("Player");
            if (playerObj != null)
            {
                fn = playerObj.GetComponent<FloatingName>();
                var pc = playerObj.GetComponent<EntropyOnline.Character.PlayerController>();
                pc?.Action(PlayerStateAction.PSA_BASIC);
            }
        }
        else
        {
            var rp = EntityManager.Instance?.GetRemotePlayer(socketId);
            if (rp != null && rp.Root != null)
            {
                fn = rp.Root.GetComponent<FloatingName>();
                var rpe = rp.Root.GetComponent<RemotePlayerEntity>();
                rpe?.Action(PlayerStateAction.PSA_BASIC);
            }
        }

        // Remove persistent message
        fn?.ShowChatBubble(string.Empty, Color.clear);
    }

    /// <summary>
    /// Debug: Transform hierarchy'sini recursive log'a yazar.
    /// Çift model / T-pose teşhisi için.
    /// </summary>
    private void DumpHierarchy(Transform t, string indent, int maxDepth)
    {
        if (maxDepth <= 0) return;
        for (int i = 0; i < t.childCount; i++)
        {
            var child = t.GetChild(i);
            string components = "";
            if (child.GetComponent<Animation>() != null) components += "[Anim] ";
            if (child.GetComponent<SkinnedMeshRenderer>() != null) components += "[SMR] ";
            if (child.GetComponent<MeshRenderer>() != null) components += "[MR] ";
            if (child.GetComponent<MeshFilter>() != null) components += "[MF] ";

            DumpHierarchy(child, indent + "  ", maxDepth - 1);
        }
    }
}

public class GateBeamEffect : MonoBehaviour
{
    public float baseWidth = 1.5f;
    public float baseHeight = 20f;
    public float parentScale = 304.5818f;
    public bool isKarus = false;
    
    private Material mat;
    private float offset = 0f;
    
    void Start()
    {
        var renderer = GetComponent<MeshRenderer>();
        if (renderer != null) mat = renderer.material;
    }
    
    void Update()
    {
        // Rotate slowly on local Y axis
        transform.Rotate(0f, 60f * Time.deltaTime, 0f, Space.Self);
        
        // Pulsate scale smoothly to simulate breathing energy
        float pulse = Mathf.Sin(Time.time * 3f) * 0.1f;
        float currentWidth = (baseWidth + pulse) / parentScale;
        transform.localScale = new Vector3(currentWidth, (baseHeight / 2f) / parentScale, currentWidth);
        
        // Smoothly fade in and out color alpha (transparency) using sine wave
        if (mat != null)
        {
            Color baseColor = new Color(0.85f, 0.95f, 1.0f);
            float alpha = 0.15f + (Mathf.Sin(Time.time * 2f) + 1f) * 0.20f;
            
            Color finalColor = new Color(baseColor.r, baseColor.g, baseColor.b, alpha);
            if (mat.HasProperty("_Color")) mat.SetColor("_Color", finalColor);
            if (mat.HasProperty("_BaseColor")) mat.SetColor("_BaseColor", finalColor);
            
            // Scroll texture offset vertically upwards
            offset -= Time.deltaTime * 0.8f;
            if (mat.HasProperty("_MainTex")) mat.SetTextureOffset("_MainTex", new Vector2(0f, offset));
            if (mat.HasProperty("_BaseMap")) mat.SetTextureOffset("_BaseMap", new Vector2(0f, offset));
        }
    }
}
