            _eStateNext = PlayerStateAction.PSA_BASIC;
            _fFreezeTimeRemaining = 0f;
            StopUpperBodyLayer(); // Layer 1'deki atak animasyonunu durdur
            _currentAnim = null;  // PlayCharAnim'in wrapMode'u Loop olarak doğru set etmesi için
            PlayCharAnim("breath");
        }

        /// <summary>
        /// KOAnimResolver'ı lazy initialize et.
        /// Karakter modeli runtime'da yüklendiğinden,
        /// Animation component ilk ihtiyaç anında bulunur.
        /// </summary>
        private void EnsureAnimResolverInit()
        {
            if (_animResolver == null)
                _animResolver = new KOAnimResolver();

            if (_animResolver.ClipCount == 0)
            {
                var anim = GetComponentInChildren<Animation>();
                
                // 1. En güvenilir kaynak: Karakter modelindeki N3AnimClipRegistry
                if (_animRegistry == null && anim != null)
                {
                    _animRegistry = anim.GetComponent<EntropyOnline.Import.N3AnimClipRegistry>();
                }
                if (_animRegistry == null)
                {
                    _animRegistry = GetComponentInChildren<EntropyOnline.Import.N3AnimClipRegistry>();
                }

                if (_animRegistry != null && _animRegistry.ClipNames != null && _animRegistry.ClipNames.Length > 0)
                {
                    _animResolver.Initialize(_animRegistry.ClipNames, anim);
                }
                else
                {
                    // 2. İkinci kaynak: GameManager'daki sıralı list
                    var gm = GameManager.Instance;
                    bool hasOrderedClips = gm != null && gm.PlayerAnimClips != null && gm.PlayerAnimClips.Count > 0;
                    
                    if (hasOrderedClips)
                    {
                        _animResolver.Initialize(gm.PlayerAnimClips, anim);
                    }
                    else
                    {
                        // Fallback: Animation component'tan (sıra garantisiz!)
                        if (anim != null)
                        {
                            Debug.LogWarning($"[EnsureAnimResolver] FALLBACK: AnimationState foreach kullanılıyor — sıra GARANTİSİZ! anim='{anim.gameObject.name}'");
                            _animResolver.Initialize(anim);
                        }
                    }
                }
            }
        }

        /// <summary>
        /// R-atak için Animation component'ta "attack" isimli klip ara.
        /// KOAnimResolver index tabanlı olduğundan yanlış klip'e düşebilir —
        /// bu isim tabanlı arama fallback olarak kullanılır.
        /// </summary>
        private string FindAttackClipByName()
        {
            var anim = GetComponentInChildren<Animation>();
            if (anim == null) return null;

            // Öncelik sırası: "attack" > "atk" > "hit"
            string bestMatch = null;
            foreach (AnimationState state in anim)
            {
                string lname = state.name.ToLower();
                if (lname.Contains("attack"))
                    return state.name; // En iyi eşleşme
                if (bestMatch == null && lname.Contains("atk"))
                    bestMatch = state.name;
            }
            return bestMatch;
        }

        /// <summary>
        /// Open-KO birebir: CPlayerBase::IsMovingNow (PlayerBase.h:261-264)
        /// PSM_WALK || PSM_RUN || PSM_WALK_BACKWARD → true
        /// </summary>
        private bool IsMovingNow()
        {
            return _eStateMove == PlayerStateMove.PSM_WALK ||
                   _eStateMove == PlayerStateMove.PSM_RUN ||
                   _eStateMove == PlayerStateMove.PSM_WALK_BACKWARD;
        }

        /// <summary>
        /// Open-KO birebir: CPlayerBase::ActionMove (PlayerBase.cpp:1114-1169)
        ///
        /// State transition table ile hareket durumunu değiştirir:
        ///   1. IsDead → false
        ///   2. sStateTableMove[current][target] == 0 → aynı state, false
        ///   3. m_eStateNext = m_eState (geri dönüş state'ini kaydet)
        ///   4. m_eStateMove = eMove
        ///   5. Hareket durumuna göre animasyon seç:
        ///      PSM_STOP → JudgeAnimationBreath()
        ///      PSM_WALK → JudgeAnimationWalk()
        ///      PSM_RUN → JudgeAnimationRun()
        ///      PSM_WALK_BACKWARD → JudgeAnimationWalkBackward()
        ///   6. Action(PSA_BASIC, true)
        ///   7. AnimationClear() + AniCurSet(eAni)
        /// </summary>
        public bool ActionMove(PlayerStateMove eMove)
        {
            if (_isDead) return false;  // cpp:1116-1117

            // cpp:1119-1132: State transition table
            // Aynı state'e geçiş engellenir (diagonal 0'lar)
            if (_eStateMove == eMove) return false;  // cpp:1134

            // cpp:1137-1138
            _eStateNext = _eState;
            _eStateMove = eMove;

            // cpp:1140-1161: Hareket durumuna göre animasyon seç
            KOAni eAni = KOAni.ANI_UNKNOWN;
            switch (eMove)
            {
                case PlayerStateMove.PSM_STOP:
                    eAni = GetJudgeBreath();  // cpp:1144
                    break;
                case PlayerStateMove.PSM_WALK:
                    eAni = KOAnimJudge.JudgeAnimationWalk(false);  // cpp:1148
                    break;
                case PlayerStateMove.PSM_RUN:
                    eAni = KOAnimJudge.JudgeAnimationRun(false);  // cpp:1152
                    break;
                case PlayerStateMove.PSM_WALK_BACKWARD:
                    eAni = KOAnimJudge.JudgeAnimationWalkBackward(false);  // cpp:1156
                    break;
                default:
                    return false;
            }

            // cpp:1163
            Action(PlayerStateAction.PSA_BASIC, true);

            // cpp:1166-1167: AnimationClear + AniCurSet
            AnimationClear();
            if (eAni != KOAni.ANI_UNKNOWN)
            {
                EnsureAnimResolverInit();
                string clipName = _animResolver?.GetClipName(eAni);
                if (!string.IsNullOrEmpty(clipName))
                    PlayCharAnim(clipName);
            }

            return true;
        }

        /// <summary>
        /// Open-KO birebir: this->JudgeAnimationBreath() kısayolu.
        /// KOInventory'den sağ/sol el silah sınıfını okur ve KOAnimJudge'a devreder.
        ///
        /// C++ referans: PlayerBase.cpp:1451-1457
        ///   pTarget = TargetPointerCheck(false)
        ///   eICR = ItemClass_RightHand()
        ///   eICL = ItemClass_LeftHand()
        ///   fIWR = m_pItemPlugBasics[PLUG_POS_RIGHTHAND]->siWeight / 10.f
        /// </summary>
        private KOAni GetJudgeBreath()
        {
            var inv = UI.KOInventory.Instance;
            KOItemClass eICR = KOItemClass.ITEM_CLASS_UNKNOWN;
            KOItemClass eICL = KOItemClass.ITEM_CLASS_UNKNOWN;
            float fWeightR = 0f;

            if (inv != null)
            {
                var rightHand = inv.GetRightHandWeapon();
                var leftHand  = inv.GetLeftHandWeapon();

                if (rightHand != null && !rightHand.IsEmpty)
