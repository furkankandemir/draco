        /// <summary>
        /// Hedefe yürüme tick'i.
        /// Open-KO birebir: PlayerMySelf::TargetOrPosMove (PlayerMySelf.cpp:1100-1151)
        ///   - Her tick'te hedefin pozisyonuna doğru yürü
        ///   - Hedefe döndür
        ///   - Menzile girince → CommandEnableAttackContinous(true, pTarget) + dur
        /// </summary>
        private void TargetOrPosMove()
        {
            if (!_bTargetOrPosMove) return;

            // Open-KO birebir: pTarget = CharacterGetByID(m_iMoveTarget) — cpp:1109
            if (_moveTarget == null || !_moveTarget.gameObject.activeInHierarchy)
            {
                CancelMoveToTarget();
                return;
            }

            // Open-KO birebir: vDir = m_vTargetPos - Position() — cpp:1121-1123
            Vector3 dir = (_moveTarget.transform.position - transform.position);
            dir.y = 0;
            if (dir.sqrMagnitude < 0.001f) return;

            // Open-KO birebir: RotateTo(fYaw, true) — cpp:1126
            transform.rotation = Quaternion.LookRotation(dir.normalized);
            // C++ birebir: RotateTo(fYaw, true) — bImmediately=true → yaw'ı anında set et
            float fYawImm = Mathf.Atan2(dir.x, dir.z);
            while (fYawImm > Mathf.PI) fYawImm -= 2f * Mathf.PI;
            while (fYawImm < -Mathf.PI) fYawImm += 2f * Mathf.PI;
            _fYawCur = fYawImm;
            _fYawToReach = fYawImm;
            _fYawDirty = false;

            // Open-KO birebir: AttackableDistance hesapla — cpp:1132-1133
            float fDist = dir.magnitude;
            float playerRadius = _charController != null ? _charController.radius : 0.5f;
            float targetRadius = 0.5f;
            var targetCol = _moveTarget.GetComponent<CapsuleCollider>();
            if (targetCol != null)
                targetRadius = targetCol.radius * _moveTarget.transform.localScale.x;
            float fDistLimit = (playerRadius + targetRadius) / 2.0f;  // PlayerMySelf.cpp:735
            // Open-KO birebir: PlayerMySelf.cpp:736-740 — silah menzili ekle
            var wpn = GetEquippedRightHandWeapon();
            if (wpn != null && wpn.Range > 0)
                fDistLimit += wpn.Range / 10.0f;                 // cpp:737 — sağ el silah range
            else
            {
                // C++ birebir: PlayerMySelf.cpp:738-740
                var lhSlot = GetEquippedLeftHandItem();
                if (lhSlot != null && lhSlot.serverData != null && lhSlot.serverData.Range > 0)
                    fDistLimit += lhSlot.serverData.Range / 10.0f;
            }

            // Open-KO birebir: fDist < fDistLimit → saldırı başlat + dur — cpp:1135-1140
            if (fDist < fDistLimit)
            {
                KOEntity arrivedTarget = _moveTarget;  // referansı sakla
                CancelMoveToTarget();
                StartAutoAttack(arrivedTarget);
                return;
            }

            // Hedefe doğru yürü
            Vector3 moveDir = dir.normalized;
            // Open-KO birebir: speed = baseSpeed * m_fMoveDelta (PlayerBase.h:143)
            float hSpeed = moveSpeed * _fMoveDelta;
            Vector3 horizontalMove = moveDir * hSpeed;

            // Open-KO birebir: Dik yamaç tırmanma engeli (Slope Limit Check)
            if (CheckClimbCollision(moveDir, hSpeed * Time.deltaTime))
            {
                horizontalMove = Vector3.zero;
            }

            Vector3 velocity = horizontalMove + Vector3.up * _verticalVelocity;
            if (_charController != null && _charController.enabled)
                _charController.Move(velocity * Time.deltaTime);
            _wasMoving = true;

            // Yürüme animasyonu
            if (_eState == PlayerStateAction.PSA_ATTACK)
            {
                Action(PlayerStateAction.PSA_BASIC, true, true);
            }
            ActionMove(PlayerStateMove.PSM_RUN);
        }

