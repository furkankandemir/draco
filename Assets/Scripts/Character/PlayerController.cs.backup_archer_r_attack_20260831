        /// <summary>
        /// Respawn handler — ölüm state'ini sıfırla.
        /// Open-KO birebir: Regene() → m_fTimeAfterDeath = 0 + Action(PSA_BASIC)
        /// </summary>
        private void HandlePlayerRespawn(long charId, float x, float y, float z,
            int hp, int maxHp, int mp, int maxMp, long gold)
        {
            long myId = GameManager.Instance?.CharacterId ?? 0;
            if (charId != myId) return;

            _isDead = false;
            _fTimeAfterDeath = 0f;
            _bStun = false;
            _fStunTime = 0f;

            // Hareket state'lerini sıfırla
            _wasMoving = false;
            _eStateMove = PlayerStateMove.PSM_STOP;

            // Oto-saldırı ve hedefe yürüme iptal
            if (_bAttackContinous) StopAutoAttack();
            if (_bTargetOrPosMove) CancelMoveToTarget();

            // Pozisyonu güncelle
            transform.position = new Vector3(x, y, z);

            // State machine'i zorla sıfırla — PSA_DEATH → PSA_BASIC
            _eState = PlayerStateAction.PSA_BASIC;
            _eStateNext = PlayerStateAction.PSA_BASIC;
            Action(PlayerStateAction.PSA_BASIC, true, true);
            PlayCharAnim("breath");
        }

        /// <summary>
