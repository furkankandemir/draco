        private void Start()
        {
            _charController = GetComponent<CharacterController>();
            if (_charController == null)
                _charController = gameObject.AddComponent<CharacterController>();

            _charController.height = 2f;
            _charController.radius = 0.5f;
            _charController.center = Vector3.up;
            _charController.slopeLimit = 45f;    // Merdiven/rampa eğim limiti
            _charController.stepOffset = 0.5f;   // Basamak yüksekliği (KO merdivenleri)
            _charController.skinWidth = 0.08f;    // Collision skin

            _lastSentPosition = transform.position;

            // KOCastBar bileşenini ekle (yetenek ilerleme barı)
            gameObject.AddComponent<UI.KOCastBar>();

            // KOAnimResolver — lazy init (karakter modeli Start sonrası yüklenebilir)
            _animResolver = new KOAnimResolver();
            
            // Anlık warp event'ini dinle (Gate, Random TP, Summon)
            KOPacketHandler.OnWarp += HandleWarp_KO;

            // Saldırı sonucu event'ini dinle — MsgRecv_Attack birebir
            KOPacketHandler.OnAttackResult += HandleAttackResult_KO;
            KOPacketHandler.OnDead += HandleDead_KO;
            KOPacketHandler.OnRegene += HandleRegene_KO;

            // Open-KO birebir: MsgRecv_Effecting (MagicSkillMng.cpp:1866-1928)
            KOPacketHandler.OnMagicProcess += HandleMagicProcess_KO;
            KOPacketHandler.OnStealthInfo += HandleStealthInfo_KO;

            // CameraController referansı Initialize ile verilmediyse otomatik bul
            if (_cameraController == null)
            {
                var cam = global::UnityEngine.Camera.main;
                if (cam != null)
                    _cameraController = cam.GetComponent<EntropyOnline.Camera.CameraController>();
            }

            DisableWaterColliders();
        }

        private void DisableWaterColliders()
        {
            var colliders = Object.FindObjectsByType<Collider>(FindObjectsInactive.Exclude);
            foreach (var col in colliders)
            {
                if (col == null || col.gameObject == null) continue;
                string nameLower = col.gameObject.name.ToLowerInvariant();
                if (nameLower.Contains("water") || nameLower.Contains("plane_medium"))
                {
                    col.isTrigger = true;
                }
            }
        }

        private void OnDestroy()
        {
            if (Instance == this)
                Instance = null;

            KOPacketHandler.OnWarp -= HandleWarp_KO;
            KOPacketHandler.OnAttackResult -= HandleAttackResult_KO;
            KOPacketHandler.OnDead -= HandleDead_KO;
            KOPacketHandler.OnRegene -= HandleRegene_KO;
            KOPacketHandler.OnMagicProcess -= HandleMagicProcess_KO;
            KOPacketHandler.OnStealthInfo -= HandleStealthInfo_KO;
        }

        private void HandleStealthInfo_KO(byte isEnabled, short radius)
        {
            CanSeeStealth = (isEnabled == 1);
            StealthDetectionRadius = radius;

            // Trigger transparency refresh for all remote players
            var entityMgr = EntropyOnline.World.EntityManager.Instance;
            if (entityMgr != null)
            {
                foreach (var pair in entityMgr.GetAllRemotePlayers())
                {
                    if (pair.Value != null && pair.Value.Root != null)
                    {
                        // Trigger detection refresh by checking the visualizer state
                        var eqVis = pair.Value.Root.GetComponent<EntropyOnline.World.KOEquipmentVisualizer>();
                        if (eqVis == null) eqVis = pair.Value.Root.GetComponentInParent<EntropyOnline.World.KOEquipmentVisualizer>();
                        if (eqVis != null && eqVis.IsStealthActive)
                        {
                            // If the player was stealthy, refresh their visual transparent/cutout state
                            var gameHud = GameHUD.Instance;
                            if (gameHud != null)
                            {
                                bool isSameNation = pair.Value.Nation == GameManager.Instance.Nation;
                                gameHud.RefreshStealthTransparency(pair.Value.Root, false, isSameNation, true);
                            }
                        }
                    }
                }
            }
        }

