        private void HandleWarp_KO(byte[] rawData)
        {
            // Open-KO birebir: CharacterMovementHandler.cpp:600-602
            // Server sends: WIZ_WARP << sPosX << sPosZ — sadece 2 × uint16, Y yok!
            // Wire: [x:uint16][z:uint16]
            var r = new KOPacketReader(rawData);
            ushort x = r.ReadUInt16();   // cpp:601 — sPosX
            ushort z = r.ReadUInt16();   // cpp:601 — sPosZ
            // C++ birebir: Y sunucu tarafından gönderilmez — terrain height kullanılır
            HandleInstantWarp(x / 10f, z / 10f, 0f);
        }

        /// <summary>
        /// Open-KO birebir: MsgRecv_Attack (GameProcMain.cpp:3213-3328)
        /// Wire: [opcode][type:byte][result:byte][attackerId:int16][targetId:int16]
        /// type: 0x01=physical, 0x02=magic
        /// result: 0x00=miss, 0x01=hit, 0x02=kill
        /// </summary>
        private void HandleAttackResult_KO(byte[] rawData)
        {
            var r = new KOPacketReader(rawData);
            byte type = r.ReadByte();
            byte result = r.ReadByte();
            short attackerId = r.ReadInt16();
            short targetId = r.ReadInt16();

            var gm = GameManager.Instance;
            if (gm == null) return;

            bool bIAmTarget = (targetId == (short)gm.CharacterId);
            bool bIAmAttacker = (attackerId == (short)gm.CharacterId);

            // C++ birebir satır 3279-3294: savaş sırasında exit iptal
            if (bIAmTarget || bIAmAttacker)
            {
                // Çıkış zamanlayıcısı iptal edilir — mobilde uygulaması yok, log yeter
            }

            // C++ birebir satır 3241-3253: target == ben → SitDown(false), casting iptal
            if (bIAmTarget)
            {
                // Saldırı alındı — oturma/casting iptal
                if (_eState == PlayerStateAction.PSA_SITDOWN)
                    Action(PlayerStateAction.PSA_BASIC, true);

                // C++ birebir satır 3313-3325: iResult==0x02 (Attack And Dead)
                // if (pTarget == s_pPlayer) → Regeneration dialog
                // pTarget->m_fTimeAfterDeath = 0.1f
                if (result == 0x02)
                {
                    _isDead = true;
                    StopAutoAttack();
                    if (_bTargetOrPosMove) CancelMoveToTarget();

                    // C++ birebir: pTarget->m_fTimeAfterDeath = 0.1f
                    _fTimeAfterDeath = 0.1f;
                    // C++ birebir: ActionDying(PSD_KEEP_POSITION) — ActionMove(PSM_STOP) + Action(PSA_DYING)
                    ActionMove(PlayerStateMove.PSM_STOP);
                    Action(PlayerStateAction.PSA_DYING, false);

                    // C++ birebir satır 3315-3319: MessageBoxPost(szMsg, "", MB_OK, BEHAVIOR_REGENERATION)
                    // Regeneration dialog aç
                    if (DeathUI.Instance != null)
                        DeathUI.Instance.TriggerDeath();
                }
            }

            // C++ birebir satır 3313-3325: hedef öldü → auto-attack durdur
            if (bIAmAttacker && result == 0x02)
            {
                StopAutoAttack();
                _attackTarget = null;
            }
        }

        /// <summary>
        /// Open-KO birebir: MsgRecv_Dead (GameProcMain.cpp:3330-3364)
        /// Wire: [opcode][targetId:int16]
        /// </summary>
        private void HandleDead_KO(byte[] rawData)
        {
            // C++ birebir: MsgRecv_Dead (GameProcMain.cpp:3330-3364)
            // Wire: [opcode][targetId:int16]
            var r = new KOPacketReader(rawData);
            short targetId = r.ReadInt16();  // cpp:3332

            var gm = GameManager.Instance;
            if (gm != null && targetId == (short)gm.CharacterId)
            {
                // C++ birebir: satır 3337-3343 — kendi ölümümüz
                _isDead = true;
                StopAutoAttack();  // cpp: CommandEnableAttackContinous(false)
                if (_bTargetOrPosMove) CancelMoveToTarget();

                // C++ birebir: satır 3356-3357
                // pTarget->m_fTimeAfterDeath = 0.1f
                // pTarget->ActionDying(PSD_KEEP_POSITION, vDir)
                _fTimeAfterDeath = 0.1f;
                ActionMove(PlayerStateMove.PSM_STOP);  // cpp:1174: this->ActionMove(PSM_STOP)
                Action(PlayerStateAction.PSA_DYING, false);  // cpp:1175: this->Action(PSA_DYING, false)

                // C++ birebir: satır 3340 — MessageBoxPost(szMsg, "", MB_OK, BEHAVIOR_REGENERATION)
                if (DeathUI.Instance != null)
                    DeathUI.Instance.TriggerDeath();
            }
            else
            {
                // C++ birebir: satır 3345-3358 — başka entity'nin ölümü
                var entityMgr = World.EntityManager.Instance;
                if (entityMgr != null)
                {
                    var entity = entityMgr.GetEntityByInstanceId(targetId);
                    if (entity != null)
                    {
                        // C++ birebir: pTarget->m_fTimeAfterDeath = 0.1f
                        entity.CurrentHP = 0;
                        // C++ birebir: pTarget->ActionDying(PSD_KEEP_POSITION, vDir)
                        entity.ActionDying();
                    }
                }
            }
        }

        /// <summary>
        /// Open-KO birebir: MsgRecv_Regen (GameProcMain.cpp:2399-2428)
        /// Wire: [opcode][x:uint16][z:uint16][y:int16]
        /// PlayerController sadece _isDead state'ini sıfırlar — pozisyon DeathUI tarafından ayarlanır.
        /// </summary>
        private void HandleRegene_KO(byte[] rawData)
        {
            // C++ birebir: GameProcMain.cpp:2409-2410
            // s_pPlayer->m_fTimeAfterDeath = 0;
            _fTimeAfterDeath = 0f;
            _isDead = false;
            _bStun = false;
            _fStunTime = 0f;

            // Hareket state'lerini sıfırla — ölüm öncesi kalıntılar temizlenmeli
            _wasMoving = false;
            _eStateMove = PlayerStateMove.PSM_STOP;

            // Oto-saldırı ve hedefe yürüme iptal
            if (_bAttackContinous) StopAutoAttack();
            if (_bTargetOrPosMove) CancelMoveToTarget();

            // State machine'i zorla sıfırla — PSA_DEATH → PSA_BASIC geçişi
            // state table tarafından engelleniyor, bForceSet=true gerekli
            _eState = PlayerStateAction.PSA_BASIC;
            _eStateNext = PlayerStateAction.PSA_BASIC;
            Action(PlayerStateAction.PSA_BASIC, true, true);
            PlayCharAnim("breath");
        }

        /// <summary>
        /// Open-KO birebir: MagicSkillMng.cpp MagicPacketRecv()
        /// Wire: [opcode][subOp:byte][magicId:uint32][sourceId:int16][targetId:int16][data0-5:int16×6]
        /// </summary>
        private void HandleMagicProcess_KO(byte[] rawData)
        {
            var r = new KOPacketReader(rawData);
            byte subOp = r.ReadByte();

            // 0x05 (TYPE4BUFFTYPE) ve 0x06 (CANCEL) farklı wire format —
            // EntityManager.HandleMagicProcess_KO'da handle ediliyor.
            if (subOp == 0x05 || subOp == 0x06) return;

            uint magicId = r.ReadUInt32();
            short sourceId = r.ReadInt16();
            short targetId = r.ReadInt16();

            var gm = GameManager.Instance;
            if (gm == null) return;

            // cpp birebir: N3_SP_MAGIC_FAIL = 0x04 — MagicSkillMng.cpp:1930-2060
            if (subOp == 0x04)
            {
                // Wire: [magicID:u32][srcID:i16][tgtID:i16][Data[0-5]:i16×6]
                short d0 = r.ReadInt16();
                short d1 = r.ReadInt16();
                short d2 = r.ReadInt16();
                short d3 = r.ReadInt16(); // fail reason
                short d4 = r.ReadInt16();
                short d5 = r.ReadInt16();

                var mgr = Combat.KOMagicSkillManager.Instance;
                if (mgr != null)
                    mgr.MsgRecv_Fail(magicId, sourceId, targetId, d0, d1, d2, d3, d4, d5);
                return;
            }

            // PacketDef.h birebir: N3_SP_MAGIC_EFFECTING = 0x03
            // Hedef ben isem stun/debuff kontrolü yapılır
            if (subOp == 0x03 && targetId == (short)gm.CharacterId)
            {
                // KOMagicSkillManager stun/debuff uygulama yapıyor
            }
        }

