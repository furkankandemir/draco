        /// <summary>
        /// Sunucudan gelen saldırı sonucunu işle.
        /// Open-KO birebir: CGameProcMain::MsgRecv_Attack (GameProcMain.cpp:3213-3328)
        ///
        /// C++ referanstan birebir:
        ///   - cpp:3223-3224: bIAmTarget / bIAmAttacker kontrolü
        ///   - cpp:3241-3253: Ben hedef isem → oturmaktan kaldır + casting interrupt
        ///   - cpp:3268-3276: Saldırgan başkası ise → RotateTo + PSA_ATTACK animasyonu
        ///   - cpp:3279-3295: Savaş sırasında çıkış iptal
        ///   - cpp:3297-3305: iResult==0 (fail) → PSA_GUARD animasyonu
        ///   - cpp:3313-3325: iResult==2 (dead) → m_fTimeAfterDeath + despawn
        ///
        /// NOT: Open-KO'da MsgRecv_Attack hasar değeri ALMAZ.
        /// HP güncellemesi WIZ_HP_CHANGE ile ayrı paket olarak gelir.
        /// Bizim S2C_ATTACK_RESULT paketi damage+targetHp içerir ama client
        /// kendi HP'sini bu paketten güncellemez (çift düşüş önlenir).
        /// </summary>
        private void HandleAttackResult(long attackerId, long targetId, bool targetIsPlayer,
            int damage, int targetHp, bool targetDied)
        {
            long myId = GameManager.Instance?.CharacterId ?? 0;
            bool bIAmAttacker = (attackerId == myId);
            bool bIAmTarget = (targetIsPlayer && targetId == myId);

            // === Lider Saldırısı ise (Target Assist Takibi) ===
            if (KOPartyManager.Instance != null && KOPartyManager.Instance.MemberCount > 0)
            {
                long leaderId = KOPartyManager.Instance.Members[0].CharacterId;
                if (attackerId == leaderId && !targetIsPlayer)
                {
                    if (targetDied)
                    {
                        KOPartyManager.Instance.LeaderTargetId = 0;
                    }
                    else
                    {
                        KOPartyManager.Instance.LeaderTargetId = targetId;
                    }
                }
            }

            // Open-KO birebir: cpp:3279-3295 — savaş sırasında çıkış iptal
            // (mobilde bu şimdilik geçildi)

            // === Ben saldırgan isem ===
            if (bIAmAttacker)
            {
                // Open-KO birebir: cpp:3313-3325 — iResult==2 (dead)
                // m_fTimeAfterDeath = 0.1f → ActionDying() → entity dying anim
                if (targetDied)
                {
                    // Open-KO: pTarget->m_fTimeAfterDeath = 0.1f + ActionDying(PSD_KEEP_POSITION)
                    _attackTarget?.ActionDying();
                    StopAutoAttack();
                }
                // Open-KO birebir: ProcessAttack (PlayerBase.cpp:1329-1368)
                // pTarget->IsAlive() && !pTarget->m_bGuardSuccess (cpp:1329-1332):
                //   D3DCOLORVALUE crHit = { 1.0f, 0.2f, 0.2f, 1.0f };  (cpp:1358)
                //   pTarget->DurationColorSet(crHit, 0.3f);              (cpp:1359)
                //   pTarget->Action(PSA_STRUCK, false);                   (cpp:1368)
                else if (_attackTarget != null && !_attackTarget.IsDead)
                {
                    // Open-KO birebir: crHit = { 1.0f, 0.2f, 0.2f, 1.0f } (cpp:1358)
                    Color crHit = new Color(1.0f, 0.2f, 0.2f, 1.0f);
                    _attackTarget.DurationColorSet(crHit, 0.3f);  // cpp:1359
                    _attackTarget.ActionStruck();                   // cpp:1368
                }
            }

            // === Ben hedef isem ===
            // Open-KO birebir: cpp:3241-3255
            if (bIAmTarget)
            {
                // Open-KO birebir: cpp:3243 — CommandSitDown(false, false) — oturmaktan kaldır
                CommandSitDown(false, false);

                // Open-KO birebir: GameProcMain.cpp:3244-3253
                // rand()%100 >= pSkill->iPercentSuccess ise casting iptal
                var magicMgr = EntropyOnline.Combat.KOMagicSkillManager.Instance;
                if (magicMgr != null && magicMgr.IsCasting())
                {
                    // C++ birebir: GameProcMain.cpp:3246-3253
                    // pSkill = s_pTbl_Skill.Find(m_dwMagicID)
                    // if (rand()%100 >= pSkill->iPercentSuccess) → FailCast
                    var castingSkill = magicMgr.GetCastingSkill();
                    int percentSuccess = castingSkill?.PercentSuccess ?? 0;
                    int roll = UnityEngine.Random.Range(0, 100);

                    if (roll >= percentSuccess)
                    {
                        magicMgr.CancelCasting();
                    }
                }

                // NOT: Open-KO'da MsgRecv_Attack hasar değeri almaz.
                // HP güncellemesi WIZ_HP_CHANGE (S2C_HP_CHANGE) ile ayrı paket olarak gelir.
                // Bu yüzden burada GameManager.CurrentHp değiştirilmez.

                // NOT: Open-KO'da MsgRecv_Attack target'a struck animasyonu çalmaz.
                // cpp:3297-3305: sadece iResult==0 (fail) → PSA_GUARD animasyonu
                // cpp:3313: iResult==2 (dead) → m_fTimeAfterDeath = 0.1f
                // Normal hit'te (iResult==1) target animasyon değişmez.
            }
        }

        /// <summary>
        /// Sunucudan gelen ölüm paketi — hedef entity öldü.
        ///
        /// Open-KO referans: CGameProcMain::MsgRecv_Dead (GameProcMain.cpp:3330-3364)
        ///   - iIDTarget okur (short)
        ///   - Ben ölüyorsam → Regeneration dialog
        ///   - Target → m_fTimeAfterDeath = 0.1f + ActionDying()
        ///
        /// Open-KO'da oto-saldırı, target entity kaldırılınca attack loop'ta
        /// implicit olarak durur. Bizde explicit StopAutoAttack() çağrılır.
        /// </summary>
        private void HandleEntityDeath(long entityId, bool isPlayer)
        {
            // =============================================
            // KENDİ ÖLÜMÜMÜZ — Open-KO birebir: MsgRecv_Dead (GameProcMain.cpp:3340-3348)
            //   if (iIDTarget == s_pPlayer->IDNumber())
            //       s_pPlayer->m_fTimeAfterDeath = 0.1f;
            //       s_pPlayer->ActionDying(PSD_KEEP_POSITION, ...);
            //       → Regeneration dialog açılır
            // =============================================
            long myId = GameManager.Instance?.CharacterId ?? 0;
            if (isPlayer && entityId == myId)
            {
                _isDead = true;
                StopAutoAttack();
                if (_bTargetOrPosMove) CancelMoveToTarget();
                _eStateMove = PlayerStateMove.PSM_STOP;

                // openko-ref birebir: PlayerBase.cpp:1172-1175
                //   ActionMove(PSM_STOP) + Action(PSA_DYING, false)
                // JudgeAnimationDying() → ANI_DEAD_NEATLY(8) + rand()%3
                Action(PlayerStateAction.PSA_DYING);

                return;
            }

            // =============================================
            // DİĞER ENTITY ÖLÜMÜ — Open-KO birebir: MsgRecv_Dead (GameProcMain.cpp:3350-3358)
            // =============================================
            KOEntity dyingEntity = null;

            // Oto-saldırı hedefi ölen entity mi?
            if (_bAttackContinous && _attackTarget != null && _attackTarget.ServerInstanceId == entityId)
            {
                dyingEntity = _attackTarget;
                StopAutoAttack();
            }

            // Hedefe yürüme hedefi ölen entity mi?
            if (_bTargetOrPosMove && _moveTarget != null && _moveTarget.ServerInstanceId == entityId)
            {
                CancelMoveToTarget();
            }

            // Entity bulunamadıysa sahne genelinde ara
            if (dyingEntity == null)
            {
                var allEntities = FindObjectsByType<KOEntity>(FindObjectsInactive.Exclude);
                foreach (var e in allEntities)
                {
                    if (e.ServerInstanceId == entityId)
                    {
                        dyingEntity = e;
                        break;
                    }
                }
            }

            // Open-KO birebir: ActionDying (PlayerBase.cpp:1172-1203)
            if (dyingEntity != null)
            {
                dyingEntity.ActionDying();
            }
        }

