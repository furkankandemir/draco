        ///
        /// Open-KO'da bu handler:
        ///   - dwMagicID, iSourceID, iTargetID okur
        ///   - FX efektleri tetikler (s_pFX->TriggerBundle)
        ///   - Type1/3/4 skill-specific efektler
        ///   - Damage/HP bilgisi bu pakette YOKTUR (ayrı WIZ_HP_CHANGE ile gelir)
        ///   - Ölüm bu pakette YOKTUR (ayrı WIZ_DEAD ile gelir)
        /// </summary>
        private void HandleMagicEffecting(int magicId, long sourceId, long targetId,
            short data0, short data1, short data2, short data3, short data4, short data5)
        {
            // Open-KO birebir: MsgRecv_Effecting (MagicSkillMng.cpp:1866-1928)
            long myId = GameManager.Instance?.CharacterId ?? 0;

            // === Lider Büyüsü ise (Target Assist Takibi) ===
            if (KOPartyManager.Instance != null && KOPartyManager.Instance.MemberCount > 0)
            {
                long leaderId = KOPartyManager.Instance.Members[0].CharacterId;
                if (sourceId == leaderId)
                {
                    KOPartyManager.Instance.LeaderTargetId = targetId;
                }
            }

            // Open-KO birebir: data[3] == SKILLMAGIC_FAIL_ATTACKZERO (-104) → skill ıskaladı
            if (data3 == (short)MagicFailReason.AttackZero)
            {
                // C++ birebir: ıskalanan hedef → PSA_GUARD animasyonu
                if (sourceId == myId && _attackTarget != null && _attackTarget.ServerInstanceId == targetId)
                {
                    _attackTarget.ActionGuard();
                }
                return;
            }

            // ================================================================
            // C++ birebir: MagicSkillMng.cpp:1880-1886 — pPlayer + pSkill lookup
            // ================================================================
            var pSkill = KOImport.SkillTableParser.Find(magicId);
            if (pSkill == null)
            {
                Debug.LogWarning($"[MAGIC] EFFECTING: Skill bulunamadı: {magicId}");
                return;
            }

            var fxMgr = KO.KOFXManager.Instance;
            int iSourceID = (int)sourceId;
            int iTargetID = (int)targetId;

            // ================================================================
            // C++ birebir: MagicSkillMng.cpp:1890-1895
            // Başka oyuncunun casting'i bittiyse → SelfAnimID2 animasyonu tetikle
            // if (pPlayer != nullptr && iSourceID != s_pPlayer->IDNumber()
            //     && pPlayer->State() == PSA_SPELLMAGIC)
            //     pPlayer->m_iMagicAni = pSkill->iSelfAnimID2
            //     pPlayer->m_fCastFreezeTime = 0.0f
            //     pPlayer->Action(PSA_SPELLMAGIC, false)
            // ================================================================
            if (sourceId != myId)
            {
                // Diğer oyuncunun RemotePlayerEntity'sini bul ve animasyonu tetikle
                var remotePlayers = FindObjectsByType<EntropyOnline.World.RemotePlayerEntity>(
                    FindObjectsInactive.Exclude);
                foreach (var rpe in remotePlayers)
                {
                    if (rpe.CharId == sourceId && pSkill.SelfAnimID2 >= 0)
                    {
                        // C++ birebir: pPlayer->m_iMagicAni = pSkill->iSelfAnimID2
                        // MagicSkillMng.cpp:1892 — dönüşüm yok, ham değer kullanılır
                        rpe.ActionSpellEffecting(pSkill.SelfAnimID2);
                        break;
                    }
                }
            }

            // ================================================================
            // C++ birebir: MagicSkillMng.cpp:1897-1898
            // s_pFX->Stop(iSourceID, iSourceID, pSkill->iSelfFX1, -1, true)
            // s_pFX->Stop(iSourceID, iSourceID, pSkill->iSelfFX1, -2, true)
            // ================================================================
            if (fxMgr != null && pSkill.SelfFX1 > 0)
            {
                fxMgr.Stop(iSourceID, iSourceID, pSkill.SelfFX1, -1, true);
                fxMgr.Stop(iSourceID, iSourceID, pSkill.SelfFX1, -2, true);
            }

            // ================================================================
            // C++ birebir: MagicSkillMng.cpp:1900-1903
            // Type1 skill → EffectingType1 (combo anim + struck on target)
            // if (pSkill->dw1stTableType == 1 || pSkill->dw2ndTableType == 1)
            //     if (!EffectingType1(dwMagicID, iSourceID, iTargetID)) return;
            // ================================================================
            if (pSkill.FirstTableType == 1 || pSkill.SecondTableType == 1)
            {
                // Ben saldırgan isem: kendi struck tetikleme (zaten yukarıda yapılıyor)
                // Başkası saldırgan ise: C++ EffectingType1 → combo anim + ProcessAttack
                if (sourceId == myId)
                {
                    // Kendi skill'im — hedefte struck tetikle
                    EntropyOnline.World.KOEntity targetEntityT1 = FindEntityByIdLocal(targetId);
                    if (targetEntityT1 != null && !targetEntityT1.IsDead)
                    {
                        Color crHit = new Color(1.0f, 0.2f, 0.2f, 1.0f);
                        targetEntityT1.DurationColorSet(crHit, 0.3f);
                        targetEntityT1.ActionStruck();
                    }
                }
            }

            // ================================================================
            // C++ birebir: MagicSkillMng.cpp:1906-1910
            // Type4 buff → if (iTargetID == s_pPlayer->IDNumber()) EffectingType4(dwMagicID)
            // ================================================================
            if (pSkill.FirstTableType == 4 || pSkill.SecondTableType == 4)
            {
                if (targetId == myId)
                {
                    var magicMgr = EntropyOnline.Combat.KOMagicSkillManager.Instance;
                    magicMgr?.EffectingType4(magicId);
                }
            }

            // ================================================================
            // C++ birebir: MagicSkillMng.cpp:1912-1916
            // Type3 skill (DoT/HoT, stun, magic damage)
            // ================================================================
            bool isTargetLocalPlayer = (targetId == myId || targetId == 0 || (GameManager.Instance != null && targetId == GameManager.Instance.CharacterId));
            if (pSkill.FirstTableType == 3 || pSkill.SecondTableType == 3)
            {
                if (isTargetLocalPlayer)
                {
                    var magicMgr = EntropyOnline.Combat.KOMagicSkillManager.Instance;
                    magicMgr?.EffectingType3(magicId);
                }
            }

            // ================================================================
            // C++ birebir: MagicSkillMng.cpp:1921-1927 — TargetFX tetikleme
            // if (iTargetID == -1)
            //     vTargetPos(Data[0], Data[1], Data[2])
            //     s_pFX->TriggerBundle(iSourceID, 0, pSkill->iTargetFX, vTargetPos)
            // else
            //     s_pFX->TriggerBundle(iSourceID, 0, pSkill->iTargetFX, iTargetID, pSkill->iTargetPart)
            // ================================================================
            if (fxMgr != null && pSkill.TargetFX > 0)
            {
                if (pSkill.Target >= 10 && pSkill.Target <= 13)
                {
                    var wb = World.WorldBuilder.Instance;
                    float y = wb != null ? wb.GetTerrainHeight(data0, data2) : (float)data1;
                    Vector3 vTargetPos = new Vector3(data0, y, data2);
                    fxMgr.TriggerAreaTargetFX(iSourceID, pSkill.TargetFX, vTargetPos, pSkill.Id);
                }
                else
                {
                    if (targetId == -1)
                    {
                        // Pozisyon bazlı TargetFX (area skill)
                        var wb = World.WorldBuilder.Instance;
                        float y = wb != null ? wb.GetTerrainHeight(data0, data2) : (float)data1;
                        Vector3 vTargetPos = new Vector3(data0, y, data2);
                        fxMgr.TriggerBundle(iSourceID, 0, pSkill.TargetFX, vTargetPos);
                    }
                    else
                    {
                        // Hedef entity bazlı TargetFX
                        fxMgr.TriggerBundle(iSourceID, 0, pSkill.TargetFX, iTargetID, pSkill.TargetPart);
                    }
                }
            }
        }

