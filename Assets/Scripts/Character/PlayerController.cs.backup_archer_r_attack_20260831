        // ============================================================
        // Open-KO birebir: PlayerBase.cpp:465-476 — RotateTo(CPlayerBase* pOther)
        // Hedef pozisyonundan yaw açısını hesaplar ve _fYawToReach set eder.
        // C++: vDir = pOther->Position() - m_Chr.Pos(); fYaw = _Yaw2D(vDir.x, vDir.z);
        //      this->RotateTo(fYaw, false);
        // ============================================================
        public void RotateToTarget(Transform target)
        {
            if (target == null) return;
            Vector3 vDir = target.position - transform.position;
            vDir.y = 0;
            if (vDir.sqrMagnitude < 0.01f) return;

            // C++ birebir: _Yaw2D(vDir.x, vDir.z) — atan2 ile yaw hesapla
            float fYaw = Mathf.Atan2(vDir.x, vDir.z); // Unity forward = +Z

            // C++ birebir: RotateTo(fYaw, false) — PlayerBase.cpp:450-460
            // m_fYawToReach = fYaw (normalize edilmiş -PI..PI arası)
            // Normalize: -PI..PI arasına getir
            while (fYaw > Mathf.PI) fYaw -= 2f * Mathf.PI;
            while (fYaw < -Mathf.PI) fYaw += 2f * Mathf.PI;
            _fYawToReach = fYaw;
            _fYawDirty = true;
        }

        public void RotateToPosition(Vector3 targetPos)
        {
            Vector3 vDir = targetPos - transform.position;
            vDir.y = 0;
            if (vDir.sqrMagnitude < 0.01f) return;

            // C++ birebir: fYaw = _Yaw2D(vDir.x, vDir.z)
            float fYaw = Mathf.Atan2(vDir.x, vDir.z);

            while (fYaw > Mathf.PI) fYaw -= 2f * Mathf.PI;
            while (fYaw < -Mathf.PI) fYaw += 2f * Mathf.PI;
            _fYawToReach = fYaw;
            _fYawDirty = true;
        }


        // ============================================================
        // Open-KO birebir: PlayerBase.cpp:478-524 — TickYaw()
        // Her frame çağrılır. _fYawCur'ı _fYawToReach'e doğru
        // m_fRotRadianPerSec * deltaTime kadar döndürür.
        // C++: m_fRotRadianPerSec = DegreesToRadians(270.0f) — saniyede 270 derece
        // ============================================================
        private void TickYaw()
        {
            if (!_fYawDirty) return;

            // C++ birebir: PlayerBase.cpp:480
            // if (m_fYawCur != m_fYawToReach && this->IsAlive())
            if (Mathf.Approximately(_fYawCur, _fYawToReach))
            {
                _fYawDirty = false;
                return;
            }

            // C++ birebir: PlayerBase.cpp:482-483
            float fYawDiff = _fYawToReach - _fYawCur;
            float fYawDelta = _fRotRadianPerSec * Time.deltaTime;

            // C++ birebir: PlayerBase.cpp:484-486
            if (Mathf.Abs(fYawDiff) <= fYawDelta)
            {
                _fYawCur = _fYawToReach;
                _fYawDirty = false;
            }
            else
            {
                // C++ birebir: PlayerBase.cpp:490-503 — en kısa yönde dön
                if (fYawDiff > 0)
                {
                    if (fYawDiff >= Mathf.PI) fYawDelta *= -1f;
                    // else fYawDelta *= 1f; (varsayılan)
                }
                else
                {
                    if (fYawDiff > -Mathf.PI) fYawDelta *= -1f;
                    // else fYawDelta *= 1f;
                }

                // C++ birebir: PlayerBase.cpp:505
                _fYawCur += fYawDelta;

                // C++ birebir: PlayerBase.cpp:507-516 — normalize -PI..PI
                if (Mathf.Abs(_fYawCur) > Mathf.PI)
                {
                    int iLot = (int)(_fYawCur / Mathf.PI);
                    if (iLot != 0) _fYawCur -= iLot * 2f * Mathf.PI;
                    iLot = (int)(_fYawCur / Mathf.PI);
                    if (iLot != 0) _fYawCur -= iLot * 2f * Mathf.PI;
                }
            }

            // C++ birebir: PlayerBase.cpp:521-523
            // qtRot.RotationAxis(0, 1, 0, m_fYawCur); m_Chr.RotSet(qtRot);
            transform.rotation = Quaternion.Euler(0f, _fYawCur * Mathf.Rad2Deg, 0f);
        }

