        private string GetBonePath(Transform bone)
        {
            var path = bone.name;
            var p = bone.parent;
            int depth = 0;
            while (p != null && p != transform && depth < 5)
            {
                path = p.name + "/" + path;
                p = p.parent;
                depth++;
            }
            return path;
        }

        /// <summary>
        /// Open-KO birebir: CN3Chr::AniUpperSet (N3Chr.cpp:2291-2314)
        /// Sadece üst gövde bone'larında animasyon oynatır.
        ///
        /// C++ mantık:
        ///   m_FrmCtrlUpper.iAni = iAni
        ///   m_FrmCtrlUpper.bOnceAndFreeze = false
        ///   m_FrmCtrlUpper.fFreezeTime = fFreezeTime
        ///   → TickAnimationKey'de m_nJointPartStarts[1]..m_nJointPartEnds[1] joint'leri
        ///     m_FrmCtrlUpper.fFrmCur ile hesaplanır
        ///
        /// Unity karşılığı: AnimationState.AddMixingTransform(upperBodyBone, true)
        /// → sadece o bone alt-ağacında animasyon uygulanır.
        /// </summary>
        private void PlayCharAnimUpper(string animName)
        {
            if (_charAnim == null)
            {
                _charAnim = GetComponentInChildren<Animation>();
                if (_charAnim == null) return;
            }

            FindUpperBodyBone();
            if (_upperBodyBone == null)
            {
                // Üst gövde bone bulunamadı — fallback: tüm gövde oynat
                PlayCharAnim(animName, true);
                return;
            }

            string resolvedName = FindClipCaseInsensitive(animName);
            if (resolvedName == null) return;

            // C++ birebir: m_FrmCtrlUpper.bOnceAndFreeze = false
            // Ama animasyon bir kez oynar ve durur (once + freeze-time ile)
            var clip = _charAnim.GetClip(resolvedName);
            if (clip == null) return;

            clip.wrapMode = WrapMode.Once;

            // AnimationState'e mixing transform ekle — sadece üst gövde
            _currentAnimUpper = animName;

            var state = _charAnim[resolvedName];
            if (state != null)
            {
                state.AddMixingTransform(_upperBodyBone, true);
                state.layer = 1;     // Üst gövde layer'ı — C++ m_FrmCtrlUpper
                state.weight = 1.0f;
                state.blendMode = AnimationBlendMode.Blend;
                state.time = 0f;
            }

            _charAnim.Rewind(resolvedName);

            float blendTime = GetAnimBlendTime(resolvedName, 0.15f);
            _charAnim.CrossFade(resolvedName, blendTime);
        }

        /// <summary>
        /// Layer 1'deki üst gövde animasyonlarını durdur.
        /// PlayCharAnimUpper, atak animasyonunu layer=1 + AddMixingTransform ile oynatır.
        /// Full body animasyona (breath vb.) geçerken bu layer temizlenmezse
        /// üst gövde bone'ları (head dahil) eski atak pozisyonunda takılı kalır.
        /// </summary>
        private void StopUpperBodyLayer()
        {
            _currentAnimUpper = null;
            if (_charAnim == null) return;
            foreach (AnimationState state in _charAnim)
            {
                if (state.layer == 1)
                {
                    state.enabled = false;
                    state.weight = 0f;
                }
            }
        }

        /// <summary>
        /// Üst gövde root bone'unu bul.
        /// C++ karşılığı: m_JointRefs[m_nJointPartStarts[1]]
        /// N3ChrData.JointPartStarts[1] index'indeki bone Transform'u arar.
        /// </summary>
        private void FindUpperBodyBone()
        {
            if (_upperBodyBoneSearched) return;
            _upperBodyBoneSearched = true;

            // GameManager'dan karakter N3ChrData'sını al
            var gm = GameManager.Instance;
            if (gm == null) return;

            // N3ChrData içindeki JointPartStarts[1] = üst gövde root joint index
            var chrData = gm.PlayerChrData;
            if (chrData == null) return;

            int upperJointStart = chrData.JointPartStarts[1];
            if (upperJointStart <= 0) return; // 0 veya negatif ise tanımsız

            // Bone Transform'u bul — FindJointByIndex ile aynı mantık
            // "Bone_{index}" isimli veya depth-first sırayla
            Transform root = transform;
            var allTransforms = root.GetComponentsInChildren<Transform>(true);
            string boneName = $"Bone_{upperJointStart}";
            foreach (var t in allTransforms)
            {
                if (t.name == boneName)
                {
                    _upperBodyBone = t;
                    return;
                }
            }

            // Fallback: depth-first index ile bul
            var bones = new List<Transform>();
            N3CharBuilder.CollectBoneTransformsByName(root, bones);
            if (upperJointStart < bones.Count)
            {
                _upperBodyBone = bones[upperJointStart];
            }
        }

        /// <summary>
        /// Case-insensitive klip arama.
        /// .n3anim dosyalarında isimler mixed-case: "SitDown", "StandUp", "Shoot_Arrow_A" vb.
        /// Mevcut kod lowercase kullanıyor — bu helper eşleştirmeyi sağlar.
        /// </summary>
        private string FindClipCaseInsensitive(string animName)
        {
            if (_charAnim == null) return null;

            // Önce exact match dene
            if (_charAnim.GetClip(animName) != null)
                return animName;

            // Case-insensitive arama
            string lower = animName.ToLowerInvariant();
            foreach (AnimationState state in _charAnim)
            {
                if (state.name.ToLowerInvariant() == lower)
                    return state.name;
            }

            return null;
        }

        /// <summary>
        /// Animasyon adını kullanarak N3AnimClipRegistry'den fTimeBlend değerini sorgular.
        /// Bulamazsa varsayılan geçiş süresini döner.
        /// </summary>
        private float GetAnimBlendTime(string resolvedName, float defaultBlend = 0.25f)
        {
            if (_animRegistry == null && _charAnim != null)
            {
                _animRegistry = _charAnim.GetComponent<EntropyOnline.Import.N3AnimClipRegistry>();
            }

            if (_animRegistry != null && _animRegistry.ClipNames != null && _animRegistry.BlendTimes != null)
            {
                for (int i = 0; i < _animRegistry.ClipNames.Length; i++)
                {
                    if (string.Equals(_animRegistry.ClipNames[i], resolvedName, System.StringComparison.OrdinalIgnoreCase))
                    {
                        if (i < _animRegistry.BlendTimes.Length)
                        {
                            float bt = _animRegistry.BlendTimes[i];
                            return bt >= 0f ? bt : defaultBlend;
                        }
                        break;
                    }
                }
            }
            return defaultBlend;
        }

        private void HandleNetworkSync()
        {
            _sendTimer -= Time.deltaTime;

            if (_sendTimer <= 0f && (_wasMoving || _bTargetOrPosMove))
            {
                _sendTimer = _sendInterval;

                float dist = Vector3.Distance(transform.position, _lastSentPosition);
                if (dist > 0.1f) // Minimum hareket eşiği
                {
                    SendMovePacket();
                    _lastSentPosition = transform.position;
                }
            }

            // Rotasyon senkronizasyonu (WIZ_ROTATE)
            float currentYaw = transform.rotation.eulerAngles.y;
            float yawDiff = Mathf.Abs(Mathf.DeltaAngle(currentYaw, _lastSentYaw));
            if (yawDiff > 3f && Time.time - _lastRotateSendTime > 0.15f)
            {
                if (KONetworkManager.Instance != null)
                {
                    KONetworkManager.Instance.SendRotate((short)currentYaw);
                    _lastSentYaw = currentYaw;
                    _lastRotateSendTime = Time.time;
                }
            }
        }

        private void SendMovePacket()
        {
            if (KONetworkManager.Instance == null) return;

            // Open-KO birebir: WIZ_MOVE
            // Wire: [WIZ_MOVE][x:2][z:2][y:2][speed:2][moveType:1]
            using var pkt = new KOPacketWriter(WizOpcode.WIZ_MOVE);
            var pos = transform.position;
            // Güvenlik: negatif veya aşırı değerleri sunucuya gönderme — DB bozulur
            float safeY = Mathf.Max(0f, pos.y);
            pkt.WriteUInt16((ushort)(Mathf.Max(0f, pos.x) * 10f));  // x in decimetres
            pkt.WriteUInt16((ushort)(Mathf.Max(0f, pos.z) * 10f));  // z in decimetres
            pkt.WriteInt16((short)(safeY * 10f));     // y in decimetres
            pkt.WriteInt16((short)(moveSpeed * 10f)); // speed
            pkt.WriteByte(1); // moveType: 1=walk
            KONetworkManager.Instance.SendPacket(pkt);
        }

        private void SendStopPacket()
        {
            if (KONetworkManager.Instance == null) return;

            // Open-KO birebir: WIZ_MOVE with moveType=0 (stop)
            using var pkt = new KOPacketWriter(WizOpcode.WIZ_MOVE);
            var pos = transform.position;
            float safeY = Mathf.Max(0f, pos.y);
            pkt.WriteUInt16((ushort)(Mathf.Max(0f, pos.x) * 10f));
            pkt.WriteUInt16((ushort)(Mathf.Max(0f, pos.z) * 10f));
            pkt.WriteInt16((short)(safeY * 10f));
            pkt.WriteInt16(0); // speed = 0 (stopped)
            pkt.WriteByte(0);  // moveType: 0=stop
            KONetworkManager.Instance.SendPacket(pkt);
        }

        /// <summary>
        /// S2C_WARP: Sunucudan gelen anlık pozisyon warp (Gate, Random TP, Summon).
        /// CharacterController devre dışı bırakılarak anlık teleport yapılır.
        ///
        /// Open-KO birebir: GameProcMain.cpp:454 — InitPlayerPosition(vPos)
        ///   float fYTerrain = ACT_WORLD->GetHeightWithTerrain(vPos.x, vPos.z);
        ///   vPos.y = fYTerrain;
        /// C++ guard yok — terrain ne dönerse onu kullanır.
        /// </summary>
        private void HandleInstantWarp(float x, float z, float serverY)
        {
            if (_charController == null) return;

            // Open-KO birebir: ACT_WORLD->GetHeightWithTerrain(x, z)
            // C++ birebir: fYTerrain = GetHeightWithTerrain(x, z) — guard YOK
            // Terrain yüksekliği 0 veya negatif olabilir, bu meşru bir değer.
            // GetTerrainHeightAtPosition zaten sentinel kontrolü (-900f) ve fallback (10f) yapıyor.
            float y = GetTerrainHeightAtPosition(x, z);

            // CharacterController teleport için geçici devre dışı
            _charController.enabled = false;
            transform.position = new Vector3(x, y, z);
            _charController.enabled = true;
            
            _lastSentPosition = transform.position;
            _verticalVelocity = 0f;
            
            // Kamerayı anında snap et (Lerp dönme efektini önle)
            var cam = Object.FindAnyObjectByType<EntropyOnline.Camera.CameraController>();
            if (cam != null) cam.SnapToTarget();
        }

