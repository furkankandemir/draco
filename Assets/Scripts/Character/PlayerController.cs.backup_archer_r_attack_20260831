        /// Open-KO birebir: PlayerMySelf::Tick (PlayerMySelf.cpp:168-276)
        ///   - m_bAttackContinous ise:
        ///     - pTarget = TargetPointerCheck(false)
        ///     - pTarget null → StopAutoAttack
        ///     - Melee dalı (silah yoksa veya melee silah):
        ///       - fIntervalTable = 1.0f (varsayılan — PlayerMySelf.cpp:218)
        ///       - Silah varsa: (siAttackInterval/100) * (siAttackIntervalPercentage/100)
        ///       - fInterval = fIntervalTable / m_fAttackDelta
        ///       - fTime > m_fAttackTimeRecent + fInterval → saldır:
        ///         - IsAttackableTarget → MsgSend_Attack + Action(PSA_ATTACK)
        ///         - Değilse → RotateTo + hedefe yürü
        /// </summary>
        private void AttackTick()
        {
            if (!_bAttackContinous) return;

            // Open-KO birebir: TargetPointerCheck(false) — PlayerMySelf.cpp:170
            if (_attackTarget == null || !_attackTarget.gameObject.activeInHierarchy || _attackTarget.IsDead)
            {
                Debug.LogWarning($"[ATTACK] Hedef geçersiz veya öldü: null={_attackTarget == null}, " +
                    $"active={((_attackTarget != null) ? _attackTarget.gameObject.activeInHierarchy : false)}, " +
                    $"dead={((_attackTarget != null) ? _attackTarget.IsDead : false)}, " +
                    $"instanceId={_attackTarget?.ServerInstanceId ?? -1}");
                StopAutoAttack();  // PlayerMySelf.cpp:173
                return;
            }

            float fTime = Time.time;

            // ================================================================
            // Open-KO birebir: PlayerMySelf.cpp:179-200
            // Archery auto-attack — bow/longbow sol elde, crossbow sağ elde
            // ================================================================
            var leftHandSlot = GetEquippedLeftHandItem();
            var rightHandSlot = GetEquippedRightHandItem();
            int leftClass = leftHandSlot?.itemClass ?? 0;
            int rightClass = rightHandSlot?.itemClass ?? 0;

            bool isBow = (leftClass == (int)KOItemClass.ITEM_CLASS_BOW);
            bool isBowLong = (leftClass == (int)KOItemClass.ITEM_CLASS_BOW_LONG);
            bool isBowCross = (rightClass == (int)KOItemClass.ITEM_CLASS_BOW_CROSS);

            if (isBow || isBowLong || isBowCross)
            {
                // C++ birebir: PlayerMySelf.cpp:184
                // __TABLE_UPC_SKILL* pSkill = s_pTbl_Skill.Find(102003);
                var pSkill = KOImport.SkillTableParser.Find(102003); // basic bow skill
                if (pSkill != null)
                {
                    // C++ birebir: PlayerMySelf.cpp:187
                    if (!_attackTarget.IsDead)
                    {

                        // C++ birebir: PlayerMySelf.cpp:189-191
                        // fInterval = (pSkill->iCastTime / 10.f) + 0.15f
                        float fInterval = (pSkill.CastTime / 10f) + 0.15f;
                        if (_fAttackDelta > 0)
                            fInterval /= _fAttackDelta;

                        // C++ birebir: PlayerMySelf.cpp:192
                        if (fTime > _fAttackTimeRecent + fInterval)
                        {
                            // C++ birebir: MagicSkillMng.cpp:1179 — RotateTo(pTarget)
                            // RotateTo(fYaw, false) — smooth. TickYaw aynı frame'de işler.
                            RotateToTarget(_attackTarget.transform);
                            // C++ birebir: PlayerMySelf.cpp:195
                            // MsgSend_MagicProcess(m_iIDTarget, pSkill)
                            var magicMgr = EntropyOnline.Combat.KOMagicSkillManager.Instance;
                            if (magicMgr != null)
                            {
                                bool result = magicMgr.MsgSend_MagicProcess(
                                    (int)_attackTarget.ServerInstanceId, pSkill);
                                // Sadece başarılı cast'te timer güncelle —
                                // IsCasting() (post-cast _fDelay) nedeniyle reddedilirse
                                // bir sonraki frame'de tekrar denenecek.
                                if (result)
                                {
                                    _fAttackTimeRecent = fTime; // PlayerMySelf.cpp:196
                                }
                            }
                        }
                    }
                }
            }
            // ================================================================
            // Open-KO birebir: PlayerMySelf.cpp:201-214
            // Launcher (javelin) auto-attack — sağ elde launcher
            // ================================================================
            else if (rightClass == (int)KOItemClass.ITEM_CLASS_LAUNCHER)
            {
                // C++ birebir: PlayerMySelf.cpp:204
                var pSkill = KOImport.SkillTableParser.Find(102009); // basic javelin skill
                if (pSkill != null && fTime > _fAttackTimeRecent + (pSkill.CastTime / 10f))
                {
                    // C++ birebir: PlayerMySelf.cpp:207
                    if (!_attackTarget.IsDead)
                    {
                        // C++ birebir: PlayerMySelf.cpp:209-211
                        // MsgSend_MagicProcess(m_iIDTarget, pSkill) — 2 parametre!
                        var magicMgr = EntropyOnline.Combat.KOMagicSkillManager.Instance;
                        if (magicMgr != null)
                        {
                            magicMgr.MsgSend_MagicProcess(
                                (int)_attackTarget.ServerInstanceId, pSkill);
                        }
                        _fAttackTimeRecent = fTime; // PlayerMySelf.cpp:211
                    }
                }
            }
            // ================================================================
            // Open-KO birebir: PlayerMySelf.cpp:216-269
            // Melee auto-attack
            // ================================================================
            else
            {
                // fIntervalTable: silah yoksa 1.0f, silah varsa (siAttackInterval/100) * (siAttackIntervalPercentage/100)
                // PlayerMySelf.cpp:218-224
                float fIntervalTable = 1.0f;
                short weaponRange = 0;

                // Open-KO birebir: m_pItemPlugBasics[PLUG_POS_RIGHTHAND] → giyili sağ el silahı
                // C++ birebir: pItemBasic->siAttackInterval / 100.0f (PlayerMySelf.cpp:221-223)
                var koInv = EntropyOnline.UI.KOInventory.Instance;
                var rhSlot = koInv?.GetRightHandWeapon();
                if (rhSlot != null && !rhSlot.IsEmpty)
                {
                    // Önce pItemBasic'ten oku (C++ birebir)
                    short attackInterval = rhSlot.pItemBasic?.siAttackInterval ?? 0;
                    short attackRange = rhSlot.pItemBasic?.siAttackRange ?? 0;
                    
                    // pItemBasic null ise serverData'dan dene
                    if (attackInterval == 0 && rhSlot.serverData != null)
                        attackInterval = rhSlot.serverData.Delay;
                    if (attackRange == 0 && rhSlot.serverData != null)
                        attackRange = rhSlot.serverData.Range;

                    if (attackInterval > 0)
                    {
                        int itemDefId = rhSlot.serverData?.ItemDefId ?? rhSlot.itemId;
                        short pctRaw = KOImport.ItemDataManager.GetAttackIntervalPct(itemDefId);
                        float pct = pctRaw > 0 ? pctRaw / 100.0f : 1.0f;
                        fIntervalTable = (attackInterval / 100.0f) * pct;
                    }
                    weaponRange = attackRange;
                }
                else
                {
                    // Legacy fallback
                    var equippedWeapon = GetEquippedRightHandWeapon();
                    if (equippedWeapon != null)
                    {
                        if (equippedWeapon.Delay > 0)
                        {
                            short pctRaw = KOImport.ItemDataManager.GetAttackIntervalPct(equippedWeapon.ItemDefId);
                            float pct = pctRaw > 0 ? pctRaw / 100.0f : 1.0f;
                            fIntervalTable = (equippedWeapon.Delay / 100.0f) * pct;
                        }
                        weaponRange = equippedWeapon.Range;
                    }
                }

                // Open-KO birebir: fInterval = fIntervalTable / m_fAttackDelta — PlayerMySelf.cpp:226-229
                float fInterval = fIntervalTable;
                if (_fAttackDelta > 0)
                    fInterval /= _fAttackDelta;

                // Open-KO birebir: fTime > m_fAttackTimeRecent + fInterval — PlayerMySelf.cpp:231
                if (fTime > _fAttackTimeRecent + fInterval)
                {
                    // Open-KO birebir: PlayerMySelf.cpp:234 — casting sırasında melee saldırı yapılamaz
                    bool bCastingNow = EntropyOnline.Combat.KOMagicSkillManager.Instance?.IsCasting() ?? false;
                    if (!bCastingNow)
                    {
                        // Open-KO birebir: IsAttackableTarget(pTarget) — PlayerMySelf.cpp:237
                        float fD = Vector3.Distance(transform.position, _attackTarget.transform.position);

                        // Open-KO birebir: AttackableDistance — PlayerMySelf.cpp:730-743
                        float playerRadius = 0.5f;
                        if (_charController != null)
                            playerRadius = _charController.radius;

                        float targetRadius = 0.5f;
                        var targetCol = _attackTarget.GetComponent<CapsuleCollider>();
                        if (targetCol != null)
                            targetRadius = targetCol.radius * _attackTarget.transform.localScale.x;

                        // Open-KO birebir: PlayerMySelf.cpp:735-740
                        float fDistLimit = (playerRadius + targetRadius) / 2.0f;
                        if (weaponRange > 0)
                            fDistLimit += weaponRange / 10.0f;  // siAttackRange / 10.0f

                        if (fD <= fDistLimit)
                        {
                            // Open-KO birebir: PlayerMySelf.cpp:239-246
                            float fDistRadius = (playerRadius + targetRadius) / 2.0f;
                            float fDistance = fD - fDistRadius;
                            if (fDistance < 0) fDistance = 0;

                            // Open-KO birebir: RotateTo(pTarget) — PlayerMySelf.cpp:239
                            // C++ birebir: RotateTo(fYaw, false) — smooth
                            RotateToTarget(_attackTarget.transform);

                            MsgSend_AttackPacket(_attackTarget, fIntervalTable, fDistance);

                            // C++ birebir satır 243: animasyon koşulu
                            // if (PSA_SPELLMAGIC != m_eState && PSA_ATTACK != m_eState && m_fFlickeringFactor == 1.0f)
                            if (_eState != PlayerStateAction.PSA_SPELLMAGIC &&
                                _eState != PlayerStateAction.PSA_ATTACK &&
                                _fFlickeringFactor == 1.0f)
                            {
                                Action(PlayerStateAction.PSA_ATTACK, false);
                            }

                            // Open-KO: m_bRenderTrace (N3Chr.cpp:1733-1736)
                            SetWeaponTracing(true);
                            StartCoroutine(DisableTrailAfterDelay(fInterval));

                            _fAttackTimeRecent = fTime;  // PlayerMySelf.cpp:246
                        }
                        else
                        {
                            // Open-KO birebir: RotateTo(pTarget) — PlayerMySelf.cpp:252
                            // Menzil dışında da hedefe dön — smooth yeterli
                            RotateToTarget(_attackTarget.transform);

                            if (!_bTargetOrPosMove)
                                SetMoveTargetID(_attackTarget);

                            // C++ birebir satır 264-266: attack animasyonu değilse idle'a dön
                            // if (PSA_SPELLMAGIC != m_eState && PSA_SITDOWN != m_eState)
                            //     this->Action(PSA_BASIC, true);
                            if (_eState != PlayerStateAction.PSA_SPELLMAGIC &&
                                _eState != PlayerStateAction.PSA_SITDOWN)
                            {
                                Action(PlayerStateAction.PSA_BASIC, true);
                            }
                        }
                    }
                }
            }

            // C++ birebir satır 272-274: saldırı bu tick'te yapıldıysa → oturmayı kaldır
            if (fTime == _fAttackTimeRecent)
                CommandSitDown(false, false);
        }

        /// <summary>
        /// Saldırı paketi gönder.
        ///
        /// Open-KO referans: GameProcMain::MsgSend_Attack (GameProcMain.cpp:1463-1484)
        ///   MP_AddByte(WIZ_ATTACK)         — 0x08
        ///   MP_AddByte(0x01)               — attack sub-type
        ///   MP_AddByte(bySuccess=true)      — success flag
        ///   MP_AddShort(iTargetID)          — hedef SID (short)
        ///   MP_AddShort((fInterval+0.1)*100) — centisaniye
        ///   MP_AddShort(fDistance*10)        — desimetre
        ///
        /// NOT: Bizim sunucu (CombatProcessor.ProcessBasicAttack) farklı format bekler:
        ///   ReadInt64(targetId) + ReadBool(targetIsPlayer)
        /// Open-KO short ID kullanır, bizim sunucu long ID kullanır.
        /// Open-KO interval/distance gönderir, bizim sunucu cooldown'u kendi hesaplar.
        /// </summary>
        private void MsgSend_AttackPacket(KOEntity target, float fIntervalTable, float fDistance)
        {
            if (KONetworkManager.Instance == null || !KONetworkManager.Instance.IsConnected) return;

            // ServerInstanceId atanmamışsa sunucu bu monster'ı bulamaz
            if (target.ServerInstanceId < 0)
            {
                Debug.LogWarning($"[ATTACK] Hedef '{target.EntityName}' henüz sunucu ile eşleşmedi (ServerInstanceId=-1)");
                return;
            }

            // Saldırı öncesi pozisyon güncelle — sunucu menzil kontrolü yapıyor
            SendMovePacket();
            _lastSentPosition = transform.position;

            // Open-KO birebir: WIZ_ATTACK (GameProcMain.cpp:1474-1482)
            // Wire: [WIZ_ATTACK][attackType:byte][bySuccess:byte][targetId:int16][interval:int16][distance:int16]
            using var pkt = new KOPacketWriter(WizOpcode.WIZ_ATTACK);
            pkt.WriteByte(1);    // cpp:1475 — attackType: 0x01 = melee
            pkt.WriteByte(1);    // cpp:1476 — bySuccess: true (항상 성공으로 보냄)
            pkt.WriteInt16((short)target.ServerInstanceId);
            pkt.WriteInt16((short)((fIntervalTable + 0.1f) * 100f)); // centiseconds
            pkt.WriteInt16((short)(fDistance * 10f)); // decimetres
            KONetworkManager.Instance.SendPacket(pkt);
        }

