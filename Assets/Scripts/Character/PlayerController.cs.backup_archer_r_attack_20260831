        /// <summary>
        /// Open-KO birebir: CPlayerBase::Action (PlayerBase.cpp:940-1112)
        ///
        /// State Table doğrulaması yaparak state geçişi ve animasyon tetikler.
        /// PSA_SPELLMAGIC case'inde:
        ///   - m_eStateNext = PSA_BASIC
        ///   - fFreezeTime = m_fCastFreezeTime
        ///   - eAni = JudgetAnimationSpellMagic() = (e_Ani)(m_iMagicAni)
        ///   - bOnceAndFreeze = true
        ///   - AniCurSet(eAni, true, fBlendTime, fFreezeTime)
        /// </summary>
        public bool Action(PlayerStateAction eState, bool bLooping = false, bool bForceSet = false)
        {
            // C++ satır 942-968: State Table kontrol
            if (!bForceSet)
            {
                if (!KOStateTable.CanTransition(_eState, eState))
                    return false;

                // Open-KO rule: cannot sit down while moving/running (m_eStateMove != PSM_STOP)
                if (eState == PlayerStateAction.PSA_SITDOWN && IsMovingNow())
                    return false;
            }

            PlayerStateAction eStatePrev = _eState;
            _eStateNext = _eState = eState;  // cpp:978

            KOAni eAni = KOAni.ANI_UNKNOWN;
            KOAni eAniToRestore = KOAni.ANI_UNKNOWN;  // cpp:975 — animasyon bitince oynatılacak sonraki animasyon
            bool bOnceAndFreeze = false;
            float fFreezeTime = 0f;
            bool bNeedUpperAnimationOnly = false;  // cpp:972 — üst gövde animasyon flag'i

            switch (eState)
            {
                case PlayerStateAction.PSA_BASIC:  // cpp:982-1003
                    if (eStatePrev == PlayerStateAction.PSA_SITDOWN)
                    {
                        if (KONetworkManager.Instance != null && KONetworkManager.Instance.IsConnected)
                        {
                            using (var packet = new KOPacketWriter(WizOpcode.WIZ_STATE_CHANGE))
                            {
                                packet.WriteByte(1);
                                packet.WriteByte(1);
                                KONetworkManager.Instance.SendPacket(packet);
                            }
                        }
                    }

                    if (_eStateMove == PlayerStateMove.PSM_STOP)
                    {
                        if (eStatePrev == PlayerStateAction.PSA_SITDOWN)
                        {
                            // cpp:987-990: ANI_STANDUP + eAniToRestore = JudgeAnimationBreath()
                            eAni = KOAni.ANI_STANDUP;
                            if (_eStateMove == PlayerStateMove.PSM_STOP)
                                eAniToRestore = GetJudgeBreath();
                            bOnceAndFreeze = true;
                            break;
                        }
                        else
                        {
                            // cpp:993: JudgeAnimationBreath()
                            eAni = GetJudgeBreath();
                        }
                    }
                    else if (_eStateMove == PlayerStateMove.PSM_WALK)
                        eAni = KOAnimJudge.JudgeAnimationWalk(false);
                    else if (_eStateMove == PlayerStateMove.PSM_RUN)
                        eAni = KOAnimJudge.JudgeAnimationRun(false);
                    else if (_eStateMove == PlayerStateMove.PSM_WALK_BACKWARD)
                        eAni = KOAnimJudge.JudgeAnimationWalkBackward(false);
                    else
                        eAni = GetJudgeBreath();
                    break;

                case PlayerStateAction.PSA_ATTACK:  // cpp:1005-1030
                {
                    // cpp:1012-1023: hareket durumuna ve silaha göre animasyon seçimi
                    if (IsMovingNow())  // cpp:1012: !bNPC && IsMovingNow()
                    {
                        // cpp:1014-1017: Sağ elde silah var mı?
                        var rhWpn = UI.KOInventory.Instance?.GetRightHandWeapon();
                        if (rhWpn != null && !rhWpn.IsEmpty)  // cpp:1014: m_pItemPlugBasics[0]
                            eAni = KOAni.ANI_ATTACK_WITH_WEAPON_WHEN_MOVE;  // cpp:1015
                        else
                            eAni = KOAni.ANI_ATTACK_WITH_NAKED_WHEN_MOVE;   // cpp:1017
                        // cpp:1018: bNeedUpperAnimationOnly = true
                        bNeedUpperAnimationOnly = true;
                    }
                    else  // cpp:1020-1023
                    {
                        eAni = GetJudgeAttack();  // cpp:1022: JudgeAnimationAttack()
                    }

                    if (!bLooping)  // cpp:1025-1028
                    {
                        _eStateNext = PlayerStateAction.PSA_BASIC;  // cpp:1027
                    }
                    bOnceAndFreeze = true;  // Saldırı animasyonu bir kere oynar
                }
                break;

                case PlayerStateAction.PSA_GUARD:  // cpp:1032-1041
                    _eStateNext = PlayerStateAction.PSA_BASIC;
                    eAni = KOAnimJudge.JudgeAnimationGuard(false);  // cpp:1035
                    bNeedUpperAnimationOnly = true;  // cpp:1038: if (!bNPC) bNeedUpperAnimationOnly = true
                    fFreezeTime = 1.5f;  // cpp:1039
                    break;

                case PlayerStateAction.PSA_STRUCK:  // cpp:1043-1050
                    _eStateNext = PlayerStateAction.PSA_BASIC;
                    eAni = KOAnimJudge.JudgeAnimationStruck(false);  // cpp:1046
                    bNeedUpperAnimationOnly = true;  // cpp:1048: if (!bNPC) bNeedUpperAnimationOnly = true
                    break;

                case PlayerStateAction.PSA_DYING:  // cpp:1052-1057
                    _eStateNext = PlayerStateAction.PSA_DEATH;
                    _eStateMove = PlayerStateMove.PSM_STOP;
                    eAni = KOAnimJudge.JudgeAnimationDying(false);  // cpp:1055
                    bOnceAndFreeze = true;  // cpp:1056
                    break;

                case PlayerStateAction.PSA_DEATH:  // cpp:1059-1067
                    _eStateNext = PlayerStateAction.PSA_DEATH;
                    return true;

                case PlayerStateAction.PSA_SITDOWN:  // cpp:1069-1073
                    eAni = KOAni.ANI_SITDOWN;           // cpp:1070
                    eAniToRestore = KOAni.ANI_SITDOWN_BREATH;  // cpp:1071
                    bOnceAndFreeze = true;              // cpp:1072

                    if (KONetworkManager.Instance != null && KONetworkManager.Instance.IsConnected)
                    {
                        using (var packet = new KOPacketWriter(WizOpcode.WIZ_STATE_CHANGE))
                        {
                            packet.WriteByte(1);
                            packet.WriteByte(2);
                            KONetworkManager.Instance.SendPacket(packet);
                        }
                    }

                    break;

                // ===================================================
                // PSA_SPELLMAGIC — C++ PlayerBase.cpp satır 1075-1080
                // ===================================================
                case PlayerStateAction.PSA_SPELLMAGIC:
                    _eStateNext = PlayerStateAction.PSA_BASIC;  // cpp:1076
                    fFreezeTime = CastFreezeTime;               // cpp:1077
                    eAni = (KOAni)MagicAni;                     // cpp:1078: JudgetAnimationSpellMagic()
                    bOnceAndFreeze = true;                       // cpp:1079
                    bNeedUpperAnimationOnly = false;            // C++ birebir: spell/buff animations are played on whole body
                    break;

                default:
                    return false;
            }

            // cpp:1086-1092: bForceSet → bNeedUpperAnimationOnly = false
            if (bForceSet)
                bNeedUpperAnimationOnly = false;  // cpp:1089

            // cpp:1095-1097: AnimationClear + AnimationAdd(eAniToRestore)
            // Open-KO birebir: önce deque'yu temizle, sonra restore animasyonu ekle
            AnimationClear();  // cpp:1095
            if (eAniToRestore != KOAni.ANI_UNKNOWN)
                AnimationAdd(eAniToRestore, false);  // cpp:1096-1097

            // cpp:1099-1104: Animasyon tetikleme
            // bNeedUpperAnimationOnly → AniUpperSet (sadece üst gövde)
            // else → AniCurSet (tüm gövde)
            if (eAni != KOAni.ANI_UNKNOWN)
            {
                EnsureAnimResolverInit();
                string clipName = _animResolver?.GetClipName(eAni);

                // NOT: C++'da isim tabanlı fallback YOK.
                // C++ tamamen index-based çalışır: JudgeAnimationAttack() → e_Ani → AniCurSet(eAni)
                // KOAnimResolver index sırasını N3ChrImporter'dan alır — doğru sırada olmalı.

                if (!string.IsNullOrEmpty(clipName))
                {
                    // Open-KO birebir: AniCurSet(eAni, bOnceAndFreeze, fBlendTime, fFreezeTime)
                    // fFreezeTime > 0 → animasyon bittikten sonra bu süre boyunca IsAnimEnd()=false
                    _fFreezeTimeRemaining = fFreezeTime;

                    if (bNeedUpperAnimationOnly)
                    {
                        PlayCharAnimUpper(clipName);
                    }
                    else
                    {
                        PlayCharAnim(clipName, bOnceAndFreeze);
                    }
                }
                else
                {
                    // Clip bulunamadı — mevcut animasyonu durdur ki IsAnimEnd() true
                    // dönsün ve TickAnimation state dönüşü yapabilsin.
                    // NOT: C++'ta AniCurSet geçersiz index alırsa return -1 döner ve
                    // mevcut animasyon devam eder. Ama C++'ta bu durum asla olmaz
                    // çünkü N3 modelde tüm animasyonlar index'le geçerlidir.
                    // Bizde Unity modelinde clip eksik olabileceği için bu güvenlik
                    // önlemi gerekli — aksi halde state sonsuza kadar sıkışır.
                    if (_charAnim != null)
                    {
                        _charAnim.Stop();
                        _currentAnim = null;
                    }
                        // $"KOAnimResolver'da {_animResolver?.ClipCount ?? 0} klip var, index aralık dışı. " +
                        // "Animasyon durduruldu, IsAnimEnd()=true olacak.");
                }
            }

            return true;
        }

        public void CommandSitDown(bool bSit, bool bImmediately = false)
        {
            if (bSit)
            {
                if (_eState == PlayerStateAction.PSA_SITDOWN) return;
                Action(PlayerStateAction.PSA_SITDOWN, false, bImmediately);
            }
            else
            {
                if (_eState != PlayerStateAction.PSA_SITDOWN) return;
                Action(PlayerStateAction.PSA_BASIC, true, bImmediately);
            }
        }

