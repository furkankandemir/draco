        /// <summary>
        /// Open-KO birebir: PlayerBase::AnimationAdd (PlayerBase.cpp:2083-2093)
        ///
        /// bImmediately=true  → deque'yu temizle + doğrudan AniCurSet
        /// bImmediately=false → deque'ya ekle (animasyon bitince oynatılır)
        /// </summary>
        public void AnimationAdd(KOAni eAni, bool bImmediately)
        {
            if (bImmediately)
            {
                AnimationClear();  // cpp:2087

                // C++ birebir: AniCurSet (N3Chr.cpp:2233-2234)
                //   if (iAni == m_FrmCtrl.iAni) return -1;  ← aynı anim kontrolü Init'ten ÖNCE
                //   m_FrmCtrl.Init();  ← Init SONRA (satır 2244)
                // Unity eşdeğeri: PlayCharAnim'deki _currentAnim == animName kontrolü
                // aynı animasyonu tekrar istemeyi otomatik atlar.
                // _currentAnim sıfırlanMAZ — aynı skill SuccessCast'ten gelince atlanır.

                // C++ birebir: combo animasyonları AniCurSet ile oynatılır
                // TickAnimation combo bittikten sonra Action(m_eStateNext) çağırır
                // m_eStateNext combo başlamadan önceki state'in next'idir
                _eState = PlayerStateAction.PSA_BASIC;
                _eStateNext = PlayerStateAction.PSA_BASIC;

                EnsureAnimResolverInit();
                string clipName = _animResolver?.GetClipName(eAni);
                if (!string.IsNullOrEmpty(clipName))
                {
                    PlayCharAnim(clipName, true);  // bOnceAndFreeze=true → IsAnimEnd çalışsın
                }
                else
                {
                    Debug.LogWarning($"[AnimationAdd] Clip bulunamadı! eAni={eAni}({(int)eAni}) — " +
                        $"ClipCount={_animResolver?.ClipCount ?? 0}. " +
                        "Karakter modelinde bu index'te animasyon yok.");
                }
            }
            else
            {
                _animationDeque.Enqueue(eAni);  // cpp:2092
            }
        }

        /// <summary>
        /// Open-KO birebir: PlayerBase::AnimationClear (PlayerBase.h:268-271)
        /// Animasyon kuyruğunu temizler.
