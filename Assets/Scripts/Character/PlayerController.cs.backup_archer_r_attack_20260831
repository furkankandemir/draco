        private bool IsOneShotAnimPlaying()
        {
            if (_charAnim == null || string.IsNullOrEmpty(_currentAnim)) return false;
            string resolved = FindClipCaseInsensitive(_currentAnim);
            if (resolved == null) return false;
            AnimationState state = _charAnim[resolved];
            if (state == null) return false;
            return state.wrapMode == WrapMode.ClampForever && _charAnim.IsPlaying(resolved);
        }

