        // TickJoints blend (N3Chr.cpp:1647-1651)
        //
        // Animasyon geçişinde bone'lar arası yumuşak geçiş:
        //   fBlendFactor = fBlendTimeCur / fBlendTime (0→1)
        //   pos  = Lerp(oldPos, newPos, fBlendFactor)
        //   rot  = Slerp(oldRot, newRot, fBlendFactor)
        // =====================================================
        private float _blendTime;        // C++ m_FrmCtrl.fBlendTime
        private float _blendTimeCur;     // C++ m_FrmCtrl.fBlendTimeCur
        private Transform[] _blendBones; // Tüm bone transform'ları (cache)
        private Vector3[] _blendFromPos; // C++ fBlendFrm → eski bone localPosition
        private Quaternion[] _blendFromRot; // C++ fBlendFrm → eski bone localRotation

        /// <summary>
        /// C++ birebir: AniCurSet → fBlendFrm = fFrmPrev
        /// Mevcut bone pozisyonlarını kaydet ve blend timer başlat.
        /// </summary>
        private void StartBlend(float blendTime)
        {
            if (blendTime <= 0f || _charAnim == null) return;

            // Bone listesini cache'le (ilk seferde)
            // C++ birebir: TickJoints m_JointRefs üzerinde döner
            // Index 0 = model root (Animation component'in kendi GO'su)
            // Model root blend EDILMEZ — sadece bone joint'ler blend edilir
            if (_blendBones == null)
            {
                var allTransforms = _charAnim.GetComponentsInChildren<Transform>();
                // Index 0'i atla (model root) — C++ m_JointRefs model root içermez
                if (allTransforms.Length > 1)
                {
                    _blendBones = new Transform[allTransforms.Length - 1];
                    System.Array.Copy(allTransforms, 1, _blendBones, 0, allTransforms.Length - 1);
                }
                else
                {
                    _blendBones = allTransforms;
                }
            }

            // C++ fBlendFrm = fFrmPrev: eski bone pozisyonlarını kaydet
            int count = _blendBones.Length;
            if (_blendFromPos == null || _blendFromPos.Length != count)
            {
                _blendFromPos = new Vector3[count];
                _blendFromRot = new Quaternion[count];
            }

            for (int i = 0; i < count; i++)
            {
                if (_blendBones[i] != null)
                {
                    _blendFromPos[i] = _blendBones[i].localPosition;
                    _blendFromRot[i] = _blendBones[i].localRotation;
                }
            }

            _blendTime = blendTime;
            _blendTimeCur = 0f;
        }

        private void LateUpdate()
        {
            // =====================================================
            // C++ birebir: TickJoints (N3Chr.cpp:1647-1651)
            //   if (fBlendTime > 0)
            //     fBlendFactor = fBlendTimeCur / fBlendTime
            //     ReCalcMatrixBlended(fFrmCur, fBlendFrm, fBlendFactor)
            // =====================================================
            if (_blendTimeCur < _blendTime && _blendBones != null)
            {
                // C++ birebir: fBlendFactor = fBlendTimeCur / fBlendTime
                float fBlendFactor = _blendTimeCur / _blendTime;

                for (int i = 0; i < _blendBones.Length; i++)
                {
                    // Destroyed object kontrolü — ölüm/respawn sonrası bone silinmiş olabilir
                    if (_blendBones[i] == null) continue;

                    // C++ birebir: ReCalcMatrixBlended (N3Joint.cpp:398-416)
                    //   m_vPos = (v1 * fWeight0) + (v2 * fWeight1)  → Lerp
                    //   m_qRot.Slerp(qt1, qt2, fWeight1)            → Slerp
                    _blendBones[i].localPosition = Vector3.Lerp(
                        _blendFromPos[i], _blendBones[i].localPosition, fBlendFactor);
                    _blendBones[i].localRotation = Quaternion.Slerp(
                        _blendFromRot[i], _blendBones[i].localRotation, fBlendFactor);
                }

                // C++ birebir: TickAnimationFrame (N3Chr.cpp:1543)
                //   fBlendTimeCur += fDelta
                _blendTimeCur += Time.deltaTime;

                // C++ birebir: N3Chr.cpp:1544-1548
                //   if (fBlendTimeCur > fBlendTime) → fBlendTime = 0
                if (_blendTimeCur >= _blendTime)
                {
                    _blendTime = 0f;
                    _blendTimeCur = 0f;
                }
            }
        }

        private void Update()
        {
            // Update stealth visibility for nearby players when detection buff is active
            if (CanSeeStealth && Time.frameCount % 15 == 0)
            {
                var entityMgr = EntropyOnline.World.EntityManager.Instance;
                if (entityMgr != null)
                {
                    foreach (var pair in entityMgr.GetAllRemotePlayers())
                    {
                        if (pair.Value != null && pair.Value.Root != null)
                        {
                            var eqVis = pair.Value.Root.GetComponent<EntropyOnline.World.KOEquipmentVisualizer>();
                            if (eqVis == null) eqVis = pair.Value.Root.GetComponentInParent<EntropyOnline.World.KOEquipmentVisualizer>();
                            if (eqVis != null && eqVis.IsStealthActive)
                            {
                                var gameHud = GameHUD.Instance;
                                if (gameHud != null)
                                {
                                    bool isSameNation = pair.Value.Nation == GameManager.Instance.Nation;
                                    gameHud.RefreshStealthTransparency(pair.Value.Root, false, isSameNation, true);
                                }
                            }
                        }
                    }
                }
            }

            // C++ birebir: Blending süresince yeni animasyon başlangıç karesinde donuk kalır (fFrmCur = fFrmStart)
            if (_blendTimeCur < _blendTime && !string.IsNullOrEmpty(_currentAnim) && _charAnim != null)
            {
                string resolvedName = FindClipCaseInsensitive(_currentAnim);
                if (resolvedName != null)
                {
                    var state = _charAnim[resolvedName];
                    if (state != null)
                    {
                        state.time = 0f;
                    }
                }
            }

            if (joystick == null) return;

            // Karakter zemin/havada kalma teşhisi için her 180 frame'de bir log bas
            if (Time.frameCount % 180 == 0)
            {
                var rrs = GetComponentsInChildren<Renderer>();
                if (rrs.Length > 0)
                {
                    Bounds wb = rrs[0].bounds;
                    for (int ri = 1; ri < rrs.Length; ri++)
                    {
                        // Sadece gövde parçalarını (PART_) dahil et, pelerin/silah (PLUG) hariç
                        if (rrs[ri].name.StartsWith("PART_") && !rrs[ri].name.Contains("PLUG"))
                            wb.Encapsulate(rrs[ri].bounds);
                    }
                    
                    float realTerrainY = World.WorldBuilder.Instance != null ? World.WorldBuilder.Instance.GetTerrainHeight(transform.position.x, transform.position.z) : 0f;
                    float modelLocalY = 0f;
                    var anim = GetComponentInChildren<Animation>();
                    if (anim != null)
                        modelLocalY = anim.transform.localPosition.y;
                    
                }
            }

            // Open-KO birebir: CPlayerBase::Tick() (PlayerBase.cpp:698-706)
            // TickYaw + TickAnimation — HER ZAMAN çalışır (ölüyken de)
            // C++'da Tick() death guard'ından ÖNCE çağrılır.
            TickYaw();
            TickAnimation();

            // C++ birebir: UIStateBar::TickMiniMap() satır 519 — m_vPosPlayer = s_pPlayer->Position()
            var gm = GameManager.Instance;
            if (gm != null)
            {
                var pos = transform.position;
                gm.PlayerPosX = pos.x;
                gm.PlayerPosZ = pos.z;

                if (KOEventManager.Instance != null)
                {
                    KOEventManager.Instance.SetPos(pos.x, pos.z);
                }
            }

            // Open-KO birebir: PlayerBase::Tick → if (m_fTimeAfterDeath > 0) return;
            // Hareket, saldırı ve stun tick'leri ölüyken engellenir.
            if (_fTimeAfterDeath > 0f) return;

            // ================================================================
            // Open-KO birebir: PlayerMySelf::Tick() sıralaması (PlayerMySelf.cpp:108-298)
            //   1. Movement (satır 141-163)
            //   2. AttackTick — m_bAttackContinous (satır 168-276)
            //   3. Stun (satır 279-284)
            //   4. ProcessAttack (satır 287-292)
            // ================================================================
            HandleMovement();
            HandleNetworkSync();

            // Open-KO birebir: PlayerMySelf::Tick (PlayerMySelf.cpp:168-276)
            // Oto-saldırı tick döngüsü — RotateTo burada çağrılır
            AttackTick();

            // Open-KO birebir: PlayerMySelf::Tick (PlayerMySelf.cpp:279-284)
            // Stun countdown tick
            if (_bStun)
            {
                _fStunTime -= Time.deltaTime;  // cpp:281: m_fStunTime -= s_fSecPerFrm
                if (_fStunTime < 0f)            // cpp:282: if (m_fStunTime < 0)
                    StunRelease();              // cpp:283: this->StunRelease()
            }
        }

        private void HandleMovement()
        {
            // Open-KO birebir: GameProcMain.cpp:4697 — stun sırasında hareket engellenir
            if (_bStun) return;

            Vector2 input = joystick.Direction;

            // Editor'de WASD desteği (Yeni Input System)
#if UNITY_EDITOR
            if (!joystick.IsActive && !KOUIManager.IsAnyInputFieldFocused())
            {
                var kb = Keyboard.current;
                if (kb != null)
                {
                    float h = 0, v = 0;
                    if (kb.aKey.isPressed) h -= 1f;
                    if (kb.dKey.isPressed) h += 1f;
                    if (kb.wKey.isPressed) v += 1f;
                    if (kb.sKey.isPressed) v -= 1f;
                    if (Mathf.Abs(h) > 0.1f || Mathf.Abs(v) > 0.1f)
                        input = new Vector2(h, v).normalized;
                }
            }
#endif


            // Yerçekimi — terrain yüklenmeden uygulanmaz (ilk frame düşme koruması)
            // C++ birebir: InitWorld tamamlanmadan hareket işlenmez
            if (WorldBuilder.Instance == null || (!WorldBuilder.Instance.IsIndoor && WorldBuilder.Instance.Terrain == null))
            {
                _verticalVelocity = 0f;
                return;
            }

            if (_charController.isGrounded)
                _verticalVelocity = -6.0f;
            else
                _verticalVelocity += _gravity * Time.deltaTime;

            // Düşme koruması — terrain'den düştüyse son güvenli pozisyona geri al
            // Bu olmazsa sunucuya negatif Y gönderilir ve veritabanı bozulur
            if (transform.position.y < -10f)
            {
                Debug.LogWarning($"[PC] Düşme koruması! Y={transform.position.y:F1} — geri alınıyor");
                if (_charController != null) _charController.enabled = false;
                // C++ birebir: InitPlayerPosition ile terrain height'a dön
                float safeY = GetTerrainHeightAtPosition(transform.position.x, transform.position.z);
                if (safeY < -100f) safeY = 1f; // sentinel check
                float offset = (WorldBuilder.Instance != null && WorldBuilder.Instance.IsIndoor) ? 0.6f : 0.5f;
                transform.position = new Vector3(transform.position.x, safeY + offset, transform.position.z);
                if (_charController != null) _charController.enabled = true;
                _verticalVelocity = 0f;
            }

            if (input.sqrMagnitude > 0.01f)
            {
                // ================================================================
                // Open-KO birebir: hareket → PSA_SPELLMAGIC iptal (combo cancel)
                // C++ PlayerBase.cpp: ActionMove() → Action(PSA_BASIC, true)
                //
                // Güvenlik: _fDelay süresi dolmadan tetiklenmiyor.
                // IsCasting() = true iken (timer aktif VEYA _fDelay > 0) cancel engellenir.
                // Bu sayede ok fırladığı an (PSA_SPELLMAGIC + _fDelay=0.1f) combo cancel
                // tetiklenmez, animasyon bozulmaz.
                // ================================================================
                if (_eState == PlayerStateAction.PSA_SPELLMAGIC)
                {
                    var magicMgr = KOMagicSkillManager.Instance;
                    if (magicMgr != null)
                    {
                        if (magicMgr.IsCastingTimerActive())
                        {
                            // Casting timer çalışıyor → FailCast (skill kesilir)
                            magicMgr.CancelCasting();
                        }
                        else
                        {
                            // Casting timer bitti, büyü atıldı. Şu an bitiş/efekt animasyonu oynuyor.
                            // Hareket edilirse animasyonu kes ve yürü/koş durumuna geç (Combo/Movement cancel).
                            Action(PlayerStateAction.PSA_BASIC, true);
                        }
                    }
                }

                // Open-KO birebir: Manuel hareket → oto-saldırı ve hedefe yürüme iptal
                // GameProcMain.cpp — CommandMove çağrıldığında attack durdurulur
                if (_bAttackContinous)
                    StopAutoAttack();
                if (_bTargetOrPosMove)
                    CancelMoveToTarget();

                // C++ birebir: GameProcMain.cpp:4607-4609 — hareket başladığında
                // s_pUIMgr->UserMoveHideUIs() — UISTYLE_USER_MOVE_HIDE panelleri kapat
                if (!_wasMoving)
                {
                    var uiMgr = EntropyOnline.UI.KOUIManager.Instance;
                    if (uiMgr != null)
                        uiMgr.UserMoveHideUIs();
                }

                // Kamera yönüne göre hareket (3rd person)
                float cameraYaw = _cameraController != null ? _cameraController.CurrentYaw : 0f;
                Vector3 forward = Quaternion.Euler(0, cameraYaw, 0) * Vector3.forward;
                Vector3 right = Quaternion.Euler(0, cameraYaw, 0) * Vector3.right;

                Vector3 moveDir = (forward * input.y + right * input.x).normalized;
                moveDir.y = 0;

                // C++ birebir: RotateTo(fYaw, true) — bImmediately=true
                // Hareket yönü değiştiğinde karakter anında döner
                transform.rotation = Quaternion.LookRotation(moveDir);

                // C++ birebir: yaw'ı senkronize et
                float fMoveYaw = Mathf.Atan2(moveDir.x, moveDir.z);
                while (fMoveYaw > Mathf.PI) fMoveYaw -= 2f * Mathf.PI;
                while (fMoveYaw < -Mathf.PI) fMoveYaw += 2f * Mathf.PI;
                _fYawCur = fMoveYaw;
                _fYawToReach = fMoveYaw;
                _fYawDirty = false;

                // Hareket
                // Open-KO birebir: speed = baseSpeed * m_fMoveDelta (PlayerBase.h:143)
                float prevY = transform.position.y;
                float hSpeed = moveSpeed * _fMoveDelta;
                Vector3 horizontalMove = moveDir * hSpeed;

                // Open-KO birebir: Dik yamaç tırmanma engeli (Slope Limit Check)
                if (CheckClimbCollision(moveDir, hSpeed * Time.deltaTime))
                {
                    horizontalMove = Vector3.zero;
                }

                Vector3 velocity = horizontalMove + Vector3.up * _verticalVelocity;
                if (_charController != null && _charController.enabled)
                    _charController.Move(velocity * Time.deltaTime);

                if (WorldBuilder.Instance != null && WorldBuilder.Instance.IsIndoor)
                {
                    float newY = transform.position.y;
                    // C++ birebir: if ((m_fYNext > vPos.y + 0.6f) || (m_fYNext < vPos.y - 0.6f * 2.0f)) m_fYNext = vPos.y;
                    if (newY > prevY + 0.6f || newY < prevY - 1.2f)
                    {
                        _charController.enabled = false;
                        transform.position = new Vector3(transform.position.x, prevY, transform.position.z);
                        _charController.enabled = true;
                        _verticalVelocity = 0f;
                    }
                }

                // Open-KO birebir: C++'da hareket animasyonu sadece PSA_BASIC/PSA_ATTACK state'inde.
                // PSA_SPELLMAGIC'te hareket → ProcessCasting FailCast yapar → state PSA_BASIC olur → sonra anim oynar.
                if (_eState != PlayerStateAction.PSA_SPELLMAGIC)
                {
                    if (_eState == PlayerStateAction.PSA_ATTACK)
                    {
                        Action(PlayerStateAction.PSA_BASIC, true, true);
                    }
                    ActionMove(PlayerStateMove.PSM_RUN);
                }

                _wasMoving = true;
            }
            else
            {
                // Sadece yerçekimi
                float prevY = transform.position.y;
                if (_charController != null && _charController.enabled)
                    _charController.Move(Vector3.up * _verticalVelocity * Time.deltaTime);

                if (WorldBuilder.Instance != null && WorldBuilder.Instance.IsIndoor)
                {
                    float newY = transform.position.y;
                    if (newY > prevY + 0.6f || newY < prevY - 1.2f)
                    {
                        _charController.enabled = false;
                        transform.position = new Vector3(transform.position.x, prevY, transform.position.z);
                        _charController.enabled = true;
                        _verticalVelocity = 0f;
                    }
                }

                // Open-KO birebir: TargetOrPosMove — hedefe yürüme tick'i
                // PlayerMySelf.cpp:1100-1151
                TargetOrPosMove();

                // C++ birebir: idle breath animasyonu Action(PSA_BASIC) ile set edilir ve Loop'la döner.
                // Combo/skill animasyonu (AniCurSet + bOnceAndFreeze=true) oynarken
                // hareket handler'dan override edilmez.
                if (!_bTargetOrPosMove
                    && _eState == PlayerStateAction.PSA_BASIC
                    && !IsOneShotAnimPlaying())
                    ActionMove(PlayerStateMove.PSM_STOP);

                // Hedefe yürüme veya oto-saldırıda menzile yürüme aktifse
                // stop paketi gönderme — hareket devam ediyor
                if (_wasMoving && !_bTargetOrPosMove)
                {
                    // Durma paketi gönder
                    SendStopPacket();
                    _wasMoving = false;
                }
            }
        }

