        public void AnimationClear()
        {
            _animationDeque.Clear();
        }

        /// <summary>
        /// Open-KO birebir: PlayerBase::TickAnimation (PlayerBase.cpp:535-553)
        ///
        /// Her frame çağrılır. Mevcut animasyon bittiyse:
        ///   - Deque boş → Action(m_eStateNext) ile sonraki state'e geç
        ///   - Deque dolu → sıradaki animasyonu oynat
        /// </summary>
        private void TickAnimation()
        {
            _bAnimationChanged = false;  // cpp:538

            if (!IsAnimEnd()) return;    // cpp:539: m_Chr.IsAnimEnd()

            _bAnimationChanged = true;   // cpp:541

            if (_animationDeque.Count == 0)
            {
                // cpp:542-546: Deque boş → sonraki state'e geç
                Action(_eStateNext, true);
            }
            else
            {
                // cpp:547-552: Deque'dan bir animasyon al ve oynat
                KOAni eAniToSet = _animationDeque.Dequeue();  // cpp:549-550
                // C++ birebir: AniCurSet aynı anim kontrolü Init'ten ÖNCE (satır 2233)
                EnsureAnimResolverInit();
                string clipName = _animResolver?.GetClipName(eAniToSet);
                if (!string.IsNullOrEmpty(clipName))
                {
                    PlayCharAnim(clipName, true);  // bOnceAndFreeze=true → combo zincirleme çalışsın
                }
            }
        }

        /// <summary>
        /// Mevcut animasyonun bitip bitmediğini kontrol eder.
        /// Open-KO birebir: CN3Chr::IsAnimEnd() — animasyon son frame'e ulaştı mı?
        ///
        /// Unity legacy Animation: ClampForever (bOnceAndFreeze) modundaki klipler
        /// normalizedTime >= 1.0 olduğunda bitmiştir.
        /// Loop modundaki klipler asla bitmez (IsAnimEnd = false).
        /// </summary>
        private bool IsAnimEnd()
        {
            if (_charAnim == null)
            {
                _charAnim = GetComponentInChildren<Animation>();
                if (_charAnim == null) return false;
            }

            // Hiç animasyon oynamıyorsa → bitti sayılır
            if (!_charAnim.isPlaying) return true;

            // Eğer üst gövde (Layer 1) animasyonu oynuyorsa ve onun bitişini bekliyorsak
            if (!string.IsNullOrEmpty(_currentAnimUpper))
            {
                string resolvedUpper = FindClipCaseInsensitive(_currentAnimUpper);
                if (resolvedUpper != null)
                {
                    AnimationState stateUpper = _charAnim[resolvedUpper];
                    if (stateUpper != null)
                    {
                        if (stateUpper.normalizedTime >= 1.0f || !stateUpper.enabled)
                        {
                            StopUpperBodyLayer();
                            return true;
                        }
                        return false;
                    }
                }
            }

            // Mevcut oynatılan klibin WrapMode'unu kontrol et
            if (string.IsNullOrEmpty(_currentAnim)) return false;

            // Case-insensitive resolve
            string resolvedName = FindClipCaseInsensitive(_currentAnim);
            if (resolvedName == null) return false;

            AnimationState state = _charAnim[resolvedName];
            if (state == null) return false;

            // Loop modundaki animasyonlar asla "bitmez"
            if (state.wrapMode == WrapMode.Loop || state.wrapMode == WrapMode.PingPong)
                return false;

            // ClampForever / Once: normalizedTime >= 1.0 → bitti
            if (state.normalizedTime < 1.0f)
                return false;

            // Open-KO birebir: CN3Chr fFreezeTime — animasyon bittikten sonra
            // fFreezeTime süresince IsAnimEnd()=false döner.
            // C++ N3Chr.cpp:2250-2255: if (m_FrmCtrl.fFreezeTime > 0) → countdown
            if (_fFreezeTimeRemaining > 0f)
            {
                _fFreezeTimeRemaining -= Time.deltaTime;
                return false;
            }

            return true;
        }

        /// <summary>
        /// Oynayan bir kombo/skill animasyonunun (veya sıradaki kombo animasyonlarının)
        /// henüz bitmediğini kontrol eder.
        /// </summary>
        public bool IsComboAnimPlaying()
        {
            if (_animationDeque != null && _animationDeque.Count > 0)
            {
                return true;
            }

            if (_charAnim == null || string.IsNullOrEmpty(_currentAnim))
            {
                return false;
            }
            string resolved = FindClipCaseInsensitive(_currentAnim);
            if (resolved == null)
            {
                return false;
            }
            AnimationState state = _charAnim[resolved];
            if (state == null)
            {
                return false;
            }

            bool isClampOrOnce = (state.wrapMode == WrapMode.ClampForever || state.wrapMode == WrapMode.Once);
            bool isBasic = (_eState == PlayerStateAction.PSA_BASIC);
            bool isTimeRemaining = (state.normalizedTime < 1.0f);


            if (isClampOrOnce && isBasic)
            {
                return isTimeRemaining;
            }
            return false;
        }

        #region Blindness / Fog / Targeting Restriction
        private bool _isBlinded = false;
        private bool _savedFog = false;
        private Color _savedFogColor = Color.white;
        private float _savedFogDensity = 0.01f;
        private FogMode _savedFogMode = FogMode.Exponential;
        private Coroutine _blindCoroutine;

        public bool IsBlinded
        {
            get => _isBlinded;
            set
            {
                if (_isBlinded == value) return;
                _isBlinded = value;

                if (_isBlinded)
                {
                    // Save current fog settings
                    _savedFog = RenderSettings.fog;
                    _savedFogColor = RenderSettings.fogColor;
                    _savedFogDensity = RenderSettings.fogDensity;
                    _savedFogMode = RenderSettings.fogMode;

                    // Apply blindness white/fog overlay
                    RenderSettings.fog = true;
                    RenderSettings.fogColor = new Color(0.85f, 0.85f, 0.85f, 1f);
                    RenderSettings.fogMode = FogMode.ExponentialSquared;
                    RenderSettings.fogDensity = 0.08f;

                    // Clear active target
                    KOTargetSelector.Instance?.ClearTarget();
                }
                else
                {
                    // Restore saved fog settings
                    RenderSettings.fog = _savedFog;
                    RenderSettings.fogColor = _savedFogColor;
                    RenderSettings.fogDensity = _savedFogDensity;
                    RenderSettings.fogMode = _savedFogMode;
                }
            }
        }

        public void StartBlindEffect(float duration)
        {
            if (_blindCoroutine != null) StopCoroutine(_blindCoroutine);
            _blindCoroutine = StartCoroutine(BlindRoutine(duration));
        }

        public void StopBlindEffect()
        {
            if (_blindCoroutine != null) StopCoroutine(_blindCoroutine);
            IsBlinded = false;
        }

        private IEnumerator BlindRoutine(float duration)
        {
            IsBlinded = true;

            float fadeTime = 1.0f;
            float solidTime = duration - fadeTime;
            if (solidTime < 0f) solidTime = 0f;

            yield return new WaitForSeconds(solidTime);

            // Smooth fade-out in final 1.0s
            float elapsed = 0f;
            float startDensity = 0.08f;
            float targetDensity = _savedFogDensity;

            while (elapsed < fadeTime)
            {
                elapsed += Time.deltaTime;
                float t = elapsed / fadeTime;
                RenderSettings.fogDensity = Mathf.Lerp(startDensity, targetDensity, t);
                yield return null;
            }

            IsBlinded = false;
            _blindCoroutine = null;
        }
        #endregion

    }
