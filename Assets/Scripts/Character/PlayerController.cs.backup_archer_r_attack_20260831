        ///
        /// Open-KO birebir: CN3Chr::AniCurSet(e_Ani eAni, bool bOnceAndFreeze, float fBlendTime, float fFreezeTime)
        ///   bOnceAndFreeze=true → WrapMode.ClampForever (son frame'de don)
        ///   bOnceAndFreeze=false → WrapMode.Loop veya CrossFade
        ///   fBlendTime → CrossFade süresi (varsayılan 0.2f)
        /// </summary>
        private void PlayCharAnim(string animName, bool bOnceAndFreeze = false)
        {
            // Open-KO birebir: CN3Chr::AniCurSet (N3Chr.cpp:2233)
            // if (iAni == m_FrmCtrl.iAni) return -1;
            // bOnceAndFreeze FARK ETMEZ — aynı animasyon tekrar istenirse HER ZAMAN atla
            if (_currentAnim == animName) return;

            // Lazy init — karakter modeli runtime'da yükleniyor
            if (_charAnim == null)
            {
                _charAnim = GetComponentInChildren<Animation>();
                if (_charAnim == null)
                {
                    Debug.LogWarning($"[T-POSE-DBG] Animation component bulunamadı! Player child count: {transform.childCount}");
                    return;
                }
                // One-time diagnostic log
                int clipCount = 0;
                foreach (AnimationState s in _charAnim) clipCount++;
            }

            // Layer 1'deki upper body animasyonlarını temizle
            StopUpperBodyLayer();

            // Case-insensitive clip arama
            string resolvedName = FindClipCaseInsensitive(animName);
            if (resolvedName == null)
            {
                var clipNames = new System.Collections.Generic.List<string>();
                foreach (AnimationState s in _charAnim) clipNames.Add(s.name);
                Debug.LogWarning($"[PLAY-ANIM-FAIL] Clip bulunamadı: '{animName}' — " +
                    $"mevcut {clipNames.Count} clip: [{string.Join(", ", clipNames.GetRange(0, System.Math.Min(20, clipNames.Count)))}]");
                return;
            }

            // =====================================================
            // C++ birebir: AniCurSet (N3Chr.cpp:2244)
            //   m_FrmCtrl.Init();  ← TÜM frame state sıfırla
            //   m_FrmCtrl.fFrmCur = pAniData->fFrmStart;  ← başa sar
            //
            // C++'ta aynı anda sadece TEK animasyon çalışır.
            // Unity CrossFade ise birden fazla AnimationState'i paralel
            // çalıştırır ve artık weight/state'ler bone bozulmasına
            // neden olabilir. Bu yüzden Stop + Play kullanıyoruz.
            // =====================================================

            // C++ birebir: AniCurSet (N3Chr.cpp:2253-2258)
            //   fBlendFrm = fFrmPrev → eski bone pozisyonlarını kaydet
            //   fBlendTime = pAniData->fTimeBlend
            // Model root HARIC — sadece bone joint'ler blend edilir
            float blendTime = GetAnimBlendTime(resolvedName, 0.25f);
            StartBlend(blendTime);

            // C++ birebir: m_FrmCtrl.Init() → TÜM animasyonları durdur
            _charAnim.Stop();

            // 3. Yeni animasyonun WrapMode'unu ayarla
            var clip = _charAnim.GetClip(resolvedName);
            WrapMode wrapMode = bOnceAndFreeze
                ? WrapMode.ClampForever   // Bir kez oynat, son frame'de don
                : WrapMode.Loop;          // Sürekli tekrar
            if (clip != null)
                clip.wrapMode = wrapMode;
            // AnimationState.wrapMode ayrı property — clip.wrapMode'dan bağımsız
            AnimationState aniState = _charAnim[resolvedName];
            if (aniState != null)
            {
                aniState.wrapMode = wrapMode;

                // Büyü/yetenek animasyonu hızı ölçekleme (Tüm Sınıflar İçin)
                if (IsActiveCast && resolvedName.ToLowerInvariant().Contains("magic_") && ActiveCastDuration > 0f && clip != null)
                {
                    // Uzun büyülerde (örn. Nova 3.0 sn) animasyon hızını yavaşlatma, orijinal USKO gibi kalsın
                    if (ActiveCastDuration < clip.length)
                    {
                        // Görsel algıdaki gecikmeyi telafi etmek için %15 (1.15f) hızlandırma çarpanı uyguluyoruz
                        float targetSpeed = (clip.length / ActiveCastDuration) * 1.15f;
                        aniState.speed = targetSpeed;
                    }
                    else
                    {
                        aniState.speed = 1.0f;
                    }
                }
                else
                {
                    aniState.speed = 1.0f; // Diğer animasyonlar için hızı sıfırla
                }
            }

            // 4. Animasyonu baştan başlat ve oynat
            // C++ birebir: fFrmCur = pAniData->fFrmStart
            _charAnim.Rewind(resolvedName);
            _charAnim.Play(resolvedName);

                      // $"{(bOnceAndFreeze ? "ClampForever" : "Loop")}) prev='{_currentAnim}' " +
                      // $"clipLen={clip?.length ?? -1:F2}s");

            _currentAnim = animName;
        }

