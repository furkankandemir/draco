        }

        /// <summary>
        /// Open-KO birebir: ACT_WORLD->GetHeightWithTerrain(x, z)
        /// Verilen dünya koordinatında terrain + collision yüksekliğini döndürür.
        /// WorldBuilder.GetTerrainHeight veya raycast fallback kullanır.
        /// </summary>
        private static float GetTerrainHeightAtPosition(float x, float z)
        {
            // 1. Raycast downwards from high above to find the highest solid surface (stairs, rocks, terrain colliders)
            // excluding Water, UI, and Ignore Raycast layers
            Ray ray = new Ray(new Vector3(x, 500f, z), Vector3.down);
            int layerMask = ~LayerMask.GetMask("Water", "UI", "Ignore Raycast");
            if (UnityEngine.Physics.Raycast(ray, out RaycastHit hit, 1000f, layerMask, QueryTriggerInteraction.Ignore))
                return hit.point.y + 0.1f;

            // 2. Fallback to WorldBuilder terrain height if Raycast misses (e.g., if colliders are not active yet)
            var wb = Object.FindAnyObjectByType<World.WorldBuilder>();
            if (wb != null)
            {
                float h = wb.GetTerrainHeight(x, z);
                if (h > -900f) // Geçerli değer kontrolü
                    return h + 0.1f; // Minimal buffer — yere gömülmesin
            }

            // 3. Son çare — makul bir varsayılan
            return 10f;
        }

        /// <summary>
        /// Open-KO birebir: CPlayerMySelf::CheckCollision incline limit portu
        /// Dik yamaçları (40 dereceden fazla) tırmanmayı engeller.
        /// </summary>
        private bool CheckClimbCollision(Vector3 moveDir, float speed)
        {
            // GM/Manager kontrolü: GM'ler engellenmez
            var gm = GameManager.Instance;
            if (gm != null && gm.Authority == 0)
                return false;

            // Indoor alanlarda arazi eğimi kontrol edilmez
            if (WorldBuilder.Instance != null && WorldBuilder.Instance.IsIndoor)
                return false;

            Vector3 targetPos = transform.position + moveDir * speed;

            // Karakterin hedef zeminini yukarıdan aşağı raycast ile tararız
            Ray ray = new Ray(new Vector3(targetPos.x, targetPos.y + 10f, targetPos.z), Vector3.down);
            int layerMask = ~LayerMask.GetMask("Water", "UI", "Ignore Raycast");

            if (UnityEngine.Physics.Raycast(ray, out RaycastHit hit, 20f, layerMask, QueryTriggerInteraction.Ignore))
            {
                Vector3 normal = hit.normal.normalized;
                Vector3 normalH = new Vector3(normal.x, 0f, normal.z);
                float normalMag = normalH.magnitude;

                // MAX_INCLINE_CLIMB = 0.6430f (40 derece eğim sine değeri)
                const float MAX_INCLINE_CLIMB = 0.6430f;

                // Tırmanma yönünde mi eğim kontrolü (Dot <= 0: yukarı tırmanıyor demektir)
                if (normalMag > MAX_INCLINE_CLIMB && Vector3.Dot(normalH, moveDir) <= 0.0f)
                {
                    return true; // Hareketi engelle
                }
            }

            return false;
        }

