            SendPacket(pkt);
        }

        // ============================================================
        // PACKET RECEIVING
        // ============================================================

        /// <summary>
        /// Open-KO wire frame paketlerini sürekli dinler.
        /// Frame: [0xAA][0x55][len:2 LE][payload][0x55][0xAA]
        /// </summary>
        private async Task ListenLoop(CancellationToken ct)
        {
            byte[] headerBuf = new byte[4]; // AA 55 len[2]

            try
            {
                while (!ct.IsCancellationRequested && _stream != null && _stream.CanRead)
                {
                    // Read header: 0xAA 0x55 + length (2 bytes)
                    int read = await ReadExactAsync(_stream, headerBuf, 0, 4, ct);
                    if (read == 0) break;

                    if (headerBuf[0] != 0xAA || headerBuf[1] != 0x55)
                    {
                        Debug.LogError($"[KO-NET] Invalid packet header: {headerBuf[0]:X2} {headerBuf[1]:X2}");
                        break;
                    }

                    ushort payloadLen = (ushort)(headerBuf[2] | (headerBuf[3] << 8));
                    if (payloadLen > 32000)
                    {
                        Debug.LogError($"[KO-NET] Packet too large: {payloadLen}");
                        break;
                    }

                    // Read payload + tail (2 bytes: 0x55 0xAA)
                    byte[] payloadAndTail = new byte[payloadLen + 2];
                    read = await ReadExactAsync(_stream, payloadAndTail, 0, payloadLen + 2, ct);
                    if (read == 0) break;

                    // Verify tail
                    if (payloadAndTail[payloadLen] != 0x55 || payloadAndTail[payloadLen + 1] != 0xAA)
                    {
                        Debug.LogError($"[KO-NET] Invalid packet tail: {payloadAndTail[payloadLen]:X2} {payloadAndTail[payloadLen + 1]:X2}");
                        break;
                    }

                    // Extract payload (without tail)
                    byte[] payload = new byte[payloadLen];
                    Buffer.BlockCopy(payloadAndTail, 0, payload, 0, payloadLen);

                    // Decrypt if encryption is enabled
                    byte[] decrypted;
                    if (_encryptionEnabled)
                    {
                        decrypted = DecryptPayload(payload);
                        if (decrypted == null)
                        {
                            Debug.LogError("[KO-NET] Decryption failed!");
                            continue;
                        }
                    }
                    else
                    {
                        decrypted = payload;
                    }

                    // C++ birebir: m_qRecvPkt.push(pkt) — kuyruğa ekle, Update() drain edecek
                    _packetQueue.Enqueue(decrypted);
                }
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                if (!ct.IsCancellationRequested)
                {
                    Debug.LogError($"[KO-NET] Listen error: {ex.Message}");
                }
            }

            Log("[KO-NET] Connection closed.");
            RunOnMainThread(() => OnDisconnected?.Invoke());
        }

        /// <summary>
        /// Şifreli payload'ı çöz.
        /// Server format: encrypt([0xFC][0x1E][seq:3][opcode+data]) — CRC32 YOK
        /// Asimetrik: Client→Server CRC32 var, Server→Client CRC32 yok.
        /// </summary>
        private byte[] DecryptPayload(byte[] encrypted)
        {
            // Server sadece JvEncryptionFast kullanıyor (CRC32 yok)
            byte[] decrypted = new byte[encrypted.Length];
            _crypto.JvEncryptionFast(encrypted, decrypted, encrypted.Length);

            // Decrypted: [0xFC][0x1E][seq:3 LE][opcode][data...]
            if (decrypted.Length < 5 || decrypted[0] != 0xFC || decrypted[1] != 0x1E)
            {
                Debug.LogError($"[KO-NET] Decrypted packet missing markers: {decrypted[0]:X2} {decrypted[1]:X2}");
                return null;
            }

            // Extract 3-byte sequence
            uint recvSeq = (uint)(decrypted[2] | (decrypted[3] << 8) | (decrypted[4] << 16));
            _recvValue = recvSeq;

            // Return actual data (skip 5 byte header: 0xFC + 0x1E + seq[3])
            int dataLen = encrypted.Length - 5;
            byte[] actualData = new byte[dataLen];
            Buffer.BlockCopy(decrypted, 5, actualData, 0, dataLen);
            return actualData;
        }

        /// <summary>
        /// Stream'den tam N byte oku.
        /// </summary>
        private static async Task<int> ReadExactAsync(NetworkStream stream, byte[] buffer, int offset, int count, CancellationToken ct)
        {
            int totalRead = 0;
            while (totalRead < count)
            {
                int n = await stream.ReadAsync(buffer, offset + totalRead, count - totalRead, ct);
                if (n == 0) return 0;
                totalRead += n;
            }
            return totalRead;
        }

        private void RunOnMainThread(Action action)
        {
            _mainThreadActions.Enqueue(action);
        }
    
        private void Log(string message)
        {
            if (EnableDebugLogs)
            {
                Debug.Log(message);
            }
        }
    }
