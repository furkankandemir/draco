using System;
using System.Collections.Concurrent;
using System.Net.Sockets;
using System.Threading;
using System.Threading.Tasks;
using UnityEngine;

namespace EntropyOnline.Network.KO
{
    /// <summary>
    /// Open-KO Ebenezer sunucusuna TCP bağlantı yöneticisi.
    /// 
    /// Wire Format (unencrypted):
    ///   [0xAA][0x55][length:2 LE][payload: length bytes][0x55][0xAA]
    /// 
    /// Wire Format (encrypted — WIZ_CRYPTION sonrası):
    ///   [0xAA][0x55][length:2 LE][encrypted_payload][0x55][0xAA]
    ///   encrypted_payload = JvEncrypt(0xFC, 0x1E, seq[3], opcode, data..., CRC32[4])
    /// 
    /// Handshake akışı:
    ///   1. Client bağlanır (port 15001)
    ///   2. Client → WIZ_VERSION_CHECK (unencrypted)
    ///   3. Server → WIZ_VERSION_CHECK + public_key (unencrypted)
    ///   4. Client JvCryption.Init() — bundan sonra tüm paketler şifreli
    ///   5. Client → WIZ_LOGIN (encrypted)
    ///   6. Server → WIZ_LOGIN [result] (encrypted)
    /// </summary>
    public class KONetworkManager : MonoBehaviour
    {
        public static KONetworkManager Instance { get; private set; }
        public static bool EnableDebugLogs = false;

        [Header("Ebenezer Server")]
        [SerializeField] private string serverIP = "192.168.1.8";
        [SerializeField] private int serverPort = 15001;
        [SerializeField] private string configUrl = "https://raw.githubusercontent.com/furkankandemir/draco/main/server.txt";
        public string ServerIP => serverIP;

        // Connection state
        public bool IsConnected => _client?.Connected ?? false;
        public bool IsEncrypted => _encryptionEnabled;

        // Events
        public event Action OnConnected;
        public event Action OnDisconnected;
        public event Action<string> OnConnectionError;
        public event Action<byte, byte[]> OnPacketReceived;

        private TcpClient _client;
        private NetworkStream _stream;
        private CancellationTokenSource _cts;

        // Encryption
        private readonly JvCryption _crypto = new JvCryption();
        private bool _encryptionEnabled;
        private uint _sendValue;
        private uint _recvValue;

        // Thread-safe main thread queue (non-packet actions: connect/disconnect events)
        private readonly ConcurrentQueue<Action> _mainThreadActions = new();

        // C++ birebir: s_pProcActive != nullptr kontrolü
        // Paketler sadece aktif proc (GameScene) hazır olduğunda kuyruğdan çıkarılır.
        // Sahne geçişinde paketler kuyrukta birikir — C++ Tick() birebir.
        private bool _gameReady;
        public void SetGameReady(bool ready) { _gameReady = ready; }

        // C++ birebir: m_qRecvPkt — ham paket kuyruğu
        // Network thread paketleri kuyruğa koyar, Update() her frame kuyruğu drain eder.
        // State/sahne geçişinde paketler kuyrukta birikir, kaybolmaz.
        private readonly ConcurrentQueue<byte[]> _packetQueue = new();

        // Send lock
        private readonly object _sendLock = new object();

        // C++ birebir: s_szAccount — login'de saklanan hesap ID'si
        // WIZ_SEL_CHAR gibi paketlerde accountId gerekiyor
        private string _accountId;
        public string AccountId => _accountId;

        private void Awake()
        {
            if (Instance != null && Instance != this)
            {
                Destroy(gameObject);
                return;
            }
            Instance = this;
            DontDestroyOnLoad(gameObject);
        }

        private void Update()
        {
            // Non-packet actions (connect/disconnect events)
            while (_mainThreadActions.TryDequeue(out var action))
            {
                try { action?.Invoke(); }
                catch (Exception ex) { Debug.LogError($"[KO-NET] MainThread action error: {ex}"); }
            }

            // C++ birebir: CGameProcedure::TickActive() + Tick()
            //
            // TickActive():
            //   if (s_pProcActive != s_pProcPrev) {
            //       s_pProcPrev->Release();
            //       s_pProcActive->Init();           ← Init ÖNCE
            //       s_pProcPrev = s_pProcActive;
            //   }
            //   s_pProcActive->Tick();               ← Tick SONRA
            //
            // Tick() → CGameProcedure::Tick():
            //   while (!m_qRecvPkt.empty()) { ProcessPacket(front()); pop(); }
            //
            // ProcessPacket VIRTUAL:
            //   CGameProcedure (base)  → WIZ_VERSION_CHECK, WIZ_LOGIN, WIZ_SEL_CHAR
            //   CGameProcCharSelect    → WIZ_ALLCHAR_INFO_REQ, WIZ_DEL_CHAR
            //   CGameProcMain          → WIZ_NPC_INOUT, WIZ_MYINFO, vs.
            //
            // Unity karşılığı:
            //   _gameReady = false → CharSelect/Login state → sadece base paketler işlenir
            //   _gameReady = true  → ProcMain state → tüm paketler işlenir
            //   LoadSceneAsync sırasında _gameReady false → game paketleri kuyrukta kalır
            //   EntityManager.Start() → SetGameReady(true) → kuyruk drain başlar

            while (_packetQueue.TryPeek(out byte[] peeked))
            {
                byte opcode = peeked[0];

                // C++ birebir: CGameProcedure::ProcessPacket (base) — her state'de işler
                // + CGameProcCharacterSelect::ProcessPacket — karakter seçim paketleri
                // Değerler KOProtocol.cs'den alınmıştır
                bool isBasePacket = opcode == 0x2B  // WIZ_VERSION_CHECK
                    || opcode == 0x01               // WIZ_LOGIN
                    || opcode == 0x02               // WIZ_NEW_CHAR
                    || opcode == 0x03               // WIZ_DEL_CHAR
                    || opcode == 0x04               // WIZ_SEL_CHAR
                    || opcode == 0x05               // WIZ_SEL_NATION
                    || opcode == 0x0C               // WIZ_ALLCHAR_INFO_REQ
                    || opcode == 0x2C               // WIZ_CRYPTION
                    || opcode == 0x42               // WIZ_COMPRESS_PACKET
                    || opcode == 0x0D               // WIZ_GAMESTART
                    || opcode == 0x0E;              // WIZ_MYINFO

                // C++ birebir: s_pProcActive == s_pProcMain değilse game paketleri işlenmez
                // Game paketi + game ready değil → kuyrukta bırak, döngüyü kır
                if (!isBasePacket && !_gameReady)
                    break;

                // Kuyruktan çıkar ve işle
                if (!_packetQueue.TryDequeue(out byte[] rawData))
                    break;

                try
                {
                    KOPacketHandler.HandlePacket(rawData[0], rawData);
                    OnPacketReceived?.Invoke(rawData[0], rawData);
                }
                catch (Exception ex)
                {
                    Debug.LogError($"[KO-NET] Packet handler error (opcode=0x{rawData[0]:X2}): {ex}");
                }
            }
        }

        private void OnDestroy()
        {
            Disconnect();
        }

        // ============================================================
        // CONNECTION
        // ============================================================

        /// <summary>
        /// Ebenezer'a bağlan ve handshake başlat.
        /// </summary>
        public async void Connect()
        {
            if (IsConnected)
            {
                Debug.LogWarning("[KO-NET] Already connected.");
                return;
            }

            try
            {
                Log($"[KO-NET] Connecting to {serverIP}:{serverPort}...");

                _cts = new CancellationTokenSource();
                _client = new TcpClient { NoDelay = true };
                _encryptionEnabled = false;
                _sendValue = 0;
                _recvValue = 0;

                var connectTask = _client.ConnectAsync(serverIP, serverPort);
                var timeout = Task.Delay(5000);

                if (await Task.WhenAny(connectTask, timeout) == timeout)
                    throw new TimeoutException("Connection timed out.");

                await connectTask;

                _stream = _client.GetStream();
                Log("[KO-NET] Connected to Ebenezer!");

                RunOnMainThread(() => OnConnected?.Invoke());

                // Start listening
                _ = Task.Run(() => ListenLoop(_cts.Token));

                // Send version check to initiate handshake
                SendVersionCheck();
            }
            catch (Exception ex)
            {
                Debug.LogError($"[KO-NET] Connection error: {ex.Message}");
                RunOnMainThread(() => OnConnectionError?.Invoke(ex.Message));
            }
        }

        public void Disconnect()
        {
            _cts?.Cancel();
            _stream?.Close();
            _client?.Close();
            _client = null;
            _stream = null;
            _encryptionEnabled = false;
            Log("[KO-NET] Disconnected.");
        }

        // ============================================================
        // PACKET SENDING
        // ============================================================

        /// <summary>
        /// Open-KO wire frame'ine sarılmış paket gönder.
        /// </summary>
        public void SendPacket(KOPacketWriter writer)
        {
            if (_stream == null || !_stream.CanWrite)
            {
                Debug.LogWarning("[KO-NET] Cannot send — not connected.");
                return;
            }

            // Paket loglama — gönderilmeden önce payload'ı logla
            byte[] rawPayload = writer.GetPayload();
            if (rawPayload != null && rawPayload.Length > 0)
            {
                KOPacketLogger.LogSend(rawPayload[0], rawPayload);
            }

            byte[] wirePacket = writer.Build(_crypto, _encryptionEnabled, ref _sendValue);

            try
            {
                lock (_sendLock)
                {
                    _stream.Write(wirePacket, 0, wirePacket.Length);
                    _stream.Flush();
                }
            }
            catch (Exception ex)
            {
                Debug.LogError($"[KO-NET] Send error: {ex.Message}");
            }
        }

        // ============================================================
        // HANDSHAKE
        // ============================================================

        /// <summary>
        /// Step 1: WIZ_VERSION_CHECK gönder (şifresiz).
        /// Server, version + public key ile yanıt verecek.
        /// </summary>
        private void SendVersionCheck()
        {
            Log("[KO-NET] Sending WIZ_VERSION_CHECK...");
            using var pkt = new KOPacketWriter(WizOpcode.WIZ_VERSION_CHECK);
            // Sadece opcode — server VersionCheck() çağıracak
            SendPacket(pkt);
        }

        /// <summary>
        /// Server'dan gelen WIZ_VERSION_CHECK yanıtını işle.
        /// [WIZ_VERSION_CHECK][version:2][publicKey:8]
        /// </summary>
        internal void HandleVersionCheckResponse(KOPacketReader reader)
        {
            short version = reader.ReadInt16();
            ulong publicKey = reader.ReadUInt64();

            Log($"[KO-NET] Server version: {version}, PublicKey: 0x{publicKey:X16}");

            // JvCryption kurulumu
            _crypto.SetPublicKey(publicKey);
            _crypto.Init();
            _encryptionEnabled = true;

            Log("[KO-NET] Encryption enabled. Ready for login.");
        }

        // ============================================================
        // LOGIN
        // ============================================================

        /// <summary>
        /// WIZ_LOGIN gönder — şifreli.
        /// Wire: [WIZ_LOGIN][idLen:2][accountId][pwdLen:2][password]
        /// </summary>
        public void SendLogin(string accountId, string password)
        {
            if (!_encryptionEnabled)
            {
                Debug.LogError("[KO-NET] Cannot login — encryption not established.");
                return;
            }

            // C++ birebir: s_szAccount sakla — WIZ_SEL_CHAR'da lazım olacak
            _accountId = accountId;

            Log($"[KO-NET] Sending WIZ_LOGIN for '{accountId}'...");
            using var pkt = new KOPacketWriter(WizOpcode.WIZ_LOGIN);
            pkt.WriteKOString(accountId);
            pkt.WriteKOString(password);
            SendPacket(pkt);
        }

        /// <summary>
        /// WIZ_ALLCHAR_INFO_REQ gönder — karakter listesi iste.
        /// </summary>
        public void SendAllCharInfoReq()
        {
            Log("[KO-NET] Sending WIZ_ALLCHAR_INFO_REQ...");
            using var pkt = new KOPacketWriter(WizOpcode.WIZ_ALLCHAR_INFO_REQ);
            SendPacket(pkt);
        }

        /// <summary>
        /// WIZ_CHAT_TARGET - Fısıltı hedefini ayarlar (private mesaj gönderilecek kişi).
        /// Wire: WIZ_CHAT_TARGET + targetName (KOString)
        /// </summary>
        public void SendChatSelectTarget(string targetName)
        {
            if (string.IsNullOrEmpty(targetName) || targetName.Length > 20) return;
            using var pkt = new KOPacketWriter(WizOpcode.WIZ_CHAT_TARGET);
            pkt.WriteKOString(targetName);
            SendPacket(pkt);
            Log($"[KO-NET] SendChatSelectTarget: name='{targetName}'");
        }

        /// <summary>
        /// WIZ_SEL_CHAR — karakter seç.
        /// C++ birebir: SelCharToAgent (User.cpp:1048-1157)
        /// Wire: [WIZ_SEL_CHAR][accountId:string2][charId:string2][bInit:1]
        /// NOT: C++ ayrıca zoneId gönderir ama client'tan 0 gider, server kendi belirler.
        /// </summary>
        public void SendSelectCharacter(string characterId, byte zoneId = 0)
        {
            Log($"[KO-NET] Sending WIZ_SEL_CHAR for '{characterId}' zone={zoneId}...");
            using var pkt = new KOPacketWriter(WizOpcode.WIZ_SEL_CHAR);
            pkt.WriteKOString(_accountId ?? "");
            pkt.WriteKOString(characterId);
            // C++ birebir: MsgSend_CharacterSelect (GameProcedure.cpp:858-869)
            // Wire: [accountId:string2][charId:string2][bInit:1][zoneId:1]
            // bInit = iZoneInit (0x01 fresh login)
            // zoneId = iZoneCur (karakter seçim ekranındaki zone numarası)
            pkt.WriteByte(0x01);    // bInit = 1 (fresh login)
            pkt.WriteByte(zoneId);  // zoneId — server'ın beklediği zone numarası
            SendPacket(pkt);
        }

        /// <summary>
        /// WIZ_GAMESTART — oyuna giriş.
        /// C++ birebir: User.cpp:14451-14538
        /// Wire: [WIZ_GAMESTART][subOpcode:1]
        /// subOpcode: 1=loading started, 2=loading finished
        /// </summary>
        public void SendGameStart(byte subOpcode = 1)
        {
            Log($"[KO-NET] Sending WIZ_GAMESTART sub={subOpcode}...");
            using var pkt = new KOPacketWriter(WizOpcode.WIZ_GAMESTART);
            pkt.WriteByte(subOpcode);
            SendPacket(pkt);
        }

        /// <summary>
        /// WIZ_SKILLDATA — Skillbar verisini sunucuya gönder.
        /// Orijinal KO'da relog sırasında kaydedilir, mobilde her değişiklikte anında.
        /// Wire: [WIZ_SKILLDATA (0x79)][sub:0x01 SAVE][192 byte data]
        /// </summary>
        public void SendSkillBarData(byte[] skillBarData)
        {
            if (skillBarData == null || skillBarData.Length != 336) return;

            using var pkt = new KOPacketWriter(WizOpcode.WIZ_SKILLDATA);
            pkt.WriteByte(0x01); // sub: SAVE
            pkt.WriteBytes(skillBarData, 0, skillBarData.Length);
            SendPacket(pkt);
            Log("[KO-NET] WIZ_SKILLDATA SAVE gönderildi (336 byte).");
        }

        /// <summary>
        /// WIZ_NEW_CHAR — yeni karakter oluştur.
        /// C++ birebir: NewCharToAgent (User.cpp:869-961)
        /// Wire: [WIZ_NEW_CHAR][charIndex:1][charId:string2][race:1][class:2][face:1][hair:1]
        ///       [str:1][sta:1][dex:1][intel:1][cha:1]
        /// </summary>
        public void SendNewChar(byte charIndex, string charName, byte race, short classId,
                                byte face, byte hair, byte str, byte sta, byte dex, byte intel, byte cha)
        {
            Log($"[KO-NET] Sending WIZ_NEW_CHAR '{charName}' slot={charIndex}...");
            using var pkt = new KOPacketWriter(WizOpcode.WIZ_NEW_CHAR);
            pkt.WriteByte(charIndex);
            pkt.WriteKOString(charName);
            pkt.WriteByte(race);
            pkt.WriteInt16(classId);
            pkt.WriteByte(face);
            pkt.WriteByte(hair);
            pkt.WriteByte(str);
            pkt.WriteByte(sta);
            pkt.WriteByte(dex);
            pkt.WriteByte(intel);
            pkt.WriteByte(cha);
            SendPacket(pkt);
        }

        /// <summary>
        /// WIZ_DEL_CHAR — karakter sil.
        /// C++ birebir: DelCharToAgent (User.cpp:963-1016)
        /// Wire: [WIZ_DEL_CHAR][charIndex:1][charId:string2][socNo:string2]
        /// </summary>
        public void SendDeleteChar(byte charIndex, string charName)
        {
            Log($"[KO-NET] Sending WIZ_DEL_CHAR '{charName}' slot={charIndex}...");
            using var pkt = new KOPacketWriter(WizOpcode.WIZ_DEL_CHAR);
            pkt.WriteByte(charIndex);
            pkt.WriteKOString(charName);
            pkt.WriteKOString(""); // socNo — boş string (client'ta yok)
            SendPacket(pkt);
        }

