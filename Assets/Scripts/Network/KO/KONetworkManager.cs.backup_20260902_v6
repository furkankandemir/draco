        /// <summary>
        /// WIZ_MOVE — hareket.
        /// Birebir: User.cpp MoveProcess()
        /// </summary>
        public void SendMove(float x, float y, float z, short speed, byte moveType)
        {
            using var pkt = new KOPacketWriter(WizOpcode.WIZ_MOVE);
            pkt.WriteUInt16((ushort)(x * 10));
            pkt.WriteUInt16((ushort)(y * 10));
            pkt.WriteUInt16((ushort)(z * 10));
            pkt.WriteInt16(speed);
            pkt.WriteByte(moveType);
            SendPacket(pkt);
        }

        /// <summary>
        /// WIZ_ROTATE — yön değiştir.
        /// </summary>
        public void SendRotate(short direction)
        {
            using var pkt = new KOPacketWriter(WizOpcode.WIZ_ROTATE);
            pkt.WriteInt16(direction);
            SendPacket(pkt);
        }

        /// <summary>
        /// WIZ_ATTACK — temel saldırı.
        /// C++ birebir: MsgSend_Attack (GameProcMain.cpp:1463-1485)
        /// Wire: [WIZ_ATTACK][attackType:byte][bySuccess:byte][targetId:int16][interval:int16][distance:int16]
        /// </summary>
        public void SendAttack(short targetId, float fInterval = 1.0f, float fDistance = 2.0f)
        {
            using var pkt = new KOPacketWriter(WizOpcode.WIZ_ATTACK);
            pkt.WriteByte(1);    // cpp:1475 — attackType: 0x01 = melee
            pkt.WriteByte(1);    // cpp:1476 — bySuccess: true
            pkt.WriteInt16(targetId);
            pkt.WriteInt16((short)((fInterval + 0.1f) * 100f)); // centiseconds
            pkt.WriteInt16((short)(fDistance * 10f));            // decimetres
            SendPacket(pkt);
        }

        /// <summary>
        /// WIZ_MAGIC_PROCESS — büyü kullan.
        /// </summary>
        public void SendMagicProcess(byte subOpcode, int magicId, short sourceId, short targetId,
            short data0 = 0, short data1 = 0, short data2 = 0, short data3 = 0,
            short data4 = 0, short data5 = 0)
        {
            using var pkt = new KOPacketWriter(WizOpcode.WIZ_MAGIC_PROCESS);
            pkt.WriteByte(subOpcode);
            pkt.WriteInt32(magicId);
            pkt.WriteInt16(sourceId);
            pkt.WriteInt16(targetId);
            pkt.WriteInt16(data0);
            pkt.WriteInt16(data1);
            pkt.WriteInt16(data2);
            pkt.WriteInt16(data3);
            pkt.WriteInt16(data4);
            pkt.WriteInt16(data5);
            SendPacket(pkt);
        }

        /// <summary>
        /// WIZ_REQ_USERIN — region'daki oyuncu listesini iste.
